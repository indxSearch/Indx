@using Microsoft.JSInterop
@using Indx.Systm.Blazor.Icons
@implements IAsyncDisposable
@inject IJSRuntime JS
@* A jump menu over the page: Cmd or Ctrl and K opens it anywhere, typing narrows it, the arrows
   move the highlight, Enter goes and Escape closes. It shows what it is given: the page that hosts
   it searches (the console with Indx itself, over its datasets, sections and settings) and hands
   back the items, grouped and in order. The keys live in CommandPalette.razor.js, so the highlight
   moves without a round trip. Port of the React CommandPalette in indx-systm. *@

@if (_open)
{
    <div class="indx-palette-overlay" @onclick="Close">
        <div class="indx-palette" role="dialog" aria-modal="true" aria-label="@AriaLabel" @ref="_panel" @onclick:stopPropagation="true">
            <div class="indx-palette-field">
                <span class="indx-palette-icon"><Search Size="14" Color="currentColor" /></span>
                <input class="indx-palette-input" type="text" role="combobox" aria-expanded="true" aria-controls="@_listId"
                       aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="@Placeholder"
                       @key="_box.Key" value="@_box.Rendered" @oninput="OnInput" />
                <Kbd Keys="esc" />
            </div>
            <div class="indx-palette-list" id="@_listId" role="listbox" aria-label="@AriaLabel">
                @if (Items.Count == 0)
                {
                    <p class="indx-palette-empty">@(string.IsNullOrWhiteSpace(_box.Text) ? EmptyText : NoMatchText)</p>
                }
                @{ string? group = null; int n = 0; var shown = new HashSet<string>(StringComparer.Ordinal); }
                @foreach (var item in Items)
                {
                    // A row is keyed by its id: one given twice is shown once rather than breaking the render.
                    if (!shown.Add(item.Id)) continue;
                    if (item.Group != group)
                    {
                        group = item.Group;
                        if (group != null)
                        {
                            <div class="indx-palette-group" role="presentation">@group</div>
                        }
                    }
                    var id = $"{_listId}-{n++}";
                    <button type="button" class="indx-palette-item" id="@id" role="option" data-palette-item @key="item.Id"
                            @onclick="() => Choose(item)">
                        @if (item.Icon != null)
                        {
                            <span class="indx-palette-item-icon">@item.Icon(14)</span>
                        }
                        <span class="indx-palette-item-label">@item.Label</span>
                        @if (!string.IsNullOrEmpty(item.Hint))
                        {
                            <span class="indx-palette-item-hint">@item.Hint</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    /// <summary>An entry: what it goes to (<see cref="Id"/>, the host's own key), its name, the group
    /// it is listed under, a 14px pixl icon and a hint at the end (the team, "opens in a new tab").</summary>
    public sealed record Item(string Id, string Label, string? Group = null, RenderFragment<int>? Icon = null, string? Hint = null);

    /// <summary>The items to show for the current query, in order; consecutive items of one group
    /// are listed under its name.</summary>
    [Parameter] public IReadOnlyList<Item> Items { get; set; } = Array.Empty<Item>();
    /// <summary>What has been typed, for the host to search with.</summary>
    [Parameter] public string Query { get; set; } = "";
    [Parameter] public EventCallback<string> QueryChanged { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    /// <summary>An item was chosen; the palette closes itself.</summary>
    [Parameter] public EventCallback<Item> OnChoose { get; set; }
    /// <summary>The key that opens it with Cmd or Ctrl; "k" by default, null for none.</summary>
    [Parameter] public string? Shortcut { get; set; } = "k";
    [Parameter] public string Placeholder { get; set; } = "Search";
    /// <summary>Shown when there is nothing to list and nothing typed.</summary>
    [Parameter] public string EmptyText { get; set; } = "Nothing to show.";
    [Parameter] public string NoMatchText { get; set; } = "No matches.";
    [Parameter] public string AriaLabel { get; set; } = "Command palette";

    private readonly string _listId = $"palette-{Guid.NewGuid():N}";
    private readonly LiveInputState _box = new("");
    private bool _open;
    private bool _shown;
    private IReadOnlyList<Item>? _shownItems;
    private ElementReference _panel;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CommandPalette>? _self;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        if (OpenChanged.HasDelegate) _open = Open;
        // A query set from outside (cleared on close) replaces the box.
        if (Query != (_box.Text ?? "")) _box.Set(Query);
    }

    [JSInvokable] public Task Toggle() => InvokeAsync(() => SetOpen(!_open));
    [JSInvokable] public Task Close() => InvokeAsync(() => SetOpen(false));

    private async Task SetOpen(bool value)
    {
        if (_open == value) return;
        _open = value;
        if (!value && (_box.Text ?? "").Length > 0)
        {
            // Opened again, it starts from nothing typed.
            _box.Set("");
            if (QueryChanged.HasDelegate) await QueryChanged.InvokeAsync("");
        }
        if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(value);
        StateHasChanged();
    }

    private Task OnInput(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? "";
        _box.Typed(text);
        return QueryChanged.InvokeAsync(text);
    }

    private async Task Choose(Item item)
    {
        await SetOpen(false);
        await OnChoose.InvokeAsync(item);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (_module is null)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Indx.Systm.Blazor/CommandPalette.razor.js");
                if (_disposed) { await module.DisposeAsync(); return; }
                _module = module;
                _self = DotNetObjectReference.Create(this);
                if (Shortcut is { Length: > 0 } key) await _module.InvokeVoidAsync("listen", _self, key.ToLowerInvariant());
            }
            if (_open && !_shown) { _shownItems = Items; await _module.InvokeVoidAsync("opened", _panel, _self); }
            else if (_open && !ReferenceEquals(_shownItems, Items)) { _shownItems = Items; await _module.InvokeVoidAsync("reset", _panel); }
            _shown = _open;
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                if (_self != null) await _module.InvokeVoidAsync("unlisten", _self);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
        }
        _self?.Dispose();
    }
}
