@* A list put in order by dragging each item by its grip, or with the grip and the arrow keys. Port
   of the React SortableList in indx-systm (26 Nov 2026). Pointer events, not the browser's drag and
   drop, so the page keeps the move cursor for the whole drag and a finger drags as a mouse does.
   The browser half (SortableList.razor.js) draws the drag itself, the line where the item lands and
   the item fading, with no round trip, and tells .NET the move when it is dropped; nothing follows
   the pointer and nothing animates. An item is dragged only by its grip, so the fields inside it
   stay fields. Each move is said to screen readers. *@
@using Microsoft.JSInterop
@typeparam TItem
@inject IJSRuntime JS
@implements IAsyncDisposable

<ul class="indx-sortable @Class" aria-label="@AriaLabel" @ref="_list">
    @for (var i = 0; i < Items.Count; i++)
    {
        var item = Items[i];
        var label = Label(item);
        <li @key="Key(item)" class="indx-sortable-item @ItemClass" data-index="@i">
            @Grip(i, label)
            <div class="indx-sortable-content">@ChildContent(item)</div>
            @if (MoveButtons && !Disabled)
            {
                var at = i;
                <span class="indx-sortable-moves">
                    <Button Variant="ghost" Size="micro" aria-label="@($"Move {label} up")" @onclick="@(() => Step(at, -1))"><ArrowUp Size="21" /></Button>
                    <Button Variant="ghost" Size="micro" aria-label="@($"Move {label} down")" @onclick="@(() => Step(at, 1))"><ArrowDown Size="21" /></Button>
                </span>
            }
        </li>
    }
</ul>
<span class="indx-sortable-said" aria-live="polite">@_said</span>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = Array.Empty<TItem>();
    /// <summary>The items in their new order; with <c>@bind-Items</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyList<TItem>> ItemsChanged { get; set; }
    /// <summary>The move that made the new order, from and to, from 0.</summary>
    [Parameter] public EventCallback<(int From, int To)> OnMove { get; set; }
    /// <summary>A key per item that stays with it as it moves.</summary>
    [Parameter, EditorRequired] public Func<TItem, object> Key { get; set; } = default!;
    /// <summary>What an item is called to a screen reader: "Move Type 1", "Type 1, now 3 of 26".</summary>
    [Parameter, EditorRequired] public Func<TItem, string> Label { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<TItem> ChildContent { get; set; } = default!;
    /// <summary>No grips, no dragging: the list as it is.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>A Move up and a Move down button after each item, for those who would rather click
    /// than drag (and on a phone). At the ends they stay, and say the item is already first or last.</summary>
    [Parameter] public bool MoveButtons { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? ItemClass { get; set; }

    // The span carries the move cursor (systm's .cursor-move reaches the button inside).
    private RenderFragment Grip(int i, string label) => Disabled ? (_ => { }) : @<span class="indx-sortable-handle cursor-move">
        <Button Variant="ghost" Size="micro" data-sortable-grip="@i" aria-label="@($"Move {label}: drag, or use the arrow keys")">
            <Menu Size="21" />
        </Button>
    </span>;

    private ElementReference _list;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SortableList<TItem>>? _self;
    private bool _disposed;
    private string _said = "";

    /// <summary>The items with the one at <paramref name="from"/> moved to <paramref name="to"/>.</summary>
    public static IReadOnlyList<TItem> MoveItem(IReadOnlyList<TItem> items, int from, int to)
    {
        var next = items.ToList();
        var item = next[from];
        next.RemoveAt(from);
        next.Insert(to, item);
        return next;
    }

    /// <summary>From the browser: an item dropped, or moved by a key.</summary>
    [JSInvokable]
    public Task Moved(int from, int to) => InvokeAsync(async () =>
    {
        if (from == to || from < 0 || to < 0 || from >= Items.Count || to >= Items.Count) return;
        var label = Label(Items[from]);
        var next = MoveItem(Items, from, to);
        _said = $"{label}, now {to + 1} of {Items.Count}";
        Items = next;
        if (ItemsChanged.HasDelegate) await ItemsChanged.InvokeAsync(next);
        if (OnMove.HasDelegate) await OnMove.InvokeAsync((from, to));
        StateHasChanged();
    });

    private async Task Step(int i, int by)
    {
        var to = i + by;
        if (to < 0 || to >= Items.Count)
        {
            _said = $"{Label(Items[i])} is already {(by < 0 ? "first" : "last")}";
            return;
        }
        await Moved(i, to);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Indx.Systm.Blazor/SortableList.razor.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _list, _self);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _list); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
        }
        _self?.Dispose();
    }
}
