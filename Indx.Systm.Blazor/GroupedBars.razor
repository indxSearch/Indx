@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@* Thin bars in labelled groups across the width: a group a day and a bar an hour, a group a week
   and a bar a day. A hairline marks where each group starts, with its name and a figure above; a
   band under each group carries its colour when it is highlighted, so one group stands out from
   the rest. The sample labels sit under the band, as many as fit. Hover reads a bar by x, as
   Chart does. The width comes from the same resize module as Chart. Port of the React
   GroupedBars in indx-systm. *@
<div class="indx-grouped-bars @Class" style="height: @(Total)px;" @ref="_el" @onpointerleave="() => _hover = null">
    @if (_width > 0 && N > 0)
    {
        <svg class="indx-grouped-bars-svg" width="@F(_width)" height="@F(Total)" role="img" aria-label="@AriaLabel"
             @onpointermove="OnPointer" @onpointerdown="OnPointer">
            @for (int gi = 0; gi < Groups.Count; gi++)
            {
                var g = Groups[gi];
                double from = Start(gi);
                double span = g.Values.Count * Pitch;
                string color = ColorOf(g);
                <line class="indx-grouped-bars-divider" x1="@F(from)" y1="0" x2="@F(from)" y2="@F(BarsBottom)" />
                @for (int i = 0; i < g.Values.Count; i++)
                {
                    double bh = Top > 0 && double.IsFinite(g.Values[i]) ? Math.Max(0, g.Values[i]) / Top * Height : 0;
                    bool hovered = _hover is { } hv && hv.Group == gi && hv.Index == i;
                    <rect class="@(hovered ? "indx-grouped-bars-bar-hovered" : "indx-grouped-bars-bar")" style="@(hovered ? null : $"fill: {color};")"
                          x="@F(BarX(gi, i) - (hovered ? 1.5 : 1))" y="@F(BarsBottom - bh)" width="@(hovered ? 3 : 2)" height="@F(bh)" />
                }
                <rect class="indx-grouped-bars-band" style="@(g.Highlight ? $"fill: {color};" : null)" x="@F(from)" y="@F(BarsBottom + 4)" width="@F(span)" height="@Band" />
            }
            @* SVG text is a reserved Razor tag, so the heads and the labels go through the builder. *@
            @RenderText
        </svg>
    }
    @if (_hover is { } h && Format != null)
    {
        var g = Groups[h.Group];
        double tx = BarX(h.Group, h.Index);
        bool left = tx > _width / 2;
        // Beside the bar's top, to the right or the left past the middle, never above the chart.
        double th = Top > 0 && double.IsFinite(g.Values[h.Index]) ? Math.Max(0, g.Values[h.Index]) / Top * Height : 0;
        <div class="indx-grouped-bars-tooltip @(left ? "indx-grouped-bars-tooltip-left" : "")" style="left: @F(left ? tx - 8 : tx + 8)px; top: @F(Math.Max(Head + 12, BarsBottom - th))px;">
            <span class="indx-grouped-bars-tooltip-label">@g.Label@(Labels != null && h.Index < Labels.Count ? $" · {Labels[h.Index]}" : "")</span>
            <span class="indx-grouped-bars-tooltip-value">@Format(g.Values[h.Index], h.Group, h.Index)</span>
        </div>
    }
</div>

@code {
    /// <summary>A group: its name, a figure beside it (a total, a share), its values, and its colour and
    /// whether it stands out: a highlighted group's bars and band take its colour, the teal by default.</summary>
    public sealed record Group(string Label, IReadOnlyList<double> Values, string? Sublabel = null, string? Color = null, bool Highlight = false);

    [Parameter, EditorRequired] public IReadOnlyList<Group> Groups { get; set; } = Array.Empty<Group>();
    /// <summary>What each sample in a group is, for the tooltip and the labels under the band: the hours.</summary>
    [Parameter] public IReadOnlyList<string>? Labels { get; set; }
    /// <summary>The bars' height in pixels; 120 by default.</summary>
    [Parameter] public int Height { get; set; } = 120;
    /// <summary>The value that reaches the top; the largest by default.</summary>
    [Parameter] public double? Max { get; set; }
    /// <summary>The gap between groups in pixels; 2 by default, so the groups read as one run parted by hairlines.</summary>
    [Parameter] public double Gap { get; set; } = 2;
    /// <summary>The tooltip's text for a value, from the value, the group's index and the sample's. Nothing by default.</summary>
    [Parameter] public Func<double, int, int, string>? Format { get; set; }
    /// <summary>A name for assistive technology: "Searches by hour, this week".</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }

    private const string DefaultColor = "var(--lv6)";
    private const double Head = 30, Band = 10, Foot = 20;
    private double GroupGap => Gap;

    private ElementReference _el;
    private double _width;
    private (int Group, int Index)? _hover;
    private IJSObjectReference? _module;
    private DotNetObjectReference<GroupedBars>? _selfRef;
    private bool _disposed;

    private int N => Groups.Sum(g => g.Values.Count);
    private double Top => Max ?? Groups.SelectMany(g => g.Values).Where(double.IsFinite).DefaultIfEmpty(0).Max();
    private double Total => Height + Head + 4 + Band + Foot;
    private double BarsBottom => Head + Height;
    private double Pitch => N > 0 ? (_width - GroupGap * Math.Max(0, Groups.Count - 1)) / N : 0;
    private double Start(int gi) => Groups.Take(gi).Sum(g => g.Values.Count * Pitch + GroupGap);
    private double BarX(int gi, int i) => Start(gi) + i * Pitch + Pitch / 2;
    private static string ColorOf(Group g) => g.Highlight ? g.Color ?? "var(--CTeal)" : DefaultColor;
    // Sample labels every so many, so they stay at least 28px apart; the first and the last kept
    // inside the width.
    private int Every => Pitch > 0 ? Math.Max(1, (int)Math.Ceiling(28 / Pitch)) : 1;
    private double TickX(int gi, int i) => Math.Min(_width - 10, Math.Max(10, BarX(gi, i)));

    private RenderFragment RenderText => builder =>
    {
        int seq = 0;
        for (int gi = 0; gi < Groups.Count; gi++)
        {
            var g = Groups[gi];
            double from = Start(gi);
            Text(builder, ref seq, "indx-grouped-bars-head", from + 6, 11, "start", g.Label, null);
            if (g.Sublabel != null)
                Text(builder, ref seq, "indx-grouped-bars-sub", from + 6, 23, "start", g.Sublabel, g.Highlight ? $"fill: {ColorOf(g)};" : null);
            if (Labels != null)
                for (int i = 0; i < g.Values.Count; i += Every)
                    if (i < Labels.Count)
                        Text(builder, ref seq, "indx-grouped-bars-tick", TickX(gi, i), Total - 5, "middle", Labels[i], null);
        }
    };

    private static void Text(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ref int seq,
        string cls, double x, double y, string anchor, string text, string? style)
    {
        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "class", cls);
        builder.AddAttribute(seq++, "x", F(x));
        builder.AddAttribute(seq++, "y", F(y));
        builder.AddAttribute(seq++, "text-anchor", anchor);
        if (style != null) builder.AddAttribute(seq++, "style", style);
        builder.AddContent(seq++, text);
        builder.CloseElement();
    }

    // The bar under the pointer, by x: the group whose span (and half the gap around it) holds
    // it, then the sample inside. Only a move to another bar redraws.
    private void OnPointer(PointerEventArgs e)
    {
        if (Format == null || N == 0) return;
        (int, int)? next = null;
        for (int gi = 0; gi < Groups.Count; gi++)
        {
            double from = Start(gi), to = from + Groups[gi].Values.Count * Pitch;
            if (e.OffsetX >= from - GroupGap / 2 && e.OffsetX < to + GroupGap / 2)
            {
                int i = Math.Min(Groups[gi].Values.Count - 1, Math.Max(0, (int)Math.Floor((e.OffsetX - from) / Pitch)));
                next = (gi, i);
                break;
            }
        }
        if (next == _hover) { _skipRender = true; return; }
        _hover = next;
    }

    private bool _skipRender;

    protected override bool ShouldRender()
    {
        if (!_skipRender) return true;
        _skipRender = false;
        return false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Indx.Systm.Blazor/Chart.razor.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            _selfRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("observe", _el, _selfRef);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    [JSInvokable]
    public void OnResize(double width)
    {
        if (Math.Abs(width - _width) < 0.5) return;
        _width = width;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("unobserve", _el); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
        }
        _selfRef?.Dispose();
    }

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
