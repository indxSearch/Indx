@* A slider with no end, the port of the React ScrubSlider (Nov 2026). A ruler of ticks scrolls under
   a fixed handle and moves with the hand, as a tape does: dragging it right brings lower values
   under the handle, left higher ones, one step per tick. The arrow keys step it (Shift for ten), and
   the number field at the right shows and takes the value. The drag runs in the browser with no
   round trip; .NET hears each new value and, once the drag ends, the settled one. *@
@using System.Globalization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="indx-scrub @(Disabled ? "indx-scrub--disabled" : null) @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@_id" class="indx-scrub-label" style="@(LabelWidth is { } w ? $"width:{w}" : null)">@Label</label>
    }
    <div @ref="_ruler" class="indx-scrub-ruler"
         style="@RulerStyle(Value)" role="slider" tabindex="@(Disabled ? -1 : 0)"
         aria-label="@(AriaLabel ?? Label)" aria-valuenow="@Fmt(Shown)" aria-valuemin="@(Min is { } mn ? Fmt(mn) : null)"
         aria-valuemax="@(Max is { } mx ? Fmt(mx) : null)" aria-valuetext="@ValueText(Shown)" aria-disabled="@(Disabled ? "true" : null)">
        <div class="indx-scrub-ticks" aria-hidden="true"></div>
        @foreach (var mark in Marks ?? [])
        {
            <div class="indx-scrub-mark @(mark.Tone is { } tone ? $"indx-scrub-mark--{tone}" : null)" data-value="@Fmt(mark.Value)"
                 style="left:calc(50% + @Fmt(ToPx(mark.Value, Value))px)" aria-hidden="true"></div>
        }
        <div class="indx-scrub-handle" aria-hidden="true"></div>
    </div>
    <div class="indx-scrub-field" style="width:@FieldWidth">
        <InputField Id="@_id" inputmode="decimal" aria-label="@(Label is { } l ? $"{l}, value" : AriaLabel)" disabled="@Disabled"
                    Value="@Fmt(Shown)" ValueChanged="Typed" ValueExpression="() => _typed" />
    </div>
</div>

@code {
    /// <summary>A value marked on the ruler: a line where it stands, scrolling with the ticks. A
    /// tone ("warning", "signal") colours one that changes what the setting does.</summary>
    public sealed record ScrubMark(double Value, string? Tone = null, string? Label = null);

    // Pixels per step; every fifth tick is a major one (as the React ScrubSlider).
    private const int TickSpacing = 8, MajorEvery = 5;

    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    /// <summary>Once a drag ends, or a key or a typed value commits, with the settled value.</summary>
    [Parameter] public EventCallback<double> FinalChanged { get; set; }
    /// <summary>The value moves by this per tick and per arrow key; Shift moves ten.</summary>
    [Parameter] public double Step { get; set; } = 1;
    /// <summary>Bounds are optional: without them the slider has no end.</summary>
    [Parameter] public double? Min { get; set; }
    [Parameter] public double? Max { get; set; }
    [Parameter] public string? Label { get; set; }
    /// <summary>A fixed width for the label, as CSS, so a stack of sliders lines up its rulers.</summary>
    [Parameter] public string? LabelWidth { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Width of the number field, as CSS.</summary>
    [Parameter] public string FieldWidth { get; set; } = "70px";
    [Parameter] public IReadOnlyList<ScrubMark>? Marks { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Id { get; set; }

    private readonly string _generatedId = $"indx-scrub-{Guid.NewGuid():N}";
    private string _id => Id ?? _generatedId;
    private string? _typed;
    private ElementReference _ruler;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ScrubSlider>? _self;
    private bool _disposed;

    private int Decimals
    {
        get
        {
            var s = Step.ToString(CultureInfo.InvariantCulture);
            var i = s.IndexOf('.');
            return i < 0 ? 0 : s.Length - i - 1;
        }
    }

    private double Clamp(double v)
    {
        if (Min is { } min) v = Math.Max(min, v);
        if (Max is { } max) v = Math.Min(max, v);
        return Math.Round(v, Decimals);
    }

    /// <summary>The value at the step's decimals: a caller that keeps it as a float hands back 2.7 as
    /// 2.700000047683716, which the field showed as "2.70000005" (Nov 2026).</summary>
    private double Shown => Math.Round(Value, Decimals);

    private static string Fmt(double v) => v.ToString("0.########", CultureInfo.InvariantCulture);
    private double ToPx(double at, double value) => (at - value) / Step * TickSpacing;

    /// <summary>The ticks are two repeating gradients phased by the value; a bound clips the ruler
    /// where it is, so it visibly ends there. The same numbers the browser half sets while dragging.</summary>
    private string RulerStyle(double value)
    {
        double period = TickSpacing * MajorEvery;
        double shift = -((value / Step * TickSpacing) % period);
        string left = Min is { } min ? $"max(0px, calc(50% + {Fmt(ToPx(min, value))}px))" : "0px";
        string right = Max is { } max ? $"max(0px, calc(50% - {Fmt(ToPx(max, value))}px))" : "0px";
        return $"--scrub-shift:{Fmt(shift)}px;--scrub-tick:{TickSpacing}px;--scrub-period:{Fmt(period)}px;--scrub-clip:inset(0 {right} 0 {left})";
    }

    private string? ValueText(double value) =>
        Marks?.FirstOrDefault(m => m.Value == value && m.Label != null) is { } m ? $"{Fmt(value)}, {m.Label}" : null;

    /// <summary>From the browser, as the drag or a key moves the value.</summary>
    [JSInvokable]
    public Task Moved(double value) => InvokeAsync(async () =>
    {
        Value = value;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(value);
    });

    /// <summary>From the browser, once the drag has ended or a key has stepped.</summary>
    [JSInvokable]
    public Task Settled(double value) => InvokeAsync(async () =>
    {
        if (FinalChanged.HasDelegate) await FinalChanged.InvokeAsync(value);
    });

    private async Task Typed(string? text)
    {
        if (!double.TryParse((text ?? "").Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed)
            || !double.IsFinite(parsed))
        {
            StateHasChanged(); // not a number: the field shows the value again
            return;
        }
        var next = Clamp(parsed);
        if (next == Shown) { StateHasChanged(); return; }
        Value = next;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(next);
        if (FinalChanged.HasDelegate) await FinalChanged.InvokeAsync(next);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Indx.Systm.Blazor/ScrubSlider.razor.js");
                if (_disposed) { await module.DisposeAsync(); return; }
                _module = module;
                _self = DotNetObjectReference.Create(this);
            }
            // The browser half holds its own copy of the value while dragging; it is told the
            // value and the settings after every render, and ignores the value mid-drag.
            if (_module != null)
            {
                await _module.InvokeVoidAsync("sync", _ruler, _self, new { value = Shown, step = Step, min = Min, max = Max, disabled = Disabled, decimals = Decimals, tick = TickSpacing, major = MajorEvery });
            }
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _ruler); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
        }
        _self?.Dispose();
    }
}
