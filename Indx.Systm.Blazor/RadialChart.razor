@using System.Globalization
@* Bars around a clock face, from the top clockwise, around a hollow centre, in three shapes.
   One series: a bar a sample, its length the value, with a hairline guide a sample out to the
   rim and a dashed line at the top for the start of the period; a year of days, the hours of a
   day. Several series: the sample's slot shared between them, each in its colour, with a legend;
   searches and asks by hour. Groups, the rose: a wedge per group, its radius the value, over a
   dim wedge the full radius, the name and the value upright in it; a handful of kinds compared.
   Hover reads a bar or a wedge by its angle, as Chart reads by x. Port of the React RadialChart
   in indx-systm. *@
<div class="indx-radial-wrapper @Class">
    <div class="indx-radial" style="--radial-size: @(Size)px;" @onpointerleave="() => _hover = null">
        <svg class="indx-radial-svg" style="--radial-bar: @F(BarWidth)px;" viewBox="0 0 @Size @Size" width="@Size" height="@Size" role="img" aria-label="@AriaLabel"
             @onpointermove="OnPointer" @onpointerdown="OnPointer">
            @if (Grouped)
            {
                @* The rose: the dim wedge the full radius, the lit one to the value over it. *@
                @for (int slot = 0; slot < Slots; slot++)
                {
                    var g = Groups![slot];
                    <path class="indx-radial-wedge-track" style="stroke-width: @F(Corner * 2)px;" d="@Wedge(slot, Outer)" />
                    var len = LengthOf(g.Value);
                    if (len > 0)
                    {
                        var fill = g.Color ?? Color ?? DefaultColor;
                        <path class="indx-radial-wedge @(_hover == slot ? "indx-radial-wedge-hovered" : "")" style="fill: @fill; stroke: @fill; stroke-width: @F(Corner * 2)px;" d="@Wedge(slot, Inner + len)" />
                    }
                }
            }
            else
            {
                @for (int slot = 0; slot < Slots; slot++)
                {
                    var (gx1, gy1) = Point(slot, Inner);
                    var (gx2, gy2) = Point(slot, Outer);
                    <line class="indx-radial-guide" x1="@F(gx1)" y1="@F(gy1)" x2="@F(gx2)" y2="@F(gy2)" />
                }
            }
            @if (!Grouped && Slots > 0)
            {
                var (sx1, sy1) = Point(0, Inner);
                var (sx2, sy2) = Point(0, Outer);
                <line class="indx-radial-start" x1="@F(sx1)" y1="@F(sy1)" x2="@F(sx2)" y2="@F(sy2)" />
            }
            @for (int slot = 0; slot < Slots && !Grouped; slot++)
            {
                for (int s = 0; s < Lanes; s++)
                {
                    var len = LengthOf(ValueAt(s, slot));
                    if (len <= 0) { continue; }
                    var (bx1, by1) = Point(slot, BarFrom, s);
                    var (bx2, by2) = Point(slot, BarTo(len), s);
                    bool hovered = _hover == slot;
                    <line class="indx-radial-bar @(hovered ? "indx-radial-hovered" : "")" style="stroke: @ColorOf(s);"
                          x1="@F(bx1)" y1="@F(by1)" x2="@F(bx2)" y2="@F(by2)" />
                }
            }
            @* SVG text is a reserved Razor tag, so the rose's names and values go through the builder. *@
            @RenderSectorLabels
        </svg>
        @if (Centre != null)
        {
            <div class="indx-radial-centre" style="width: @F(Inner * 2)px; height: @F(Inner * 2)px;">@Centre</div>
        }
        @if (_hover is { } hv && Format != null)
        {
            double longest = Math.Max(Enumerable.Range(0, Lanes).Max(i => LengthOf(ValueAt(i, hv))), Span * 0.15);
            // At the bar's end: past it from the hollow, or inside it from the rim.
            var (tx, ty) = Point(hv, Inverse && !Grouped ? Outer - longest - 6 : Inner + longest + 6);
            <div class="indx-radial-tooltip @(tx > Outer ? "indx-radial-tooltip-left" : "")" style="left: @F(tx)px; top: @F(ty)px;">
                @if (!Grouped)
                {
                    <span class="indx-radial-tooltip-label">@(Labels != null && hv < Labels.Count ? Labels[hv] : (hv + 1).ToString(CultureInfo.InvariantCulture))</span>
                }
                @if (Grouped)
                {
                    var g = Groups![hv];
                    <span class="indx-radial-tooltip-row"><span class="indx-radial-tooltip-name">@g.Label</span><span class="indx-radial-tooltip-value">@Format(g.Value, hv)</span></span>
                }
                else
                {
                    @for (int s = 0; s < Lanes; s++)
                    {
                        var ser = All[s];
                        <span class="indx-radial-tooltip-row">
                            @if (Lanes > 1) { <span class="indx-radial-tooltip-dot" style="background: @ColorOf(s);"></span><span class="indx-radial-tooltip-name">@ser.Label</span> }
                            <span class="indx-radial-tooltip-value">@Format(hv < ser.Values.Count ? ser.Values[hv] : 0, hv)</span>
                        </span>
                    }
                }
            </div>
        }
    </div>
    @if (ShowLegend && !Grouped && Lanes > 1)
    {
        <div class="indx-radial-legend">
            @for (int s = 0; s < Lanes; s++)
            {
                <span class="indx-radial-legend-item"><span class="indx-radial-legend-mark" style="background: @ColorOf(s);"></span><span class="indx-radial-legend-label">@All[s].Label</span></span>
            }
        </div>
    }
</div>

@code {
    /// <summary>One series over the samples; the first is the ink, the rest need a colour.</summary>
    public sealed record Series(string Label, IReadOnlyList<double> Values, string? Color = null);
    /// <summary>A group of the rose: its name, its value and, optionally, its colour.</summary>
    public sealed record Group(string Label, double Value, string? Color = null);

    /// <summary>One series: a value a sample, from the top clockwise.</summary>
    [Parameter] public IReadOnlyList<double>? Values { get; set; }
    /// <summary>Several series over the same samples, each in its colour; the first is the ink.</summary>
    [Parameter] public IReadOnlyList<Series>? SeriesList { get; set; }
    /// <summary>What each sample is, for the tooltip: a date, an hour. The index when left out.</summary>
    [Parameter] public IReadOnlyList<string>? Labels { get; set; }
    /// <summary>The rose: a wedge a group, its radius the group's value, the name and value in it.</summary>
    [Parameter] public IReadOnlyList<Group>? Groups { get; set; }
    /// <summary>The gap between the rose's wedges, in pixels, the same at the hollow and the rim; 4 by default.</summary>
    [Parameter] public double Gap { get; set; } = 4;
    /// <summary>The rose's corner radius in pixels; 8 by default, less on a small face.</summary>
    [Parameter] public double Rounding { get; set; } = 8;
    /// <summary>The diameter in pixels; 240 by default.</summary>
    [Parameter] public int Size { get; set; } = 240;
    /// <summary>The hollow centre's share of the radius; 0.4 by default.</summary>
    [Parameter] public double Hollow { get; set; } = 0.4;
    /// <summary>Bars hung from the rim, growing inward over the ticks, as a dial; the value sits in the centre.</summary>
    [Parameter] public bool Inverse { get; set; }
    /// <summary>The value that reaches the rim; the largest by default.</summary>
    [Parameter] public double? Max { get; set; }
    /// <summary>The bars' colour for one series; the ink by default. The hovered bar is always the ink.</summary>
    [Parameter] public string? Color { get; set; }
    /// <summary>The tooltip's text for a value, from the value and its index. Nothing by default.</summary>
    [Parameter] public Func<double, int, string>? Format { get; set; }
    /// <summary>What sits in the hollow centre: a total, a Stat.</summary>
    [Parameter] public RenderFragment? Centre { get; set; }
    /// <summary>The legend under several series; on by default.</summary>
    [Parameter] public bool ShowLegend { get; set; } = true;
    /// <summary>A name for assistive technology: "Searches per day, last year".</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }

    private const string DefaultColor = "var(--lv6)";
    private int? _hover;

    private double Outer => Size / 2.0;
    private double Inner => Outer * Math.Min(0.9, Math.Max(0, Hollow));
    private double Span => Outer - Inner;
    private bool Grouped => Groups is { Count: > 0 };
    // The shape: the rose is a wedge a group, one slot each; otherwise the series over the samples'
    // slots, a lane a series inside the slot.
    private IReadOnlyList<Series> All => Grouped ? [new Series("", Groups!.Select(g => g.Value).ToArray(), Color)]
        : SeriesList is { Count: > 0 } ? SeriesList : [new Series("", Values ?? Array.Empty<double>(), Color)];
    private int Lanes => All.Count;
    private int Slots => All.Max(s => s.Values.Count);
    private double ValueAt(int s, int slot) => slot < All[s].Values.Count ? All[s].Values[slot] : double.NaN;
    private double Top => Max ?? All.SelectMany(s => s.Values).Where(double.IsFinite).DefaultIfEmpty(0).Max();

    // The rose's corner radius, and the edges' offset from the slot's boundaries: half the gap
    // and the corner, since the stroke that rounds the corners brings the path out by the corner.
    private double Corner => Math.Min(Rounding, Span * 0.12);
    private double Inset => Gap / 2 + Corner;

    /// <summary>A wedge of the rose, from the hollow out to r. Its edges stand off the slot's boundaries
    /// by a fixed number of pixels, so the gap is as wide at the rim as at the hollow, and the path is
    /// inset by the corner radius: the stroke in its own colour with round joins rounds the corners.</summary>
    private string Wedge(int slot, double r)
    {
        double ri = Inner + Inset;
        double ro = Math.Max(ri + 0.5, r - Inset);
        double a = AngleOf(slot);
        double hi = Math.Max(0.01, Step / 2 - Inset / ri);
        double ho = Math.Max(0.01, Step / 2 - Inset / ro);
        string P(double rad, double ang) => $"{F(Outer + rad * Math.Cos(ang))} {F(Outer + rad * Math.Sin(ang))}";
        int large = 2 * ho > Math.PI ? 1 : 0;
        return $"M {P(ri, a - hi)} L {P(ro, a - ho)} A {F(ro)} {F(ro)} 0 {large} 1 {P(ro, a + ho)} L {P(ri, a + hi)} A {F(ri)} {F(ri)} 0 {large} 0 {P(ri, a - hi)} Z";
    }
    private double Step => 2 * Math.PI / Math.Max(1, Slots);
    private double AngleOf(int slot, int lane = 0) => -Math.PI / 2 + Step * (slot + (Lanes > 1 ? (lane + 0.5) / Lanes - 0.5 : 0));
    private (double X, double Y) Point(int slot, double r, int lane = 0) => (Outer + r * Math.Cos(AngleOf(slot, lane)), Outer + r * Math.Sin(AngleOf(slot, lane)));
    private double LengthOf(double v) => Top > 0 && double.IsFinite(v) ? Math.Max(0, v) / Top * Span : 0;
    // Where a bar starts and where it ends: from the hollow out, or from the rim in.
    private double BarFrom => Inverse ? Outer : Inner;
    private double BarTo(double len) => Inverse ? Outer - len : Inner + len;
    // A bar is 2px, as the BarMeter's, where the hollow's edge has room for that; with many it
    // thins so they stay apart there, down to a hairline.
    private double BarWidth => Math.Max(0.5, Math.Min(2, 2 * Math.PI * Inner / Math.Max(1, Slots * Lanes) * 0.55));
    private string ColorOf(int s) => All[s].Color ?? DefaultColor;

    // The rose's names and values, upright at the sector's middle, out near the rim, when the
    // sectors are few enough to hold them.
    private RenderFragment RenderSectorLabels => builder =>
    {
        if (!Grouped || Groups!.Count > 12 || Size < 200) return;
        int seq = 0;
        for (int i = 0; i < Groups.Count; i++)
        {
            var g = Groups[i];
            double angle = AngleOf(i);
            // A tall wedge carries its text inside, in the page tone as print on it; a short one
            // has it in the dim remainder above, in the ink.
            double len = LengthOf(g.Value);
            bool onLit = len >= Span * 0.5;
            double r = onLit ? Inner + len * 0.62 : Inner + len + (Span - len) * 0.55;
            double tx = Outer + r * Math.Cos(angle), ty = Outer + r * Math.Sin(angle);
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "class", onLit ? "indx-radial-sector-text indx-radial-sector-text-on-lit" : "indx-radial-sector-text");
            builder.AddAttribute(seq++, "x", F(tx));
            builder.AddAttribute(seq++, "y", F(ty));
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.OpenElement(seq++, "tspan");
            builder.AddAttribute(seq++, "class", "indx-radial-sector-value");
            builder.AddAttribute(seq++, "x", F(tx));
            builder.AddAttribute(seq++, "dy", "-0.2em");
            builder.AddContent(seq++, Format != null ? Format(g.Value, i) : g.Value.ToString("0.##", CultureInfo.InvariantCulture));
            builder.CloseElement();
            builder.OpenElement(seq++, "tspan");
            builder.AddAttribute(seq++, "class", "indx-radial-sector-name");
            builder.AddAttribute(seq++, "x", F(tx));
            builder.AddAttribute(seq++, "dy", "1.3em");
            builder.AddContent(seq++, g.Label);
            builder.CloseElement();
            builder.CloseElement();
        }
    };

    // The slot under the pointer: by its angle from the centre, clockwise from the top. Outside
    // the ring, inside the hollow, and in a gap between sectors, there is none. Only a move to
    // another slot redraws.
    private void OnPointer(PointerEventArgs e)
    {
        if (Slots == 0 || Format == null) return;
        double x = e.OffsetX - Outer, y = e.OffsetY - Outer;
        double r = Math.Sqrt(x * x + y * y);
        int? next = null;
        if (r >= Inner && r <= Outer)
        {
            double turn = ((Math.Atan2(y, x) + Math.PI / 2 + 2 * Math.PI) % (2 * Math.PI)) / (2 * Math.PI);
            // A wedge spans its slot; a bar sits at the slot's angle.
            next = (Grouped ? (int)Math.Floor(turn * Slots) : (int)Math.Round(turn * Slots)) % Slots;
        }
        if (next == _hover) { _skipRender = true; return; }
        _hover = next;
    }

    private bool _skipRender;

    protected override bool ShouldRender()
    {
        if (!_skipRender) return true;
        _skipRender = false;
        return false;
    }

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
