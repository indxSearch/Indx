@using System.Globalization
@* One series around a clock face: a bar a sample, from the top clockwise, its length the value,
   around a hollow centre. A thin guide a sample runs out to the rim, a dashed line at the top
   marks the start of the period. For a long series whose shape matters more than any one
   reading: a year of searches a day, the hours of a day. Hover reads a bar by its angle, as Chart
   reads by x, and says what it is in a tooltip at the bar's end. Port of the React RadialChart
   in indx-systm. *@
<div class="indx-radial @Class" style="--radial-size: @(Size)px;@(Color != null ? $"color: {Color};" : null)" @onpointerleave="() => _hover = null">
    <svg class="indx-radial-svg" style="--radial-bar: @F(BarWidth)px;" viewBox="0 0 @Size @Size" width="@Size" height="@Size" role="img" aria-label="@AriaLabel"
         @onpointermove="OnPointer" @onpointerdown="OnPointer">
        @for (int i = 0; i < Values.Count; i++)
        {
            var (gx1, gy1) = Point(i, Inner);
            var (gx2, gy2) = Point(i, Outer);
            <line class="indx-radial-guide" x1="@F(gx1)" y1="@F(gy1)" x2="@F(gx2)" y2="@F(gy2)" />
        }
        @{
            var (sx1, sy1) = Point(0, Inner);
            var (sx2, sy2) = Point(0, Outer);
        }
        <line class="indx-radial-start" x1="@F(sx1)" y1="@F(sy1)" x2="@F(sx2)" y2="@F(sy2)" />
        @for (int i = 0; i < Values.Count; i++)
        {
            var len = LengthOf(Values[i]);
            if (len <= 0) { continue; }
            var (bx1, by1) = Point(i, Inner);
            var (bx2, by2) = Point(i, Inner + len);
            <line class="indx-radial-bar @(_hover == i ? "indx-radial-hovered" : "")" x1="@F(bx1)" y1="@F(by1)" x2="@F(bx2)" y2="@F(by2)" />
        }
    </svg>
    @if (Centre != null)
    {
        <div class="indx-radial-centre" style="width: @F(Inner * 2)px; height: @F(Inner * 2)px;">@Centre</div>
    }
    @if (_hover is { } h && Format != null && h < Values.Count)
    {
        var len = LengthOf(Values[h]);
        var (tx, ty) = Point(h, Inner + Math.Max(len, (Outer - Inner) * 0.15) + 6);
        <div class="indx-radial-tooltip @(tx > Outer ? "indx-radial-tooltip-left" : "")" style="left: @F(tx)px; top: @F(ty)px;">
            <span class="indx-radial-tooltip-label">@(Labels != null && h < Labels.Count ? Labels[h] : (h + 1).ToString(CultureInfo.InvariantCulture))</span>
            <span class="indx-radial-tooltip-value">@Format(Values[h], h)</span>
        </div>
    }
</div>

@code {
    /// <summary>One value a sample, from the top clockwise.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<double> Values { get; set; } = Array.Empty<double>();
    /// <summary>What each sample is, for the tooltip: a date, an hour. The index when left out.</summary>
    [Parameter] public IReadOnlyList<string>? Labels { get; set; }
    /// <summary>The diameter in pixels; 240 by default.</summary>
    [Parameter] public int Size { get; set; } = 240;
    /// <summary>The hollow centre's share of the radius; 0.4 by default.</summary>
    [Parameter] public double Hollow { get; set; } = 0.4;
    /// <summary>The value that reaches the rim; the largest by default.</summary>
    [Parameter] public double? Max { get; set; }
    /// <summary>The bars' colour; the ink by default. The hovered bar is always the ink.</summary>
    [Parameter] public string? Color { get; set; }
    /// <summary>The tooltip's text for a sample, from the value and its index. Nothing by default.</summary>
    [Parameter] public Func<double, int, string>? Format { get; set; }
    /// <summary>What sits in the hollow centre: a total, a Stat.</summary>
    [Parameter] public RenderFragment? Centre { get; set; }
    /// <summary>A name for assistive technology: "Searches per day, last year".</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }

    private int? _hover;
    private double Outer => Size / 2.0;
    private double Inner => Outer * Math.Min(0.9, Math.Max(0, Hollow));
    private double Top => Max ?? Values.Where(double.IsFinite).DefaultIfEmpty(0).Max();

    private double AngleOf(int i) => (-90 + 360.0 * i / Math.Max(1, Values.Count)) * Math.PI / 180;
    private (double X, double Y) Point(int i, double r) => (Outer + r * Math.Cos(AngleOf(i)), Outer + r * Math.Sin(AngleOf(i)));
    private double LengthOf(double v) => Top > 0 && double.IsFinite(v) ? Math.Max(0, v) / Top * (Outer - Inner) : 0;
    // A bar is 2px, as the BarMeter's, where the hollow's edge has room for that; with many samples
    // it thins so the bars stay apart there, down to a hairline.
    private double BarWidth => Math.Max(0.5, Math.Min(2, 2 * Math.PI * Inner / Math.Max(1, Values.Count) * 0.55));

    // The bar under the pointer: by its angle from the centre, clockwise from the top. Outside
    // the ring, and inside the hollow, there is none. Only a move to another bar redraws.
    private void OnPointer(PointerEventArgs e)
    {
        if (Values.Count == 0 || Format == null) return;
        double x = e.OffsetX - Outer, y = e.OffsetY - Outer;
        double r = Math.Sqrt(x * x + y * y);
        int? next = null;
        if (r >= Inner && r <= Outer)
        {
            double deg = (Math.Atan2(y, x) * 180 / Math.PI + 90 + 360) % 360;
            next = (int)Math.Round(deg / 360 * Values.Count) % Values.Count;
        }
        if (next == _hover) { _skipRender = true; return; }
        _hover = next;
    }

    private bool _skipRender;

    protected override bool ShouldRender()
    {
        if (!_skipRender) return true;
        _skipRender = false;
        return false;
    }

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
