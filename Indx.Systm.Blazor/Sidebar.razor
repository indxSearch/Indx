@* The side column of an app: groups of systm Buttons, the open one primary. It folds to a rail of
   icons (Cmd or Ctrl and B, or the button at its foot), remembered per viewer when it has a
   StorageKey; in the rail each item names itself in a Tooltip and a badge is a dot. A group with
   Collapsible opens and closes under its title. At 768px and narrower it is a drawer over the page
   instead, opened by the host (Open) and closed by Escape, a press beside it or a choice. No
   motion: it is simply there, and then not. The keys live in Sidebar.razor.js. Port of the React
   Sidebar in indx-systm. *@
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_open)
{
    <div class="indx-sidebar-overlay" @onclick="() => SetOpen(false)"></div>
}
<nav class="indx-sidebar @(_collapsed ? "indx-sidebar--rail" : null) @(_open ? "indx-sidebar--open" : null) @Class"
     aria-label="@AriaLabel" @ref="_nav">
    @if (Header != null)
    {
        <div class="indx-sidebar-header">@Header</div>
    }
    <div class="indx-sidebar-body">
        @foreach (var group in Groups)
        {
            var g = group;
            var shut = g.Collapsible && g.Title != null && _shut.Contains(g.Title);
            <div class="indx-sidebar-group">
                @if (!string.IsNullOrEmpty(g.Title))
                {
                    if (g.Collapsible)
                    {
                        <button type="button" class="indx-sidebar-title indx-sidebar-title--toggle" aria-expanded="@(shut ? "false" : "true")"
                                @onclick="() => ToggleGroup(g.Title!)">
                            <span class="indx-sidebar-title-text">@g.Title</span>
                            <span class="indx-sidebar-title-chevron" aria-hidden="true">
                                @if (shut) { <ChevronRight Size="14" Color="currentColor" /> } else { <ChevronDown Size="14" Color="currentColor" /> }
                            </span>
                        </button>
                    }
                    else
                    {
                        <div class="indx-sidebar-title"><span class="indx-sidebar-title-text">@g.Title</span></div>
                    }
                }
                @* The rail shows every item: a closed group has no title there to open it by. *@
                <div class="indx-sidebar-items @(shut ? "indx-sidebar-items--shut" : null)">
                    @foreach (var item in g.Items)
                    {
                        var it = item;
                        var active = it.Key == Active;
                        <span class="indx-sidebar-item" @key="it.Key">
                            <Tooltip Content="@(it.Badge is { Length: > 0 } b ? $"{it.Label} ({b})" : it.Label)" Position="right">
                                @if (it.Disabled)
                                {
                                    @* aria-disabled rather than disabled, so it stays focusable and its title can say why. *@
                                    <Button Variant="ghost" Size="micro" IconLeft="@it.Icon" aria-disabled="true" title="@it.Title">@ItemLabel(it)</Button>
                                }
                                else if (it.Href != null)
                                {
                                    <Button Variant="@(active ? "primary" : "ghost")" Size="micro" IconLeft="@it.Icon" title="@it.Title"
                                            aria-current="@(active ? "page" : null)" Href="@it.Href" @onclick="() => Choose(it)">@ItemLabel(it)</Button>
                                }
                                else
                                {
                                    <Button Variant="@(active ? "primary" : "ghost")" Size="micro" IconLeft="@it.Icon" title="@it.Title"
                                            aria-current="@(active ? "page" : null)" @onclick="() => Choose(it)">@ItemLabel(it)</Button>
                                }
                            </Tooltip>
                        </span>
                    }
                </div>
            </div>
        }
    </div>
    @if (Footer != null || Collapsible)
    {
        <div class="indx-sidebar-footer">
            @if (Footer != null)
            {
                <div class="indx-sidebar-footer-content">@Footer</div>
            }
            @if (Collapsible)
            {
                <span class="indx-sidebar-item indx-sidebar-fold">
                    <Tooltip Content="@($"{(_collapsed ? "Expand" : "Collapse")} ({_shortcut})")" Position="right">
                        <Button Variant="ghost" Size="micro" IconLeft="@(_collapsed ? _iconExpand : _iconCollapse)"
                                aria-expanded="@(_collapsed ? "false" : "true")" aria-keyshortcuts="@(_mac ? "Meta+B" : "Control+B")"
                                @onclick="ToggleCollapsed"><span class="indx-sidebar-label">Collapse</span></Button>
                    </Tooltip>
                </span>
            }
        </div>
    }
</nav>

@code {
    /// <summary>An entry: its key (what Active and OnSelect speak of), its name, a 14px pixl icon,
    /// where it goes (a link) or nothing (OnSelect), a badge at its end ("3"), a title for the
    /// pointer, Disabled for an item that is there but not yet usable (its Title says why), and
    /// Signal for a badge that wants attention (the signal colour; a plain count otherwise).</summary>
    public sealed record Item(string Key, string Label, RenderFragment<int>? Icon = null, string? Href = null,
        string? Badge = null, string? Title = null, bool Disabled = false, bool Signal = false);

    /// <summary>Items under a title. Collapsible lets the title open and close them.</summary>
    public sealed record Group(string? Title, IReadOnlyList<Item> Items, bool Collapsible = false);

    [Parameter, EditorRequired] public IReadOnlyList<Group> Groups { get; set; } = [];
    /// <summary>The key of the open item, drawn primary.</summary>
    [Parameter] public string? Active { get; set; }
    /// <summary>An item was chosen. A link still follows its Href.</summary>
    [Parameter] public EventCallback<Item> OnSelect { get; set; }
    /// <summary>Above the groups, typically the product's name; hidden in the rail.</summary>
    [Parameter] public RenderFragment? Header { get; set; }
    /// <summary>Under the groups, above the fold button; hidden in the rail.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>The rail of icons. Controlled with CollapsedChanged (@bind-Collapsed); leave both
    /// out and the sidebar keeps its own, starting from DefaultCollapsed or what StorageKey kept.</summary>
    [Parameter] public bool? Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }
    [Parameter] public bool DefaultCollapsed { get; set; }
    /// <summary>Whether it can fold to the rail at all: the button at its foot and the shortcut.</summary>
    [Parameter] public bool Collapsible { get; set; } = true;
    /// <summary>The key that folds it with Cmd or Ctrl; "b" by default, null for none.</summary>
    [Parameter] public string? Shortcut { get; set; } = "b";
    /// <summary>Where the viewer's own choice of rail or not is kept (localStorage); null keeps nothing.</summary>
    [Parameter] public string? StorageKey { get; set; }

    /// <summary>The drawer, at 768px and narrower: the host's trigger opens it.</summary>
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public string AriaLabel { get; set; } = "Sections";
    [Parameter] public string? Class { get; set; }

    private static readonly RenderFragment<int> _iconCollapse = size => @<IndentLeft Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconExpand = size => @<IndentRight Size="size" Color="currentColor" />;

    private readonly HashSet<string> _shut = new(StringComparer.Ordinal);
    private bool? _own;
    private bool _collapsed => Collapsible && (Collapsed ?? _own ?? DefaultCollapsed);
    private bool _open;
    private bool _drawn;
    private bool _mac = true;
    private string _shortcut => Shortcut is { Length: > 0 } k ? (_mac ? $"⌘{k.ToUpperInvariant()}" : $"Ctrl {k.ToUpperInvariant()}") : "";
    private ElementReference _nav;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Sidebar>? _self;
    private bool _disposed;

    protected override void OnParametersSet() => _open = Open;

    private RenderFragment ItemLabel(Item it) => @<text><span class="indx-sidebar-label">@it.Label</span>@if (it.Badge is { Length: > 0 } badge) { <span class="indx-sidebar-badge @(it.Signal ? "indx-sidebar-badge--signal" : null)">@badge</span> }</text>;

    private void ToggleGroup(string title)
    {
        if (!_shut.Remove(title)) _shut.Add(title);
    }

    private async Task Choose(Item item)
    {
        if (OnSelect.HasDelegate) await OnSelect.InvokeAsync(item);
        await SetOpen(false);
    }

    private async Task SetOpen(bool value)
    {
        if (_open == value) return;
        _open = value;
        if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(value);
    }

    [JSInvokable] public Task Toggle() => InvokeAsync(ToggleCollapsed);
    [JSInvokable] public Task Close() => InvokeAsync(async () => { await SetOpen(false); StateHasChanged(); });

    private async Task ToggleCollapsed()
    {
        if (!Collapsible) return;
        var next = !_collapsed;
        if (Collapsed == null) _own = next;
        if (CollapsedChanged.HasDelegate) await CollapsedChanged.InvokeAsync(next);
        if (StorageKey != null && Collapsed == null && _module != null)
        {
            try { await _module.InvokeVoidAsync("keep", StorageKey, next); } catch (JSException) { } catch (JSDisconnectedException) { }
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // The drawer was just opened, by the host or otherwise: focus goes inside it.
            if (_open && !_drawn && _module != null)
            {
                try { await _module.InvokeVoidAsync("drawer", _nav, true); } catch (JSException) { } catch (JSDisconnectedException) { }
            }
            _drawn = _open;
            return;
        }
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Indx.Systm.Blazor/Sidebar.razor.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            _self = DotNetObjectReference.Create(this);
            var state = await _module.InvokeAsync<SidebarStart>("start", _nav, _self, Collapsible ? Shortcut?.ToLowerInvariant() : null, StorageKey);
            var changed = state.Mac != _mac;
            _mac = state.Mac;
            if (Collapsed == null && state.Kept is { } kept && kept != _collapsed) { _own = kept; changed = true; }
            if (changed) StateHasChanged();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (JSException) { }
    }

    internal sealed record SidebarStart(bool Mac, bool? Kept);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop", _nav);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
        }
        _self?.Dispose();
    }
}
