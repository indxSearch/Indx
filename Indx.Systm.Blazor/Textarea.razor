@inherits InputBase<string?>
@using Microsoft.AspNetCore.Components.Forms

@if (!string.IsNullOrEmpty(Label))
{
    <div class="indx-textarea-wrapper">
        <label for="@_id" class="indx-textarea-label">
            @Label
            @if (Required) { <span aria-label="required"> *</span> }
        </label>
        <textarea id="@_id"
                  name="@NameAttributeValue"
                  class="@_textareaClass"
                  rows="@Rows"
                  value="@CurrentValueAsString"
                  @onchange="OnChange"
                  aria-invalid="@(HasError ? "true" : "false")"
                  aria-describedby="@(HasError && !string.IsNullOrEmpty(Error) ? $"{_id}-error" : null)"
                  @attributes="AdditionalAttributes"></textarea>
        @if (!string.IsNullOrEmpty(Error))
        {
            <span id="@_id-error" class="indx-textarea-error-text" role="alert">@Error</span>
        }
    </div>
}
else
{
    <textarea id="@_id"
              name="@NameAttributeValue"
              class="@_textareaClass"
              rows="@Rows"
              value="@CurrentValueAsString"
              @onchange="OnChange"
              aria-invalid="@(HasError ? "true" : "false")"
              @attributes="AdditionalAttributes"></textarea>
}

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool IsValid { get; set; } = true;
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public int Rows { get; set; } = 4;

    private bool HasError => !string.IsNullOrEmpty(Error) || !IsValid;

    private string _id => Id ?? _generatedId;
    private readonly string _generatedId = $"textarea-{Guid.NewGuid():N}";

    private string _textareaClass
    {
        get
        {
            var cls = "indx-textarea";
            if (HasError) cls += " indx-textarea-error";
            return cls;
        }
    }

    protected override bool TryParseValueFromString(string? value, out string? result, out string validationErrorMessage)
    {
        result = value;
        validationErrorMessage = string.Empty;
        return true;
    }

    private void OnChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }
}
