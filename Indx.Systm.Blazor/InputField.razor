@inherits InputBase<string?>
@using Microsoft.AspNetCore.Components.Forms

@if (!string.IsNullOrEmpty(Label))
{
    <div class="@_wrapperClass">
        <label for="@_id" class="indx-input-label">
            @Label
            @if (Required) { <span aria-label="required"> *</span> }
        </label>
        <input id="@_id"
               @key="_live.Key"
               name="@NameAttributeValue"
               value="@_rendered"
               @onchange="OnChange"
               aria-invalid="@(HasError ? "true" : "false")"
               aria-describedby="@(HasError && !string.IsNullOrEmpty(Error) ? $"{_id}-error" : null)"
               @attributes="_attributes"
               class="@_inputClass" />
        @if (!string.IsNullOrEmpty(Error))
        {
            <span id="@_id-error" class="indx-input-error-text" role="alert">@Error</span>
        }
    </div>
}
else
{
    <input id="@_id"
           @key="_live.Key"
           name="@NameAttributeValue"
           value="@_rendered"
           @onchange="OnChange"
           aria-invalid="@(HasError ? "true" : "false")"
           @attributes="_attributes"
           class="@_inputClass" />
}

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool IsValid { get; set; } = true;
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Required { get; set; }
    /// <summary>Update the bound value on every keystroke rather than when the field is left, for a
    /// form that reacts as the user types (a Confirm button that enables on a valid name). The box
    /// is not rewritten with the echo of what was typed (see <see cref="LiveInputState"/>), so
    /// typing stays intact on a slow connection.</summary>
    [Parameter] public bool Immediate { get; set; }

    // An EditForm's validation counts too: a field the form rejected is styled as one. The
    // caller's own class is kept beside the system's (it is rendered after the splat, so it wins).
    private bool HasError => !string.IsNullOrEmpty(Error) || !IsValid
        || (EditContext?.GetValidationMessages(FieldIdentifier).Any() ?? false);

    private string? _callerClass => AdditionalAttributes is { } a && a.TryGetValue("class", out var c) ? c?.ToString() : null;

    private string _id => Id ?? _generatedId;
    private readonly string _generatedId = $"input-{Guid.NewGuid():N}";

    private string _wrapperClass => "indx-input-wrapper";

    private string _inputClass
    {
        get
        {
            var cls = "indx-input";
            if (Variant == "borderBottom") cls += " indx-input-border-bottom";
            if (HasError) cls += " indx-input-error";
            if (!string.IsNullOrEmpty(_callerClass)) cls += " " + _callerClass;
            return cls;
        }
    }

    protected override bool TryParseValueFromString(string? value, out string? result, out string validationErrorMessage)
    {
        result = value;
        validationErrorMessage = string.Empty;
        return true;
    }

    // Without Immediate the box shows the value as before. With it, the rendered value holds
    // still while text arrives from typing, and only an outside change (a reset) is written.
    private readonly LiveInputState _live = new();
    private string? _rendered => Immediate ? _live.Rendered : CurrentValueAsString;

    protected override void OnParametersSet()
    {
        if (Immediate) _live.Set(CurrentValueAsString);
    }

    // The input handler is added only with Immediate: registered on every field, each keystroke in
    // every form would go to the server.
    private IReadOnlyDictionary<string, object>? _attributes
    {
        get
        {
            if (!Immediate) return AdditionalAttributes;
            var all = AdditionalAttributes is null ? new Dictionary<string, object>() : new Dictionary<string, object>(AdditionalAttributes);
            all["oninput"] = EventCallback.Factory.Create<ChangeEventArgs>(this, OnInput);
            return all;
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        _live.Typed(e.Value?.ToString());
        CurrentValueAsString = e.Value?.ToString();
    }

    private void OnChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }
}
