@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="indx-tabs @(Scrollable ? "indx-tabs-scrollable" : "")"
     role="tablist"
     @ref="_listEl">
    @foreach (var item in Items)
    {
        <button class="indx-tab indx-tab-@Size @(Active == item.Value ? "indx-tab-active" : "")"
                type="button"
                @onclick="() => OnClick(item.Value)">
            @item.Label
        </button>
    }
</div>

@code {
    [Parameter] public IEnumerable<TabItem> Items { get; set; } = [];
    [Parameter] public string? Active { get; set; }
    [Parameter] public EventCallback<string?> ActiveChanged { get; set; }
    [Parameter] public string Size { get; set; } = "default";

    /// <summary>
    /// When the tabs don't fit, scroll horizontally instead of clipping. The edges fade to hint there's
    /// more (the design system uses no shadows); the fade is scroll-aware — the left edge only fades once
    /// you've scrolled right. Opt-in — leave off for a small, fixed set of tabs.
    /// </summary>
    [Parameter] public bool Scrollable { get; set; }

    private ElementReference _listEl;
    private IJSObjectReference? _module;

    private async Task OnClick(string value)
    {
        await ActiveChanged.InvokeAsync(value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Scrollable) return;
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Indx.Systm.Blazor/Tabs.razor.js");
            await _module.InvokeVoidAsync("init", _listEl);
        }
        else if (_module is not null)
        {
            // Tabs may have changed (e.g. a dataset added/removed) — recompute the fade edges.
            await _module.InvokeVoidAsync("refresh", _listEl);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _listEl);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* circuit gone — nothing to clean up */ }
            catch (Exception) { }
        }
    }

    public record TabItem(string Label, string Value);
}
