@* A range over a number field's values, picked on their histogram or typed (Nov 2026). The bars are
   the counts of the values given, gathered into at most MaxBars; under them from and to are ghost
   numbers. Dragging across the bars writes the numbers, typing a number lights the bars it reaches:
   one range, two ways in. An empty end is open. The drag runs in the browser with no round trip;
   .NET hears the range once it ends. The console's search preview filters a number field with it. *@
@using System.Globalization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="indx-histrange @(Disabled ? "indx-histrange--disabled" : null) @Class">
    @if (_bars.Count > 0)
    {
        double most = Math.Max(1, _bars.Max(b => b.Count));
        <div @ref="_histogram" class="indx-histrange-bars" aria-hidden="true">
            @for (int i = 0; i < _bars.Count; i++)
            {
                var bar = _bars[i];
                <div class="indx-histrange-bar @(HasRange && InRange(bar) ? "indx-histrange-bar--in" : null)"
                     style="height:@Fmt(Math.Max(6, bar.Count / most * 100))%" title="@BarTitle(bar)"
                     data-index="@i"></div>
            }
        </div>
    }
    <div class="indx-histrange-ends">
        <InputField Variant="ghost" type="number" step="@StepText" class="indx-histrange-from" disabled="@Disabled"
                    placeholder="@(_bars.Count > 0 ? Fmt(_bars[0].From) : null)" aria-label="@($"{AriaLabel}, from")" @key="@($"from-{_tick}")"
                    Value="@(From is { } f ? Fmt(f) : string.Empty)" ValueExpression="() => _typedFrom" ValueChanged="TypedFrom" />
        <span class="indx-histrange-to">to</span>
        <InputField Variant="ghost" type="number" step="@StepText" class="indx-histrange-upto" disabled="@Disabled"
                    placeholder="@(_bars.Count > 0 ? Fmt(_bars[^1].To) : null)" aria-label="@($"{AriaLabel}, to")" @key="@($"to-{_tick}")"
                    Value="@(To is { } t ? Fmt(t) : string.Empty)" ValueExpression="() => _typedTo" ValueChanged="TypedTo" />
    </div>
</div>

@code {
    /// <summary>One bar: the first and last value it holds and how many records hold them.</summary>
    public sealed record Bar(double From, double To, int Count);

    /// <summary>The field's values and their counts, in any order.</summary>
    [Parameter] public IReadOnlyList<KeyValuePair<double, int>>? Values { get; set; }
    /// <summary>The range's ends; null is open.</summary>
    [Parameter] public double? From { get; set; }
    [Parameter] public double? To { get; set; }
    /// <summary>Once the range is picked: a drag ended, a bar clicked, an end typed.</summary>
    [Parameter] public EventCallback<(double? From, double? To)> RangeChanged { get; set; }
    /// <summary>At most this many bars; fewer values than this are a bar each.</summary>
    [Parameter] public int MaxBars { get; set; } = 30;
    /// <summary>What the arrow keys add in the numbers; any by default.</summary>
    [Parameter] public double? Step { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Range";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    private IReadOnlyList<Bar> _bars = [];
    // Only named by ValueExpression, which an InputField needs; the typed text goes through
    // TypedFrom and TypedTo, never into these.
    private readonly string? _typedFrom = null, _typedTo = null;
    // A typed end that was refused leaves From and To as they were, so nothing would rewrite the
    // box: a new key recreates it, showing the range as it stands.
    private int _tick;
    private ElementReference _histogram;
    private IJSObjectReference? _module;
    private DotNetObjectReference<HistogramRange>? _self;
    private bool _disposed;

    private bool HasRange => From != null || To != null;
    private bool InRange(Bar bar) => (From is not { } f || bar.To >= f) && (To is not { } t || bar.From <= t);
    private string StepText => Step is { } s ? Fmt(s) : "any";
    private static string Fmt(double v) => v.ToString("0.########", CultureInfo.InvariantCulture);
    private static string BarTitle(Bar bar) =>
        (bar.From == bar.To ? Fmt(bar.From) : $"{Fmt(bar.From)} to {Fmt(bar.To)}") + $": {bar.Count.ToString("N0", CultureInfo.InvariantCulture)}";

    protected override void OnParametersSet() => _bars = BarsOf(Values, MaxBars);

    /// <summary>The values as bars: a bar each when there are no more than <paramref name="maxBars"/>,
    /// else that many of equal width from the lowest to the highest, each spanning the values it holds.</summary>
    public static IReadOnlyList<Bar> BarsOf(IReadOnlyList<KeyValuePair<double, int>>? values, int maxBars)
    {
        var sorted = (values ?? []).Where(v => double.IsFinite(v.Key)).OrderBy(v => v.Key).ToList();
        if (sorted.Count == 0) return [];
        if (sorted.Count <= maxBars) return sorted.Select(v => new Bar(v.Key, v.Key, v.Value)).ToList();
        double lo = sorted[0].Key, hi = sorted[^1].Key, width = (hi - lo) / maxBars;
        var bars = new List<Bar>(maxBars);
        int at = 0;
        for (int i = 0; i < maxBars; i++)
        {
            double end = i == maxBars - 1 ? double.PositiveInfinity : lo + (i + 1) * width;
            int first = at, count = 0;
            while (at < sorted.Count && sorted[at].Key < end) count += sorted[at++].Value;
            bars.Add(at > first
                ? new Bar(sorted[first].Key, sorted[at - 1].Key, count)
                : new Bar(lo + i * width, Math.Min(hi, lo + (i + 1) * width), 0));
        }
        return bars;
    }

    /// <summary>From the browser: the bars from <paramref name="a"/> to <paramref name="b"/> were
    /// dragged across, or one clicked. Clicking the one bar that is the whole range clears it.</summary>
    [JSInvokable]
    public Task Picked(int a, int b) => InvokeAsync(() =>
    {
        if (_bars.Count == 0) return Task.CompletedTask;
        int lo = Math.Clamp(Math.Min(a, b), 0, _bars.Count - 1), hi = Math.Clamp(Math.Max(a, b), 0, _bars.Count - 1);
        double? from = _bars[lo].From, to = _bars[hi].To;
        if (lo == hi && From == from && To == to) from = to = null;
        return Commit(from, to);
    });

    private Task TypedFrom(string? text) => Typed(text, isFrom: true);
    private Task TypedTo(string? text) => Typed(text, isFrom: false);

    private Task Typed(string? text, bool isFrom)
    {
        double? value = null;
        if (!string.IsNullOrWhiteSpace(text))
        {
            if (!double.TryParse(text.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) || !double.IsFinite(v))
            {
                _tick++;
                return Task.CompletedTask;
            }
            value = v;
        }
        var (from, to) = isFrom ? (value, To) : (From, value);
        // Ends typed the wrong way round are the same range.
        if (from is { } f && to is { } t && f > t) { (from, to) = (t, f); _tick++; }
        return Commit(from, to);
    }

    private async Task Commit(double? from, double? to)
    {
        if (from == From && to == To) return;
        From = from;
        To = to;
        if (RangeChanged.HasDelegate) await RangeChanged.InvokeAsync((from, to));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Indx.Systm.Blazor/HistogramRange.razor.js");
                if (_disposed) { await module.DisposeAsync(); return; }
                _module = module;
                _self = DotNetObjectReference.Create(this);
            }
            if (_module != null && _bars.Count > 0)
                await _module.InvokeVoidAsync("sync", _histogram, _self, new { disabled = Disabled });
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _histogram); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
        }
        _self?.Dispose();
    }
}
