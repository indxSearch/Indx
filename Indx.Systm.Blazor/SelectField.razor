@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="indx-select-wrapper @(Variant == "ghost" ? "indx-select-wrapper-ghost" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@_id" class="indx-select-label">@Label</label>
    }
    <div class="indx-select-trigger" @ref="_trigger">
        <button type="button" id="@_id" class="indx-select indx-select-@Size @(Variant == "ghost" ? "indx-select-ghost" : null)" @onclick="Toggle" @onkeydown="OnKeyDown" @attributes="AdditionalAttributes">
            <span class="indx-select-value @(string.IsNullOrEmpty(Value) ? "indx-select-placeholder" : null)" style="display:inline-flex; align-items:center; gap:6px;">
                @if (SelectedOption?.Icon is { } selIcon)
                {
                    @selIcon(_iconSize)
                }
                @if (Variant == "ghost")
                {
                    @* Every label in one grid cell, only the chosen one visible: the field is as
                       wide as its widest option, so a value never clips and the field does not
                       change width as the choice changes. *@
                    <span class="indx-select-sizer">
                        @foreach (var option in Options)
                        {
                            <span class="@(option.Value == Value ? null : "indx-select-sizer-hidden")" aria-hidden="@(option.Value == Value ? null : "true")">@option.Label</span>
                        }
                        @if (SelectedOption == null)
                        {
                            <span>@Placeholder</span>
                        }
                    </span>
                }
                else
                {
                    <span>@(SelectedLabel ?? Placeholder)</span>
                }
            </span>
            <span class="indx-select-icon" aria-hidden="true"><ChevronDown Size="@_iconSize" /></span>
        </button>
        @if (_open)
        {
            <div class="indx-select-backdrop" @onclick="Close"></div>
            <div class="indx-select-menu" role="listbox">
                @foreach (var option in Options)
                {
                    <Button Variant="ghost" Size="@Size" @onclick="() => Pick(option.Value)" style="width:100%; justify-content:space-between;">
                        <span style="display:inline-flex; align-items:center; gap:6px;">
                            @if (option.Icon is { } optIcon)
                            {
                                @optIcon(_iconSize)
                            }
                            <span>@option.Label</span>
                        </span>
                        @if (Value == option.Value)
                        {
                            <Check Size="12" />
                        }
                    </Button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>"micro" | "default" | "large" — matches Button sizing.</summary>
    [Parameter] public string Size { get; set; } = "default";

    /// <summary>"default" (a bordered field) | "ghost" (no border or background, sized to its
    /// value, like a ghost Button): for a view setting in a toolbar rather than a form field.</summary>
    [Parameter] public string Variant { get; set; } = "default";

    [Parameter, EditorRequired] public IEnumerable<SelectOption> Options { get; set; } = [];
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _open;

    private string _id => Id ?? _generatedId;
    private readonly string _generatedId = $"select-{Guid.NewGuid():N}";

    // Match Button's icon sizing.
    private int _iconSize => Size == "large" ? 21 : 14;

    private SelectOption? SelectedOption => Options.FirstOrDefault(o => o.Value == Value);
    private string? SelectedLabel => SelectedOption?.Label;

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private async Task Pick(string value)
    {
        _open = false;
        await ValueChanged.InvokeAsync(value);
    }

    // v1 keyboard support: Escape closes. (Arrow-key navigation / type-ahead is a follow-up.)
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _open = false;
    }

    // The open menu is placed against the window by SelectField.razor.js, so a scrolling
    // ancestor (a Modal's content box) cannot clip it. Without JS it falls back to the CSS
    // position under the field.
    private ElementReference _trigger;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Indx.Systm.Blazor/SelectField.razor.js");
            await _module.InvokeVoidAsync("init", _trigger);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("dispose", _trigger);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
        catch (TaskCanceledException) { }
        catch (JSException) { } // element already gone on the client
    }

    public record SelectOption(string Label, string Value)
    {
        /// <summary>Optional leading icon, rendered in the trigger and menu. Receives the icon size.</summary>
        public RenderFragment<int>? Icon { get; init; }
    }
}
