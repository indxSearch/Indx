@* Port of indx-systm StreamStatus: one quiet line saying what the assistant is doing right now,
   "Reading the statistics…", with a spinner beside it. *@
<div class="indx-chat-status @Class" role="status">
    <span class="indx-chat-status-spinner"><Spinner Name="@SpinnerName" Size="14" /></span>
    <span>@ChildContent</span>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Which spinner plays beside the line, so each stage can have its own.</summary>
    [Parameter] public string SpinnerName { get; set; } = Spinners.Names.First();
    [Parameter] public string? Class { get; set; }
}
