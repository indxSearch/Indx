@if (!string.IsNullOrEmpty(Href))
{
    @if (Disabled || Loading)
    {
        <span class="@_classes"
              aria-disabled="true"
              aria-busy="@(Loading ? "true" : null)"
              tabindex="-1"
              @attributes="DisabledAttributes">
            @if (Loading) { <Spinner Size="@_iconSize" /> }
            else if (IconLeft != null) { @IconLeft(_iconSize) }
            @ChildContent
            @if (IconRight != null) { <span class="indx-btn-icon-right">@IconRight(_iconSize)</span> }
        </span>
    }
    else
    {
        <a class="@_classes"
           href="@Href"
           @attributes="AdditionalAttributes">
            @if (Loading) { <Spinner Size="@_iconSize" /> }
            else if (IconLeft != null) { @IconLeft(_iconSize) }
            @ChildContent
            @if (IconRight != null) { <span class="indx-btn-icon-right">@IconRight(_iconSize)</span> }
        </a>
    }
}
else
{
    <button class="@_classes"
            type="@Type"
            disabled="@(Disabled || Loading)"
            aria-busy="@(Loading ? "true" : null)"
            @attributes="AdditionalAttributes">
        @if (Loading) { <Spinner Size="@_iconSize" /> }
        else if (IconLeft != null) { @IconLeft(_iconSize) }
        @ChildContent
        @if (IconRight != null) { <span class="indx-btn-icon-right">@IconRight(_iconSize)</span> }
    </button>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Variant { get; set; } = "primary";
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    /// <summary>The action behind this button is in progress: a <see cref="Spinner"/> takes the
    /// left-icon slot and the button is disabled until it clears. Every button that starts work
    /// the user has to wait for sets this, so a slow operation never reads as a dead click.</summary>
    [Parameter] public bool Loading { get; set; }
    [Parameter] public RenderFragment<int>? IconLeft { get; set; }
    [Parameter] public RenderFragment<int>? IconRight { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private int _iconSize => Size == "large" ? 21 : 14;

    private Dictionary<string, object>? DisabledAttributes => AdditionalAttributes?
        .Where(pair => !pair.Key.StartsWith("on", StringComparison.OrdinalIgnoreCase)
            && !new[] { "href", "tabindex", "aria-disabled", "contenteditable" }.Contains(pair.Key, StringComparer.OrdinalIgnoreCase))
        .ToDictionary(pair => pair.Key, pair => pair.Value);

    private string _classes => $"indx-btn indx-btn-{Size} indx-btn-{Variant}";
}
