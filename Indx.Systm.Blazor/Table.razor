@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@* Port of indx-systm Table. Rows and cells go in as children: use TableHeader, TableRow and
   TableCell, or plain thead / tr / td where a row needs attributes of its own. The styles are
   global (indx-systm.css, .indx-table), so both forms look the same. *@

@if (Scrollable)
{
    <div class="indx-table-scroll @(BleedEnd != null ? "indx-table-bleed-end" : null) @WrapperClass"
         style="@(BleedEnd != null ? $"--table-bleed: {BleedEnd}" : null)" role="region" aria-label="@(AriaLabel ?? Caption)" tabindex="0">
        @TableElement
    </div>
}
else
{
    @TableElement
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Caption { get; set; }
    /// <summary>Names the table for assistive technology. Give this or a Caption.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Put the table in a frame that scrolls sideways when the table is wider than the
    /// space it has, so a wide table never makes the page scroll. The frame is focusable, so it
    /// can be scrolled from the keyboard.</summary>
    [Parameter] public bool Scrollable { get; set; }

    /// <summary>With Scrollable: keep the first column in place while the rest scrolls under it,
    /// so the reader always knows which row they are on. Give that column a sensible width, since
    /// it takes its share of a narrow screen for good.</summary>
    [Parameter] public bool StickyFirstColumn { get; set; }

    /// <summary>With Scrollable: how far the frame reaches past its box on the end side, into
    /// the gutter there, as a CSS length. A table that has to scroll then runs to the edge of the
    /// screen instead of stopping at the page margin, and stops scrolling when its end meets that
    /// edge. The start side stays put, so the table
    /// lines up with the page and a pinned first column stays where it is. Set it to the width
    /// of the gutter beside the table.</summary>
    [Parameter] public string? BleedEnd { get; set; }

    [Parameter] public string? Class { get; set; }
    /// <summary>Extra class on the scrolling frame (Scrollable only).</summary>
    [Parameter] public string? WrapperClass { get; set; }

    /// <summary>Let the reader set each column's width by dragging a handle at its header's right
    /// edge, or with the arrow keys once it has focus; a double click (or Delete) gives the width
    /// back. Every column gets a fixed width from the start, so the rows a page shows never move the
    /// columns: a longer value is cut instead. Name a column by its header's <c>data-column</c>, and
    /// give its first width as <c>data-width</c> (px); without them a column is named by its place
    /// and keeps the width it first had. The column whose header says <c>data-fill</c> (else the last)
    /// takes what the frame has left. A cell stays on one line unless it says <c>data-wrap</c>. Never render a width on a header yourself: the browser half
    /// (Table.razor.js) owns them, and a render would undo a reader's. Port of the React Table's
    /// resizableColumns.</summary>
    [Parameter] public bool ResizableColumns { get; set; }
    /// <summary>With ResizableColumns: where the reader's widths are kept (localStorage). Left out,
    /// they last as long as the page.</summary>
    [Parameter] public string? ColumnStorageKey { get; set; }

    private ElementReference _table;
    private IJSObjectReference? _module;
    private bool _enabled;
    private string? _enabledKey;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Turned on, off, or onto another key (another dataset in the same page): the browser half
        // starts again, so it reads that key's widths.
        if (ResizableColumns == _enabled && ColumnStorageKey == _enabledKey) return;
        try
        {
            if (_module == null && ResizableColumns)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Indx.Systm.Blazor/Table.razor.js");
                if (_disposed) { await module.DisposeAsync(); return; }
                _module = module;
            }
            if (_module == null) return;
            if (ResizableColumns) await _module.InvokeVoidAsync("enable", _table, ColumnStorageKey);
            else await _module.InvokeVoidAsync("dispose", _table);
            _enabled = ResizableColumns;
            _enabledKey = ColumnStorageKey;
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _table); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
        }
    }

    private RenderFragment TableElement => __builder =>
    {
        <table @ref="_table" class="indx-table @(Scrollable && StickyFirstColumn ? "indx-table-sticky-first" : null) @Class" aria-label="@AriaLabel">
            @if (Caption != null) { <caption class="indx-table-caption">@Caption</caption> }
            @ChildContent
        </table>
    };
}
