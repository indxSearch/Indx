@* A link, either a direct top-level entry (Variant="navigation", styled like a trigger) or a
   row inside a panel (the default). Marked data-active when it points at the current page,
   or when Active is set explicitly. *@

<a href="@Href" class="@(Variant == "navigation" ? "indx-navmenu-control" : "indx-navmenu-link") @Class"
   data-active="@(_active ? "" : null)" aria-current="@(_active ? "page" : null)"
   target="@Target" @onclick="OnClick">
    @if (Icon != null && Variant == "navigation") { <span class="indx-navmenu-icon" aria-hidden="true">@Icon(Menu.IconSize)</span> }
    @ChildContent
</a>

@code {
    [CascadingParameter] private NavigationMenu Menu { get; set; } = default!;

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter, EditorRequired] public string? Href { get; set; }
    /// <summary>"navigation" for a direct link in the top-level list; "panel" (default) inside a content panel.</summary>
    [Parameter] public string Variant { get; set; } = "panel";
    /// <summary>Optional leading icon for the navigation variant; receives the icon size, 14 or 21 at Size="large".</summary>
    [Parameter] public RenderFragment<int>? Icon { get; set; }
    /// <summary>Force the active state; null resolves it from the current URL.</summary>
    [Parameter] public bool? Active { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public string? Class { get; set; }

    private bool _active => Active ?? Menu.IsCurrent(Href);

    private void OnClick() => Menu.Close();
}
