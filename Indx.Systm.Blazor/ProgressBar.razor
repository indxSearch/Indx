<div class="indx-progress-wrapper" role="progressbar" aria-valuenow="@_clamped" aria-valuemin="0" aria-valuemax="100">
    <div class="indx-progress-track">
        <div class="indx-progress-fill" style="width: @(_clamped)%; @(_fillColor)"></div>
    </div>
    @if (ShowLabel)
    {
        <span class="indx-progress-label" aria-hidden="true">@(Math.Round(_clamped))%</span>
    }
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public bool ShowLabel { get; set; }
    [Parameter] public bool FulfilledColor { get; set; }

    private double _clamped => Math.Min(100, Math.Max(0, Value));
    private string _fillColor => FulfilledColor && _clamped >= 100 ? "background-color: var(--CPureBlue);" : "";
}
