@* Port of indx-systm Stat: one number with its label, on the Base surface tone. A count, a KPI, a
   state (pass a Chip as ValueContent, or a word with an Icon). Put several in a StatGroup. *@

@* Three rows: the label on top, the body in the middle, the foot at the bottom. The body takes
   the height the others leave and centres what it holds, so in a StatGroup, whose tiles are as
   tall as the tallest, the labels line up at the top, the feet at the bottom, and a ring, a number
   and a chip sit on one middle (25 Oct 2026). With a figure the label stays on top too; the figure
   sits in the body with the value and foot beside it. *@
<div class="indx-stat @Class">
    @LabelFragment
    <span class="indx-stat-body">
        @if (Figure != null)
        {
            <span class="indx-stat--figured">
                <span class="indx-stat-figure">@Figure</span>
                <span class="indx-stat-text">@ValueFragment @FootFragment</span>
            </span>
        }
        else
        {
            @ValueFragment
        }
    </span>
    @if (Figure == null)
    {
        @FootFragment
    }
</div>

@code {
    /// <summary>What the number is: "Searches", "Click-through".</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>The label as markup, in place of Label (a skeleton while it loads).</summary>
    [Parameter] public RenderFragment? LabelContent { get; set; }
    /// <summary>A pixl icon before the label, at <see cref="LabelIconSize"/> in the label's tone: what the
    /// tile is about, a search, a cart, a CPU, for a row of tiles read at a glance.</summary>
    [Parameter] public RenderFragment<int>? LabelIcon { get; set; }
    /// <summary>Two cells of the pixl grid: 14 wide, 10 tall, on the label's x-height.</summary>
    public const int LabelIconSize = 14;
    /// <summary>The number, formatted. Left out when the figure carries it.</summary>
    [Parameter] public string? Value { get; set; }
    /// <summary>A graphic under the label, the value and foot beside it: a BarMeter ring with the number in it.</summary>
    [Parameter] public RenderFragment? Figure { get; set; }
    /// <summary>The value as markup, in place of Value: a chip for a state, a skeleton while it loads.</summary>
    [Parameter] public RenderFragment? ValueContent { get; set; }
    /// <summary>A pixl icon before the value, for a state ("Up", "Key set"): drawn at <see cref="IconSize"/>
    /// in the value's colour. A good state stays in the ink; the icon says it.</summary>
    [Parameter] public RenderFragment<int>? Icon { get; set; }
    /// <summary>The value's colour, and the icon's: the signal red for a state that is wrong.</summary>
    [Parameter] public string? Color { get; set; }
    /// <summary>The pixl grid is 7 cells by 5, so an icon is crisp at a width that is a multiple of 7: 14,
    /// 21, 28, 35. The value is set at 24px; 28 wide (20 tall) sits on its cap height.</summary>
    public const int IconSize = 28;
    /// <summary>Shown on the label, which gets a dotted underline to say there is more.</summary>
    [Parameter] public string? Hint { get; set; }
    /// <summary>A line under the value: a change against the previous period, a unit, a note.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }

    private RenderFragment LabelText => LabelContent ?? (b => b.AddContent(0, Label));
    private RenderFragment LabelBody => LabelIcon == null ? LabelText : @<text><span class="indx-stat-label-icon" aria-hidden="true">@LabelIcon(LabelIconSize)</span>@LabelText</text>;
    private bool HasValue => Value != null || ValueContent != null || Icon != null;

    private RenderFragment LabelFragment => @<text>
        @if (!string.IsNullOrEmpty(Hint))
        {
            <Tooltip Content="@Hint"><span class="indx-stat-label indx-stat-label--hint">@LabelBody</span></Tooltip>
        }
        else
        {
            <span class="indx-stat-label">@LabelBody</span>
        }
    </text>;

    private RenderFragment ValueFragment => @<text>
        @if (HasValue)
        {
            <span class="indx-stat-value" style="@(Color != null ? $"color: {Color};" : null)">
                @if (Icon != null) { <span class="indx-stat-icon" aria-hidden="true">@Icon(IconSize)</span> }
                @(ValueContent ?? (RenderFragment)(b => b.AddContent(0, Value)))
            </span>
        }
    </text>;

    private RenderFragment FootFragment => @<text>
        @if (ChildContent != null)
        {
            <span class="indx-stat-foot">@ChildContent</span>
        }
    </text>;
}
