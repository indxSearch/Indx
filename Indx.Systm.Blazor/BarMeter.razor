@* A level against its ceiling, as a row of bars: the filled ones in the ink, the rest dim. A label
   above, the value at the left below and the ceiling at the right. Where ProgressBar is a
   percentage on its way to done, BarMeter goes up and down: CPU pressure, memory in use, a quota.
   The bars are drawn by a repeating gradient, so their number follows the width. Port of the
   React BarMeter in indx-systm. *@
<div class="indx-barmeter" role="meter" aria-valuenow="@_now" aria-valuemin="0" aria-valuemax="@_max">
    <span class="indx-barmeter-label">@Label</span>
    <div class="indx-barmeter-bars" aria-hidden="true">
        <div class="indx-barmeter-fill" style="--meter-fill: @(_pct)%;@(_color)"></div>
    </div>
    <div class="indx-barmeter-foot" aria-hidden="true">
        <span class="indx-barmeter-value">@Show(Value)</span>
        <span class="indx-barmeter-max">@(MaxLabel ?? $"of {Show(Max)}")</span>
    </div>
</div>

@code {
    /// <summary>What is measured: "CPU pressure", "Memory".</summary>
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public double Value { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    /// <summary>The value as shown; defaults to the number with thousands separators.</summary>
    [Parameter] public Func<double, string>? Format { get; set; }
    /// <summary>The ceiling as shown at the right; defaults to "of" and the formatted max.</summary>
    [Parameter] public string? MaxLabel { get; set; }
    /// <summary>The filled bars' colour, for a level that has become a problem: the signal red past a threshold.</summary>
    [Parameter] public string? Color { get; set; }

    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private double _fraction => Max > 0 ? Math.Min(1, Math.Max(0, Value / Max)) : 0;
    // Invariant: in a culture with a decimal comma, "45,5%" is invalid CSS and the fill vanishes.
    private string _pct => (_fraction * 100).ToString(Inv);
    private string _now => Value.ToString(Inv);
    private string _max => Max.ToString(Inv);
    private string _color => string.IsNullOrEmpty(Color) ? "" : $"color: {Color};";
    private string Show(double n) => Format != null ? Format(n) : n.ToString("#,0.##");
}
