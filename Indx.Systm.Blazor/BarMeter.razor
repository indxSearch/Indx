@* A level against its ceiling, as bars: the filled ones in the ink, the rest dim. Two shapes. "bar"
   is a row with a label above, the value at the left below and the ceiling at the right. "ring" is
   the same bars around a circle, from the top clockwise, the value in the middle, the ceiling under
   it from 96px, and the label beneath; a 48px ring holds a short value and fits a Stat. Where ProgressBar is a percentage on its way to done, BarMeter goes
   up and down: CPU pressure, memory in use, a quota. The row's bars are drawn by a repeating
   gradient, so their number follows the width; the ring's are SVG lines, as many as keep the same
   4px pitch at the middle of the band. With Segments the row is shares of a whole instead of a
   level: each segment its share of the bars in a tone of its own, the name and share above it, a
   hairline between; a colour stays on the bars, the share is ink. Port of the React BarMeter in
   indx-systm. *@
@if (Segments != null && Shape != "ring")
{
    var parts = Parts();
    <div class="indx-barmeter indx-barmeter-segmented" role="img" aria-label="@Label">
        @if (!string.IsNullOrEmpty(Label))
        {
            <span class="indx-barmeter-label">@Label</span>
        }
        <div class="indx-barmeter-shares @(Labels == "legend" ? "indx-barmeter-shares-legend" : "")">
            @foreach (var part in parts)
            {
                if (Labels != "heads" || (part.Share < MinHeadShare && !part.Last)) { continue; }
                <div class="indx-barmeter-head @(part.Last ? "indx-barmeter-head-last" : "")" style="--seg-from: @(part.From)%; --seg-to: @(part.To)%;">
                    <span class="indx-barmeter-head-name">@part.Segment.Label</span>
                    <span class="indx-barmeter-head-share">@ShowShare(part.Segment)</span>
                </div>
            }
            <div class="indx-barmeter-bars" aria-hidden="true">
                @foreach (var part in parts)
                {
                    <div class="indx-barmeter-fill indx-barmeter-segment" style="--seg-from: @(part.From)%; --seg-to: @(part.To)%; color: @part.Color;"></div>
                }
            </div>
            @foreach (var part in parts.Skip(1))
            {
                <span class="indx-barmeter-divider" style="--seg-from: @(part.From)%;"></span>
            }
        </div>
        @if (Labels == "legend")
        {
            <ul class="indx-barmeter-legend">
                @foreach (var part in parts)
                {
                    <li class="indx-barmeter-legend-item">
                        <span class="indx-barmeter-swatch" style="background: @part.Color;"></span>
                        <span class="indx-barmeter-legend-name">@part.Segment.Label</span>
                        <span class="indx-barmeter-legend-share">@ShowShare(part.Segment)</span>
                    </li>
                }
            </ul>
        }
    </div>
}
else if (Shape == "ring")
{
    <div class="indx-barmeter indx-barmeter-ring" role="meter" aria-valuenow="@_now" aria-valuemin="0" aria-valuemax="@_max"
         style="--meter-size: @(Size)px;@(_color)">
        <div class="indx-barmeter-dial">
            <svg class="indx-barmeter-svg" viewBox="0 0 @Size @Size" width="@Size" height="@Size" aria-hidden="true">
                @foreach (var line in RingLines())
                {
                    <line class="@(line.Lit ? "indx-barmeter-lit" : line.Zone != null ? "indx-barmeter-zone-bar" : "indx-barmeter-dim")"
                          style="@(line.Zone != null ? $"stroke: {line.Zone};" : null)"
                          x1="@line.X1" y1="@line.Y1" x2="@line.X2" y2="@line.Y2" />
                }
            </svg>
            <div class="indx-barmeter-centre" aria-hidden="true">
                <span class="indx-barmeter-value">@Show(Value)</span>
                @if (Size >= RingCeilingFrom)
                {
                    <span class="indx-barmeter-max">@_ceiling</span>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Label))
        {
            <span class="indx-barmeter-label">@Label</span>
        }
    </div>
}
else
{
    <div class="indx-barmeter" role="meter" aria-valuenow="@_now" aria-valuemin="0" aria-valuemax="@_max">
        @if (!string.IsNullOrEmpty(Label))
        {
            <span class="indx-barmeter-label">@Label</span>
        }
        <div class="indx-barmeter-bars" aria-hidden="true">
            @if (Zones != null)
            {
                @foreach (var z in Zones)
                {
                    <div class="indx-barmeter-fill indx-barmeter-zone" style="--zone-from: @((z.From * 100).ToString("0.###", Inv))%; color: @z.Color;"></div>
                }
            }
            <div class="indx-barmeter-fill" style="--meter-fill: @(_pct)%;@(_color)"></div>
        </div>
        <div class="indx-barmeter-foot" aria-hidden="true">
            <span class="indx-barmeter-value">@Show(Value)</span>
            <span class="indx-barmeter-max">@_ceiling</span>
        </div>
    </div>
}

@code {
    /// <summary>What is measured: "CPU pressure", "Memory". A ring inside a Stat leaves it to the Stat.</summary>
    [Parameter] public string Label { get; set; } = "";
    /// <summary>The level; with Segments, left out: the segments are the whole.</summary>
    [Parameter] public double Value { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    /// <summary>A segment of the row as shares: its label, its value and, optionally, its colour; without one, the tone ladder from the ink down, four steps.</summary>
    public sealed record Segment(string Label, double Value, string? Color = null);
    /// <summary>The row as shares of a whole: each segment its share of the bars in its own tone, with
    /// its name and share above it and a hairline between. Holders by kind, documents by type. The row
    /// shape only; Value, Max and the foot are not used.</summary>
    [Parameter] public IReadOnlyList<Segment>? Segments { get; set; }
    /// <summary>Where the segments' names and shares go: "heads" above each segment (a segment under
    /// 8 % of the row gets none, the last one apart), or "legend", a list under the bars, for many or narrow segments.</summary>
    [Parameter] public string Labels { get; set; } = "heads";
    /// <summary>The value as shown; defaults to the number with thousands separators.</summary>
    [Parameter] public Func<double, string>? Format { get; set; }
    /// <summary>The ceiling as shown; defaults to "of" and the formatted max.</summary>
    [Parameter] public string? MaxLabel { get; set; }
    /// <summary>The filled bars' colour, for a level that has become a problem: the signal red past a threshold. Overrides the zones.</summary>
    [Parameter] public string? Color { get; set; }
    /// <summary>A level from which the meter changes colour: where it starts as a share of Max, 0 to 1, and the colour.</summary>
    public sealed record Zone(double From, string Color);
    /// <summary>Levels from which the filled bars change colour: a warning from 70 %, the signal red from 85 %.
    /// The bars past the level show each zone faintly, so the thresholds can be seen before they are reached.</summary>
    [Parameter] public IReadOnlyList<Zone>? Zones { get; set; }
    /// <summary>"bar" (default), a row of bars, or "ring", a ring of them.</summary>
    [Parameter] public string Shape { get; set; } = "bar";
    /// <summary>The ring's diameter in pixels; 72 by default, 48 the smallest that holds a value. From 96 the ceiling joins the value in the middle. The row ignores it.</summary>
    [Parameter] public int Size { get; set; } = 72;

    private const double RingPitch = 4;
    // The band is 14px like the row, 6px below 72px so the hole still holds a short value ("84 %"
    // at 48px); the ceiling joins the value in the hole from 96px, where there is room for a
    // second line.
    private const int RingCeilingFrom = 96;
    private double RingBand => Size < 72 ? 6 : 14;

    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private double _fraction => Max > 0 ? Math.Min(1, Math.Max(0, Value / Max)) : 0;
    // Invariant: in a culture with a decimal comma, "45,5%" is invalid CSS and the fill vanishes.
    private string _pct => (_fraction * 100).ToString(Inv);
    private string _now => Value.ToString(Inv);
    private string _max => Max.ToString(Inv);
    /// <summary>The colour of the zone the level has reached, or none below the first.</summary>
    private string? ZoneColor(double at) => Zones?.Where(z => at >= z.From).OrderByDescending(z => z.From).FirstOrDefault()?.Color;
    private string? FillColor => string.IsNullOrEmpty(Color) ? ZoneColor(_fraction) : Color;
    private string _color => FillColor is { } c ? $"color: {c};" : "";
    private string _ceiling => MaxLabel ?? $"of {Show(Max)}";
    private string Show(double n) => Format != null ? Format(n) : n.ToString("#,0.##");

    private readonly record struct RingLine(bool Lit, string X1, string Y1, string X2, string Y2, string? Zone = null);

    // The ring's bars: 2px radial lines from the inner to the outer radius, as many as give a 4px
    // pitch along the middle of the band, the first at the top and the rest clockwise. The filled
    // ones are the first round(fraction * count); the rest dim.
    private IEnumerable<RingLine> RingLines()
    {
        double outer = Size / 2.0;
        double inner = Math.Max(0, outer - RingBand);
        double middle = (outer + inner) / 2;
        int count = Math.Max(4, (int)Math.Round(2 * Math.PI * middle / RingPitch));
        int filled = (int)Math.Round(_fraction * count);
        for (int i = 0; i < count; i++)
        {
            double angle = (-90 + 360.0 * i / count) * Math.PI / 180;
            double cos = Math.Cos(angle), sin = Math.Sin(angle);
            yield return new RingLine(i < filled,
                F(outer + inner * cos), F(outer + inner * sin), F(outer + outer * cos), F(outer + outer * sin),
                i < filled ? null : ZoneColor((double)i / count));
        }
    }

    private static string F(double v) => v.ToString("0.##", Inv);

    // The same four steps as Waffle, apart enough to tell at 2px; a fifth segment and on keep the
    // last, never back to the ink.
    private static readonly string[] SegmentTones = { "var(--lv8)", "var(--lv5)", "var(--lv4)", "var(--lv3)" };
    private static string ToneOf(int i) => SegmentTones[Math.Min(i, SegmentTones.Length - 1)];
    // A head needs room: a segment narrower than this gets none, so heads never pile up. The last
    // keeps its head whatever its width, since it sits against the right edge with the edge to itself.
    private const double MinHeadShare = 0.08;
    private readonly record struct Part(Segment Segment, string From, string To, double Share, string Color, bool Last);

    private double SegmentSum => Segments?.Sum(g => Math.Max(0, g.Value)) ?? 0;
    private string ShowShare(Segment g) => Format != null ? Format(g.Value) : $"{Math.Round((SegmentSum > 0 ? g.Value / SegmentSum : 0) * 100)} %";

    private List<Part> Parts()
    {
        var parts = new List<Part>();
        if (Segments == null) return parts;
        double sum = SegmentSum, start = 0;
        for (int i = 0; i < Segments.Count; i++)
        {
            var g = Segments[i];
            double from = start;
            double share = sum > 0 ? Math.Max(0, g.Value) / sum : 0;
            start += share;
            bool last = i == Segments.Count - 1;
            parts.Add(new Part(g, (from * 100).ToString("0.###", Inv), ((last ? 1 : start) * 100).ToString("0.###", Inv),
                share, g.Color ?? ToneOf(i), last));
        }
        return parts;
    }
}
