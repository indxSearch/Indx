@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@* A SelectField you can type into, for a list too long to scroll: a field, a dataset, a team.
   Looks like SelectField closed; open, a Popover holds a search box over the options, typing
   narrows them, the arrows move the highlight, Enter chooses and Escape closes and gives the field
   its focus back. By default an option matches when its label starts with or holds what was
   typed, starts first; a host with a better search (the console's Indx) passes Search. The keys
   are the command palette's own (Combobox.razor.js brings them in), so the highlight moves without
   a round trip. Port of the React Combobox in indx-systm. *@

<div class="indx-combobox-wrapper @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_id-label" for="@_id" class="indx-combobox-label">@Label</label>
    }
    <Popover @ref="_popover" Open="_open" OpenChanged="OnOpenChanged" Align="start" AriaLabel="@(AriaLabel ?? Label)" Class="indx-combobox-panel">
        <Trigger>
            <button type="button" id="@_id" class="indx-combobox indx-combobox-@Size" @ref="_button" disabled="@Disabled"
                    aria-haspopup="listbox" aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : $"{_id}-label {_id}-value")"
                    aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : null)">
                <span id="@_id-value" class="indx-combobox-value @(Selected == null ? "indx-combobox-placeholder" : null)">
                    @if (Selected?.Icon is { } icon) { @icon(_iconSize) }
                    <span class="indx-combobox-text">@(Selected?.Label ?? Placeholder)</span>
                </span>
                <span class="indx-combobox-chevron" aria-hidden="true"><ChevronDown Size="@_iconSize" Color="currentColor" /></span>
            </button>
        </Trigger>
        <ChildContent>
            <div class="indx-combobox-body" @ref="_panel">
                <div class="indx-combobox-field">
                    <span class="indx-combobox-search" aria-hidden="true"><Indx.Systm.Blazor.Icons.Search Size="14" Color="currentColor" /></span>
                    <input class="indx-combobox-input" type="text" role="combobox" aria-expanded="true" aria-controls="@_listId"
                           aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="@SearchPlaceholder"
                           @key="_box.Key" value="@_box.Rendered" @oninput="OnInput" />
                </div>
                <div class="indx-combobox-list" id="@_listId" role="listbox" aria-label="@(AriaLabel ?? Label)">
                    @if (_matches.Count == 0)
                    {
                        <p class="indx-combobox-empty">@NoMatchText</p>
                    }
                    @{ var n = 0; }
                    @foreach (var option in _matches)
                    {
                        var o = option;
                        var chosen = o.Value == Value;
                        <button type="button" class="indx-combobox-item" id="@($"{_listId}-{n++}")" role="option" data-palette-item
                                aria-selected="@(chosen ? "true" : "false")" @key="o.Value" @onclick="() => Pick(o)">
                            @if (o.Icon is { } oi) { <span class="indx-combobox-item-icon">@oi(14)</span> }
                            <span class="indx-combobox-item-label">@o.Label</span>
                            @if (chosen) { <span class="indx-combobox-item-check"><Check Size="14" Color="currentColor" /></span> }
                        </button>
                    }
                </div>
            </div>
        </ChildContent>
    </Popover>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; } = "Choose…";
    [Parameter] public string SearchPlaceholder { get; set; } = "Search";
    [Parameter] public string NoMatchText { get; set; } = "No matches.";
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter, EditorRequired] public IEnumerable<SelectField.SelectOption> Options { get; set; } = [];
    /// <summary>The host's own search over the options (the console uses Indx); left out, a label
    /// that starts with what was typed comes first, then one that holds it.</summary>
    [Parameter] public Func<string, IEnumerable<SelectField.SelectOption>>? Search { get; set; }
    /// <summary>"micro" | "default" | "large", as SelectField and Button.</summary>
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }

    private readonly string _generatedId = $"combobox-{Guid.NewGuid():N}";
    private string _id => Id ?? _generatedId;
    private string _listId => $"{_id}-list";
    private int _iconSize => Size == "large" ? 21 : 14;

    private readonly LiveInputState _box = new("");
    private IReadOnlyList<SelectField.SelectOption> _options = [];
    private IReadOnlyList<SelectField.SelectOption> _matches = [];
    private SelectField.SelectOption? Selected => _options.FirstOrDefault(o => o.Value == Value);

    private Popover? _popover;
    private ElementReference _button;
    private ElementReference _panel;
    private bool _open, _shown, _refocus;
    private IReadOnlyList<SelectField.SelectOption>? _shownMatches;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Combobox>? _self;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        _options = Options as IReadOnlyList<SelectField.SelectOption> ?? Options.ToArray();
        Narrow(_box.Text ?? "");
    }

    private void Narrow(string text)
    {
        var q = text.Trim();
        if (q.Length == 0) { _matches = _options; return; }
        if (Search != null) { _matches = Search(q).ToArray(); return; }
        _matches = _options.Where(o => o.Label.StartsWith(q, StringComparison.OrdinalIgnoreCase))
            .Concat(_options.Where(o => !o.Label.StartsWith(q, StringComparison.OrdinalIgnoreCase) && o.Label.Contains(q, StringComparison.OrdinalIgnoreCase)))
            .ToArray();
    }

    private void OnInput(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? "";
        _box.Typed(text);
        Narrow(text);
    }

    private void OnOpenChanged(bool open)
    {
        _open = open;
        // Opened again, it starts from the whole list.
        if (!open && (_box.Text ?? "").Length > 0) { _box.Set(""); Narrow(""); }
    }

    private async Task Pick(SelectField.SelectOption option)
    {
        await CloseAndReturn();
        await ValueChanged.InvokeAsync(option.Value);
    }

    /// <summary>Escape in the search box (CommandPalette.razor.js): closed, and the field has the focus.</summary>
    [JSInvokable] public Task Close() => InvokeAsync(CloseAndReturn);

    private async Task CloseAndReturn()
    {
        if (_popover != null) await _popover.Close();
        OnOpenChanged(false);
        _refocus = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (_refocus) { _refocus = false; await _button.FocusAsync(); }
            if (_open && (!_shown || !ReferenceEquals(_shownMatches, _matches)))
            {
                if (_module is null)
                {
                    var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Indx.Systm.Blazor/Combobox.razor.js");
                    if (_disposed) { await module.DisposeAsync(); return; }
                    _module = module;
                }
                _self ??= DotNetObjectReference.Create(this);
                if (_shown) await _module.InvokeVoidAsync("reset", _panel);
                else await _module.InvokeVoidAsync("opened", _panel, _self, _button);
                _shownMatches = _matches;
            }
            _shown = _open;
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
        }
        _self?.Dispose();
    }
}
