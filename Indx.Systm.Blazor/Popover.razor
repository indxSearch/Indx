@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@* A panel that opens from a trigger and floats by it, without blocking the page: a menu of
   actions, a few settings, a short list. Fixed to the window (Popover.razor.js), so a scrolling or
   clipping parent never cuts it off; it takes the side asked and flips to the other when that has
   no room. A press or focus outside closes it, Escape closes it and returns focus to the trigger,
   and so does a navigation. Role="menu" makes it a menu: its items are ghost Buttons, full width,
   and the arrows move between them; PopoverDivider separates groups. The trigger's control gets
   aria-expanded and aria-haspopup. Port of the React Popover in indx-systm (Radix there). *@
<span class="indx-popover-anchor" @ref="_anchor">
    <span class="indx-popover-trigger" @onclick="Toggle">@Trigger</span>
    @if (_open)
    {
        <div class="indx-popover @(Role == "menu" ? "indx-popover-menu" : "") @Class" role="@Role" aria-label="@AriaLabel"
             tabindex="-1" @ref="_content">
            @ChildContent
        </div>
    }
</span>

@code {
    /// <summary>What opens it: a Button, usually ghost. Its control gets aria-expanded.</summary>
    [Parameter, EditorRequired] public RenderFragment? Trigger { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Whether it is open, for @bind-Open; left unbound, the popover keeps its own state.</summary>
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    /// <summary>"bottom" (the default), "top", "left" or "right" of the trigger; flipped when it has no room.</summary>
    [Parameter] public string Side { get; set; } = "bottom";
    /// <summary>"end" (the default), "center" or "start": which edge of the trigger the panel lines up with.</summary>
    [Parameter] public string Align { get; set; } = "end";
    /// <summary>The gap to the trigger in pixels; 5 by default.</summary>
    [Parameter] public int SideOffset { get; set; } = 5;
    /// <summary>"dialog" (the default) for a panel of content, "menu" for a list of actions.</summary>
    [Parameter] public string Role { get; set; } = "dialog";
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>Classes on the panel, for its width or padding.</summary>
    [Parameter] public string? Class { get; set; }

    private bool _open;
    private bool _shown;          // the module has placed the panel and listens for it
    private ElementReference _anchor;
    private ElementReference _content;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Popover>? _self;
    private bool _disposed;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override void OnParametersSet()
    {
        if (OpenChanged.HasDelegate) _open = Open;
    }

    private Task Toggle() => SetOpen(!_open);

    /// <summary>Closes it, for a menu item that has done its work.</summary>
    public Task Close() => SetOpen(false);

    private async Task SetOpen(bool value)
    {
        if (_open == value) return;
        _open = value;
        if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(value);
        StateHasChanged();
    }

    [JSInvokable]
    public Task Dismiss() => InvokeAsync(() => SetOpen(false));

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_open) _ = InvokeAsync(() => SetOpen(false));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open == _shown) return;
        try
        {
            if (_module is null)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Indx.Systm.Blazor/Popover.razor.js");
                if (_disposed) { await module.DisposeAsync(); return; }
                _module = module;
            }
            if (_open)
            {
                _self ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("show", _anchor, _content, Side, Align, SideOffset, Role, _self);
            }
            else await _module.InvokeVoidAsync("closed", _anchor);
            _shown = _open;
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("closed", _anchor); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
        }
        _self?.Dispose();
    }
}
