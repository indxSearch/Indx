@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@* A panel the height of the window, over the page from its right edge (or left): a record opened
   from a list, a finding with its evidence, settings too long for a Modal. The list stays where it
   was beneath it. A press on the scrim, Escape or the close button closes it; while open the focus
   stays inside and the page does not scroll, and on closing the focus goes back to what opened it
   (Sheet.razor.js). Header with title and description, a body that scrolls, an optional footer for
   its buttons. No motion: it is simply there, and then not. Port of the React Sheet in indx-systm. *@
@if (Open)
{
    <div class="indx-sheet-overlay" @onclick="Close"></div>
    <div class="indx-sheet indx-sheet-@Side indx-sheet-@Size @Class" role="dialog" aria-modal="true"
         aria-labelledby="@(string.IsNullOrEmpty(Title) ? null : $"{_id}-title")" aria-label="@(string.IsNullOrEmpty(Title) ? AriaLabel : null)"
         tabindex="-1" @ref="_panel">
        <div class="indx-sheet-header">
            <div class="indx-sheet-heading">
                @if (!string.IsNullOrEmpty(Title)) { <h2 id="@_id-title" class="indx-sheet-title">@Title</h2> }
                @if (!string.IsNullOrEmpty(Description)) { <p class="indx-sheet-description">@Description</p> }
            </div>
            <Button Variant="ghost" Size="micro" IconLeft="_iconClose" aria-label="Close" @onclick="Close" />
        </div>
        <div class="indx-sheet-body">@ChildContent</div>
        @if (Footer != null)
        {
            <div class="indx-sheet-footer">@Footer</div>
        }
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Buttons at the foot, primary first, as a Modal's form actions.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }
    /// <summary>"right" (the default) or "left".</summary>
    [Parameter] public string Side { get; set; } = "right";
    /// <summary>"default" (480px) or "wide" (720px); the whole width on a phone.</summary>
    [Parameter] public string Size { get; set; } = "default";
    /// <summary>The name a screen reader gives it when there is no Title.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Panel";
    [Parameter] public string? Class { get; set; }

    private static readonly RenderFragment<int> _iconClose = size => @<XOrError Size="size" Color="currentColor" />;
    private readonly string _id = $"sheet-{Guid.NewGuid():N}";
    private ElementReference _panel;
    private bool _shown;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Sheet>? _self;
    private bool _disposed;

    private async Task Close()
    {
        if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(false);
    }

    [JSInvokable] public Task Dismiss() => InvokeAsync(Close);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open == _shown) return;
        try
        {
            if (_module is null)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Indx.Systm.Blazor/Sheet.razor.js");
                if (_disposed) { await module.DisposeAsync(); return; }
                _module = module;
            }
            _self ??= DotNetObjectReference.Create(this);
            if (Open) await _module.InvokeVoidAsync("opened", _panel, _self);
            else await _module.InvokeVoidAsync("closed", _self);
            _shown = Open;
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                if (_shown && _self != null) await _module.InvokeVoidAsync("closed", _self);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
        }
        _self?.Dispose();
    }
}
