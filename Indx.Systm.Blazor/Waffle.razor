@* Shares of a whole as a grid of pixel squares: each segment gets its share of the cells, filled
   column by column from the left, the first segment in the ink and the rest down the tone ladder,
   with a legend beneath. A portfolio by holding, a dataset by field type, searches by source.
   Where a pie would be, this is the pixel version. Hovering a cell names its segment in a
   tooltip beside it, and a cell or a legend entry under the pointer dims the other segments, so
   which is which can be browsed from either side. Port of the React Waffle in indx-systm. *@
<div class="indx-waffle @Class">
    <div class="indx-waffle-grid-wrap" @onmouseleave="Leave">
        <div class="indx-waffle-grid" role="img" aria-label="@AriaLabel"
             style="--waffle-rows: @Rows; --waffle-cell: @(Cell)px;">
            @{
                var counts = AllocateCells(Segments.Select(s => s.Value).ToArray(), Columns * Rows);
                int seg = 0, used = 0;
            }
            @for (int i = 0; i < Columns * Rows; i++)
            {
                while (seg < counts.Length && used >= counts[seg]) { seg++; used = 0; }
                var color = seg < counts.Length ? ColorOf(seg) : null;
                used++;
                var (cell, of) = (i, seg < counts.Length ? seg : -1);
                <span class="indx-waffle-cell @(_segment is { } hs && hs != of ? "indx-waffle-dim" : null)"
                      style="@(color != null ? $"background: {color};" : null)"
                      @onmouseover="() => Hover(cell, of)"></span>
            }
        </div>
        @* The hovered cell's segment, beside it: at the right, or at the left past the middle. *@
        @if (_cell is { } c && _segment is { } sg && sg < Segments.Count)
        {
            int col = c / Rows, row = c % Rows, pitch = Cell + 2;
            bool rightHalf = col > Columns / 2.0;
            var s = Segments[sg];
            <div class="indx-waffle-tooltip @(rightHalf ? "indx-waffle-tooltip-left" : "")"
                 style="top: @(row * pitch + Cell / 2.0)px; left: @(rightHalf ? col * pitch - 6 : col * pitch + Cell + 6)px;">
                @if (s.Icon != null) { <span class="indx-waffle-icon">@s.Icon</span> }
                <span class="indx-waffle-name">@s.Label</span>
                <span class="indx-waffle-share">@Show(s)</span>
            </div>
        }
    </div>
    @if (Legend)
    {
        <ul class="indx-waffle-legend" aria-hidden="@(AriaLabel == null ? "true" : null)">
            @for (int i = 0; i < Segments.Count; i++)
            {
                var s = Segments[i];
                var index = i;
                <li class="indx-waffle-item" @onmouseover="() => { _cell = null; _segment = index; }" @onmouseleave="Leave">
                    <span class="indx-waffle-swatch" style="background: @ColorOf(i);"></span>
                    @if (s.Icon != null) { <span class="indx-waffle-icon">@s.Icon</span> }
                    <span class="indx-waffle-name">@s.Label</span>
                    <span class="indx-waffle-share">@Show(s)</span>
                </li>
            }
        </ul>
    }
</div>

@code {
    /// <summary>A segment: its label, its value and, optionally, its colour; without one, the tone ladder from the ink down, four steps, so a fifth segment needs one.
    /// An icon goes before the label in the legend, about the text's height: a pixl icon at 14, or a flag.</summary>
    public sealed record Segment(string Label, double Value, string? Color = null, RenderFragment? Icon = null);

    [Parameter, EditorRequired] public IReadOnlyList<Segment> Segments { get; set; } = Array.Empty<Segment>();
    /// <summary>Cells across; 20 by default.</summary>
    [Parameter] public int Columns { get; set; } = 20;
    /// <summary>Cells down; 5 by default.</summary>
    [Parameter] public int Rows { get; set; } = 5;
    /// <summary>A cell's side in pixels; 4 by default, with a 2px gap.</summary>
    [Parameter] public int Cell { get; set; } = 4;
    /// <summary>The share as shown in the legend, from the fraction and the value; defaults to a whole percent.</summary>
    [Parameter] public Func<double, double, string>? Format { get; set; }
    /// <summary>The legend beneath the grid; on by default.</summary>
    [Parameter] public bool Legend { get; set; } = true;
    /// <summary>A name for assistive technology: "Portfolio by holding".</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }

    // Four steps apart enough to tell at 4px: lv6 is all but lv8 in both themes. A fifth segment
    // and on keep the last step, never back to the ink, so give them a colour to tell apart.
    private static readonly string[] Tones = { "var(--lv8)", "var(--lv5)", "var(--lv4)", "var(--lv3)" };

    // The segment under the pointer, from a cell or a legend entry, and the cell when it is one.
    private int? _segment, _cell;
    private void Leave() => (_segment, _cell) = (null, null);
    private void Hover(int cell, int segment)
    {
        if (segment < 0) { Leave(); return; }
        (_segment, _cell) = (segment, cell);
    }

    private double Sum => Segments.Sum(s => Math.Max(0, s.Value));
    private string ColorOf(int i) => Segments[i].Color ?? Tones[Math.Min(i, Tones.Length - 1)];
    private string Show(Segment s)
    {
        double fraction = Sum > 0 ? Math.Max(0, s.Value) / Sum : 0;
        return Format != null ? Format(fraction, s.Value) : $"{Math.Round(fraction * 100)} %";
    }

    /// <summary>Each segment's cells, by largest remainder, so they always sum to the grid. A segment
    /// with a share but a rounded count of zero still gets one cell, taken from the largest.</summary>
    public static int[] AllocateCells(double[] values, int total)
    {
        double sum = values.Sum(v => Math.Max(0, v));
        if (sum <= 0) return new int[values.Length];
        var exact = values.Select(v => Math.Max(0, v) / sum * total).ToArray();
        var cells = exact.Select(e => (int)Math.Floor(e)).ToArray();
        int left = total - cells.Sum();
        foreach (var i in Enumerable.Range(0, values.Length).OrderByDescending(i => exact[i] - Math.Floor(exact[i])))
        {
            if (left <= 0) break;
            cells[i]++;
            left--;
        }
        for (int i = 0; i < cells.Length; i++)
        {
            if (values[i] > 0 && cells[i] == 0)
            {
                int largest = Array.IndexOf(cells, cells.Max());
                if (cells[largest] > 1) { cells[largest]--; cells[i] = 1; }
            }
        }
        return cells;
    }
}
