@* Port of indx-systm Composer: the message field. Enter sends, Shift+Enter breaks the line; the
   field grows with its text up to MaxLines; over MaxLength it says so and Send waits. Send becomes Stop while an answer is in flight. Enter
   is read by the browser (a conditional preventDefault is not Blazor's), which clicks the Send
   button, so the send goes through the same handler as a click. The field grows as its text wraps
   (Composer.razor.js), not only on line breaks; Rows is the first render's height before that. *@
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="indx-composer-wrap">
<div class="indx-composer @Class @(Over ? "indx-composer-over" : null)">
    <div class="indx-composer-field">
        @if (!HideIcon)
        {
            <span class="indx-composer-icon" aria-hidden="true">
                @if (Icon != null) { @Icon(21) } else { <AiAgent Size="21" Color="currentColor" /> }
            </span>
        }
        <textarea @ref="_input" class="indx-composer-input" rows="@Rows" value="@Value" placeholder="@Placeholder" disabled="@Disabled" aria-label="@AriaLabel"
                  @oninput="OnInput" autofocus="@AutoFocus"
                  onkeydown="if(event.key==='Enter'&&!event.shiftKey&&!event.isComposing){event.preventDefault();this.closest('.indx-composer').querySelector('[data-send]')?.click();}"></textarea>
    </div>
    <div class="indx-composer-button">
        @if (Streaming)
        {
            <Button Variant="secondary" Size="micro" aria-label="Stop" IconLeft="_stop" @onclick="() => OnStop.InvokeAsync()" />
        }
        else
        {
            <Button Variant="primary" Size="micro" aria-label="Send" IconLeft="_send" Disabled="@(!CanSend)" data-send @onclick="SendAsync" />
        }
    </div>
</div>
@if (Over)
{
    <p class="indx-composer-note" role="status">@Value.Length.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) of @MaxLength.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) characters. Shorten it to send.</p>
}
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Called with the trimmed text on Enter or the send button. Not while Streaming.</summary>
    [Parameter] public EventCallback<string> OnSend { get; set; }
    /// <summary>Called by the Stop button, which replaces Send while Streaming.</summary>
    [Parameter] public EventCallback OnStop { get; set; }
    /// <summary>An answer is in flight: the send button becomes Stop and Enter does nothing.</summary>
    [Parameter] public bool Streaming { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Ask a question…";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AutoFocus { get; set; }
    /// <summary>Leading icon; the pixl AI agent by default. HideIcon leaves it out.</summary>
    [Parameter] public RenderFragment<int>? Icon { get; set; }
    [Parameter] public bool HideIcon { get; set; }
    /// <summary>Tallest the field grows before it scrolls, in lines.</summary>
    [Parameter] public int MaxLines { get; set; } = 6;
    /// <summary>Longest text that can be sent, in characters; 0 is no limit. Over it the field says
    /// so under itself and Send waits, so a limit the receiver enforces is never met as a silent
    /// refusal (19 Oct 2026: the Agent's question bounced back without a word).</summary>
    [Parameter] public int MaxLength { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Message";

    private static readonly RenderFragment<int> _send = size => @<ArrowUp Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _stop = size => @<Stop Size="size" Color="currentColor" />;

    private bool Over => MaxLength > 0 && Value.Length > MaxLength;
    private bool CanSend => !Streaming && !Disabled && !Over && !string.IsNullOrWhiteSpace(Value);
    private int Rows => Math.Clamp(Value.Count(c => c == '\n') + 1, 1, Math.Max(1, MaxLines));

    private const int Line = 18;          // the input's line-height
    private ElementReference _input;
    private IJSObjectReference? _module;
    private bool _disposed;
    private string? _typed;               // the text as the browser last sent it
    private string? _fitted;              // the text the height was last fitted to

    private Task OnInput(ChangeEventArgs e)
    {
        _typed = e.Value?.ToString() ?? "";
        return ValueChanged.InvokeAsync(_typed);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Indx.Systm.Blazor/Composer.razor.js");
                if (_disposed) { await module.DisposeAsync(); return; }
                _module = module;
                await _module.InvokeVoidAsync("init", _input, Line * Math.Max(1, MaxLines) + 12);
                _fitted = Value;
            }
            // Typing fits itself in the browser; refit only when the text came from .NET instead.
            else if (_module is not null && Value != _typed && Value != _fitted)
            {
                _fitted = Value;
                await _module.InvokeVoidAsync("fit", _input);
            }
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("dispose", _input);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (Exception) { }
    }

    private async Task SendAsync()
    {
        if (!CanSend) return;
        await OnSend.InvokeAsync(Value.Trim());
    }
}
