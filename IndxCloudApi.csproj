<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>aspnet-IndxCloudApi-753A8260-85A1-4678-9E16-CC33E76477FD</UserSecretsId>
		<!-- Indx.Systm.Blazor lives INSIDE this folder so it rides the git-subtree split to the
		     public repo, but it is its own project (referenced below) — keep its files out of
		     this app's own compile/content globs or every component gets compiled twice. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);Indx.Systm.Blazor/**</DefaultItemExcludes>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>IndxCloudApi.xml</DocumentationFile>

		<!-- Versioning (Semantic Versioning: MAJOR.MINOR.PATCH-PRERELEASE) -->
		<Version>2.0.0</Version>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<InformationalVersion>2.0.0-beta</InformationalVersion>

		<!-- License Information -->
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<Copyright>Copyright (c) 2026 Indx (Bionic AS)</Copyright>
		<!-- 1591: keep doc generation on (Swagger reads IndxCloudApi.xml) but don't warn on every
		     public member lacking an XML comment — the MCP models, BoostRule, etc. are self-describing. -->
		<NoWarn>$(NoWarn);MSTEST0001;BL0008;1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>

	<!-- Internal services (LicenseBootstrapper, NotificationService, …) are exercised
	     by the test project, which needs access to them. -->
	<ItemGroup>
		<InternalsVisibleTo Include="TestIndxCloudApi" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="IndxData\*.license" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<PropertyGroup Condition=" '$(RunConfiguration)' == 'IndxCloudApi' " />

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <NoWarn>1701;1702;CA2254;CS1998;MSTEST0001;BL0008;1591</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <NoWarn>1701;1702;CA2254;CS1998;MSTEST0001;BL0008;1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
		<PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.3" />
		<PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.3" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.3">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
		<PackageReference Include="NuGet.Packaging" Version="6.14.3" />
		<PackageReference Include="NuGet.Protocol" Version="6.14.3" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
		<PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="9.0.6" />
		<PackageReference Include="System.ServiceModel.Syndication" Version="10.0.3" />
		<!-- Pin MessagePack to 3.1.7 to remediate CVE-2026-48109 / GHSA-hv8m-jj95-wg3x (High: LZ4
		     decompression out-of-bounds read). HNSW transitively resolves the vulnerable 3.1.0
		     (directly in LocalDll mode, via the Indx engine otherwise); this higher reference wins
		     in every IndxReferenceMode. Patch-level bump within 3.1.x, so HNSW keeps working. -->
		<PackageReference Include="MessagePack" Version="3.1.7" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="Indx.Systm.Blazor\Indx.Systm.Blazor.csproj" />
	</ItemGroup>

	<!-- ===== Indx engine reference selection =====
	     Three modes, resolved into $(IndxReferenceMode):
	       Source  - ProjectReference to ..\Indx (full IndxSolutions checkout). Default for us.
	       NuGet   - obfuscated IndxSearchLib package. Default for the public IndxCloudApi repo.
	       LocalDll- a local obfuscated Indx.dll next to this .csproj. Testing only; opt-in.
	     Auto-detect: if the Indx source project is present we default to Source, otherwise NuGet.
	     Override explicitly with:  -p:IndxFromNuGet=true   or   -p:IndxFromLocalDll=true  -->
	<PropertyGroup>
	  <IndxReferenceMode Condition="'$(IndxFromLocalDll)' == 'true'">LocalDll</IndxReferenceMode>
	  <IndxReferenceMode Condition="'$(IndxReferenceMode)' == '' And '$(IndxFromNuGet)' == 'true'">NuGet</IndxReferenceMode>
	  <IndxReferenceMode Condition="'$(IndxReferenceMode)' == '' And Exists('../Indx/Indx.csproj')">Source</IndxReferenceMode>
	  <IndxReferenceMode Condition="'$(IndxReferenceMode)' == ''">NuGet</IndxReferenceMode>
	</PropertyGroup>

	<!-- Source build: project reference + SOURCE_BUILD constant -->
	<PropertyGroup Condition="'$(IndxReferenceMode)' == 'Source'">
	  <DefineConstants>$(DefineConstants);SOURCE_BUILD</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="'$(IndxReferenceMode)' == 'Source'">
	  <ProjectReference Include="..\Indx\Indx.csproj" />
	</ItemGroup>

	<!-- Obfuscated NuGet package -->
	<ItemGroup Condition="'$(IndxReferenceMode)' == 'NuGet'">
	  <PackageReference Include="IndxSearchLib" Version="5.0.0-beta2" />
	</ItemGroup>

	<!-- Local obfuscated DLL (testing only, opt-in: -p:IndxFromLocalDll=true).
	     A bare <Reference> does not restore the DLL's transitive NuGet dependencies,
	     so they are listed explicitly here (see IndxSearchLib.nuspec for the same set). -->
	<ItemGroup Condition="'$(IndxReferenceMode)' == 'LocalDll'">
	  <Reference Include="Indx">
	    <HintPath>Indx.dll</HintPath>
	  </Reference>
	  <PackageReference Include="NLog.Extensions.Logging" Version="6.0.0" />
	  <PackageReference Include="HNSW" Version="26.1.63669" />
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
	  <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
	</ItemGroup>

</Project>
