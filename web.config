<?xml version="1.0" encoding="utf-8"?>
<!-- Read only when the server runs under IIS (Windows App Service, an IIS host); Kestrel, Docker and
     Linux ignore it. dotnet publish adds the ASP.NET Core module section to this file.

     IIS refuses request bodies over 30,000,000 bytes (about 28.6 MB) before the app sees them, with
     its own 413 page. analyze, load and replace take a whole dataset in one body, so the limit is
     raised to IIS's own maximum, 4,294,967,295 bytes, and the server's setting decides below it
     (Indx:MaxUploadBytes, 2 GB by default, 6 Nov 2026; until then 2 GB here too). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="4294967295" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
