<?xml version="1.0" encoding="utf-8"?>
<!-- Read only when the server runs under IIS (Windows App Service, an IIS host); Kestrel, Docker and
     Linux ignore it. dotnet publish adds the ASP.NET Core module section to this file.

     IIS refuses request bodies over 30,000,000 bytes (about 28.6 MB) before the app sees them, with
     its own 413 page. analyze, load and replace take a whole dataset in one body, so the limit is
     raised to the 2 GB the server allows (MaxRequestBodySize in StartupServices). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="2000000000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
