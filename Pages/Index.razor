                                    <div class="indx-search-field-wrap">
                                        <span class="indx-search-field-icon"><Search Size="16" /></span>
                                        <input class="indx-search-field-input"
                                               type="search"
                                               placeholder="@($"Search {datasetName}")"
                                               value="@(_searchTexts.GetValueOrDefault(datasetName, string.Empty))"
                                               @oninput="@(e => RunQuickSearch(datasetName, ownerUserId, e.Value?.ToString() ?? string.Empty))" />
                                        @if (!string.IsNullOrEmpty(_searchTexts.GetValueOrDefault(datasetName)))
                                        {
                                            <div class="indx-search-clear">
                                                <Button Variant="ghost" Size="micro" @onclick="@(() => ClearSearch(datasetName))">Clear</Button>
                                            </div>
                                        }
                                    </div>
                                    @if (_searchResults.TryGetValue(datasetName, out var results) && results != null)
