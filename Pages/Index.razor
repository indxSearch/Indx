@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using System.Reflection
@using Indx.Api
@using Indx.Storage
@using Indx.Utilities
@using IndxCloudApi.Data
@using IndxCloudApi.Models
@using IndxCloudApi.Services
@using System.Globalization
@using System.Text.Json
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IndxCloudApi.Services.ActiveTeamState ActiveTeam
@inject Microsoft.AspNetCore.Identity.UI.Services.IEmailSender EmailSender
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Indx Cloud API</PageTitle>

<div class="indx-datasets-heading">
    <h2>Datasets</h2>
    <TeamSwitcher />
    @if (!isLoading)
    {
        @if (_showNewDatasetForm)
        {
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <input class="indx-text-input" placeholder="Dataset name" value="@_newDatasetName" @oninput="e => _newDatasetName = e.Value?.ToString() ?? string.Empty" @onkeydown="OnNewDatasetKeyDown" />
                <Button Variant="primary" Size="micro" @onclick="CreateDataset" disabled="@string.IsNullOrWhiteSpace(_newDatasetName)">Create</Button>
                <Button Variant="secondary" Size="micro" @onclick="() => { _showNewDatasetForm = false; _newDatasetName = string.Empty; _createError = null; }">Cancel</Button>
            </div>
            @if (!string.IsNullOrEmpty(_createError))
            {
                <p style="color:var(--CSignal);margin-top:4px;margin-bottom:0;">@_createError</p>
            }
        }
        else
        {
            <Button Variant="secondary" Size="micro" IconLeft="_iconPanelAdd" @onclick="() => _showNewDatasetForm = true">New dataset</Button>
        }
    }
</div>

@if (isLoading)
{
    <p>Loading datasets...</p>
}
else
{

    @if (datasets == null || datasets.Length == 0)
    {
        <div style="margin-top: 40px; max-width: 520px;">
            <p style="color: var(--lv5); margin-bottom: 20px;">A dataset holds your JSON documents and search index. Create one here to get started.</p>
            <Button Variant="primary" Size="default" @onclick="() => _showNewDatasetForm = true">Create your first dataset</Button>

            <div style="margin-top: 24px;">
                <p style="color: var(--lv5); margin-bottom: 8px;">Using an LLM to set up your search? Get the skill.</p>
                <Button Variant="secondary" Size="micro" IconLeft="_iconAgent" Href="https://www.skills.sh/indxsearch/skill-indx-search/indx-search">Indx Agent Skill ↗</Button>
            </div>
        </div>
    }
    else
    {
        <Tabs Items="@AllDatasetTabItems()"
              @bind-Active="selectedDataset" />

        @if (selectedDataset != null)
        {
            var datasetName = GetDatasetName(selectedDataset);
            // Owner key is the active team id; the legacy role strings (owner/editor/viewer) are
            // derived from the user's team role (Admin->owner, Editor->editor, Viewer->viewer) so
            // the existing permission checks in this view keep working unchanged.
            var ownerUserId = activeTeamId ?? "";
            var isAdmin = TeamRoles.CanAdmin(activeRole);
            var isEditor = TeamRoles.CanWrite(activeRole);
            var status = datasetStatuses.ContainsKey(selectedDataset) ? datasetStatuses[selectedDataset] : null;
            var engineState = status?.SystemState ?? SystemState.Created;
            var isSaving = _savingDataset == datasetName;
            var isUploading = _uploadingDataset == datasetName;
            var isLoadIndexing = _loadIndexingDataset == datasetName;
            var isAnalyzed = _bufferedFiles.ContainsKey(datasetName);
            var activeTab = _datasetTabs.GetValueOrDefault(selectedDataset, "fields");
            // A Created engine with records persisted on disk is hibernated (manual datasets stay
            // this way until woken; timed/pinned wake themselves on access), not an empty dataset.
            var recordCount = _keepAlive.GetValueOrDefault(datasetName)?.RecordCount ?? 0;
            var isHibernated = engineState == SystemState.Created && recordCount > 0;

            <div class="indx-dataset-card">
                <div class="indx-dataset-card-inner">
                    <Surface Transparent>

                        @* ── Status table (always shown when status is available) ── *@
                        @if (status != null)
                        {
                            <div class="indx-status-wrap">
                                <table class="indx-status-table">
                                    <tbody>
                                        <tr>
                                            <td>System State</td>
                                            <td style="display:flex; gap:6px; align-items:center;">
                                                @if (isHibernated)
                                                {
                                                    <Chip Size="large" Color="var(--CLightBlue)" TextColor="#080809" Icon="_iconHibernate">Hibernated</Chip>
                                                }
                                                else
                                                {
                                                    <Chip Size="large" Color="@StateChipColor(engineState)" TextColor="@StateChipTextColor(engineState)" Icon="@StateChipIcon(engineState)">@status.SystemState</Chip>
                                                }
                                                @if (isSaving && engineState == SystemState.Ready)
                                                {
                                                    <Chip Size="large" Color="var(--lv8)" TextColor="var(--lv0)">Shadow indexing</Chip>
                                                }
                                            </td>
                                        </tr>
                                        @if (engineState == SystemState.Ready)
                                        {
                                            <tr><td>Document Count</td><td>@status.DocumentCount</td></tr>
                                            <tr><td>Search Counter</td><td>@status.SearchCounter</td></tr>
                                            <tr><td>Seconds To Index</td><td>@status.SecondsToIndex.ToString("0.##")s</td></tr>
                                            <tr><td>Instance Created</td><td>@TimeAgo(status.TimeOfInstanceCreation)</td></tr>
                                            <tr><td>Last Index Build</td><td>@TimeAgo(status.TimeOfLastIndexBuild)</td></tr>
                                            @if (status.LicenseInfo?.DocumentLimitExceeded == true)
                                            {
                                                <tr><td style="color:var(--CSignal);">License Limit</td><td style="color:var(--CSignal);">@status.DocumentCount.ToString("N0") / @status.LicenseInfo.DocumentLimit.ToString("N0")</td></tr>
                                            }
                                            @if (status.InvalidArgument)
                                            {
                                                <tr><td style="color:var(--CSignal);">Invalid Argument</td><td>@status.InvalidArgument</td></tr>
                                            }
                                            @if (status.InvalidState)
                                            {
                                                <tr><td style="color:var(--CSignal);">Invalid State</td><td>@status.InvalidState</td></tr>
                                            }
                                            @if (status.TooLongClientText)
                                            {
                                                <tr><td style="color:var(--CSignal);">Too Long Client Text</td><td>@status.TooLongClientText</td></tr>
                                            }
                                            @if (status.TooLongSearchText)
                                            {
                                                <tr><td style="color:var(--CSignal);">Too Long Search Text</td><td>@status.TooLongSearchText</td></tr>
                                            }
                                            @if (status.UnknownConfigurationError)
                                            {
                                                <tr><td style="color:var(--CSignal);">Config Error</td><td>@status.UnknownConfigurationError</td></tr>
                                            }
                                            @if (!string.IsNullOrEmpty(status.ErrorMessage))
                                            {
                                                <tr><td style="color:var(--CSignal);">Error</td><td>@status.ErrorMessage</td></tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }


                        @* ── Dataset tab nav (hidden when hibernated: that view is just Wake up /
                              Delete, no tabs — the user lands here directly after Hibernate now) ── *@
                        @if (engineState == SystemState.Ready || (isAnalyzed && !isLoadIndexing && isEditor))
                        {
                            <nav class="indx-dataset-nav">
                                <Button Variant="@(activeTab == "fields" ? "primary" : "ghost")" Size="micro" IconLeft="_iconFields" @onclick="@(() => _datasetTabs[selectedDataset] = "fields")">Field configuration</Button>
                                @if (engineState == SystemState.Ready)
                                {
                                    <Button Variant="@(activeTab == "search" ? "primary" : "ghost")" Size="micro" IconLeft="_iconSearch" @onclick="@(() => _datasetTabs[selectedDataset] = "search")">Search preview</Button>
                                }
                                @if (isAdmin)
                                {
                                    <Button Variant="@(activeTab == "options" ? "primary" : "ghost")" Size="micro" IconLeft="_iconSliders" @onclick="@(() => _datasetTabs[selectedDataset] = "options")">Options</Button>
                                }
                            </nav>
                        }

                        @* ════════════════════════════════════════
                   Tab: Field configuration
                   ════════════════════════════════════════ *@
                        @if (activeTab == "fields")
                        {
                            @* ── Loading / Indexing in progress (navigated back while engine is busy) ── *@
                            @if ((engineState is SystemState.Loading or SystemState.Loaded or SystemState.Indexing) && !isLoadIndexing)
                            {
                                <div class="indx-field-config-saving" style="margin-top:16px;">
                                    <p class="indx-field-config-saving-label">
                                        @(engineState == SystemState.Indexing ? "Indexing in progress…" : "Loading in progress…")
                                    </p>
                                </div>
                            }

                            @* ── Hibernated (data on disk, engine not loaded) or empty (needs upload) ── *@
                            @if (engineState == SystemState.Created && !isAnalyzed && !isUploading && !isLoadIndexing && isEditor)
                            {
                                @if (isHibernated)
                                {
                                    <p style="color:var(--lv5);margin-top:16px;max-width:560px;">
                                        This dataset is <strong>hibernated</strong> — @recordCount.ToString("N0") document@(recordCount == 1 ? "" : "s") @(recordCount == 1 ? "is" : "are") stored on disk but not loaded into memory. Wake it to search and edit.
                                    </p>
                                    <div style="display:flex;gap:8px;align-items:center;margin-top:8px;">
                                        <Button Variant="primary" Size="micro" IconLeft="_iconEye" @onclick="() => StartWake(datasetName)">Wake up</Button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_uploadError) && _uploadErrorDataset == datasetName)
                                    {
                                        <p style="color:var(--CSignal);margin-top:4px;">@_uploadError</p>
                                    }
                                }
                                else
                                {
                                    <p style="color:var(--lv5);margin-top:16px;">Upload a JSON file to configure and index this dataset.</p>
                                    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px;">
                                        <InputFile OnChange="@(e => OnFileSelected(datasetName, e))" accept=".json" style="display:none" id="@($"fileinput-{datasetName}")" />
                                        <label for="@($"fileinput-{datasetName}")" class="indx-upload-label">
                                            <Json Size="14" />
                                            @if (_selectedFile != null && _selectedFileDataset == datasetName)
                                            {
                                                <span>@_selectedFile.Name (@FormatBytes(_selectedFile.Size))</span>
                                            }
                                            else
                                            {
                                                <span>Choose JSON file…</span>
                                            }
                                        </label>
                                        @if (_selectedFile != null && _selectedFileDataset == datasetName)
                                        {
                                            <Button Variant="primary" Size="micro" @onclick="() => StartUpload(datasetName)">Upload</Button>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(_uploadError) && _uploadErrorDataset == datasetName)
                                    {
                                        <p style="color:var(--CSignal);margin-top:4px;">@_uploadError</p>
                                    }
                                }
                                <div style="margin-top:16px;">
                                    @if (deleteConfirmDataset == datasetName)
                                    {
                                        <div style="display:flex;gap:8px;align-items:center;">
                                            <span style="font:var(--text-xs);color:var(--lv5);">Are you sure?</span>
                                            <Button Variant="danger" Size="micro" @onclick="() => ConfirmDelete(datasetName)">Yes, Delete</Button>
                                            <Button Variant="secondary" Size="micro" @onclick="CancelDelete">Cancel</Button>
                                        </div>
                                    }
                                    else
                                    {
                                        <Button Variant="ghost" Size="micro" IconLeft="_iconDelete" @onclick="() => ShowDeleteConfirm(datasetName)">Delete dataset</Button>
                                    }
                                </div>
                            }

                            @* ── Uploading progress ── *@
                            @if (isUploading)
                            {
                                <div class="indx-field-config-saving">
                                    <ProgressBar Value="@_uploadProgress" ShowLabel FulfilledColor />
                                    <p class="indx-field-config-saving-label">Uploading…</p>
                                    <Button Variant="secondary" Size="micro" @onclick="CancelUpload">Cancel</Button>
                                </div>
                            }

                            @* ── Analyzed: configure + Load and Index ── *@
                            @if (engineState != SystemState.Ready && isAnalyzed && !isUploading && !isLoadIndexing)
                            {
                                @if (_editedFieldConfigs.TryGetValue(datasetName, out var editedFields) && editedFields != null)
                                {
                                    <div class="indx-field-config-toolbar">
                                        <Button Variant="primary" Size="micro"
                                                @onclick="() => StartLoadAndIndex(datasetName)"
                                                disabled="@(!HasSearchable(datasetName))">
                                            Load and Index
                                        </Button>
                                        @if (_searchableTouched.Contains(datasetName) && !HasSearchable(datasetName))
                                        {
                                            <span class="indx-field-config-error">At least one field must be searchable</span>
                                        }
                                        <span style="margin-left:auto;display:flex;gap:16px;align-items:center;">
                                            <ToggleSwitch Checked="@_showUnusedFields.Contains(datasetName)"
                                                          CheckedChanged="@(v => { if (v) _showUnusedFields.Add(datasetName); else _showUnusedFields.Remove(datasetName); })"
                                                          Label="Show unused fields"
                                                          Elevated />
                                            <ToggleSwitch Checked="@_showAdvancedFields.Contains(datasetName)"
                                                          CheckedChanged="@(v => { if (v) _showAdvancedFields.Add(datasetName); else _showAdvancedFields.Remove(datasetName); })"
                                                          Label="Show advanced settings"
                                                          Elevated />
                                        </span>
                                    </div>
                                    <div class="indx-table-wrap">
                                        <table class="indx-table">
                                            <thead>
                                                <tr>
                                                    <th>Field and type</th>
                                                    <th><span class="indx-th-tip" data-tooltip="Included in full-text search. At least one field must be searchable.">Searchable</span></th>
                                                    <th><span class="indx-th-tip" data-tooltip="Can be used to filter results by exact value or range.">Filterable</span></th>
                                                    <th><span class="indx-th-tip" data-tooltip="Field values are counted and returned as facets for building filter UI.">Facetable</span></th>
                                                    <th><span class="indx-th-tip" data-tooltip="Results can be sorted by this field's value.">Sortable</span></th>
                                                    @if (_showAdvancedFields.Contains(datasetName))
                                                    {
                                                        <th><span class="indx-th-tip" data-tooltip="Enables word-level matching. Useful for categories, tags, and enum values.">WordIndexing</span></th>
                                                        <th><span class="indx-th-tip" data-tooltip="Field is included in vector embeddings for semantic and AI-powered search.">Embeddable</span></th>
                                                        <th><span class="indx-th-tip" data-tooltip="Filter bitsets are pre-computed at load time for faster filtering on large datasets.">PreloadFilters</span></th>
                                                        <th><span class="indx-th-tip" data-tooltip="Sharper matching for run-together or split-word queries. Coverage already matches these; high resolution improves precision — recommended only for key fields such as titles.">HighResolution</span></th>
                                                    }
                                                    <th><span class="indx-th-tip" data-tooltip="Relevance weight for this field (recommended range 0.5–3.0). Typical: title 3.0, heading 2.0, metadata 1.5, body 1.0.">Weight</span></th>
                                                    @if (_showAdvancedFields.Contains(datasetName))
                                                    {
                                                        <th><span class="indx-th-tip" data-tooltip="BM25F length normalisation (0–1). Higher values penalise longer fields more. Activates BM25F multi-field scoring.">BM25b</span></th>
                                                        <th><span class="indx-th-tip" data-tooltip="BM25F term saturation factor. Higher values give more weight to repeated terms in this field.">BM25k1</span></th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var field in editedFields.Where(f => _showUnusedFields.Contains(datasetName) || !IsUnused(f)))
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="cell-inner">
                                                                <span>@field.FieldName</span>
                                                                @if (field.FieldType != null)
                                                                {
                                                                    <span class="cell-value">@(field.FieldType + (field.IsArray == true ? "[]" : ""))</span>
                                                                }
                                                            </div>
                                                        </td>
                                                        <td class="indx-table-check"><Checkbox Checked="@(field.Searchable == true)" CheckedChanged="@(v => { field.Searchable = v; _searchableTouched.Add(datasetName); })" /></td>
                                                        <td class="indx-table-check"><Checkbox Checked="@(field.Filterable == true)" CheckedChanged="@(v => { field.Filterable = v; })" /></td>
                                                        <td class="indx-table-check"><Checkbox Checked="@(field.Facetable == true)" CheckedChanged="@(v => { field.Facetable = v; })" /></td>
                                                        <td class="indx-table-check"><Checkbox Checked="@(field.Sortable == true)" CheckedChanged="@(v => { field.Sortable = v; })" /></td>
                                                        @if (_showAdvancedFields.Contains(datasetName))
                                                        {
                                                            <td class="indx-table-check"><Checkbox Checked="@(field.WordIndexing == true)" CheckedChanged="@(v => { field.WordIndexing = v; })" /></td>
                                                            <td class="indx-table-check"><Checkbox Checked="@(field.Embeddable == true)" CheckedChanged="@(v => { field.Embeddable = v; })" /></td>
                                                            <td class="indx-table-check"><Checkbox Checked="@(field.PreloadFilters == true)" CheckedChanged="@(v => { field.PreloadFilters = v; })" /></td>
                                                            <td class="indx-table-check"><Checkbox Checked="@(field.HighResolution == true)" CheckedChanged="@(v => { field.HighResolution = v; })" /></td>
                                                        }
                                                        <td>
                                                            <input class="indx-num-input" type="number" step="0.1" min="0"
                                                                   value="@(field.Weight.HasValue ? field.Weight.Value.ToString("0.0##", CultureInfo.InvariantCulture) : "")"
                                                                   @onchange="@(e => { field.Weight = ParseFloat(e.Value?.ToString()); })" />
                                                        </td>
                                                        @if (_showAdvancedFields.Contains(datasetName))
                                                        {
                                                            <td>
                                                                <input class="indx-num-input" type="number" step="0.01" min="0" max="1"
                                                                       value="@(field.BM25b.HasValue ? field.BM25b.Value.ToString("G4", CultureInfo.InvariantCulture) : "")"
                                                                       @onchange="@(e => { field.BM25b = ParseFloat(e.Value?.ToString()); })" />
                                                            </td>
                                                            <td>
                                                                <input class="indx-num-input" type="number" step="0.1" min="0"
                                                                       value="@(field.BM25k1.HasValue ? field.BM25k1.Value.ToString("G4", CultureInfo.InvariantCulture) : "")"
                                                                       @onchange="@(e => { field.BM25k1 = ParseFloat(e.Value?.ToString()); })" />
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div style="display:flex;gap:8px;align-items:center;margin-top:8px;margin-bottom:8px;flex-wrap:wrap;">
                                        <InputFile OnChange="@(e => ImportFieldConfig(datasetName, e))" accept=".json" style="display:none" id="@($"fieldconfig-import-{datasetName}")" />
                                        <Button Variant="ghost" Size="micro" IconLeft="_iconDynamicJson" @onclick="() => TriggerImportFile(datasetName)">Upload field configuration</Button>
                                        @if (_importWarnings.TryGetValue(datasetName, out var warning) && warning != null)
                                        {
                                            <span class="indx-field-config-import-warning">@warning</span>
                                        }
                                        <Button Variant="ghost" Size="micro" IconLeft="_iconDownload" @onclick="() => ExportFieldConfig(datasetName)">Export field configuration as json</Button>
                                    </div>
                                }
                            }

                            @* ── Load & Index progress ── *@
                            @if (isLoadIndexing)
                            {
                                <div class="indx-field-config-saving">
                                    <ProgressBar Value="_loadProgress" ShowLabel FulfilledColor />
                                    <p class="indx-field-config-saving-label">Loading…</p>
                                </div>
                                @if (_isIndexingPhase)
                                {
                                    <div class="indx-field-config-saving">
                                        <ProgressBar Value="_indexProgress" ShowLabel FulfilledColor />
                                        <p class="indx-field-config-saving-label">Indexing…</p>
                                    </div>
                                }
                            }

                            @* ── Ready: field config table ── *@
                            @if (engineState == SystemState.Ready)
                            {
                                @if (!isSaving)
                                {
                                    <div class="indx-field-config-toolbar">
                                        @if (isEditor && IsDirty(datasetName))
                                        {
                                            <Button Variant="primary" Size="micro" @onclick="() => SaveFieldConfig(datasetName, ownerUserId)" disabled="@(!HasSearchable(datasetName))">Save</Button>
                                            <Button Variant="secondary" Size="micro" @onclick="() => CancelFieldConfig(datasetName)">Cancel</Button>
                                            @if (_searchableTouched.Contains(datasetName) && !HasSearchable(datasetName))
                                            {
                                                <span class="indx-field-config-error">At least one field must be searchable</span>
                                            }
                                        }
                                        <span style="margin-left:auto;display:flex;gap:16px;align-items:center;">
                                            <ToggleSwitch Checked="@_showUnusedFields.Contains(datasetName)"
                                                          CheckedChanged="@(v => { if (v) _showUnusedFields.Add(datasetName); else _showUnusedFields.Remove(datasetName); })"
                                                          Label="Show unused fields"
                                                          Elevated />
                                            <ToggleSwitch Checked="@_showAdvancedFields.Contains(datasetName)"
                                                          CheckedChanged="@(v => { if (v) _showAdvancedFields.Add(datasetName); else _showAdvancedFields.Remove(datasetName); })"
                                                          Label="Show advanced settings"
                                                          Elevated />
                                        </span>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(_saveError) && _saveErrorDataset == datasetName)
                                {
                                    <p style="color:var(--CSignal);margin-top:4px;">@_saveError</p>
                                }

                                @if (isSaving)
                                {
                                    <div class="indx-field-config-saving">
                                        <ProgressBar Value="_shadowBuildPercent" ShowLabel FulfilledColor />
                                        <p class="indx-field-config-saving-label">@(_shadowBuildPercent == 0 ? "Preparing…" : "Reindexing…")</p>
                                    </div>
                                }

                                @if (!isSaving)
                                {
                                    @if (_editedFieldConfigs.TryGetValue(datasetName, out var readyFields) && readyFields != null)
                                    {
                                        <div class="indx-table-wrap">
                                            <table class="indx-table">
                                                <thead>
                                                    <tr>
                                                        <th>Field and type</th>
                                                        <th><span class="indx-th-tip" data-tooltip="Included in full-text search. At least one field must be searchable.">Searchable</span></th>
                                                        <th><span class="indx-th-tip" data-tooltip="Can be used to filter results by exact value or range.">Filterable</span></th>
                                                        <th><span class="indx-th-tip" data-tooltip="Field values are counted and returned as facets for building filter UI.">Facetable</span></th>
                                                        <th><span class="indx-th-tip" data-tooltip="Results can be sorted by this field's value.">Sortable</span></th>
                                                        @if (_showAdvancedFields.Contains(datasetName))
                                                        {
                                                            <th><span class="indx-th-tip" data-tooltip="Enables word-level matching. Useful for categories, tags, and enum values.">WordIndexing</span></th>
                                                            <th><span class="indx-th-tip" data-tooltip="Field is included in vector embeddings for semantic and AI-powered search.">Embeddable</span></th>
                                                            <th><span class="indx-th-tip" data-tooltip="Filter bitsets are pre-computed at load time for faster filtering on large datasets.">PreloadFilters</span></th>
                                                            <th><span class="indx-th-tip" data-tooltip="Sharper matching for run-together or split-word queries. Coverage already matches these; high resolution improves precision — recommended only for key fields such as titles.">HighResolution</span></th>
                                                        }
                                                        <th><span class="indx-th-tip" data-tooltip="Relevance weight for this field (recommended range 0.5–3.0). Typical: title 3.0, heading 2.0, metadata 1.5, body 1.0.">Weight</span></th>
                                                        @if (_showAdvancedFields.Contains(datasetName))
                                                        {
                                                            <th><span class="indx-th-tip" data-tooltip="BM25F length normalisation (0–1). Higher values penalise longer fields more. Activates BM25F multi-field scoring.">BM25b</span></th>
                                                            <th><span class="indx-th-tip" data-tooltip="BM25F term saturation factor. Higher values give more weight to repeated terms in this field.">BM25k1</span></th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var field in readyFields.Where(f => _showUnusedFields.Contains(datasetName) || !IsUnused(f)))
                                                    {
                                                        <tr title="@(!isEditor ? "Read-only — editor access is required to change field configuration" : null)">
                                                            <td>
                                                                <div class="cell-inner">
                                                                    <span>@field.FieldName</span>
                                                                    @if (field.FieldType != null)
                                                                    {
                                                                        <span class="cell-value">@(field.FieldType + (field.IsArray == true ? "[]" : ""))</span>
                                                                    }
                                                                </div>
                                                            </td>
                                                            <td class="indx-table-check"><Checkbox Checked="@(field.Searchable == true)" CheckedChanged="@(v => { field.Searchable = v; _searchableTouched.Add(datasetName); })" Disabled="@(!isEditor)" /></td>
                                                            <td class="indx-table-check"><Checkbox Checked="@(field.Filterable == true)" CheckedChanged="@(v => { field.Filterable = v; })" Disabled="@(!isEditor)" /></td>
                                                            <td class="indx-table-check"><Checkbox Checked="@(field.Facetable == true)" CheckedChanged="@(v => { field.Facetable = v; })" Disabled="@(!isEditor)" /></td>
                                                            <td class="indx-table-check"><Checkbox Checked="@(field.Sortable == true)" CheckedChanged="@(v => { field.Sortable = v; })" Disabled="@(!isEditor)" /></td>
                                                            @if (_showAdvancedFields.Contains(datasetName))
                                                            {
                                                                <td class="indx-table-check"><Checkbox Checked="@(field.WordIndexing == true)" CheckedChanged="@(v => { field.WordIndexing = v; })" Disabled="@(!isEditor)" /></td>
                                                                <td class="indx-table-check"><Checkbox Checked="@(field.Embeddable == true)" CheckedChanged="@(v => { field.Embeddable = v; })" Disabled="@(!isEditor)" /></td>
                                                                <td class="indx-table-check"><Checkbox Checked="@(field.PreloadFilters == true)" CheckedChanged="@(v => { field.PreloadFilters = v; })" Disabled="@(!isEditor)" /></td>
                                                                <td class="indx-table-check"><Checkbox Checked="@(field.HighResolution == true)" CheckedChanged="@(v => { field.HighResolution = v; })" Disabled="@(!isEditor)" /></td>
                                                            }
                                                            <td>
                                                                <input class="indx-num-input" type="number" step="0.1" min="0" disabled="@(!isEditor)"
                                                                       value="@(field.Weight.HasValue ? field.Weight.Value.ToString("0.0##", CultureInfo.InvariantCulture) : "")"
                                                                       @onchange="@(e => { field.Weight = ParseFloat(e.Value?.ToString()); })" />
                                                            </td>
                                                            @if (_showAdvancedFields.Contains(datasetName))
                                                            {
                                                                <td>
                                                                    <input class="indx-num-input" type="number" step="0.01" min="0" max="1" disabled="@(!isEditor)"
                                                                           value="@(field.BM25b.HasValue ? field.BM25b.Value.ToString("G4", CultureInfo.InvariantCulture) : "")"
                                                                           @onchange="@(e => { field.BM25b = ParseFloat(e.Value?.ToString()); })" />
                                                                </td>
                                                                <td>
                                                                    <input class="indx-num-input" type="number" step="0.1" min="0" disabled="@(!isEditor)"
                                                                           value="@(field.BM25k1.HasValue ? field.BM25k1.Value.ToString("G4", CultureInfo.InvariantCulture) : "")"
                                                                           @onchange="@(e => { field.BM25k1 = ParseFloat(e.Value?.ToString()); })" />
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <div style="display:flex;gap:8px;align-items:center;margin-top:8px;flex-wrap:wrap;">
                                            <Button Variant="ghost" Size="micro" IconLeft="_iconDownload" @onclick="() => ExportFieldConfig(datasetName)">Export field configuration as json</Button>
                                            @if (isEditor)
                                            {
                                                <InputFile OnChange="@(e => ImportFieldConfig(datasetName, e))" accept=".json" style="display:none" id="@($"fieldconfig-import-ready-{datasetName}")" />
                                                <Button Variant="ghost" Size="micro" IconLeft="_iconDynamicJson" @onclick="() => TriggerImportReadyFile(datasetName)">Upload field configuration</Button>
                                                @if (_importWarnings.TryGetValue(datasetName, out var readyWarning) && readyWarning != null)
                                                {
                                                    <span class="indx-field-config-import-warning">@readyWarning</span>
                                                }
                                            }
                                        </div>
                                    }
                                }
                            }
                        }

