ZM144.57 145.003H145.07V116.203H144.57H144.07V145.003H144.57ZM144.57 116.203V116.703H173.284V116.203V115.703H144.57V116.203ZM173.284 116.203H172.784V145.003H173.284H173.784V116.203H173.284ZM29.7139 116.198V115.698H1V116.198V116.698H29.7139V116.198ZM1 116.198H1.5V87.3984H1H0.5V116.198H1ZM1 87.3984V87.8984H29.7139V87.3984V86.8984H1V87.3984ZM29.7139 87.3984H29.2139V116.198H29.7139H30.2139V87.3984H29.7139ZM202.003 116.198V115.698H173.289V116.198V116.698H202.003V116.198ZM173.289 116.198H173.789V87.3984H173.289H172.789V116.198H173.289ZM173.289 87.3984V87.8984H202.003V87.3984V86.8984H173.289V87.3984ZM202.003 87.3984H201.503V116.198H202.003H202.503V87.3984H202.003ZM144.565 87.4014V86.9014H58.4297V87.4014V87.9014H144.565V87.4014ZM58.4297 87.4014H58.9297V58.6016H58.4297H57.9297V87.4014H58.4297ZM58.4297 58.6016V59.1016H144.565V58.6016V58.1016H58.4297V58.6016ZM144.565 58.6016H144.065V87.4014H144.565H145.065V58.6016H144.565ZM58.4248 29.7998V29.2998H29.7139V29.7998V30.2998H58.4248V29.7998ZM29.7139 29.7998H29.2139V58.5967H29.7139H30.2139V29.7998H29.7139ZM29.7139 58.5967V58.0967H1V58.5967V59.0967H29.7139V58.5967ZM1 58.5967H1.5V29.7969H1H0.5V58.5967H1ZM1 29.7969V30.2969H29.7109V29.7969V29.2969H1V29.7969ZM29.7109 29.7969H30.2109V1H29.7109H29.2109V29.7969H29.7109ZM29.7109 1V1.5H58.4248V1V0.5H29.7109V1ZM58.4248 1H57.9248V29.7998H58.4248H58.9248V1H58.4248ZM202.003 58.5967V58.0967H173.289V58.5967V59.0967H202.003V58.5967ZM173.289 58.5967H173.789V29.7969H173.289H172.789V58.5967H173.289ZM173.289 29.7969V30.2969H202.003V29.7969V29.2969H173.289V29.7969ZM202.003 29.7969H201.503V58.5967H202.003H202.503V29.7969H202.003ZM173.284 29.7998V29.2998H144.57V29.7998V30.2998H173.284V29.7998ZM144.57 29.7998H145.07V1H144.57H144.07V29.7998H144.57ZM144.57 1V1.5H173.284V1V0.5H144.57V1ZM173.284 1H172.784V29.7998H173.284H173.784V1H173.284Z" fill="currentColor" />
                                        </svg>
                                    }
                                    <div class="indx-search-field-wrap">
                                        <span class="indx-search-field-icon"><Search Size="16" /></span>
                                        <input class="indx-search-field-input"
                                               type="search"
                                               placeholder="@($"Search {datasetName}")"
                                               value="@(_searchTexts.GetValueOrDefault(datasetName, string.Empty))"
                                               @oninput="@(e => RunQuickSearch(datasetName, ownerUserId, e.Value?.ToString() ?? string.Empty))" />
                                        @if (!string.IsNullOrEmpty(_searchTexts.GetValueOrDefault(datasetName)))
                                        {
                                            <div class="indx-search-clear">
                                                <Button Variant="ghost" Size="micro" @onclick="@(() => ClearSearch(datasetName))">Clear</Button>
                                            </div>
                                        }
                                    </div>
                                    @if (_searchResults.TryGetValue(datasetName, out var results) && results != null)
                                    {
                                        @if (results.Count == 0 && !string.IsNullOrEmpty(_searchTexts.GetValueOrDefault(datasetName)))
                                        {
                                            <p class="indx-search-empty">No results</p>
                                        }
                                        else if (results.Count > 0)
                                        {
                                            <div class="indx-search-results">
                                                @foreach (var hit in results)
                                                {
                                                    <div class="indx-search-result-item" style="display:flex; align-items:baseline; gap:12px;">
                                                        <span style="flex:1; min-width:0; display:flex; flex-wrap:wrap; gap:8px;">
                                                            @foreach (var prop in GetDisplayFields(datasetName, hit.Doc))
                                                            {
                                                                <span class="indx-search-result-field"><span class="indx-search-result-key">@prop.Name</span> @prop.Value</span>
                                                            }
                                                        </span>
                                                        <span class="indx-search-result-score" title="Relevance score" style="flex:none; font-variant-numeric:tabular-nums; color:var(--lv4); font:var(--text-xs); white-space:nowrap;">@hit.Score</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="indx-perf-toolbar">
                                                <Button Variant="ghost" Size="micro" IconLeft="_iconSpeedometer"
                                                        disabled="@_perfRunning.Contains(datasetName)"
                                                        @onclick="@(() => RunPerfTest(datasetName, ownerUserId, _searchTexts.GetValueOrDefault(datasetName, string.Empty)))">
                                                    @(_perfRunning.Contains(datasetName) ? "Running…" : "Run performance benchmark")
                                                </Button>
                                                @if (_perfResults.TryGetValue(datasetName, out var perf) && perf != null)
                                                {
                                                    <span class="indx-perf-result">@perf.Iterations× — avg <strong>@perf.AvgMs.ToString("0.0") ms</strong></span>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <p style="color:var(--lv5);margin-top:16px;">Index your dataset first to enable search preview.</p>
                            }
                        }

                        @* ════════════════════════════════════════
                   Tab: Options (owned only)
                   ════════════════════════════════════════ *@
                        @if (activeTab == "options")
                        {
                            <div style="margin-top:8px;">

                                @* ── Description (domain context for AI agents over MCP) ── *@
                                @if (isEditor)
                                {
                                    EnsureDescriptionLoaded(datasetName, ownerUserId);
                                    <h3 style="margin-top:8px;margin-bottom:6px;">Description</h3>
                                    <p style="color:var(--lv5);font:var(--text-xs);margin-bottom:8px;max-width:560px;">
                                        Domain context shown to AI agents that use this dataset over MCP (<code>describe_dataset</code>) — e.g. what the records are and what key fields mean.
                                    </p>
                                    <div style="max-width:560px;">
                                        <Textarea @bind-Value="_descEdit[datasetName]" Rows="3" placeholder="What is this dataset? Any field caveats an agent should know?" />
                                    </div>
                                    @if (DescriptionDirty(datasetName))
                                    {
                                        <div style="display:flex;gap:8px;margin-top:8px;">
                                            <Button Variant="primary" Size="micro" IconLeft="_iconSave" @onclick="() => SaveDescription(datasetName, ownerUserId)">Save description</Button>
                                            <Button Variant="ghost" Size="micro" @onclick="() => CancelDescription(datasetName)">Cancel</Button>
                                        </div>
                                    }
                                    <div style="height:18px;"></div>
                                }

                                @* ── Keep-alive (team admins manage their dataset's memory lifecycle) ── *@
                                <h3 style="margin-top:8px;margin-bottom:6px;">Keep-alive</h3>
                                <p style="color:var(--lv5);font:var(--text-xs);margin-bottom:8px;max-width:560px;">
                                    Controls how long this dataset stays loaded in memory. <strong>Pinned</strong> keeps it always loaded; <strong>Off</strong> lets the client load it on demand; <strong>Timed</strong> unloads it after inactivity and reloads it automatically on next use.
                                </p>
                                @{ var ka = _keepAlive.GetValueOrDefault(datasetName); }
                                @if (_editingKeepAliveFor == datasetName)
                                {
                                    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                                        <div style="width:220px;"><SelectField @bind-Value="_keepAliveEditMode" Options="_keepAliveModes" /></div>
                                        @if (_keepAliveEditMode == "timed")
                                        {
                                            <div style="width:80px;"><InputField @bind-Value="_keepAliveEditHours" placeholder="hours" /></div>
                                        }
                                        <Button Variant="primary" Size="micro" @onclick="() => SaveKeepAlive(datasetName)">Save</Button>
                                        <Button Variant="ghost" Size="micro" @onclick="() => _editingKeepAliveFor = null">Cancel</Button>
                                    </div>
                                }
                                else
                                {
                                    <div style="display:flex;align-items:center;gap:8px;">
                                        <span style="font-variant-numeric:tabular-nums;">@KeepAliveLabel(ka?.KeepAliveTimeHrs ?? int.MaxValue)</span>
                                        <span style="color:var(--lv4);font-size:12px;">@RemainingLabel(ka)</span>
                                        <Button Variant="ghost" Size="micro" @onclick="() => BeginEditKeepAlive(datasetName, ka)">Edit</Button>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_keepAliveError) && _editingKeepAliveFor == datasetName)
                                {
                                    <p style="color:var(--CSignal);font:var(--text-xs);margin-top:4px;">@_keepAliveError</p>
                                }

                                @* Manual hibernate — frees memory now. Only durable for Off (client-managed)
                                   datasets; timed/pinned would auto-reload on the next access. *@
                                @if (engineState == SystemState.Ready)
                                {
                                    @if (ka?.KeepAliveTimeHrs == 0)
                                    {
                                        <div style="display:flex;align-items:center;gap:8px;margin-top:10px;">
                                            <Button Variant="secondary" Size="micro" IconLeft="_iconHibernate" @onclick="() => HibernateDataset(datasetName)" disabled="@_hibernating">
                                                @(_hibernating ? "Hibernating…" : "Hibernate now")
                                            </Button>
                                            <span style="color:var(--lv4);font:var(--text-xs);">Unloads from memory; data stays on disk. Wake it from the Field configuration tab.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <p style="color:var(--lv4);font:var(--text-xs);margin-top:10px;">Set keep-alive to <strong>Off</strong> to hibernate this dataset manually.</p>
                                    }
                                }

                                @* ── Replace data (atomic full reload) ── *@
                                @if (isEditor)
                                {
                                    <h3 style="margin-top:24px;margin-bottom:6px;">Replace data</h3>
                                    <p style="color:var(--lv5);font:var(--text-xs);margin-bottom:8px;max-width:560px;">
                                        Atomically reload the whole dataset from a new JSON file. The current data keeps serving with zero downtime until the new index is ready; field configuration, boost rules and the description are preserved. If the new file fails to load, the current data is left untouched.
                                    </p>
                                    @if (_replaceBusy == datasetName)
                                    {
                                        <p style="color:var(--lv5);font:var(--text-xs);">Replacing…</p>
                                    }
                                    else
                                    {
                                        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                                            <InputFile OnChange="@(e => OnReplaceFileSelected(datasetName, e))" accept=".json" style="display:none" id="@($"replace-input-{datasetName}")" />
                                            <label for="@($"replace-input-{datasetName}")" class="indx-upload-label">
                                                <Json Size="14" />
                                                @if (_replaceFile != null && _replaceFileDataset == datasetName)
                                                {
                                                    <span>@_replaceFile.Name (@FormatBytes(_replaceFile.Size))</span>
                                                }
                                                else
                                                {
                                                    <span>Choose JSON…</span>
                                                }
                                            </label>
                                            @if (_replaceFile != null && _replaceFileDataset == datasetName)
                                            {
                                                <Button Variant="secondary" Size="micro" @onclick="() => RunReplace(datasetName)">Replace all data</Button>
                                                <Button Variant="ghost" Size="micro" @onclick="@(() => { _replaceFile = null; _replaceFileDataset = null; })">Cancel</Button>
                                            }
                                        </div>
                                    }
                                    @if (_replaceResultDataset == datasetName && !string.IsNullOrEmpty(_replaceResult))
                                    {
                                        <p style="color:var(--CTeal);font:var(--text-xs);margin-top:6px;">@_replaceResult</p>
                                    }
                                    @if (_replaceErrorDataset == datasetName && !string.IsNullOrEmpty(_replaceError))
                                    {
                                        <p style="color:var(--CSignal);font:var(--text-xs);margin-top:6px;">@_replaceError</p>
                                    }
                                }

                                @{
                                    var transferTargets = _myTeams
                                        .Where(t => t.Team.Id.ToString() != activeTeamId && TeamRoles.CanAdmin(t.Role))
                                        .ToList();
                                }
                                @if (transferTargets.Count > 0)
                                {
                                    <h3 style="margin-top:8px;margin-bottom:8px;">Transfer to another team</h3>
                                    <p style="color:var(--lv5);font:var(--text-xs);margin-bottom:8px;">Move this dataset to another team you administer. The current team loses access.</p>
                                    @if (_transferConfirmDataset != datasetName)
                                    {
                                        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                                            <div style="width:240px;">
                                                <SelectField Size="micro" Placeholder="Select a team…" @bind-Value="_transferTargetTeamId"
                                                             Options="@transferTargets.Select(t => new SelectField.SelectOption(t.Team.Name, t.Team.Id.ToString())).ToList()" />
                                            </div>
                                            <Button Variant="secondary" Size="micro" disabled="@string.IsNullOrEmpty(_transferTargetTeamId)" @onclick="() => { _transferError = null; _transferConfirmDataset = datasetName; }">Transfer</Button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                                            <span style="color:var(--CSignal);font:var(--text-sm);">Move "@datasetName" to the selected team? This team loses access.</span>
                                            <Button Variant="primary" Size="micro" @onclick="() => TransferDataset(datasetName)">Confirm transfer</Button>
                                            <Button Variant="ghost" Size="micro" @onclick="() => _transferConfirmDataset = null">Cancel</Button>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(_transferError))
                                    {
                                        <p style="color:var(--CSignal);font:var(--text-xs);margin-top:4px;">@_transferError</p>
                                    }
                                }
                                @if (isAdmin)
                                {
                                    @if (engineState == SystemState.Ready)
                                    {
                                        <h3 style="color:var(--CSignal);margin-top:24px;margin-bottom:8px;">Danger Zone</h3>
                                    }
                                    @if (!isUploading && !isLoadIndexing && !isSaving)
                                    {
                                        @if (deleteConfirmDataset == datasetName)
                                        {
                                            <div style="display:flex;gap:8px;align-items:center;">
                                                <span style="font:var(--text-xs);color:var(--lv5);">Are you sure?</span>
                                                <Button Variant="danger" Size="micro" @onclick="() => ConfirmDelete(datasetName)">Yes, Delete</Button>
                                                <Button Variant="secondary" Size="micro" @onclick="CancelDelete">Cancel</Button>
                                            </div>
                                        }
                                        else
                                        {
                                            <Button Variant="@(engineState == SystemState.Ready ? "secondary" : "ghost")" Size="micro" IconLeft="_iconDelete" @onclick="() => ShowDeleteConfirm(datasetName)">Delete dataset</Button>
                                        }
                                    }
                                    else
                                    {
                                        <p style="color:var(--lv4);font:var(--text-xs);">Cannot delete while an operation is in progress.</p>
                                    }
                                }
                            </div>
                        }

                        @* ════════════════════════════════════════
                           Tab: Boost rules (editor+)
                           ════════════════════════════════════════ *@
                        @if (activeTab == "boosts")
                        {
                            <div style="margin-top: 16px;">
                                <p style="color: var(--lv5); font: var(--text-sm); margin-bottom: 12px;">
                                    Ranking rules that lift matching documents when a search runs with <code>enableBoost</code>. Conditions use filterable fields; rules stack.
                                </p>

                                @{ var bFieldOpts = FieldOptions(selectedDataset); }
                                @{ var bRules = _editedBoostRules.GetValueOrDefault(selectedDataset) ?? new(); }

                                @if (bFieldOpts.Count == 0)
                                {
                                    <p style="color: var(--CWarning); font: var(--text-sm);">No filterable fields on this dataset — mark a field <strong>Filterable</strong> in Field configuration to build boost rules.</p>
                                }
                                else
                                {
                                    @if (bRules.Count == 0)
                                    {
                                        <p style="color: var(--lv4); font: var(--text-sm); margin: 8px 0 12px;">No boost rules yet.</p>
                                    }

                                    <div style="display: flex; flex-direction: column; gap: 12px;">
                                        @foreach (var bRule in bRules)
                                        {
                                            <div style="border: 1px solid var(--lv2); border-radius: var(--radius); padding: 16px; background: var(--lv1);">
                                                <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
                                                    <ToggleSwitch @bind-Checked="bRule.Enabled" />
                                                    <div style="flex:1;"><InputField placeholder="Rule name" @bind-Value="bRule.Name" /></div>
                                                    <span style="color:var(--lv5); font:var(--text-xs); white-space:nowrap;">Strength:</span>
                                                    <div style="width:130px;"><SelectField Size="micro" Options="StrengthOptions" Value="@bRule.Strength.ToString()" ValueChanged="@(v => bRule.Strength = ParseStrength(v))" /></div>
                                                    <Button Variant="ghost" Size="micro" IconLeft="_iconDelete" @onclick="@(() => bRules.Remove(bRule))" />
                                                </div>

                                                <div style="display:flex; flex-direction:column; gap:8px; padding-left:10px; border-left:2px solid var(--lv2);">
                                                    @for (int ci = 0; ci < bRule.Conditions.Count; ci++)
                                                    {
                                                        var cond = bRule.Conditions[ci];
                                                        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                                                            <div style="width:190px;"><SelectField Size="micro" Options="FieldOptionsForCondition(selectedDataset, cond.Field)" Value="@cond.Field" ValueChanged="@(v => OnConditionFieldChanged(selectedDataset, cond, v))" /></div>
                                                            @if (IsNumericField(selectedDataset, cond.Field))
                                                            {
                                                                <span style="color:var(--lv5); font:var(--text-xs);">between</span>
                                                                <div style="width:90px;"><InputField placeholder="min" @bind-Value="cond.MinText" /></div>
                                                                <span style="color:var(--lv5); font:var(--text-xs);">and</span>
                                                                <div style="width:90px;"><InputField placeholder="max" @bind-Value="cond.MaxText" /></div>
                                                            }
                                                            else if (IsBooleanField(selectedDataset, cond.Field))
                                                            {
                                                                <span style="color:var(--lv5); font:var(--text-xs);">is</span>
                                                                <ToggleSwitch Label="@(cond.Value == "true" ? "true" : "false")" Checked="@(cond.Value == "true")" CheckedChanged="@(v => cond.Value = v ? "true" : "false")" />
                                                            }
                                                            else
                                                            {
                                                                <span style="color:var(--lv5); font:var(--text-xs);">equals</span>
                                                                <div style="flex:1; min-width:160px;"><InputField placeholder="value" @bind-Value="cond.Value" /></div>
                                                            }
                                                            @if (bRule.Conditions.Count > 1)
                                                            {
                                                                <Button Variant="ghost" Size="micro" IconLeft="_iconDelete" @onclick="@(() => bRule.Conditions.Remove(cond))" />
                                                            }
                                                        </div>
                                                        @if (ci < bRule.Conditions.Count - 1)
                                                        {
                                                            <div style="width:130px;"><SelectField Size="micro" Options="_joinOptions" Value="@bRule.Join.ToString()" ValueChanged="@(v => bRule.Join = ParseJoin(v))" /></div>
                                                        }
                                                    }
                                                    <div><Button Variant="ghost" Size="micro" IconLeft="_iconPanelAdd" @onclick="@(() => bRule.Conditions.Add(NewCondition(selectedDataset, bFieldOpts[0].Value)))">Add condition</Button></div>
                                                </div>

                                                @if (Edition.IsEnabled(IndxCloudApi.Services.EditionFeature.BoostRuleScheduling))
                                                {
                                                    <div style="margin-top:12px;">
                                                        <Checkbox Label="Time limit" Checked="@IsTimeLimited(bRule)" CheckedChanged="@(v => SetTimeLimited(bRule, v))" />
                                                        @if (IsTimeLimited(bRule))
                                                        {
                                                            <div style="display:flex; gap:20px; margin-top:8px;">
                                                                <div><span style="color:var(--lv5); font:var(--text-xs); display:block; margin-bottom:2px;">Active from</span><DatePicker @bind-Value="bRule.ActiveFrom" /></div>
                                                                <div><span style="color:var(--lv5); font:var(--text-xs); display:block; margin-bottom:2px;">Active until</span><DatePicker @bind-Value="bRule.ActiveUntil" /></div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span style="color:var(--lv4); font:var(--text-xs); display:block; margin-top:4px;">Always active</span>
                                                        }
                                                    </div>
                                                }

                                                @{ var badFields = bRule.Conditions.Where(c => !string.IsNullOrEmpty(c.Field) && !FilterableFieldNames(selectedDataset).Contains(c.Field)).Select(c => c.Field).Distinct().ToList(); }
                                                @if (badFields.Count > 0)
                                                {
                                                    <p style="color:var(--CWarning); font:var(--text-xs); margin-top:8px; margin-bottom:0;">References non-filterable field(s): @string.Join(", ", badFields). This rule won't apply until fixed.</p>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div style="margin-top:14px;">
                                        <Button Variant="secondary" Size="micro" IconLeft="_iconPanelAdd" @onclick="@(() => AddBoostRule(selectedDataset))">Add boost rule</Button>
                                    </div>

                                    @if (!string.IsNullOrEmpty(_boostError))
                                    {
                                        <p style="color:var(--CSignal); font:var(--text-sm); margin-top:10px;">@_boostError</p>
                                    }

                                    @if (BoostRulesDirty(selectedDataset))
                                    {
                                        <div style="display:flex; gap:8px; margin-top:16px;">
                                            <Button Variant="primary" Size="micro" IconLeft="_iconSave" @onclick="@(() => SaveBoostRules(selectedDataset, ownerUserId))">Save boost rules</Button>
                                            <Button Variant="secondary" Size="micro" @onclick="@(() => CancelBoostRules(selectedDataset))">Cancel</Button>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        @* ════════════════════════════════════════
                           Tab: Synonyms (editor+)
                           ════════════════════════════════════════ *@
                        @if (activeTab == "synonyms")
                        {
                            <div style="margin-top: 16px;">
                                <p style="color: var(--lv5); font: var(--text-sm); margin-bottom: 12px;">
                                    Synonyms widen searches: when a query matches an entry, its synonyms are appended to the query text before scoring.
                                    Changes apply on the next search — no re-indexing.
                                </p>

                                @{
                                    // Self-loading: the tab button also loads, but the cache can be cleared
                                    // while this tab is active (team switch, dataset refresh) — an idempotent
                                    // load here means the section never renders from a stale gap.
                                    EnsureSynonymsLoaded(selectedDataset, ownerUserId);
                                    var synList = _synonymLists.GetValueOrDefault(selectedDataset);
                                    var visibleSynEntries = FilteredSynonymEntries(selectedDataset).ToList();
                                }

                                <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px; flex-wrap:wrap;">
                                    <Button Variant="secondary" Size="micro" IconLeft="_iconPanelAdd" @onclick="@(() => OpenSynonymModal(null))">Create new</Button>
                                    @if (synList != null && synList.Entries.Count > 0)
                                    {
                                        <input class="indx-text-input" placeholder="Filter entries" style="max-width:220px;"
                                               value="@_synonymFilter.GetValueOrDefault(selectedDataset)"
                                               @oninput="e => _synonymFilter[selectedDataset] = e.Value?.ToString() ?? string.Empty" />
                                        <span style="color:var(--lv4); font:var(--text-xs); white-space:nowrap;">@visibleSynEntries.Count of @synList.Entries.Count entries</span>
                                    }
                                    <div style="flex:1;"></div>
                                    <InputFile OnChange="@(e => ImportSynonyms(selectedDataset, ownerUserId, e))" accept=".json" style="display:none" id="@($"synonyms-import-{selectedDataset}")" />
                                    <Button Variant="ghost" Size="micro" IconLeft="_iconDynamicJson" @onclick="() => TriggerSynonymsImport(selectedDataset)">Import from json</Button>
                                    @if (synList != null)
                                    {
                                        <Button Variant="ghost" Size="micro" IconLeft="_iconDownload" @onclick="() => ExportSynonyms(selectedDataset)">Export as json</Button>
                                        @if (_synRemoveConfirm)
                                        {
                                            <span style="color:var(--lv5); font:var(--text-sm);">Remove the whole list?</span>
                                            <Button Variant="primary" Size="micro" @onclick="@(() => RemoveSynonymList(selectedDataset, ownerUserId))">Remove</Button>
                                            <Button Variant="secondary" Size="micro" @onclick="@(() => _synRemoveConfirm = false)">Cancel</Button>
                                        }
                                        else
                                        {
                                            <Button Variant="ghost" Size="micro" IconLeft="_iconDelete" @onclick="@(() => _synRemoveConfirm = true)">Remove list</Button>
                                        }
                                    }
                                </div>

                                @if (synList == null || synList.Entries.Count == 0)
                                {
                                    <p style="color: var(--lv4); font: var(--text-sm); margin: 8px 0 12px;">No synonyms on this dataset yet.</p>
                                }
                                else
                                {
                                    <table class="indx-table">
                                        <tbody>
                                            @foreach (var synEntry in visibleSynEntries)
                                            {
                                                <tr>
                                                    <td>
                                                        @* One-way: From → the synonyms it expands into.
                                                           Two-way: every term ↔ every other. *@
                                                        @* Clicking any chip opens the edit modal for its entry. *@
                                                        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:6px;">
                                                            @if (synEntry.Direction == SynonymDirection.OneWay)
                                                            {
                                                                <span style="cursor:pointer;" @onclick="@(() => OpenSynonymModal(synEntry))"><Chip>@synEntry.Source</Chip></span>
                                                                <ArrowRight Size="14" Color="var(--lv5)" />
                                                                @foreach (var synTerm in synEntry.Terms)
                                                                {
                                                                    <span style="cursor:pointer;" @onclick="@(() => OpenSynonymModal(synEntry))"><Chip>@synTerm</Chip></span>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                @for (int ti = 0; ti < synEntry.Terms.Length; ti++)
                                                                {
                                                                    @* Copy to a local: the Chip's child content renders deferred,
                                                                       so capturing the loop variable itself would read past the end. *@
                                                                    var synTerm = synEntry.Terms[ti];
                                                                    @if (ti > 0)
                                                                    {
                                                                        <ResizeEw Size="14" Color="var(--lv5)" />
                                                                    }
                                                                    <span style="cursor:pointer;" @onclick="@(() => OpenSynonymModal(synEntry))"><Chip>@synTerm</Chip></span>
                                                                }
                                                            }
                                                        </div>
                                                    </td>
                                                    <td style="text-align:right; white-space:nowrap; width:1%;">
                                                        <Button Variant="ghost" Size="micro" IconLeft="_iconDelete" @onclick="@(() => DeleteSynonymEntry(selectedDataset, ownerUserId, synEntry))" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }

                                @if (!string.IsNullOrEmpty(_synonymError))
                                {
                                    <p style="color:var(--CSignal); font:var(--text-sm); margin-top:10px;">@_synonymError</p>
                                }

                                <Modal @bind-Open="_synModalOpen" Title="@(_synModalTarget == null ? "New synonym entry" : "Edit synonym entry")">
                                    <div style="display:flex; flex-direction:column; gap:14px; min-width:380px;">
                                        <div>
                                            <span style="color:var(--lv5); font:var(--text-xs); display:block; margin-bottom:4px;">Type</span>
                                            <SelectField Size="micro" Options="_synonymTypeOptions" Value="@(_synModalOneWay ? "OneWay" : "TwoWay")" ValueChanged="@(v => _synModalOneWay = v == "OneWay")" />
                                            <span style="color:var(--lv4); font:var(--text-xs); display:block; margin-top:4px;">
                                                @(_synModalOneWay
                                                    ? "Only From expands, into the synonyms — searching a synonym does not pull in From."
                                                    : "Every synonym is equivalent; matching any of them pulls in the whole group.")
                                            </span>
                                        </div>
                                        @if (_synModalOneWay)
                                        {
                                            <InputField Label="From" placeholder="e.g. hms" @bind-Value="_synModalFrom" />
                                        }
                                        <div>
                                            <InputField Label="Synonyms" placeholder="term; term; term" @bind-Value="_synModalTerms" />
                                            <span style="color:var(--lv4); font:var(--text-xs); display:block; margin-top:4px;">Separate terms with semicolons — a comma is part of a term. Multi-word terms are fine.</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(_synModalError))
                                        {
                                            <p style="color:var(--CSignal); font:var(--text-sm); margin:0;">@_synModalError</p>
                                        }
                                        <div style="display:flex; gap:8px; justify-content:flex-end;">
                                            <Button Variant="secondary" Size="micro" @onclick="@(() => _synModalOpen = false)">Cancel</Button>
                                            <Button Variant="primary" Size="micro" @onclick="@(() => SaveSynonymModal(selectedDataset, ownerUserId))">Save</Button>
                                        </div>
                                    </div>
                                </Modal>
                            </div>
                        }

                    </Surface>
                </div>
            </div>
        }
    }
}

@code {
    private string[]? datasets;
    private static string StateChipColor(SystemState state) => state switch
    {
        SystemState.Ready => "var(--CTeal)",
        SystemState.Loading => "var(--CLightBlue)",
        SystemState.Indexing => "var(--CWarning)",
        SystemState.Error => "var(--CSignal)",
        _ => "var(--lv3)",
    };

    private static string StateChipTextColor(SystemState state) => state switch
    {
        SystemState.Error => "var(--lv0)",
        SystemState.Ready => "#080809",
        SystemState.Loading => "#080809",
        SystemState.Indexing => "#080809",
        _ => "var(--lv5)",
    };

    private Dictionary<string, SystemStatus> datasetStatuses = new();
    private bool isLoading = true;
    private string? userId;
    // Active team: datasets are owned by a team, so the dashboard operates within one team at a
    // time. Defaults to the user's first team (their personal team for migrated/registered users);
    // a selector appears when the user belongs to more than one.
    private List<(Team Team, string Role)> _myTeams = new();
    private string? activeTeamId;
    private string? activeTeamName;
    private string? activeRole;
    private string? selectedDataset;
    private string? deleteConfirmDataset;
    private HashSet<string> expandedFieldConfig = new();
    private HashSet<string> _showUnusedFields = new();
    private HashSet<string> _showAdvancedFields = new();
    private Dictionary<string, FieldProxy[]?> fieldConfigs = new();
    private Dictionary<string, FieldProxy[]> _editedFieldConfigs = new();

    // Shadow-build reindex (Ready state)
    private string? _savingDataset;
    private int _shadowBuildPercent;
    private CancellationTokenSource? _pollingCts;
    private string? _saveError;
    private string? _saveErrorDataset;

    // Create dataset
    private string _newDatasetName = string.Empty;
    private bool _showNewDatasetForm;
    private string? _createError;

    // Upload phase (stream file + analyze)
    private string? _uploadingDataset;
    private readonly Dictionary<string, string> _analyzeWarnings = new();
    private string? _analyzingDataset; // set while Init runs (schema scan) after the upload transfer
    private int _uploadProgress;
    private IBrowserFile? _selectedFile;
    private string? _selectedFileDataset;
    private string? _uploadError;
    private string? _uploadErrorDataset;
    private CancellationTokenSource? _uploadCts;

    // Tracks datasets where the user has ever toggled a Searchable checkbox
    private HashSet<string> _searchableTouched = new();

    // Buffered files awaiting Load & Index (keyed by dataset name)
    private Dictionary<string, System.IO.FileStream> _bufferedFiles = new();

    // Transitional-state polling (when navigating back to a busy engine)
    private CancellationTokenSource? _transitionPollCts;

    // Load & Index phase
    private string? _loadIndexingDataset;
    private int _loadProgress;
    private int _indexProgress;
    private bool _isIndexingPhase;

    // Dataset sub-tabs ("fields" | "search" | "options" | "sharing")
    private Dictionary<string, string> _datasetTabs = new();

    // Transfer-to-team (Options tab, Admin only)
    private string _transferTargetTeamId = "";
    private string? _transferConfirmDataset;
    private string? _transferError;

    // Keep-alive (Options tab, team admins manage their dataset's memory lifecycle)
    private Dictionary<string, IndxCloudInternalApi.KeepAliveInfo> _keepAlive = new();
    private string? _editingKeepAliveFor;
    private string _keepAliveEditMode = "max";   // "max" (∞ pinned) | "0" (manual) | "timed"
    private string _keepAliveEditHours = "24";
    private string? _keepAliveError;
    private bool _hibernating;
    private static readonly IEnumerable<SelectField.SelectOption> _keepAliveModes =
    [
        new("∞ Pinned — always loaded", "max"),
        new("Off — client-managed", "0"),
        new("Timed — idle eviction", "timed"),
    ];


    // Field config import/export
    private Dictionary<string, string?> _importWarnings = new();

    // Quick search
    private Dictionary<string, string> _searchTexts = new();
    private Dictionary<string, List<PreviewHit>?> _searchResults = new();

    /// <summary>One search-preview row: the document and its relevance score.</summary>
    private record PreviewHit(JsonElement Doc, ushort Score);

    // Perf test
    private Dictionary<string, PerfTestResult?> _perfResults = new();
    private HashSet<string> _perfRunning = new();

    private record PerfTestResult(int Iterations, double TotalMs, double AvgMs, double MinMs, double MaxMs);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }
        // Onboarding not finished (admin account exists but instance not configured yet) → finish it.
        if (!InstanceSettingsService.Load().SetupComplete)
        {
            NavigationManager.NavigateTo("/Account/Setup/Configure", forceLoad: true);
            return;
        }
        userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId))
        {
            isLoading = false;
            return;
        }
        await ActiveTeam.EnsureInitializedAsync(userId);
        ActiveTeam.OnChange += HandleTeamChanged;
        SyncFromActiveTeam();
        await LoadDatasets();
        StartTransitionPollingIfNeeded();
    }

    // Mirror the shared ActiveTeamState into the local fields the dashboard reads.
    private void SyncFromActiveTeam()
    {
        _myTeams = ActiveTeam.Teams.ToList();
        activeTeamId = ActiveTeam.ActiveTeamId?.ToString();
        activeTeamName = ActiveTeam.ActiveTeamName;
        activeRole = ActiveTeam.ActiveRole;
    }

    // Active team switched elsewhere (Team page / nav) — re-mirror and reload this team's datasets.
    private async void HandleTeamChanged()
    {
        SyncFromActiveTeam();
        selectedDataset = null;
        ClearDatasetCaches();   // caches are keyed by dataset name — avoid bleed across teams
        await LoadDatasets();
        await InvokeAsync(StateHasChanged);
    }

    // Per-dataset state is keyed by name, so two teams with a same-named dataset would otherwise
    // share cached field config / search state. Drop it all when the active team changes.
    private void ClearDatasetCaches()
    {
        foreach (var fs in _bufferedFiles.Values)
        {
            try { fs.Dispose(); } catch { /* best effort */ }
        }
        _bufferedFiles.Clear();
        fieldConfigs.Clear();
        _editedFieldConfigs.Clear();
        _editedBoostRules.Clear();
        _savedBoostJson.Clear();
        _ruleTimeLimited.Clear();
        _synonymLists.Clear();
        _synonymFilter.Clear();
        foreach (var engine in _synFilterEngines.Values) engine.Dispose();
        _synFilterEngines.Clear();
        _descEdit.Clear();
        _descSaved.Clear();
        _keyFieldByDataset.Clear();
        _keyFieldCandidates.Clear();
        _keyFieldNeedsReload.Clear();
        _keyFieldChecking.Clear();
        _searchableTouched.Clear();
        _searchTexts.Clear();
        _searchResults.Clear();
        _perfResults.Clear();
        _importWarnings.Clear();
        _datasetTabs.Clear();
        expandedFieldConfig.Clear();
        _showUnusedFields.Clear();
        _showAdvancedFields.Clear();
        _keepAlive.Clear();
        _editingKeepAliveFor = null;
        _keepAliveError = null;
    }

    // ── Keep-alive (Options tab) ────────────────────────────────────────────

    private static string KeepAliveLabel(int hrs) => hrs switch
    {
        int.MaxValue => "∞ pinned",
        0 => "Off (manual)",
        _ => $"{hrs} h",
    };

    private static string RemainingLabel(IndxCloudInternalApi.KeepAliveInfo? ka)
    {
        if (ka is null || ka.KeepAliveTimeHrs is int.MaxValue or 0) return "";
        if (!ka.Ready) return "(not loaded)";
        if (ka.Remaining is { } rem)
            return rem.TotalHours >= 1 ? $"~{(int)rem.TotalHours}h {rem.Minutes}m left" : $"~{rem.Minutes}m left";
        return "";
    }

    private void BeginEditKeepAlive(string datasetName, IndxCloudInternalApi.KeepAliveInfo? ka)
    {
        _keepAliveError = null;
        (_keepAliveEditMode, _keepAliveEditHours) = (ka?.KeepAliveTimeHrs ?? int.MaxValue) switch
        {
            int.MaxValue => ("max", "24"),
            0 => ("0", "24"),
            var h => ("timed", h.ToString()),
        };
        _editingKeepAliveFor = datasetName;
    }

    private void SaveKeepAlive(string datasetName)
    {
        _keepAliveError = null;
        if (string.IsNullOrEmpty(activeTeamId)) return;

        int hrs;
        switch (_keepAliveEditMode)
        {
            case "max": hrs = int.MaxValue; break;
            case "0": hrs = 0; break;
            default:
                if (!int.TryParse((_keepAliveEditHours ?? "").Trim(), out hrs) || hrs < 1)
                {
                    _keepAliveError = $"\"{_keepAliveEditHours}\" is not a valid number of hours — enter a whole number of 1 or more.";
                    return;
                }
                break;
        }

        // Team-scoped: SetKeepAliveHrs only affects this team's dataset; the Options tab is
        // already gated to team Admins (isAdmin = TeamRoles.CanAdmin).
        if (IndxCloudInternalApi.Manager.SetKeepAliveHrs(datasetName, activeTeamId, hrs))
        {
            _editingKeepAliveFor = null;
            _keepAlive[datasetName] = IndxCloudInternalApi.Manager.GetKeepAliveInfo(datasetName, activeTeamId);
        }
        else
        {
            _keepAliveError = $"Could not update keep-alive for \"{datasetName}\".";
        }
    }

    private async Task TransferDataset(string datasetName)
    {
        _transferError = null;
        if (string.IsNullOrEmpty(_transferTargetTeamId) || string.IsNullOrEmpty(activeTeamId)) return;
        try
        {
            // TransferOwnership evicts the source engine (can be slow) — run off the circuit.
            await Task.Run(() => IndxCloudInternalApi.Manager.TransferOwnership(datasetName, activeTeamId!, _transferTargetTeamId));
        }
        catch (Exception ex)
        {
            _transferError = $"Transfer failed: {ex.Message}";
            return;
        }
        _transferTargetTeamId = "";
        _transferConfirmDataset = null;
        selectedDataset = null;
        await LoadDatasets(); // dataset now belongs to another team — drops off this view
    }

    public void Dispose()
    {
        ActiveTeam.OnChange -= HandleTeamChanged;
        foreach (var engine in _synFilterEngines.Values) engine.Dispose();
        _synFilterEngines.Clear();
    }

    private void StartTransitionPollingIfNeeded()
    {
        if (_transitionPollCts != null) return;
        var hasTransitional = datasetStatuses.Values.Any(s =>
            s.SystemState is SystemState.Loading or SystemState.Loaded or SystemState.Indexing);
        if (hasTransitional)
        {
            _transitionPollCts = new CancellationTokenSource();
            _ = PollTransitionalStateAsync(_transitionPollCts.Token);
        }
    }

    private async Task PollTransitionalStateAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(1000, ct);
                bool anyTransitional = false;
                foreach (var datasetName in datasets ?? [])
                {
                    var status = IndxCloudInternalApi.Manager.GetState(datasetName, activeTeamId!);
                    if (status != null)
                    {
                        datasetStatuses[datasetName] = status;
                        if (status.SystemState is SystemState.Loading or SystemState.Loaded or SystemState.Indexing)
                            anyTransitional = true;
                        else if (status.SystemState == SystemState.Ready && !fieldConfigs.ContainsKey(datasetName))
                        {
                            var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, activeTeamId!);
                            var fields = engine?.GetFieldConfiguration();
                            fieldConfigs[datasetName] = fields;
                            if (fields != null)
                                _editedFieldConfigs[datasetName] = fields.Select(DeepCopy).ToArray();
                        }
                    }
                }
                await InvokeAsync(StateHasChanged);
                if (!anyTransitional) break;
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        finally
        {
            _transitionPollCts?.Dispose();
            _transitionPollCts = null;
        }
    }

    // ── Tab key helpers ──────────────────────────────────────────────────────
    // Tab keys are dataset names directly (team-owned; no synthetic "shared:" keys anymore).
    private static string GetDatasetName(string tabKey) => tabKey;

    private IEnumerable<Tabs.TabItem> AllDatasetTabItems() =>
        (datasets ?? Array.Empty<string>()).Select(d => new Tabs.TabItem(d, d));

    private async Task LoadDatasets()
    {
        isLoading = true;
        try
        {
            if (string.IsNullOrEmpty(activeTeamId))
            {
                datasets = Array.Empty<string>();
                return;
            }
            datasets = IndxCloudInternalApi.Manager.GetTeamDataSets(activeTeamId).ToArray();

            datasetStatuses.Clear();
            _keepAlive.Clear();
            // Load status for the active team's datasets
            if (datasets != null)
            {
                foreach (var datasetName in datasets)
                {
                    try
                    {
                        _keepAlive[datasetName] = IndxCloudInternalApi.Manager.GetKeepAliveInfo(datasetName, activeTeamId);
                        var status = IndxCloudInternalApi.Manager.GetState(datasetName, activeTeamId);
                        if (status != null)
                        {
                            datasetStatuses[datasetName] = status;
                            if (status.SystemState == SystemState.Ready && !fieldConfigs.ContainsKey(datasetName))
                            {
                                var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, activeTeamId);
                                var fields = engine?.GetFieldConfiguration();
                                fieldConfigs[datasetName] = fields;
                                if (fields != null)
                                    _editedFieldConfigs[datasetName] = fields.Select(DeepCopy).ToArray();
                            }
                        }
                    }
                    catch { }
                }
            }
        }
        catch
        {
            datasets = Array.Empty<string>();
        }
        finally
        {
            isLoading = false;
            var allKeys = datasets ?? Array.Empty<string>();
            if (selectedDataset == null || !allKeys.Contains(selectedDataset))
                selectedDataset = allKeys.FirstOrDefault();
        }
    }

    // ── Create dataset ──────────────────────────────────────────────────────

    private async Task OnNewDatasetKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateDataset();
    }

    private async Task CreateDataset()
    {
        _createError = null;
        var name = _newDatasetName.Trim();
        if (string.IsNullOrEmpty(name)) return;
        if (!FileNameValidity.IsValid(name))
        {
            _createError = "Invalid dataset name.";
            return;
        }
        try
        {
            var persistence = new Persistence(IndxCloudInternalApi.SearchDbConnectionString, name, activeTeamId!);
            if (persistence.DataSetExists())
            {
                _createError = $"Dataset '{name}' already exists.";
                return;
            }
            persistence.CreateOrOpenDataSet(400);
            _newDatasetName = string.Empty;
            _showNewDatasetForm = false;
            await LoadDatasets();
            selectedDataset = name;
        }
        catch (Exception ex)
        {
            _createError = $"Failed to create dataset: {ex.Message}";
        }
    }

