.003H145.07V116.203H144.57H144.07V145.003H144.57ZM144.57 116.203V116.703H173.284V116.203V115.703H144.57V116.203ZM173.284 116.203H172.784V145.003H173.284H173.784V116.203H173.284ZM29.7139 116.198V115.698H1V116.198V116.698H29.7139V116.198ZM1 116.198H1.5V87.3984H1H0.5V116.198H1ZM1 87.3984V87.8984H29.7139V87.3984V86.8984H1V87.3984ZM29.7139 87.3984H29.2139V116.198H29.7139H30.2139V87.3984H29.7139ZM202.003 116.198V115.698H173.289V116.198V116.698H202.003V116.198ZM173.289 116.198H173.789V87.3984H173.289H172.789V116.198H173.289ZM173.289 87.3984V87.8984H202.003V87.3984V86.8984H173.289V87.3984ZM202.003 87.3984H201.503V116.198H202.003H202.503V87.3984H202.003ZM144.565 87.4014V86.9014H58.4297V87.4014V87.9014H144.565V87.4014ZM58.4297 87.4014H58.9297V58.6016H58.4297H57.9297V87.4014H58.4297ZM58.4297 58.6016V59.1016H144.565V58.6016V58.1016H58.4297V58.6016ZM144.565 58.6016H144.065V87.4014H144.565H145.065V58.6016H144.565ZM58.4248 29.7998V29.2998H29.7139V29.7998V30.2998H58.4248V29.7998ZM29.7139 29.7998H29.2139V58.5967H29.7139H30.2139V29.7998H29.7139ZM29.7139 58.5967V58.0967H1V58.5967V59.0967H29.7139V58.5967ZM1 58.5967H1.5V29.7969H1H0.5V58.5967H1ZM1 29.7969V30.2969H29.7109V29.7969V29.2969H1V29.7969ZM29.7109 29.7969H30.2109V1H29.7109H29.2109V29.7969H29.7109ZM29.7109 1V1.5H58.4248V1V0.5H29.7109V1ZM58.4248 1H57.9248V29.7998H58.4248H58.9248V1H58.4248ZM202.003 58.5967V58.0967H173.289V58.5967V59.0967H202.003V58.5967ZM173.289 58.5967H173.789V29.7969H173.289H172.789V58.5967H173.289ZM173.289 29.7969V30.2969H202.003V29.7969V29.2969H173.289V29.7969ZM202.003 29.7969H201.503V58.5967H202.003H202.503V29.7969H202.003ZM173.284 29.7998V29.2998H144.57V29.7998V30.2998H173.284V29.7998ZM144.57 29.7998H145.07V1H144.57H144.07V29.7998H144.57ZM144.57 1V1.5H173.284V1V0.5H144.57V1ZM173.284 1H172.784V29.7998H173.284H173.784V1H173.284Z" fill="currentColor"/>
                            </svg>
                            }
                            <div class="indx-search-field-wrap">
                                <span class="indx-search-field-icon"><Search Size="16" /></span>
                                <input class="indx-search-field-input"
                                       type="search"
                                       placeholder="@($"Search {datasetName}")"
                                       value="@(_searchTexts.GetValueOrDefault(datasetName, string.Empty))"
                                       @oninput="@(e => RunQuickSearch(datasetName, ownerUserId, e.Value?.ToString() ?? string.Empty))" />
                                @if (!string.IsNullOrEmpty(_searchTexts.GetValueOrDefault(datasetName)))
                                {
                                    <div class="indx-search-clear">
                                        <Button Variant="ghost" Size="micro" @onclick="@(() => ClearSearch(datasetName))">Clear</Button>
                                    </div>
                                }
                            </div>
                            @if (_searchResults.TryGetValue(datasetName, out var results) && results != null)
                            {
                                @if (results.Count == 0 && !string.IsNullOrEmpty(_searchTexts.GetValueOrDefault(datasetName)))
                                {
                                    <p class="indx-search-empty">No results</p>
                                }
                                else if (results.Count > 0)
                                {
                                    <div class="indx-search-results">
                                        @foreach (var doc in results)
                                        {
                                            <div class="indx-search-result-item">
                                                @foreach (var prop in GetDisplayFields(datasetName, doc))
                                                {
                                                    <span class="indx-search-result-field"><span class="indx-search-result-key">@prop.Name</span> @prop.Value</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="indx-perf-toolbar">
                                        <Button Variant="ghost" Size="micro" IconLeft="_iconZap"
                                                disabled="@_perfRunning.Contains(datasetName)"
                                                @onclick="@(() => RunPerfTest(datasetName, ownerUserId, _searchTexts.GetValueOrDefault(datasetName, string.Empty)))">
                                            @(_perfRunning.Contains(datasetName) ? "Running…" : "Run performance test")
                                        </Button>
                                        @if (_perfResults.TryGetValue(datasetName, out var perf) && perf != null)
                                        {
                                            <span class="indx-perf-result">@perf.Iterations× — avg <strong>@perf.AvgMs.ToString("0.0") ms</strong></span>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <p style="color:var(--lv5);margin-top:16px;">Index your dataset first to enable search preview.</p>
                    }
                }

                @* ════════════════════════════════════════
                   Tab: Options (owned only)
                   ════════════════════════════════════════ *@
                @if (activeTab == "options")
                {
                    <div style="margin-top:8px;">
                        @* Transfer ownership *@
                        <h3 style="margin-bottom:8px;">Transfer ownership</h3>
                        <p style="color:var(--lv5);font:var(--text-xs);margin-bottom:12px;">Transfer this dataset to another user. You will lose owner access.</p>
                        @if (_transferConfirmDataset == datasetName)
                        {
                            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                                <span style="font:var(--text-xs);color:var(--lv5);">Transfer to @_transferEmailInput?</span>
                                <Button Variant="danger" Size="micro" @onclick="() => ConfirmTransfer(datasetName, ownerUserId)">Yes, transfer</Button>
                                <Button Variant="secondary" Size="micro" @onclick="() => { _transferConfirmDataset = null; _transferEmailInput = null; _transferError = null; }">Cancel</Button>
                            </div>
                        }
                        else
                        {
                            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:4px;">
                                <input class="indx-text-input" placeholder="New owner email" @bind="_transferEmailInput" />
                                <Button Variant="secondary" Size="micro"
                                        disabled="@string.IsNullOrWhiteSpace(_transferEmailInput)"
                                        @onclick="() => _transferConfirmDataset = datasetName">Transfer</Button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_transferError))
                        {
                            <p style="color:var(--CSignal);font:var(--text-xs);margin-top:4px;">@_transferError</p>
                        }

                        @if (engineState == SystemState.Ready)
                        {
                            <h3 style="color:var(--CSignal);margin-top:24px;margin-bottom:8px;">Danger Zone</h3>
                        }
                        @if (!isUploading && !isLoadIndexing && !isSaving)
                        {
                            @if (deleteConfirmDataset == datasetName)
                            {
                                <div style="display:flex;gap:8px;align-items:center;">
                                    <span style="font:var(--text-xs);color:var(--lv5);">Are you sure?</span>
                                    <Button Variant="danger" Size="micro" @onclick="() => ConfirmDelete(datasetName)">Yes, Delete</Button>
                                    <Button Variant="secondary" Size="micro" @onclick="CancelDelete">Cancel</Button>
                                </div>
                            }
                            else
                            {
                                <Button Variant="@(engineState == SystemState.Ready ? "secondary" : "ghost")" Size="micro" IconLeft="_iconDelete" @onclick="() => ShowDeleteConfirm(datasetName)">Delete dataset</Button>
                            }
                        }
                        else
                        {
                            <p style="color:var(--lv4);font:var(--text-xs);">Cannot delete while an operation is in progress.</p>
                        }
                    </div>
                }

                @* ════════════════════════════════════════
                   Tab: Members (owner + grantees)
                   ════════════════════════════════════════ *@
                @if (activeTab == "members")
                {
                    <div style="margin-top:8px;">
                        <h3 style="margin-bottom:16px;">Members</h3>

                        @* Members table — owner row first, then grants *@
                        <table style="width:100%;border-collapse:collapse;font-size:13px;margin-bottom:20px;">
                            <thead>
                                <tr style="border-bottom:1px solid var(--lv3);color:var(--lv5);">
                                    <th style="text-align:left;padding:6px 12px;font-weight:500;">Email</th>
                                    <th style="text-align:left;padding:6px 12px;font-weight:500;">Role</th>
                                    <th style="padding:6px 12px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @* Owner row *@
                                @if (_ownerEmail.TryGetValue(datasetName, out var ownerEmail))
                                {
                                    <tr style="border-bottom:1px solid var(--lv2);">
                                        <td style="padding:8px 12px;">@ownerEmail</td>
                                        <td style="padding:8px 12px;"><Chip Color="var(--lv8)" TextColor="var(--lv0)">Owner</Chip></td>
                                        <td></td>
                                    </tr>
                                }
                                @* Grantee rows *@
                                @if (_accessGrants.TryGetValue(datasetName, out var grants))
                                {
                                    @foreach (var (email, role) in grants)
                                    {
                                        <tr style="border-bottom:1px solid var(--lv2);">
                                            <td style="padding:8px 12px;">@email</td>
                                            <td style="padding:8px 12px;"><Chip Color="var(--lv2)" TextColor="var(--lv6)">@(char.ToUpper(role[0]) + role[1..])</Chip></td>
                                            <td style="padding:8px 12px;text-align:right;">
                                                @if (currentRole == "owner")
                                                {
                                                    <Button Variant="ghost" Size="micro"
                                                            @onclick="async () => await RevokeShareAccess(datasetName, ownerUserId, email)">Revoke</Button>
                                                }
                                                else if (email == _currentUserEmail)
                                                {
                                                    <Button Variant="ghost" Size="micro"
                                                            @onclick="async () => await LeaveDataset(datasetName, ownerUserId)">Leave</Button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                        @* Grant form — owner only *@
                        @if (currentRole == "owner")
                        {
                            @if (!_showGrantForm)
                            {
                                <Button Variant="secondary" Size="micro" IconLeft="_iconUserPlus"
                                        @onclick="() => { _showGrantForm = true; _shareError = null; }">Add a user</Button>
                            }
                            else
                            {
                                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:4px;">
                                    <input class="indx-text-input" placeholder="Email address"
                                           @bind="_shareEmailInput" style="min-width:220px;" />
                                    <select style="padding:6px 8px;border:1px solid var(--lv3);border-radius:var(--radius);background:var(--lv0);color:var(--lv8);font-size:13px;width:auto;"
                                            @bind="_shareRoleInput">
                                        <option value="viewer">Viewer</option>
                                        <option value="editor">Editor</option>
                                    </select>
                                    <Button Variant="primary" Size="micro"
                                            disabled="@string.IsNullOrWhiteSpace(_shareEmailInput)"
                                            @onclick="async () => { await GrantShareAccess(datasetName, ownerUserId); if (string.IsNullOrEmpty(_shareError)) _showGrantForm = false; }">Grant access</Button>
                                    <Button Variant="ghost" Size="micro"
                                            @onclick="() => { _showGrantForm = false; _shareEmailInput = string.Empty; _shareError = null; }">Cancel</Button>
                                </div>
                                @if (!string.IsNullOrEmpty(_shareError))
                                {
                                    <p style="color:var(--CSignal);font:var(--text-xs);margin-top:4px;">@_shareError</p>
                                }
                            }
                        }
                    </div>
                }

            </Surface>
            </div>
            </div>
        }
    }
}

@code {
    private static readonly string _indxVersion =
        Assembly.GetAssembly(typeof(SearchEngine))?.GetName().Version?.ToString(3) ?? "";

    private string[]? datasets;
    private static string StateChipColor(SystemState state) => state switch
    {
        SystemState.Ready      => "var(--CTeal)",
        SystemState.Loading    => "var(--CLightBlue)",
        SystemState.Indexing   => "var(--CWarning)",
        SystemState.Error      => "var(--CSignal)",
        _                      => "var(--lv3)",
    };

    private static string StateChipTextColor(SystemState state) => state switch
    {
        SystemState.Error => "var(--lv0)",
        SystemState.Ready => "#080809",
        _                 => state == SystemState.Created || state == SystemState.Loaded || state == SystemState.Hibernated
                             ? "var(--lv5)"
                             : "var(--lv8)",
    };

    private Dictionary<string, SystemStatus> datasetStatuses = new();
    private bool isLoading = true;
    private string? userId;
    private string? selectedDataset;
    private string? deleteConfirmDataset;
    private HashSet<string> expandedFieldConfig = new();
    private HashSet<string> _showUnusedFields = new();
    private HashSet<string> _showAdvancedFields = new();
    private Dictionary<string, FieldProxy[]?> fieldConfigs = new();
    private Dictionary<string, FieldProxy[]> _editedFieldConfigs = new();

    // Shadow-build reindex (Ready state)
    private string? _savingDataset;
    private int _shadowBuildPercent;
    private CancellationTokenSource? _pollingCts;

    // Create dataset
    private string _newDatasetName = string.Empty;
    private bool _showNewDatasetForm;
    private string? _createError;

    // Upload phase (stream file + analyze)
    private string? _uploadingDataset;
    private int _uploadProgress;
    private IBrowserFile? _selectedFile;
    private string? _selectedFileDataset;
    private string? _uploadError;
    private string? _uploadErrorDataset;
    private CancellationTokenSource? _uploadCts;

    // Tracks datasets where the user has ever toggled a Searchable checkbox
    private HashSet<string> _searchableTouched = new();

    // Buffered files awaiting Load & Index (keyed by dataset name)
    private Dictionary<string, System.IO.MemoryStream> _bufferedFiles = new();

    // Load & Index phase
    private string? _loadIndexingDataset;
    private int _loadProgress;
    private int _indexProgress;
    private bool _isIndexingPhase;

    // Dataset sub-tabs ("fields" | "search" | "options" | "sharing")
    private Dictionary<string, string> _datasetTabs = new();

    // Shared datasets: keyed by synthetic tab key "shared:{ownerUserId}:{datasetName}"
    private Dictionary<string, (string OwnerUserId, string OwnerEmail, string Role)> _sharedDatasets = new();

    // Members panel state
    private Dictionary<string, List<(string Email, string Role)>> _accessGrants = new();
    private Dictionary<string, string> _ownerEmail = new();  // datasetName → owner email
    private string? _currentUserEmail;
    private string _shareEmailInput = "";
    private string _shareRoleInput = "viewer";
    private string? _shareError;
    private bool _showGrantForm = false;

    // Transfer ownership state
    private string? _transferEmailInput;
    private string? _transferConfirmDataset;
    private string? _transferError;

    // Field config import/export
    private Dictionary<string, string?> _importWarnings = new();

    // Quick search
    private Dictionary<string, string> _searchTexts = new();
    private Dictionary<string, List<JsonElement>?> _searchResults = new();

    // Perf test
    private Dictionary<string, PerfTestResult?> _perfResults = new();
    private HashSet<string> _perfRunning = new();

    private record PerfTestResult(int Iterations, double TotalMs, double AvgMs, double MinMs, double MaxMs);

    private string GetVersion()
    {
        var version = Assembly.GetExecutingAssembly()
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
            .InformationalVersion ?? "";
        var plusIndex = version.IndexOf('+');
        if (plusIndex > 0)
            version = version.Substring(0, plusIndex);
        return version;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }
        userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _currentUserEmail = user.FindFirst(ClaimTypes.Email)?.Value
                            ?? user.FindFirst(ClaimTypes.Name)?.Value;
        if (string.IsNullOrEmpty(userId))
        {
            isLoading = false;
            return;
        }
        await LoadDatasets();
    }

    // ── Tab key helpers ──────────────────────────────────────────────────────
    private static string MakeSharedKey(string ownerUserId, string datasetName) =>
        $"shared:{ownerUserId}:{datasetName}";

    private string GetDatasetName(string tabKey) =>
        _sharedDatasets.ContainsKey(tabKey)
            ? tabKey[(tabKey.IndexOf(':', 7) + 1)..] // after "shared:{ownerId}:"
            : tabKey;

    private IEnumerable<Tabs.TabItem> AllDatasetTabItems()
    {
        var items = (datasets ?? Array.Empty<string>())
            .Select(d => new Tabs.TabItem(d, d));
        var sharedItems = _sharedDatasets.Keys
            .Select(k => new Tabs.TabItem($"{GetDatasetName(k)} ↗", k));
        return items.Concat(sharedItems);
    }

    private async Task LoadDatasets()
    {
        isLoading = true;
        try
        {
            if (string.IsNullOrEmpty(userId))
            {
                datasets = Array.Empty<string>();
                return;
            }
            var persistence = new Persistence(IndxCloudInternalApi.SearchDbConnectionString, "dummy", userId);
            datasets = persistence.GetUserDataSets(userId);

            // Load shared datasets
            _sharedDatasets.Clear();
            var sharedAccess = IndxCloudInternalApi.Manager.GetAccessibleDataSets(userId);
            foreach (var (dsName, ownerUserId, role) in sharedAccess)
            {
                var ownerUser = await UserManager.FindByIdAsync(ownerUserId);
                var key = MakeSharedKey(ownerUserId, dsName);
                _sharedDatasets[key] = (ownerUserId, ownerUser?.Email ?? ownerUserId, role);
            }

            datasetStatuses.Clear();
            // Load status for owned datasets
            if (datasets != null)
            {
                foreach (var datasetName in datasets)
                {
                    try
                    {
                        var status = IndxCloudInternalApi.Manager.GetState(datasetName, userId);
                        if (status != null)
                        {
                            datasetStatuses[datasetName] = status;
                            if (status.SystemState == SystemState.Ready && !fieldConfigs.ContainsKey(datasetName))
                            {
                                var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, userId);
                                var fields = engine?.GetFieldConfiguration();
                                fieldConfigs[datasetName] = fields;
                                if (fields != null)
                                    _editedFieldConfigs[datasetName] = fields.Select(DeepCopy).ToArray();
                            }
                        }
                    }
                    catch { }
                }
            }
            // Load status and field configs for shared datasets (status keyed by synthetic tab key, fields by dataset name)
            foreach (var (tabKey, info) in _sharedDatasets)
            {
                try
                {
                    var sharedName = GetDatasetName(tabKey);
                    var status = IndxCloudInternalApi.Manager.GetState(sharedName, info.OwnerUserId);
                    if (status != null)
                    {
                        datasetStatuses[tabKey] = status;
                        if (status.SystemState == SystemState.Ready && !fieldConfigs.ContainsKey(sharedName))
                        {
                            var engine = IndxCloudInternalApi.Manager.FindSearchEngine(sharedName, info.OwnerUserId);
                            var fields = engine?.GetFieldConfiguration();
                            fieldConfigs[sharedName] = fields;
                            if (fields != null)
                                _editedFieldConfigs[sharedName] = fields.Select(DeepCopy).ToArray();
                        }
                    }
                }
                catch { }
            }
        }
        catch
        {
            datasets = Array.Empty<string>();
        }
        finally
        {
            isLoading = false;
            var allKeys = (datasets ?? Array.Empty<string>())
                .Concat(_sharedDatasets.Keys).ToArray();
            if (selectedDataset == null || !allKeys.Contains(selectedDataset))
                selectedDataset = allKeys.FirstOrDefault();
        }
    }

    // ── Create dataset ──────────────────────────────────────────────────────

    private async Task OnNewDatasetKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateDataset();
    }

    private async Task CreateDataset()
    {
        _createError = null;
        var name = _newDatasetName.Trim();
        if (string.IsNullOrEmpty(name)) return;
        if (!FileNameValidity.IsValid(name))
        {
            _createError = "Invalid dataset name.";
            return;
        }
        try
        {
            if (_sharedDatasets.Keys.Any(k => GetDatasetName(k) == name))
            {
                _createError = $"You already have access to a shared dataset named '{name}'. Choose a different name.";
                return;
            }
            var persistence = new Persistence(IndxCloudInternalApi.SearchDbConnectionString, name, userId!);
            if (persistence.DataSetExists())
            {
                _createError = $"Dataset '{name}' already exists.";
                return;
            }
            persistence.CreateOrOpenDataSet(400);
            _newDatasetName = string.Empty;
            _showNewDatasetForm = false;
            await LoadDatasets();
            selectedDataset = name;
        }
        catch (Exception ex)
        {
            _createError = $"Failed to create dataset: {ex.Message}";
        }
    }

    // ── Upload (stream + analyze) ───────────────────────────────────────────

    private void OnFileSelected(string datasetName, InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _selectedFileDataset = datasetName;
        _uploadError = null;
        _uploadErrorDataset = null;
        StateHasChanged();
    }

    private void CancelUpload()
    {
        _uploadCts?.Cancel();
    }

    private async Task StartUpload(string datasetName)
    {
        if (_selectedFile == null) return;
        var file = _selectedFile;
        _selectedFile = null;
        _selectedFileDataset = null;
        _uploadError = null;
        _uploadErrorDataset = null;
        _uploadingDataset = datasetName;
        _uploadProgress = 0;
        _uploadCts = new CancellationTokenSource();
        StateHasChanged();

        System.IO.MemoryStream? ms = null;
        try
        {
            // Stream file to server with upload progress
            ms = new System.IO.MemoryStream();
            const int chunkSize = 65536;
            var buffer = new byte[chunkSize];
            long totalRead = 0;
            await using var stream = file.OpenReadStream(maxAllowedSize: 2_000_000_000L);
            int bytesRead;
            while ((bytesRead = await stream.ReadAsync(buffer, _uploadCts.Token)) > 0)
            {
                await ms.WriteAsync(buffer, 0, bytesRead, _uploadCts.Token);
                totalRead += bytesRead;
                var pct = file.Size > 0 ? (int)(100L * totalRead / file.Size) : 0;
                if (pct != _uploadProgress)
                {
                    _uploadProgress = pct;
                    await InvokeAsync(StateHasChanged);
                }
            }

            // Analyze field structure asynchronously (avoids blocking Blazor thread on large files)
            ms.Position = 0;
            var initError = await IndxCloudInternalApi.Manager.InitFromStreamAsync(datasetName, userId!, ms);
            if (!string.IsNullOrEmpty(initError))
            {
                _uploadError = $"Analyze failed: {initError}";
                _uploadErrorDataset = datasetName;
                ms.Dispose();
                ms = null;
                return;
            }

            // Buffer the stream for the Load & Index step
            if (_bufferedFiles.TryGetValue(datasetName, out var old))
                old.Dispose();
            _bufferedFiles[datasetName] = ms;
            ms = null; // ownership transferred

            // Populate field config for display; show unused fields by default for new datasets
            var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, userId!);
            var fields = engine?.GetFieldConfiguration();
            if (fields != null)
            {
                fieldConfigs[datasetName] = fields;
                _editedFieldConfigs[datasetName] = fields.Select(DeepCopy).ToArray();
                _showUnusedFields.Add(datasetName);
            }
        }
        catch (OperationCanceledException)
        {
            ms?.Dispose();
        }
        catch (Exception ex)
        {
            _uploadError = $"Upload failed: {ex.Message}";
            _uploadErrorDataset = datasetName;
            ms?.Dispose();
        }
        finally
        {
            _uploadCts?.Dispose();
            _uploadCts = null;
            _uploadingDataset = null;
            await LoadDatasets();
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Load & Index ────────────────────────────────────────────────────────

    private async Task StartLoadAndIndex(string datasetName)
    {
        if (!HasSearchable(datasetName)) return;
        if (!_bufferedFiles.TryGetValue(datasetName, out var ms)) return;

        // Apply field configuration before Load so MakeSearchEngines sees the correct searchable set
        if (_editedFieldConfigs.TryGetValue(datasetName, out var edited))
        {
            var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, userId!);
            engine?.SetFieldConfiguration(edited);
            var df = engine?.DocumentFields;
            if (df != null && engine?.Persistence != null)
                engine.Persistence.SaveDocumentFields(df.GetSerialized());
        }

        _loadIndexingDataset = datasetName;
        _loadProgress = 0;
        _indexProgress = 0;
        _isIndexingPhase = false;
        StateHasChanged();

        try
        {
            // Phase 1: Load
            ms.Position = 0;
            var loadResult = IndxCloudInternalApi.Manager.StartLoadAsync(datasetName, userId!, ms);
            if (loadResult == null)
            {
                _uploadError = "Load failed: dataset not found";
                _uploadErrorDataset = datasetName;
                return;
            }
            var (loadTask, loadMonitor) = loadResult.Value;
            await PollUntilDone(loadTask, loadMonitor, v => _loadProgress = v);

            if (!loadMonitor.Succeeded)
            {
                _uploadError = $"Load failed: {loadMonitor.ErrorMessage ?? "unknown error"}";
                _uploadErrorDataset = datasetName;
                return;
            }

            // Release the buffer — no longer needed
            _bufferedFiles.Remove(datasetName);
            ms.Dispose();

            // Phase 2: Index — keep Loading bar at 100%
            _loadProgress = 100;
            _indexProgress = 0;
            _isIndexingPhase = true;
            await InvokeAsync(StateHasChanged);

            var indexMonitor = new ProcessMonitor();
            var indexTask = Task.Run(() =>
            {
                var eng = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, userId!);
                eng?.Index(monitor: indexMonitor);
                indexMonitor.WaitForCompletion();
            });
            await PollUntilDone(indexTask, indexMonitor, v => _indexProgress = v);

            if (!indexMonitor.Succeeded)
                Console.WriteLine($"Index failed: {indexMonitor.ErrorMessage}");

            // Refresh field config
            var freshEngine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, userId!);
            var freshFields = freshEngine?.GetFieldConfiguration();
            if (freshFields != null)
            {
                fieldConfigs[datasetName] = freshFields;
                _editedFieldConfigs[datasetName] = freshFields.Select(DeepCopy).ToArray();
            }
        }
        finally
        {
            _loadIndexingDataset = null;
            _loadProgress = 0;
            _indexProgress = 0;
            _isIndexingPhase = false;
            await LoadDatasets();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PollUntilDone(Task task, ProcessMonitor monitor, Action<int> setProgress)
    {
        while (!task.IsCompleted)
        {
            setProgress(monitor.ProgressPercent);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);
        }
        setProgress(monitor.ProgressPercent);
        await InvokeAsync(StateHasChanged);
    }

    // ── Quick search ──────────────────────────────────────────────────────────

    private async Task ExportFieldConfig(string datasetName)
    {
        if (!_editedFieldConfigs.TryGetValue(datasetName, out var fields) || fields == null) return;
        var json = JsonSerializer.Serialize(fields, new JsonSerializerOptions { WriteIndented = true });
        await JSRuntime.InvokeVoidAsync("indxDownloadFile", $"{datasetName}-field-config.json", json, "application/json");
    }

    private async Task TriggerImportFile(string datasetName) =>
        await JSRuntime.InvokeVoidAsync("indxTriggerFileInput", $"fieldconfig-import-{datasetName}");

    private async Task TriggerImportReadyFile(string datasetName) =>
        await JSRuntime.InvokeVoidAsync("indxTriggerFileInput", $"fieldconfig-import-ready-{datasetName}");

    private async Task ImportFieldConfig(string datasetName, InputFileChangeEventArgs e)
    {
        _importWarnings.Remove(datasetName);
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 1_000_000);
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var imported = JsonSerializer.Deserialize<FieldProxy[]>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (imported == null || imported.Length == 0)
            {
                _importWarnings[datasetName] = "Invalid or empty configuration file.";
                return;
            }
            if (!_editedFieldConfigs.TryGetValue(datasetName, out var current) || current == null) return;

            var currentByName = current.ToDictionary(f => f.FieldName);
            int matched = 0, unmatched = 0;
            foreach (var imp in imported)
            {
                if (currentByName.TryGetValue(imp.FieldName, out var existing))
                {
                    existing.Searchable     = imp.Searchable;
                    existing.Filterable     = imp.Filterable;
                    existing.Facetable      = imp.Facetable;
                    existing.Sortable       = imp.Sortable;
                    existing.WordIndexing   = imp.WordIndexing;
                    existing.Embeddable     = imp.Embeddable;
                    existing.PreloadFilters = imp.PreloadFilters;
                    existing.Weight         = imp.Weight;
                    existing.BM25b         = imp.BM25b;
                    existing.BM25k1        = imp.BM25k1;
                    matched++;
                }
                else unmatched++;
            }

            if (matched == 0)
                _importWarnings[datasetName] = "No matching fields found. This config may be for a different dataset.";
            else if (unmatched > imported.Length / 3)
                _importWarnings[datasetName] = $"{matched} field(s) applied, {unmatched} not found in this dataset and were skipped.";
        }
        catch (Exception ex)
        {
            _importWarnings[datasetName] = $"Failed to import: {ex.Message}";
        }
    }

    private IEnumerable<JsonProperty> GetDisplayFields(string datasetName, JsonElement doc)
    {
        const int max = 4;
        var allProps = doc.EnumerateObject()
            .Where(p => p.Value.ValueKind is JsonValueKind.String or JsonValueKind.Number or JsonValueKind.True or JsonValueKind.False)
            .ToList();

        if (!_editedFieldConfigs.TryGetValue(datasetName, out var fields) || fields == null)
            return allProps.Take(max);

        var searchable = fields.Where(f => f.Searchable == true).Select(f => f.FieldName).ToHashSet();
        var facetable  = fields.Where(f => f.Facetable  == true).Select(f => f.FieldName).ToHashSet();

        var result = new List<JsonProperty>(max);

        foreach (var p in allProps)
            if (result.Count < max && searchable.Contains(p.Name))
                result.Add(p);

        foreach (var p in allProps)
            if (result.Count < max && facetable.Contains(p.Name) && !searchable.Contains(p.Name))
                result.Add(p);

        foreach (var p in allProps)
            if (result.Count < max && !searchable.Contains(p.Name) && !facetable.Contains(p.Name))
                result.Add(p);

        return result;
    }

    private void ClearSearch(string datasetName)
    {
        _searchTexts[datasetName] = string.Empty;
        _searchResults[datasetName] = null;
        _perfResults.Remove(datasetName);
    }

    private void RunQuickSearch(string datasetName, string ownerUserId, string text)
    {
        _searchTexts[datasetName] = text;
        _perfResults.Remove(datasetName);
        if (string.IsNullOrWhiteSpace(text))
        {
            _searchResults[datasetName] = null;
            return;
        }
        var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, ownerUserId);
        if (engine == null) return;
        var query = new global::Indx.CloudApi.CloudQuery { Text = text, MaxNumberOfRecordsToReturn = 8 };
        var result = IndxCloudInternalApi.Manager.Search(query, datasetName, ownerUserId);
        var docs = new List<JsonElement>();
        foreach (var record in result.Records)
        {
            var json = engine.GetJsonDataOfKey(record.DocumentKey);
            if (!string.IsNullOrEmpty(json))
            {
                try { docs.Add(JsonDocument.Parse(json).RootElement.Clone()); }
                catch { }
            }
        }
        _searchResults[datasetName] = docs;
    }

    private async Task RunPerfTest(string datasetName, string ownerUserId, string text)
    {
        if (string.IsNullOrWhiteSpace(text) || _perfRunning.Contains(datasetName)) return;
        _perfRunning.Add(datasetName);
        _perfResults[datasetName] = null;
        StateHasChanged();
        await Task.Yield();

        const int iterations = 100;
        var timings = new double[iterations];
        var query = new global::Indx.CloudApi.CloudQuery { Text = text, MaxNumberOfRecordsToReturn = 8 };
        var sw = System.Diagnostics.Stopwatch.StartNew();
        await Task.Run(() =>
        {
            for (int i = 0; i < iterations; i++)
            {
                var t0 = sw.Elapsed.TotalMilliseconds;
                IndxCloudInternalApi.Manager.Search(query, datasetName, ownerUserId);
                timings[i] = sw.Elapsed.TotalMilliseconds - t0;
            }
        });
        var total = timings.Sum();
        _perfResults[datasetName] = new PerfTestResult(
            iterations, total,
            total / iterations,
            timings.Min(),
            timings.Max());
        _perfRunning.Remove(datasetName);
    }

    // ── Members / sharing ───────────────────────────────────────────────────

    private async Task LoadAccessGrants(string datasetName, string ownerUserId)
    {
        var grants = IndxCloudInternalApi.Manager.GetAccessGrants(datasetName, ownerUserId);
        var result = new List<(string Email, string Role)>();
        foreach (var (granteeId, role) in grants)
        {
            var user = await UserManager.FindByIdAsync(granteeId);
            result.Add((user?.Email ?? granteeId, role));
        }
        _accessGrants[datasetName] = result;

        // Resolve owner email for the members table header row
        if (!_ownerEmail.ContainsKey(datasetName))
        {
            var owner = await UserManager.FindByIdAsync(ownerUserId);
            _ownerEmail[datasetName] = owner?.Email ?? ownerUserId;
        }
    }

    private async Task GrantShareAccess(string datasetName, string ownerUserId)
    {
        _shareError = null;
        var email = _shareEmailInput.Trim();
        if (string.IsNullOrEmpty(email)) return;

        var grantee = await UserManager.FindByEmailAsync(email);
        if (grantee == null) { _shareError = "User not found."; return; }
        if (grantee.Id == userId) { _shareError = "Cannot grant access to yourself."; return; }

        var granteeDb = new SqLiteManager(IndxCloudInternalApi.SearchDbConnectionString);
        var granteePersistence = new Persistence(IndxCloudInternalApi.SearchDbConnectionString, datasetName, grantee.Id);
        if (granteePersistence.DataSetExists())
        {
            _shareError = $"This user already owns a dataset named '{datasetName}'. They must delete or rename it before access can be granted.";
            return;
        }
        if (granteeDb.GetAccessibleDataSets(grantee.Id).Any(a => a.DataSetName == datasetName))
        {
            _shareError = $"This user already has shared access to a dataset named '{datasetName}'.";
            return;
        }

        IndxCloudInternalApi.Manager.GrantAccess(datasetName, ownerUserId, grantee.Id, _shareRoleInput);
        _shareEmailInput = "";

        // Send email notification
        try
        {
            await EmailSender.SendEmailAsync(
                email,
                $"You've been granted access to dataset \"{datasetName}\"",
                $"<p>You have been granted <strong>{_shareRoleInput}</strong> access to the dataset <strong>{datasetName}</strong> on Indx Cloud API.</p>");
        }
        catch { /* email failure is non-fatal */ }

        await LoadAccessGrants(datasetName, ownerUserId);
    }

    private async Task RevokeShareAccess(string datasetName, string ownerUserId, string granteeEmail)
    {
        var grantee = await UserManager.FindByEmailAsync(granteeEmail);
        if (grantee == null) return;
        IndxCloudInternalApi.Manager.RevokeAccess(datasetName, ownerUserId, grantee.Id);
        await LoadAccessGrants(datasetName, ownerUserId);
    }

    private async Task LeaveDataset(string datasetName, string ownerUserId)
    {
        if (string.IsNullOrEmpty(userId)) return;
        IndxCloudInternalApi.Manager.RevokeAccess(datasetName, ownerUserId, userId);
        await LoadDatasets();
    }

    private async Task ConfirmTransfer(string datasetName, string ownerUserId)
    {
        _transferError = null;
        if (string.IsNullOrEmpty(_transferEmailInput)) return;

        var newOwner = await UserManager.FindByEmailAsync(_transferEmailInput.Trim());
        if (newOwner == null) { _transferError = "User not found."; return; }
        if (newOwner.Id == userId) { _transferError = "Cannot transfer to yourself."; return; }

        try
        {
            IndxCloudInternalApi.Manager.TransferOwnership(datasetName, ownerUserId, newOwner.Id);
        }
        catch (InvalidOperationException ex) { _transferError = ex.Message; return; }

        _transferConfirmDataset = null;
        _transferEmailInput = null;

        try
        {
            await EmailSender.SendEmailAsync(
                newOwner.Email!,
                $"Dataset \"{datasetName}\" has been transferred to you",
                $"<p>Ownership of the dataset <strong>{datasetName}</strong> on Indx Cloud API has been transferred to your account.</p>");
        }
        catch { /* email failure is non-fatal */ }

        await LoadDatasets();
    }

    // ── Ready state: collapsible field config + shadow-swap reindex ─────────

    private void ShowDeleteConfirm(string datasetName) => deleteConfirmDataset = datasetName;
    private void CancelDelete() => deleteConfirmDataset = null;

    private async Task ConfirmDelete(string datasetName)
    {
        if (string.IsNullOrEmpty(userId)) return;
        try
        {
            if (IndxCloudInternalApi.Manager.DeleteDataSet(datasetName, userId))
            {
                deleteConfirmDataset = null;
                expandedFieldConfig.Remove(datasetName);
                fieldConfigs.Remove(datasetName);
                _editedFieldConfigs.Remove(datasetName);
                _searchTexts.Remove(datasetName);
                _searchResults.Remove(datasetName);
                if (_bufferedFiles.TryGetValue(datasetName, out var buf))
                {
                    buf.Dispose();
                    _bufferedFiles.Remove(datasetName);
                }
                if (selectedDataset == datasetName) selectedDataset = null;
                await LoadDatasets();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting dataset: {ex.Message}");
            deleteConfirmDataset = null;
        }
    }

    private void ToggleFieldConfig(string datasetName)
    {
        if (expandedFieldConfig.Contains(datasetName))
        {
            expandedFieldConfig.Remove(datasetName);
            return;
        }
        expandedFieldConfig.Add(datasetName);
        if (!fieldConfigs.ContainsKey(datasetName))
        {
            try
            {
                var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, userId!);
                var fields = engine?.GetFieldConfiguration();
                fieldConfigs[datasetName] = fields;
                if (fields != null)
                    _editedFieldConfigs[datasetName] = fields.Select(DeepCopy).ToArray();
            }
            catch
            {
                fieldConfigs[datasetName] = null;
            }
        }
    }

    private bool IsDirty(string datasetName)
    {
        if (!fieldConfigs.TryGetValue(datasetName, out var original) || original == null) return false;
        if (!_editedFieldConfigs.TryGetValue(datasetName, out var edited) || edited == null) return false;
        for (int i = 0; i < original.Length && i < edited.Length; i++)
        {
            var o = original[i]; var e = edited[i];
            if ((o.Searchable ?? false) != (e.Searchable ?? false)) return true;
            if ((o.Filterable ?? false) != (e.Filterable ?? false)) return true;
            if ((o.Facetable ?? false) != (e.Facetable ?? false)) return true;
            if ((o.Sortable ?? false) != (e.Sortable ?? false)) return true;
            if ((o.WordIndexing ?? false) != (e.WordIndexing ?? false)) return true;
            if ((o.Embeddable ?? false) != (e.Embeddable ?? false)) return true;
            if ((o.PreloadFilters ?? false) != (e.PreloadFilters ?? false)) return true;
            if (o.Weight != e.Weight) return true;
            if (o.BM25b != e.BM25b) return true;
            if (o.BM25k1 != e.BM25k1) return true;
        }
        return false;
    }

    private bool HasSearchable(string datasetName)
    {
        if (!_editedFieldConfigs.TryGetValue(datasetName, out var edited)) return true;
        return edited.Any(f => f.Searchable == true);
    }

    private void CancelFieldConfig(string datasetName)
    {
        if (fieldConfigs.TryGetValue(datasetName, out var original) && original != null)
            _editedFieldConfigs[datasetName] = original.Select(DeepCopy).ToArray();
        else
            _editedFieldConfigs.Remove(datasetName);
    }

    private async Task SaveFieldConfig(string datasetName)
    {
        if (!_editedFieldConfigs.TryGetValue(datasetName, out var edited)) return;
        if (!HasSearchable(datasetName)) return;

        _savingDataset = datasetName;
        _shadowBuildPercent = 0;
        StateHasChanged();

        _pollingCts = new CancellationTokenSource();
        var pollingTask = PollShadowProgress(datasetName, _pollingCts.Token);

        try
        {
            await Task.Run(() =>
            {
                var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, userId!);
                if (engine == null) return;
                var df = engine.DocumentFields;
                bool needsReindex = df?.RequiresReindex(edited) ?? false;
                if (needsReindex && engine.Status.SystemState == SystemState.Ready)
                    IndxCloudInternalApi.Manager.RunFieldConfigurationOnShadow(datasetName, userId!, edited);
                else
                    engine.SetFieldConfiguration(edited);
            });

            var freshEngine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, userId!);
            var freshFields = freshEngine?.GetFieldConfiguration();
            fieldConfigs[datasetName] = freshFields;
            _editedFieldConfigs[datasetName] = freshFields?.Select(DeepCopy).ToArray() ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SaveFieldConfig failed: {ex.Message}");
        }
        finally
        {
            _pollingCts.Cancel();
            try { await pollingTask; } catch { }
            _savingDataset = null;
            _shadowBuildPercent = 0;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PollShadowProgress(string datasetName, CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(100, ct);
                _shadowBuildPercent = IndxCloudInternalApi.Manager.GetShadowBuildPercent(datasetName, userId!);
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) { break; }
        }
    }

