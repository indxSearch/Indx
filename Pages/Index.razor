    // ── Dataset description (MCP describe_dataset context) ──
    private readonly Dictionary<string, string> _descEdit = new();
    private readonly Dictionary<string, string> _descSaved = new();

    private void EnsureDescriptionLoaded(string datasetName, string teamId)
    {
        if (_descEdit.ContainsKey(datasetName)) return;
        var d = DatasetMeta.Load(teamId, datasetName);
        _descEdit[datasetName] = d;
        _descSaved[datasetName] = d;
    }

    private bool DescriptionDirty(string datasetName) =>
        _descEdit.TryGetValue(datasetName, out var e)
        && (!_descSaved.TryGetValue(datasetName, out var s) || e != s);

    private async Task SaveDescription(string datasetName, string teamId)
    {
        var text = _descEdit.GetValueOrDefault(datasetName) ?? "";
        await Task.Run(() => DatasetMeta.Save(teamId, datasetName, text));
        _descSaved[datasetName] = text;
    }

    private void CancelDescription(string datasetName)
    {
        if (_descSaved.TryGetValue(datasetName, out var s)) _descEdit[datasetName] = s;
    }

    // Rules with no schedule are "always active". The Time-limit checkbox reveals the date pickers;
    // a rule is considered time-limited if the box was ticked or it already carries a date.
    private readonly HashSet<BoostRule> _ruleTimeLimited = new();
    private bool IsTimeLimited(BoostRule rule) =>
        _ruleTimeLimited.Contains(rule) || rule.ActiveFrom.HasValue || rule.ActiveUntil.HasValue;
    private void SetTimeLimited(BoostRule rule, bool on)
    {
        if (on) _ruleTimeLimited.Add(rule);
        else { _ruleTimeLimited.Remove(rule); rule.ActiveFrom = null; rule.ActiveUntil = null; }
    }

    private bool BoostRulesDirty(string datasetName)
    {
        if (!_editedBoostRules.TryGetValue(datasetName, out var edited)) return false;
        var current = System.Text.Json.JsonSerializer.Serialize(edited, _boostJsonOpts);
        return !_savedBoostJson.TryGetValue(datasetName, out var saved) || current != saved;
    }

    private async Task SaveBoostRules(string datasetName, string teamId)
    {
        _boostError = null;
        var rules = _editedBoostRules.GetValueOrDefault(datasetName) ?? new();
        foreach (var r in rules)
        {
            if (string.IsNullOrWhiteSpace(r.Name)) { _boostError = "Every rule needs a name."; return; }
            if (r.Conditions.Count == 0) { _boostError = $"Rule \"{r.Name}\" needs at least one condition."; return; }
            foreach (var c in r.Conditions)
            {
                if (string.IsNullOrWhiteSpace(c.Field)) { _boostError = $"Rule \"{r.Name}\" has a condition with no field."; return; }
                if (IsNumericField(datasetName, c.Field))
                {
                    if (c.Min == null && c.Max == null) { _boostError = $"Rule \"{r.Name}\": set a min or max for {c.Field}."; return; }
                }
                else if (string.IsNullOrWhiteSpace(c.Value)) { _boostError = $"Rule \"{r.Name}\": enter a value for {c.Field}."; return; }
            }
        }
        await Task.Run(() => BoostStore.Save(teamId, datasetName, rules));
        _savedBoostJson[datasetName] = System.Text.Json.JsonSerializer.Serialize(rules, _boostJsonOpts);
    }

    private void CancelBoostRules(string datasetName)
    {
        _boostError = null;
        if (_savedBoostJson.TryGetValue(datasetName, out var json))
            _editedBoostRules[datasetName] = System.Text.Json.JsonSerializer.Deserialize<List<BoostRule>>(json, _boostJsonOpts) ?? new();
    }

    // ── Synonyms (per-dataset synonym list, stored in the engine's own database) ─────
    // List view + create/edit modal. Every action saves immediately through the internal
    // API, which persists the list and applies it to the live engine (effective on the
    // next search, no re-indexing) — there is no local dirty state to manage.
    private readonly Dictionary<string, SynonymList?> _synonymLists = new();
    private readonly Dictionary<string, string> _synonymFilter = new();
    private string? _synonymError;
    private bool _synRemoveConfirm;

    // Create/edit modal state. A null target means the modal is creating a new entry.
    private bool _synModalOpen;
    private SynonymEntry? _synModalTarget;
    private bool _synModalOneWay;
    private string? _synModalFrom;
    private string? _synModalTerms;
    private string? _synModalError;

    private static readonly IEnumerable<SelectField.SelectOption> _synonymTypeOptions =
        [new("Two-way", "TwoWay"), new("One-way", "OneWay")];

    private static string[] SplitTerms(string? text) =>
        (text ?? string.Empty).Split(';', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

    private void EnsureSynonymsLoaded(string datasetName, string teamId)
    {
        if (_synonymLists.ContainsKey(datasetName)) return;
        var json = IndxCloudInternalApi.Manager.GetSynonyms(datasetName, teamId)?.GetSerialized();
        _synonymLists[datasetName] = json == null ? null : SynonymList.Deserialize(json);
    }

    // The filter box is itself an Indx search: the entries are indexed in a small
    // in-memory engine, so filtering is fault tolerant (typo, affix and trigram
    // matching from the standard configuration) and results come back ranked.
    private readonly Dictionary<string, SearchEngine> _synFilterEngines = new();

    private void InvalidateSynonymFilterEngine(string datasetName)
    {
        if (_synFilterEngines.Remove(datasetName, out var engine)) engine.Dispose();
    }

    /// <summary>Returns the filter engine for the dataset's current entries, building it
    /// lazily — an entry list this size indexes in milliseconds. Null when there is
    /// nothing to index.</summary>
    private SearchEngine? GetSynonymFilterEngine(string datasetName)
    {
        if (_synFilterEngines.TryGetValue(datasetName, out var cached)) return cached;
        var list = _synonymLists.GetValueOrDefault(datasetName);
        if (list == null || list.Entries.Count == 0) return null;

        var docs = list.Entries.Select((en, i) => new
        {
            key = i,
            text = ((en.Source ?? string.Empty) + " " + string.Join(" ", en.Terms)).Trim()
        });
        using var stream = new System.IO.MemoryStream(System.Text.Encoding.UTF8.GetBytes(JsonSerializer.Serialize(docs)));

        var engine = new SearchEngine();
        var initMonitor = new ProcessMonitor();
        engine.Init(stream, "key", initMonitor);
        initMonitor.WaitForCompletion();
        foreach (var field in engine.GetFieldList())
            if (field.Name == "text") field.Searchable = true;
        stream.Position = 0;
        var loadMonitor = new ProcessMonitor();
        engine.Load(stream, loadMonitor);
        loadMonitor.WaitForCompletion();
        var indexMonitor = new ProcessMonitor();
        engine.Index(monitor: indexMonitor);
        indexMonitor.WaitForCompletion();

        _synFilterEngines[datasetName] = engine;
        return engine;
    }

    private IEnumerable<SynonymEntry> FilteredSynonymEntries(string datasetName)
    {
        var list = _synonymLists.GetValueOrDefault(datasetName);
        if (list == null) return [];
        var filter = _synonymFilter.GetValueOrDefault(datasetName);
        if (string.IsNullOrWhiteSpace(filter)) return list.Entries;

        try
        {
            var engine = GetSynonymFilterEngine(datasetName);
            if (engine != null)
            {
                var result = engine.Search(new Query { Text = filter, MaxNumberOfRecordsToReturn = Math.Max(50, list.Entries.Count) });
                return result.Records
                    .Where(r => r.Score > 0 && r.DocumentKey >= 0 && r.DocumentKey < list.Entries.Count)
                    .Select(r => list.Entries[(int)r.DocumentKey])
                    .ToList();
            }
        }
        catch
        {
            // The fuzzy filter is a convenience — fall through to plain substring matching.
        }

        return list.Entries.Where(en =>
            (en.Source?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false) ||
            en.Terms.Any(t => t.Contains(filter, StringComparison.OrdinalIgnoreCase)));
    }

    private void OpenSynonymModal(SynonymEntry? entry)
    {
        _synonymError = null;
        _synModalError = null;
        _synModalTarget = entry;
        _synModalOneWay = entry?.Direction == SynonymDirection.OneWay;
        _synModalFrom = entry?.Source;
        _synModalTerms = entry == null ? null : string.Join("; ", entry.Terms);
        _synModalOpen = true;
    }

    private async Task SaveSynonymModal(string datasetName, string teamId)
    {
        _synModalError = null;
        var terms = SplitTerms(_synModalTerms);
        if (terms.Length == 0) { _synModalError = "Enter at least one synonym."; return; }
        if (_synModalOneWay && string.IsNullOrWhiteSpace(_synModalFrom)) { _synModalError = "A one-way entry needs a From term."; return; }

        var list = _synonymLists.GetValueOrDefault(datasetName) ?? new SynonymList();
        _synonymLists[datasetName] = list;

        var entry = _synModalTarget ?? new SynonymEntry();
        entry.Direction = _synModalOneWay ? SynonymDirection.OneWay : SynonymDirection.Multidirectional;
        entry.Source = _synModalOneWay ? _synModalFrom!.Trim() : null;
        entry.Terms = terms;
        if (_synModalTarget == null) list.Entries.Add(entry);

        if (await PushSynonyms(datasetName, teamId))
            _synModalOpen = false;
        else
            _synModalError = "Failed to save.";
    }

    private async Task DeleteSynonymEntry(string datasetName, string teamId, SynonymEntry entry)
    {
        _synonymError = null;
        _synonymLists.GetValueOrDefault(datasetName)?.Entries.Remove(entry);
        if (!await PushSynonyms(datasetName, teamId)) _synonymError = "Failed to save.";
    }

    private async Task RemoveSynonymList(string datasetName, string teamId)
    {
        _synonymError = null;
        _synRemoveConfirm = false;
        _synonymLists[datasetName] = null;
        if (!await PushSynonyms(datasetName, teamId)) _synonymError = "Failed to remove the list.";
    }

    /// <summary>Persists the current list and applies it to the live engine. Pushes a deep
    /// copy so the engine never shares an instance with the page's edit state; null removes
    /// the stored list.</summary>
    private async Task<bool> PushSynonyms(string datasetName, string teamId)
    {
        InvalidateSynonymFilterEngine(datasetName);
        var list = _synonymLists.GetValueOrDefault(datasetName);
        var copy = list == null ? null : SynonymList.Deserialize(list.GetSerialized());
        return await Task.Run(() => IndxCloudInternalApi.Manager.SetSynonyms(datasetName, teamId, copy));
    }

    private async Task TriggerSynonymsImport(string datasetName) =>
        await JSRuntime.InvokeVoidAsync("indxTriggerFileInput", $"synonyms-import-{datasetName}");

    private async Task ImportSynonyms(string datasetName, string teamId, InputFileChangeEventArgs e)
    {
        _synonymError = null;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 5_000_000);
            using var reader = new System.IO.StreamReader(stream);
            var imported = SynonymList.Deserialize(await reader.ReadToEndAsync());
            if (imported.Entries.Count == 0) { _synonymError = "No entries found in the file."; return; }
            _synonymLists[datasetName] = imported;
            if (!await PushSynonyms(datasetName, teamId)) _synonymError = "Failed to save the imported list.";
        }
        catch (Exception ex)
        {
            _synonymError = $"Failed to import: {ex.Message}";
        }
    }

    private async Task ExportSynonyms(string datasetName)
    {
        var list = _synonymLists.GetValueOrDefault(datasetName);
        if (list == null) return;
        var opts = new JsonSerializerOptions { WriteIndented = true, Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() } };
        var json = JsonSerializer.Serialize(list, opts);
        await JSRuntime.InvokeVoidAsync("indxDownloadFile", $"{datasetName}-synonyms.json", json, "application/json");
    }

