    private static FieldProxy DeepCopy(FieldProxy f) => new FieldProxy
    {
        FieldName = f.FieldName,
        FieldType = f.FieldType,
        IsArray = f.IsArray,
        Searchable = f.Searchable ?? false,
        Filterable = f.Filterable ?? false,
        Facetable = f.Facetable ?? false,
        Sortable = f.Sortable ?? false,
        WordIndexing = f.WordIndexing ?? false,
        Embeddable = f.Embeddable ?? false,
        PreloadFilters = f.PreloadFilters ?? false,
        HighResolution = f.HighResolution ?? false,
        Weight = f.Weight,
        BM25b = f.BM25b,
        BM25k1 = f.BM25k1
    };

    private static bool IsUnused(FieldProxy f) =>
        f.Searchable != true && f.Filterable != true && f.Facetable != true &&
        f.Sortable != true && f.WordIndexing != true && f.Embeddable != true &&
        f.PreloadFilters != true && f.HighResolution != true;

    private static float? ParseFloat(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        return float.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var f) ? f : null;
    }

    private static string TimeAgo(DateTime dt)
    {
        if (dt == default) return "—";
        var age = DateTime.Now - dt;
        if (age.TotalSeconds < 60) return "just now";
        if (age.TotalMinutes < 60) return $"{(int)age.TotalMinutes}m ago";
        if (age.TotalHours < 24) return $"{(int)age.TotalHours}h ago";
        if (age.TotalDays < 30) return $"{(int)age.TotalDays}d ago";
        if (age.TotalDays < 365) return $"{(int)(age.TotalDays / 30)}mo ago";
        return $"{(int)(age.TotalDays / 365)}y ago";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:F1} GB";
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes} B";
    }

    // ── Boost rules (per-dataset ranking rules) ──────────────────────────────
    private Dictionary<string, List<BoostRule>> _editedBoostRules = new();
    private Dictionary<string, string> _savedBoostJson = new();
    private string? _boostError;

    private static readonly System.Text.Json.JsonSerializerOptions _boostJsonOpts = new()
    {
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };

    private static readonly IEnumerable<SelectField.SelectOption> _joinOptions =
        [new("AND", "And"), new("OR", "Or")];

    private void EnsureBoostRulesLoaded(string datasetName, string teamId)
    {
        if (_editedBoostRules.ContainsKey(datasetName)) return;
        var rules = BoostStore.Load(teamId, datasetName);
        var json = System.Text.Json.JsonSerializer.Serialize(rules, _boostJsonOpts);
        _editedBoostRules[datasetName] = System.Text.Json.JsonSerializer.Deserialize<List<BoostRule>>(json, _boostJsonOpts) ?? new();
        _savedBoostJson[datasetName] = json;
    }

    private List<string> FilterableFieldNames(string datasetName) =>
        _editedFieldConfigs.TryGetValue(datasetName, out var f) && f != null
            ? f.Where(x => x.Filterable == true).Select(x => x.FieldName).ToList()
            : new();

    private List<SelectField.SelectOption> FieldOptions(string datasetName) =>
        FilterableFieldNames(datasetName).Select(n => new SelectField.SelectOption(n, n)).ToList();

    /// <summary>
    /// Field options for one condition's picker. If the condition references a field that is no
    /// longer filterable (or gone), keep it in the list — labelled "(unavailable)" — so its stored
    /// name still shows instead of a blank dropdown.
    /// </summary>
    private List<SelectField.SelectOption> FieldOptionsForCondition(string datasetName, string? currentField)
    {
        var opts = FieldOptions(datasetName);
        if (!string.IsNullOrEmpty(currentField) && !opts.Any(o => o.Value == currentField))
            opts.Add(new SelectField.SelectOption($"{currentField} (unavailable)", currentField));
        return opts;
    }

    private bool IsNumericField(string datasetName, string field) =>
        _editedFieldConfigs.TryGetValue(datasetName, out var f) && f != null
        && f.FirstOrDefault(x => x.FieldName == field)?.FieldType == "Number";

    private bool IsBooleanField(string datasetName, string field) =>
        _editedFieldConfigs.TryGetValue(datasetName, out var f) && f != null
        && f.FirstOrDefault(x => x.FieldName == field)?.FieldType == "Boolean";

    private BoostCondition NewCondition(string datasetName, string field)
    {
        var c = new BoostCondition { Field = field };
        if (IsBooleanField(datasetName, field)) c.Value = "false";
        else if (!IsNumericField(datasetName, field)) c.Value = "";
        return c;
    }

    private void OnConditionFieldChanged(string datasetName, BoostCondition cond, string? newField)
    {
        cond.Field = newField ?? "";
        if (IsNumericField(datasetName, cond.Field)) { cond.Value = null; }
        else if (IsBooleanField(datasetName, cond.Field))
        {
            cond.Min = null; cond.Max = null;
            if (cond.Value != "true" && cond.Value != "false") cond.Value = "false";
        }
        else { cond.Min = null; cond.Max = null; cond.Value ??= ""; }
    }

    private void AddBoostRule(string datasetName)
    {
        _boostError = null;
        var first = FilterableFieldNames(datasetName).FirstOrDefault() ?? "";
        if (!_editedBoostRules.ContainsKey(datasetName)) _editedBoostRules[datasetName] = new();
        _editedBoostRules[datasetName].Add(new BoostRule { Name = "New rule", Conditions = new() { NewCondition(datasetName, first) } });
    }

