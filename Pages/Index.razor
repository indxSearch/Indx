    // ── Declared key field (document key / primary key) ──
    // Cloud-owned (DatasetMetadataStore) since the lib doesn't persist the key-field name. Applied
    // to the engine before each external Load. See indx_dataset_primary_key.md.
    // Local cache holds the raw stored value: "" = undeclared (engine default), the sentinel = explicit
    // auto-generated, otherwise a field name.
    private const string AutoKeyValue = "__auto__";
    private static string KeyAutoSentinel => IndxCloudApi.Models.IndxCloudInternalApi.KeyFieldAutoSentinel;
    private readonly Dictionary<string, string> _keyFieldByDataset = new();
    private readonly Dictionary<string, string[]> _keyFieldCandidates = new(); // numeric + non-optional
    private readonly HashSet<string> _keyFieldNeedsReload = new();
    private readonly HashSet<string> _keyFieldChecking = new(); // dry-run validation in progress
    private string? _keyFieldError;
    private string? _keyFieldErrorDataset;

    private void EnsureKeyFieldLoaded(string datasetName, string teamId)
    {
        if (_keyFieldByDataset.ContainsKey(datasetName)) return;
        _keyFieldByDataset[datasetName] = DatasetMeta.LoadKeyField(teamId, datasetName);
        _keyFieldCandidates[datasetName] =
            IndxCloudApi.Models.IndxCloudInternalApi.Manager.GetKeyFieldCandidates(datasetName, teamId);
    }

    private bool IsKeyCandidate(string datasetName, string field) =>
        _keyFieldCandidates.TryGetValue(datasetName, out var c) && c.Contains(field);

    // The value shown as selected in the dropdown. Resolves the undeclared default to "id" when "id" is
    // a valid candidate (numeric + always present — that's what the engine actually keys on), else auto.
    private string KeyFieldValue(string datasetName)
    {
        var raw = _keyFieldByDataset.GetValueOrDefault(datasetName) ?? "";
        if (raw == KeyAutoSentinel) return AutoKeyValue;
        if (raw.Length > 0) return raw;
        return IsKeyCandidate(datasetName, "id") ? "id" : AutoKeyValue;
    }

    private string KeyFieldDisplay(string datasetName)
    {
        var v = KeyFieldValue(datasetName);
        return v == AutoKeyValue ? "Auto-generated" : v;
    }

    private List<SelectField.SelectOption> KeyFieldOptions(string datasetName)
    {
        // Only numeric, non-optional fields are eligible — a key must identify every document.
        var opts = new List<SelectField.SelectOption>();
        if (_keyFieldCandidates.TryGetValue(datasetName, out var cands))
            foreach (var name in cands)
                opts.Add(new SelectField.SelectOption(name, name));
        opts.Add(new SelectField.SelectOption("Auto-generated (no key field)", AutoKeyValue));
        // Keep a declared-but-now-ineligible key visible so it isn't silently dropped from the dropdown.
        var cur = _keyFieldByDataset.GetValueOrDefault(datasetName) ?? "";
        if (cur.Length > 0 && cur != KeyAutoSentinel && !opts.Any(o => o.Value == cur))
            opts.Insert(0, new SelectField.SelectOption($"{cur} (unavailable)", cur));
        return opts;
    }

    private async Task OnKeyFieldChanged(string datasetName, string teamId, string? value)
    {
        _keyFieldError = null;
        _keyFieldErrorDataset = null;
        var fieldName = (value == null || value == AutoKeyValue) ? "" : value;
        var (err, needsReload) = await Task.Run(() =>
        {
            var e = IndxCloudApi.Models.IndxCloudInternalApi.Manager.SetKeyField(datasetName, teamId, fieldName, out var nr);
            return (e, nr);
        });
        if (err != null)
        {
            _keyFieldError = err;
            _keyFieldErrorDataset = datasetName;
            return;
        }
        // Mirror what the store now holds so the dropdown reflects the choice (sentinel for explicit auto).
        _keyFieldByDataset[datasetName] = fieldName.Length == 0 ? KeyAutoSentinel : fieldName;
        if (needsReload) _keyFieldNeedsReload.Add(datasetName);
        else _keyFieldNeedsReload.Remove(datasetName);

        // Notify immediately if the chosen key can't actually identify the documents. While the
        // uploaded data is still buffered (setup) and fields are configured, dry-run the key in memory
        // now so the user finds out at selection time, not only when they click Load and Index.
        if (fieldName.Length > 0 && HasSearchable(datasetName) && _bufferedFiles.TryGetValue(datasetName, out var buffered))
        {
            // The dry-run reads the engine's field config, so apply the user's current edits first —
            // otherwise a valid key could falsely fail the dry-run's index on "no searchable field".
            if (_editedFieldConfigs.TryGetValue(datasetName, out var edited))
                IndxCloudApi.Models.IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, teamId)?.SetFieldConfiguration(edited);

            _keyFieldChecking.Add(datasetName);
            await InvokeAsync(StateHasChanged);
            var checkErr = await Task.Run(() =>
            {
                try
                {
                    buffered.Position = 0;
                    return IndxCloudApi.Models.IndxCloudInternalApi.Manager
                        .ValidateExternalLoadForCustomKey(datasetName, teamId, buffered);
                }
                catch (Exception ex) { return ex.Message; }
            });
            _keyFieldChecking.Remove(datasetName);
            if (checkErr != null) { _keyFieldError = checkErr; _keyFieldErrorDataset = datasetName; }
        }
    }

