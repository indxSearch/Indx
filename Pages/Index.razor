    private static string? FieldTypeLabel(string? type, bool? isArray) =>
        type == null ? null : isArray == true ? $"Array ({type}s)" : type;

    // The simple-mode weight slider (0.5-3.0, step 0.25) only renders values it can show
    // truthfully; anything off-grid or out of range (advanced mode, imported configs, the
    // API) keeps the numeric input so a stored value is never silently rounded.
    private static bool IsSliderWeight(float? weight)
    {
        var v = weight ?? 1.0f;
        if (v < 0.5f || v > 3.0f) return false;
        var quartered = v * 4f;
        return Math.Abs(quartered - Math.Round(quartered)) < 0.001f;
    }

    private RenderFragment<int>? FieldTypeIcon(string? type, bool? isArray) =>
        isArray == true ? _iconArrayType : type switch
        {
            "String" => _iconStringType,
            "Number" => _iconNumberType,
            "Boolean" => _iconBoolType,
            _ => null,
        };

    // Maps the engine state to its chip icon (Ready=Flag, Loading=Trolley, Indexing=Hour glass,
    // Error=Warning, Created=Empty). Hibernated uses its own chip with the Hibernate icon.
    private RenderFragment<int>? StateChipIcon(SystemState state) => state switch
    {
        SystemState.Ready => _iconFlag,
        SystemState.Loading => _iconTrolley,
        SystemState.Indexing => _iconHourGlass,
        SystemState.Error => _iconWarning,
        SystemState.Created => _iconEmpty,
        _ => null,
    };
