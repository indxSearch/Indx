    // ── Replace data (atomic full reload) ──
    private IBrowserFile? _replaceFile;
    private string? _replaceFileDataset;
    private string? _replaceBusy;
    private string? _replaceResult, _replaceResultDataset;
    private string? _replaceError, _replaceErrorDataset;

    private void OnReplaceFileSelected(string datasetName, InputFileChangeEventArgs e)
    {
        _replaceFile = e.File;
        _replaceFileDataset = datasetName;
        _replaceResult = _replaceError = null;
        StateHasChanged();
    }

    private async Task RunReplace(string datasetName)
    {
        if (_replaceFile == null || string.IsNullOrEmpty(activeTeamId)) return;
        var file = _replaceFile;
        var teamId = activeTeamId!;
        _replaceFile = null;
        _replaceFileDataset = null;
        _replaceResult = _replaceError = null;
        _replaceBusy = datasetName;
        StateHasChanged();

        System.IO.FileStream? fs = null;
        try
        {
            var tempPath = System.IO.Path.Combine(System.IO.Path.GetTempPath(), $"indx-replace-{Guid.NewGuid():N}.tmp");
            fs = new System.IO.FileStream(tempPath, System.IO.FileMode.Create, System.IO.FileAccess.ReadWrite,
                System.IO.FileShare.None, 65536, System.IO.FileOptions.DeleteOnClose);
            await using (var stream = file.OpenReadStream(maxAllowedSize: 2_000_000_000L))
                await stream.CopyToAsync(fs);
            fs.Position = 0;

            var localFs = fs;
            var summary = await Task.Run(() => IndxCloudInternalApi.Manager.RunReplaceFromJson(datasetName, teamId, localFs));

            _keepAlive[datasetName] = IndxCloudInternalApi.Manager.GetKeepAliveInfo(datasetName, teamId);
            _searchResults.Remove(datasetName); // preview now points at stale docs

            var parts = new List<string>();
            if (summary.Added.Count > 0) parts.Add($"added {string.Join(", ", summary.Added)}");
            if (summary.Removed.Count > 0) parts.Add($"removed {string.Join(", ", summary.Removed)}");
            if (summary.TypeChanged.Count > 0) parts.Add($"type changed {string.Join(", ", summary.TypeChanged)}");
            _replaceResultDataset = datasetName;
            _replaceResult = parts.Count > 0
                ? $"Data replaced. Schema changes: {string.Join("; ", parts)}."
                : "Data replaced.";
        }
        catch (Exception ex)
        {
            _replaceErrorDataset = datasetName;
            _replaceError = $"Replace failed: {ex.Message}";
        }
        finally
        {
            fs?.Dispose();
            _replaceBusy = null;
            StateHasChanged();
        }
    }

    private void CancelUpload()
    {
        _uploadCts?.Cancel();
    }

    private async Task StartUpload(string datasetName)
    {
        if (_selectedFile == null) return;
        var file = _selectedFile;
        _selectedFile = null;
        _selectedFileDataset = null;
        _uploadError = null;
        _uploadErrorDataset = null;
        _uploadingDataset = datasetName;
        _uploadProgress = 0;
        _uploadCts = new CancellationTokenSource();
        StateHasChanged();

        System.IO.FileStream? fs = null;
        string? tempPath = null;
        try
        {
            // Stream file to a temp file instead of memory to avoid large heap allocations
            tempPath = System.IO.Path.Combine(System.IO.Path.GetTempPath(), $"indx-upload-{Guid.NewGuid():N}.tmp");
            fs = new System.IO.FileStream(tempPath, System.IO.FileMode.Create, System.IO.FileAccess.ReadWrite,
                System.IO.FileShare.None, bufferSize: 65536, System.IO.FileOptions.DeleteOnClose);
            const int chunkSize = 65536;
            var buffer = new byte[chunkSize];
            long totalRead = 0;
            await using var stream = file.OpenReadStream(maxAllowedSize: 2_000_000_000L);
            int bytesRead;
            while ((bytesRead = await stream.ReadAsync(buffer, _uploadCts.Token)) > 0)
            {
                await fs.WriteAsync(buffer, 0, bytesRead, _uploadCts.Token);
                totalRead += bytesRead;
                var pct = file.Size > 0 ? (int)(100L * totalRead / file.Size) : 0;
                if (pct != _uploadProgress)
                {
                    _uploadProgress = pct;
                    await InvokeAsync(StateHasChanged);
                }
            }

            // Analyze field structure asynchronously (avoids blocking Blazor thread on large files).
            // Init only discovers the schema (field names/types/presence) — no documents are stored or
            // indexed yet — so it's the fast first pass. Label it distinctly from the upload transfer.
            _analyzingDataset = datasetName;
            await InvokeAsync(StateHasChanged);
            fs.Position = 0;
            var initError = await IndxCloudInternalApi.Manager.InitFromStreamAsync(datasetName, activeTeamId!,fs);
            if (!string.IsNullOrEmpty(initError))
            {
                _uploadError = $"Analyze failed: {initError}";
                _uploadErrorDataset = datasetName;
                fs.Dispose();
                fs = null;
                return;
            }

            // Buffer the stream for the Load & Index step
            if (_bufferedFiles.TryGetValue(datasetName, out var old))
                old.Dispose();
            _bufferedFiles[datasetName] = fs;
            fs = null; // ownership transferred

            // Populate field config for display; show unused fields by default for new datasets
            var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, activeTeamId!);

            // A single document in a non-trivial file means no document array was found: the
            // whole file is being read as one record, which then "loads" as 1 document and can
            // exhaust memory during indexing. Warn now, before Load/Index is attempted.
            // The advice used to be "extract the inner array yourself" - wrong since b25b7a9,
            // which taught Init and Analyze to find the documents inside an export envelope on
            // their own. What is left when this fires is a file whose records the detection
            // could not locate at all.
            var analyzedDocs = engine?.DocumentFields?.AnalyzedDocumentCount ?? 0;
            var analyzedBytes = _bufferedFiles.TryGetValue(datasetName, out var buffered) ? buffered.Length : 0;
            if (analyzedDocs == 1 && analyzedBytes > 100_000)
            {
                _analyzeWarnings[datasetName] =
                    $"Only 1 document was found in a {analyzedBytes / (1024.0 * 1024.0):F1} MB file. " +
                    "Indx finds the document array inside an export envelope on its own " +
                    "(e.g. { \"count\": …, \"products\": [ … ] }), so this means no array of objects " +
                    "was found anywhere in the file - it is being read as one large document. " +
                    "Check the structure before loading: the records may be nested deeper than the " +
                    "detection reaches, or the file may hold a single document after all.";
            }
            else
            {
                _analyzeWarnings.Remove(datasetName);
            }

            var fields = engine?.GetFieldConfiguration();
            if (fields != null)
            {
                fieldConfigs[datasetName] = fields;
                _editedFieldConfigs[datasetName] = fields.Select(DeepCopy).ToArray();
                _showUnusedFields.Add(datasetName);
            }
        }
        catch (OperationCanceledException)
        {
            fs?.Dispose();
        }
        catch (Exception ex)
        {
            _uploadError = $"Upload failed: {ex.Message}";
            _uploadErrorDataset = datasetName;
            fs?.Dispose();
        }
        finally
        {
            _uploadCts?.Dispose();
            _uploadCts = null;
            _uploadingDataset = null;
            _analyzingDataset = null;
            await LoadDatasets();
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Load & Index ────────────────────────────────────────────────────────

    private void StartLoadAndIndex(string datasetName)
    {
        if (!HasSearchable(datasetName)) return;
        if (!_bufferedFiles.TryGetValue(datasetName, out var ms)) return;
        _uploadError = null; // clear any prior load error before retrying
        _uploadErrorDataset = null;

        // Apply field configuration before Load so MakeSearchEngines sees the correct searchable set
        if (_editedFieldConfigs.TryGetValue(datasetName, out var edited))
        {
            var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, activeTeamId!);
            engine?.SetFieldConfiguration(edited);
            var df = engine?.DocumentFields;
            if (df != null && engine?.Persistence != null)
                engine.Persistence.SaveDocumentFields(df.GetSerialized());
        }

        _loadIndexingDataset = datasetName;
        _loadProgress = 0;
        _indexProgress = 0;
        _isIndexingPhase = false;

        _ = RunLoadAndIndexAsync(datasetName, ms);
    }

    private async Task RunLoadAndIndexAsync(string datasetName, FileStream ms)
    {
        var pollCts = new CancellationTokenSource();
        try
        {
            // Phase 1: Load — in-place (peak memory ~1×). This is the first load (no live engine to
            // serve yet); a bad custom key is already flagged at selection time, and otherwise the load
            // fails cleanly below (the lib's clear+append is atomic, so the db is left recoverable).
            ms.Position = 0;
            var loadResult = IndxCloudInternalApi.Manager.StartLoadAsync(datasetName, activeTeamId!,ms);
            if (loadResult == null)
            {
                _uploadError = "Load failed: dataset not found";
                _uploadErrorDataset = datasetName;
                await InvokeAsync(StateHasChanged);
                return;
            }
            var (loadTask, loadMonitor) = loadResult.Value;

            var pollTask = PollProgressAsync(loadMonitor, v => _loadProgress = v, pollCts.Token);
            await loadTask;
            pollCts.Cancel();
            try { await pollTask; } catch { }
            _loadProgress = loadMonitor.ProgressPercent;
            await InvokeAsync(StateHasChanged);

            if (!loadMonitor.Succeeded)
            {
                _uploadError = "Load failed: " + IndxCloudInternalApi.Manager.DescribeLoadFailure(datasetName, activeTeamId!, loadMonitor.ErrorMessage);
                _uploadErrorDataset = datasetName;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Release the buffer — no longer needed
            _bufferedFiles.Remove(datasetName);
            ms.Dispose();

            // Phase 2: Index — keep Loading bar at 100%
            _loadProgress = 100;
            _indexProgress = 0;
            _isIndexingPhase = true;
            await InvokeAsync(StateHasChanged);

            var indexMonitor = new ProcessMonitor();
            pollCts = new CancellationTokenSource();
            pollTask = PollProgressAsync(indexMonitor, v => _indexProgress = v, pollCts.Token);

            await Task.Run(() =>
            {
                var eng = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, activeTeamId!);
                eng?.Index(monitor: indexMonitor);
                indexMonitor.WaitForCompletion();
            });
            pollCts.Cancel();
            try { await pollTask; } catch { }
            _indexProgress = indexMonitor.ProgressPercent;
            await InvokeAsync(StateHasChanged);

            if (!indexMonitor.Succeeded)
                Console.WriteLine($"Index failed: {indexMonitor.ErrorMessage}");

            // Refresh field config
            var freshEngine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, activeTeamId!);
            var freshFields = freshEngine?.GetFieldConfiguration();
            if (freshFields != null)
            {
                fieldConfigs[datasetName] = freshFields;
                _editedFieldConfigs[datasetName] = freshFields.Select(DeepCopy).ToArray();
            }
        }
        catch (ObjectDisposedException) { }
        finally
        {
            pollCts.Cancel();
            pollCts.Dispose();
            _loadIndexingDataset = null;
            _loadProgress = 0;
            _indexProgress = 0;
            _isIndexingPhase = false;
            try
            {
                await InvokeAsync(async () =>
                {
                    await LoadDatasets();
                    StateHasChanged();
                });
            }
            catch (ObjectDisposedException) { }
        }
    }

    // ── Hibernate (Options tab): free the in-memory engine; data stays in the store ──

    private async Task HibernateDataset(string datasetName)
    {
        if (string.IsNullOrEmpty(activeTeamId)) return;
        _hibernating = true;
        StateHasChanged();
        try
        {
            // Dispose can take a moment (engine teardown / native pool free); run it off the circuit.
            await Task.Run(() => IndxCloudInternalApi.Manager.DisposeDataSetInstance(datasetName, activeTeamId));
            // A hibernated dataset isn't Ready, so the tab nav (Field config / Search / Options)
            // disappears. Land on the field-config view, where the "Hibernated → Wake up" UI lives,
            // so the user isn't stranded on the now-navless Options tab.
            _datasetTabs[datasetName] = "fields";
            // For manual (Off) datasets the GetState in LoadDatasets won't auto-reload, so it
            // correctly comes back hibernated (Created + records on disk).
            await LoadDatasets();
        }
        finally
        {
            _hibernating = false;
            StateHasChanged();
        }
    }

    // ── Wake a hibernated dataset (load + index from the store, no upload) ───────

    private void StartWake(string datasetName)
    {
        _uploadError = null;
        _uploadErrorDataset = null;
        _loadIndexingDataset = datasetName;   // reuses the Load/Index progress bars
        _loadProgress = 0;
        _indexProgress = 0;
        _isIndexingPhase = false;
        _ = RunWakeAsync(datasetName);
    }

    private async Task RunWakeAsync(string datasetName)
    {
        var pollCts = new CancellationTokenSource();
        try
        {
            // Phase 1: rehydrate documents from the SQLite store (data is already persisted).
            // Call LoadFromDatabaseSync directly — the same path the startup warmup / lazy-reload
            // use. It loads the document fields itself, reports progress, and finishes the monitor.
            var loadMonitor = new ProcessMonitor();
            var pollTask = PollProgressAsync(loadMonitor, v => _loadProgress = v, pollCts.Token);
            await Task.Run(() =>
            {
                var eng = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, activeTeamId!);
                if (eng == null) { loadMonitor.MarkFinished(); return; }
                eng.LoadFromDatabaseSync(loadMonitor);
                loadMonitor.WaitForCompletion();
            });
            pollCts.Cancel();
            try { await pollTask; } catch { }
            _loadProgress = loadMonitor.ProgressPercent;
            await InvokeAsync(StateHasChanged);

            if (!loadMonitor.Succeeded)
            {
                _uploadError = $"Wake failed: {loadMonitor.ErrorMessage ?? "could not load from store"}";
                _uploadErrorDataset = datasetName;
                return;
            }

            // Phase 2: rebuild the inverted index.
            _loadProgress = 100;
            _indexProgress = 0;
            _isIndexingPhase = true;
            await InvokeAsync(StateHasChanged);

            var indexMonitor = new ProcessMonitor();
            pollCts = new CancellationTokenSource();
            pollTask = PollProgressAsync(indexMonitor, v => _indexProgress = v, pollCts.Token);
            await Task.Run(() =>
            {
                var eng = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, activeTeamId!);
                eng?.Index(monitor: indexMonitor);
                indexMonitor.WaitForCompletion();
            });
            pollCts.Cancel();
            try { await pollTask; } catch { }
            _indexProgress = indexMonitor.ProgressPercent;
            await InvokeAsync(StateHasChanged);

            // Refresh field config so the Ready view renders correctly.
            var freshEngine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, activeTeamId!);
            var freshFields = freshEngine?.GetFieldConfiguration();
            if (freshFields != null)
            {
                fieldConfigs[datasetName] = freshFields;
                _editedFieldConfigs[datasetName] = freshFields.Select(DeepCopy).ToArray();
            }
        }
        catch (ObjectDisposedException) { }
        finally
        {
            pollCts.Cancel();
            pollCts.Dispose();
            _loadIndexingDataset = null;
            _loadProgress = 0;
            _indexProgress = 0;
            _isIndexingPhase = false;
            try
            {
                await InvokeAsync(async () =>
                {
                    await LoadDatasets();
                    StateHasChanged();
                });
            }
            catch (ObjectDisposedException) { }
        }
    }

    private async Task PollProgressAsync(ProcessMonitor monitor, Action<int> setProgress, CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(150, ct);
                setProgress(monitor.ProgressPercent);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    // ── Quick search ──────────────────────────────────────────────────────────

    private async Task ExportFieldConfig(string datasetName)
    {
        if (!_editedFieldConfigs.TryGetValue(datasetName, out var fields) || fields == null) return;
        var json = JsonSerializer.Serialize(fields, new JsonSerializerOptions { WriteIndented = true });
        await JSRuntime.InvokeVoidAsync("indxDownloadFile", $"{datasetName}-field-config.json", json, "application/json");
    }

    private async Task TriggerImportFile(string datasetName) =>
        await JSRuntime.InvokeVoidAsync("indxTriggerFileInput", $"fieldconfig-import-{datasetName}");

    private async Task TriggerImportReadyFile(string datasetName) =>
        await JSRuntime.InvokeVoidAsync("indxTriggerFileInput", $"fieldconfig-import-ready-{datasetName}");

    private async Task ImportFieldConfig(string datasetName, InputFileChangeEventArgs e)
    {
        _importWarnings.Remove(datasetName);
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 1_000_000);
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var imported = JsonSerializer.Deserialize<FieldProxy[]>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (imported == null || imported.Length == 0)
            {
                _importWarnings[datasetName] = "Invalid or empty configuration file.";
                return;
            }
            if (!_editedFieldConfigs.TryGetValue(datasetName, out var current) || current == null) return;

            var currentByName = current.ToDictionary(f => f.FieldName);
            int matched = 0, unmatched = 0;
            foreach (var imp in imported)
            {
                if (currentByName.TryGetValue(imp.FieldName, out var existing))
                {
                    existing.Searchable = imp.Searchable;
                    existing.Filterable = imp.Filterable;
                    existing.Facetable = imp.Facetable;
                    existing.Sortable = imp.Sortable;
                    existing.WordIndexing = imp.WordIndexing;
                    existing.Embeddable = imp.Embeddable;
                    existing.PreloadFilters = imp.PreloadFilters;
                    existing.HighResolution = imp.HighResolution;
                    existing.Weight = imp.Weight;
                    existing.BM25b = imp.BM25b;
                    existing.BM25k1 = imp.BM25k1;
                    matched++;
                }
                else unmatched++;
            }

            if (matched == 0)
                _importWarnings[datasetName] = "No matching fields found. This config may be for a different dataset.";
            else if (unmatched > imported.Length / 3)
                _importWarnings[datasetName] = $"{matched} field(s) applied, {unmatched} not found in this dataset and were skipped.";
        }
        catch (Exception ex)
        {
            _importWarnings[datasetName] = $"Failed to import: {ex.Message}";
        }
    }

    /// <summary>One field shown on a search-preview row.</summary>
    private record DisplayField(string Name, string Value);

    /// <summary>
    /// The (up to four) fields shown per hit: searchable first, then facetable, then the
    /// rest — unchanged. What changed is how a field finds its value.
    /// <para>This used to enumerate the hit document's own top-level properties and match
    /// their names against the configuration. That only works while documents are flat. The
    /// parser names a nested value by its whole path — <c>displayName.values.text</c>, see
    /// DocumentFields.ProcessObjectElement — and no such property exists at the top level,
    /// so nothing ever matched: every field fell through to the third bucket and the row
    /// came out in document order, with the field the user marked searchable missing
    /// altogether. Verified in the portal on a nested Relewise export.</para>
    /// <para>So the iteration is inverted: walk the configured fields, which already carry
    /// the parser's names, and resolve each name as a path into the document. Nothing has to
    /// re-derive how a field is named. It is also less work than before — at most four
    /// lookups per hit instead of enumerating a wide document.</para>
    /// </summary>
    private IEnumerable<DisplayField> GetDisplayFields(string datasetName, JsonElement doc)
    {
        const int max = 4;

        if (!_editedFieldConfigs.TryGetValue(datasetName, out var fields) || fields == null)
            return doc.EnumerateObject()
                .Where(p => p.Value.ValueKind is JsonValueKind.String or JsonValueKind.Number
                                              or JsonValueKind.True or JsonValueKind.False)
                .Take(max)
                .Select(p => new DisplayField(p.Name, p.Value.ToString()))
                .ToList();

        // Same three buckets, same priority, same cap — applied to the field list now.
        var ordered = fields.Where(f => f.Searchable == true)
            .Concat(fields.Where(f => f.Facetable == true && f.Searchable != true))
            .Concat(fields.Where(f => f.Searchable != true && f.Facetable != true));

        var result = new List<DisplayField>(max);
        foreach (var f in ordered)
        {
            if (result.Count >= max) break;
            // Absent on this document — an Optional field, say — shows as an empty cell
            // rather than being skipped, so the columns stay the same down the result list.
            result.Add(new DisplayField(f.FieldName, ResolveFieldValue(doc, f.FieldName)));
        }
        return result;
    }

    /// <summary>
    /// Follows a parser field name — dot-separated, no array indices — down to its value.
    /// A segment landing on an array applies the rest of the path to its elements and takes
    /// the first that yields something, which mirrors how the parser collapses arrays when
    /// it names the field. Returns an empty string when the document has no value there.
    /// </summary>
    private static string ResolveFieldValue(JsonElement element, string path) =>
        ResolveFieldValue(element, path.Split('.'), 0);

    private static string ResolveFieldValue(JsonElement element, string[] segments, int index)
    {
        for (; index < segments.Length; index++)
        {
            if (element.ValueKind == JsonValueKind.Array)
            {
                // Resume the SAME segment inside each element: the parser did not spend a
                // segment on the array, so neither do we.
                foreach (var item in element.EnumerateArray())
                {
                    var found = ResolveFieldValue(item, segments, index);
                    if (!string.IsNullOrEmpty(found)) return found;
                }
                return string.Empty;
            }
            if (element.ValueKind != JsonValueKind.Object ||
                !element.TryGetProperty(segments[index], out element))
                return string.Empty;
        }

        // A name always ends at a scalar, but guard anyway: a future change to how fields
        // are named should leave an empty cell, not a type name, in the UI.
        if (element.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in element.EnumerateArray())
            {
                if (item.ValueKind is JsonValueKind.Object or JsonValueKind.Array) continue;
                var text = item.ToString();
                if (!string.IsNullOrEmpty(text)) return text;
            }
            return string.Empty;
        }
        return element.ValueKind == JsonValueKind.Object ? string.Empty : element.ToString();
    }

    private void ClearSearch(string datasetName)
    {
        _searchTexts[datasetName] = string.Empty;
        _searchResults[datasetName] = null;
        _perfResults.Remove(datasetName);
    }

    private void RunQuickSearch(string datasetName, string ownerUserId, string text)
    {
        _searchTexts[datasetName] = text;
        _perfResults.Remove(datasetName);
        if (string.IsNullOrWhiteSpace(text))
        {
            _searchResults[datasetName] = null;
            return;
        }
        var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, ownerUserId);
        if (engine == null) return;
        // EnableBoost so the preview reflects this dataset's saved boost rules (applied
        // server-side in FromCloudQuery2Query), matching what real searches return.
        var query = new global::Indx.CloudApi.CloudQuery { Text = text, MaxNumberOfRecordsToReturn = 8, EnableBoost = true };
        var result = IndxCloudInternalApi.Manager.Search(query, datasetName, ownerUserId);
        var hits = new List<PreviewHit>();
        foreach (var record in result.Records)
        {
            var json = engine.GetJsonDataOfKey(record.DocumentKey);
            if (!string.IsNullOrEmpty(json))
            {
                try { hits.Add(new PreviewHit(JsonDocument.Parse(json).RootElement.Clone(), record.Score)); }
                catch { }
            }
        }
        _searchResults[datasetName] = hits;
    }

    private async Task RunPerfTest(string datasetName, string ownerUserId, string text)
    {
        if (string.IsNullOrWhiteSpace(text) || _perfRunning.Contains(datasetName)) return;
        _perfRunning.Add(datasetName);
        _perfResults[datasetName] = null;
        StateHasChanged();
        await Task.Yield();

        const int iterations = 100;
        var timings = new double[iterations];
        var query = new global::Indx.CloudApi.CloudQuery { Text = text, MaxNumberOfRecordsToReturn = 8 };
        var sw = System.Diagnostics.Stopwatch.StartNew();
        await Task.Run(() =>
        {
            for (int i = 0; i < iterations; i++)
            {
                var t0 = sw.Elapsed.TotalMilliseconds;
                IndxCloudInternalApi.Manager.Search(query, datasetName, ownerUserId);
                timings[i] = sw.Elapsed.TotalMilliseconds - t0;
            }
        });
        var total = timings.Sum();
        _perfResults[datasetName] = new PerfTestResult(
            iterations, total,
            total / iterations,
            timings.Min(),
            timings.Max());
        _perfRunning.Remove(datasetName);
    }

    // ── Ready state: collapsible field config + shadow-swap reindex ─────────

    private void ShowDeleteConfirm(string datasetName) => deleteConfirmDataset = datasetName;
    private void CancelDelete() => deleteConfirmDataset = null;

    private async Task ConfirmDelete(string datasetName)
    {
        if (string.IsNullOrEmpty(userId)) return;
        try
        {
            // Run off the SignalR circuit dispatcher — SearchEngine.Dispose can
            // take seconds (task.Wait timeouts, native pool free), and running
            // it inline would freeze this user's UI for the full duration.
            var ok = await Task.Run(() => IndxCloudInternalApi.Manager.DeleteDataSet(datasetName, activeTeamId!));
            if (ok)
            {
                deleteConfirmDataset = null;
                expandedFieldConfig.Remove(datasetName);
                _analyzeWarnings.Remove(datasetName);
                fieldConfigs.Remove(datasetName);
                _editedFieldConfigs.Remove(datasetName);
                _searchTexts.Remove(datasetName);
                _searchResults.Remove(datasetName);
                if (_bufferedFiles.TryGetValue(datasetName, out var buf))
                {
                    buf.Dispose();
                    _bufferedFiles.Remove(datasetName);
                }
                if (selectedDataset == datasetName) selectedDataset = null;
                await LoadDatasets();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting dataset: {ex.Message}");
            deleteConfirmDataset = null;
        }
    }

    private void ToggleFieldConfig(string datasetName)
    {
        if (expandedFieldConfig.Contains(datasetName))
        {
            expandedFieldConfig.Remove(datasetName);
            return;
        }
        expandedFieldConfig.Add(datasetName);
        if (!fieldConfigs.ContainsKey(datasetName))
        {
            try
            {
                var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, activeTeamId!);
                var fields = engine?.GetFieldConfiguration();
                fieldConfigs[datasetName] = fields;
                if (fields != null)
                    _editedFieldConfigs[datasetName] = fields.Select(DeepCopy).ToArray();
            }
            catch
            {
                fieldConfigs[datasetName] = null;
            }
        }
    }

    private bool IsDirty(string datasetName)
    {
        if (!fieldConfigs.TryGetValue(datasetName, out var original) || original == null) return false;
        if (!_editedFieldConfigs.TryGetValue(datasetName, out var edited) || edited == null) return false;
        for (int i = 0; i < original.Length && i < edited.Length; i++)
        {
            var o = original[i]; var e = edited[i];
            if ((o.Searchable ?? false) != (e.Searchable ?? false)) return true;
            if ((o.Filterable ?? false) != (e.Filterable ?? false)) return true;
            if ((o.Facetable ?? false) != (e.Facetable ?? false)) return true;
            if ((o.Sortable ?? false) != (e.Sortable ?? false)) return true;
            if ((o.WordIndexing ?? false) != (e.WordIndexing ?? false)) return true;
            if ((o.Embeddable ?? false) != (e.Embeddable ?? false)) return true;
            if ((o.PreloadFilters ?? false) != (e.PreloadFilters ?? false)) return true;
            if ((o.HighResolution ?? false) != (e.HighResolution ?? false)) return true;
            if (o.Weight != e.Weight) return true;
            if (o.BM25b != e.BM25b) return true;
            if (o.BM25k1 != e.BM25k1) return true;
        }
        return false;
    }

    private bool HasSearchable(string datasetName)
    {
        if (!_editedFieldConfigs.TryGetValue(datasetName, out var edited)) return true;
        return edited.Any(f => f.Searchable == true);
    }

    private void CancelFieldConfig(string datasetName)
    {
        if (fieldConfigs.TryGetValue(datasetName, out var original) && original != null)
            _editedFieldConfigs[datasetName] = original.Select(DeepCopy).ToArray();
        else
            _editedFieldConfigs.Remove(datasetName);
    }

    private void SaveFieldConfig(string datasetName, string engineOwnerUserId)
    {
        if (!_editedFieldConfigs.TryGetValue(datasetName, out var edited)) return;
        if (!HasSearchable(datasetName)) return;

        _savingDataset = datasetName;
        _shadowBuildPercent = 0;
        _saveError = null;
        _saveErrorDataset = null;

        _ = RunSaveFieldConfigAsync(datasetName, engineOwnerUserId, edited);
    }

    private async Task RunSaveFieldConfigAsync(string datasetName, string engineOwnerUserId, FieldProxy[] edited)
    {
        _pollingCts = new CancellationTokenSource();
        var pollingTask = PollShadowProgress(datasetName, engineOwnerUserId, _pollingCts.Token);

        try
        {
            await Task.Run(() =>
            {
                var engine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, engineOwnerUserId);
                if (engine == null) return;
                var df = engine.DocumentFields;
                bool needsReindex = df?.RequiresReindex(edited) ?? false;
                if (needsReindex && engine.Status.SystemState == SystemState.Ready)
                    IndxCloudInternalApi.Manager.RunFieldConfigurationOnShadow(datasetName, engineOwnerUserId, edited);
                else
                    engine.SetFieldConfiguration(edited);
            });

            var freshEngine = IndxCloudInternalApi.Manager.FindSearchEngine(datasetName, engineOwnerUserId);
            var freshFields = freshEngine?.GetFieldConfiguration();
            fieldConfigs[datasetName] = freshFields;
            _editedFieldConfigs[datasetName] = freshFields?.Select(DeepCopy).ToArray() ?? [];
        }
        catch (ShadowBusyException)
        {
            _saveError = "A shadow build is already in progress. Please wait for it to complete.";
            _saveErrorDataset = datasetName;
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            _saveError = $"Save failed: {ex.Message}";
            _saveErrorDataset = datasetName;
        }
        finally
        {
            _pollingCts?.Cancel();
            try { await pollingTask; } catch { }
            _savingDataset = null;
            _shadowBuildPercent = 0;
            try { await InvokeAsync(StateHasChanged); }
            catch (ObjectDisposedException) { }
        }
    }

    private async Task PollShadowProgress(string datasetName, string engineOwnerUserId, CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(100, ct);
                _shadowBuildPercent = IndxCloudInternalApi.Manager.GetShadowBuildPercent(datasetName, engineOwnerUserId);
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) { break; }
        }
    }

