@page "/teams/{TeamName}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits TeamRouteBase

<PageTitle>@(Team?.Name ?? "Team")</PageTitle>

@* The team page: [team ▾] with "Manage team" on the right, then the team's datasets as a grid.
   Reached from "/" (last-visited team), the breadcrumb switcher, or a dataset's team crumb. *@

@if (TeamResolved)
{
    <ConsoleBreadcrumb TeamName="@TeamName">
        <Actions>
            <Button Variant="secondary" Size="micro" Href="@TeamRoutes.TeamSettings(TeamName)" IconLeft="_iconManage">Manage team</Button>
        </Actions>
    </ConsoleBreadcrumb>

    <DatasetList TeamId="@TeamId" TeamName="@TeamName" Role="@Role" />
}

@code {
    private static readonly RenderFragment<int> _iconManage = size => @<Users Size="size" Color="currentColor" />;
}
