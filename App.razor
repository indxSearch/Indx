<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="favicon_dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="_content/Indx.Systm.Blazor/fonts/fonts.css" />
    <link rel="stylesheet" href="_content/Indx.Systm.Blazor/indx-systm.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="IndxCloudApi.styles.css" />
</head>
<body>
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>Not found</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p role="alert">Sorry, there's nothing at this address.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>

    @* Blazor replaces its default reconnect dialog with this element when it carries this id.
       It toggles components-reconnect-show / -failed / -rejected on it and fills the two
       attempt counters; everything else here is ours. Styled in app.css (global — it lives
       outside any component). *@
    <div id="components-reconnect-modal" class="indx-reconnect" role="alertdialog" aria-live="assertive" aria-labelledby="indx-reconnect-title">
        <div class="indx-reconnect-panel">
            <p id="indx-reconnect-title" class="indx-reconnect-title">
                <span class="indx-reconnect-reconnecting"><svg class="indx-reconnect-icon" width="21" height="15" viewBox="0 0 7 5" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 3H5V4H6V5H1V4H2V3H3V2H4V3ZM6 1H5V2H4V1H3V2H2V1H1V0H6V1Z" fill="currentColor"/></svg> Reconnecting</span>
                <span class="indx-reconnect-failed indx-reconnect-resume-failed">Connection lost</span>
                <span class="indx-reconnect-paused"><svg class="indx-reconnect-icon" width="21" height="15" viewBox="0 0 7 5" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 3H5V4H6V5H1V4H2V3H3V2H4V3ZM6 1H5V2H4V1H3V2H2V1H1V0H6V1Z" fill="currentColor"/></svg> Resuming</span>
                <span class="indx-reconnect-rejected">Session ended</span>
            </p>
            <p class="indx-reconnect-body">
                <span class="indx-reconnect-reconnecting">Attempt <span id="components-reconnect-current-attempt"></span> of <span id="components-reconnect-max-retries"></span>. Your work is kept while we restore the connection.</span>
                <span class="indx-reconnect-failed">The server could not be reached. Retry, or reload the page.</span>
                <span class="indx-reconnect-resume-failed">The paused session could not be restored. Resume again, or reload the page.</span>
                <span class="indx-reconnect-paused">Your session was paused while inactive and is being restored.</span>
                <span class="indx-reconnect-rejected">The server restarted or your session expired. Reload to continue.</span>
            </p>
            <div class="indx-reconnect-actions">
                <button type="button" class="indx-btn indx-btn-micro indx-btn-primary indx-reconnect-failed" onclick="window.Blazor.reconnect()">Retry now</button>
                <button type="button" class="indx-btn indx-btn-micro indx-btn-primary indx-reconnect-resume-failed" onclick="window.Blazor.resume()">Resume</button>
                <button type="button" class="indx-btn indx-btn-micro indx-btn-secondary indx-reconnect-failed indx-reconnect-resume-failed indx-reconnect-rejected" onclick="location.reload()">Reload</button>
            </div>
        </div>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script src="js/browser-files.js"></script>
</body>
</html>