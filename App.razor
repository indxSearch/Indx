@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* iOS Safari zooms the page whenever a form field with a font under 16px takes focus, and
       stays zoomed. The console's micro fields (the field filter, the synonym filter, selects)
       are 11 to 13px by design, and the filters matter most on a phone. Since iOS 10 Safari
       ignores maximum-scale for pinch-zoom, so this costs the user nothing, but it still
       honours it for that focus zoom. iOS only: Android Chrome would take it literally and
       block pinch-zoom altogether. Same approach as indx-docs (src/main.tsx). Inline and in
       the head, so it is in place before the first field can be touched. *@
    <script>
        (function () {
            var ios = /iP(hone|ad|od)/.test(navigator.platform)
                || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
            if (!ios) return;
            var viewport = document.querySelector('meta[name="viewport"]');
            if (viewport) viewport.setAttribute('content', 'width=device-width, initial-scale=1.0, maximum-scale=1.0');
        })();
    </script>
    <base href="/" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="favicon_dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="@V("_content/Indx.Systm.Blazor/fonts/fonts.css")" />
    <link rel="stylesheet" href="@V("_content/Indx.Systm.Blazor/indx-systm.css")" />
    <link rel="stylesheet" href="@V("app.css")" />
    <link rel="stylesheet" href="@V("IndxServer.styles.css")" />
</head>
<body>
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>Not found</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p role="alert">Sorry, there's nothing at this address.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>

    <ReconnectOverlay />

    <script src="_framework/blazor.web.js"></script>
    <script src="@V("js/browser-files.js")"></script>
    <script src="@V("js/fill-viewport.js")"></script>
    <script src="@V("js/reveal-current.js")"></script>
    <script src="@V("js/agent-thread.js")"></script>
</body>
</html>

@code {
    /// <summary>The file's address with its last change in the query, so a browser fetches a
    /// stylesheet or script again after a deploy or a restart instead of keeping the copy it has:
    /// the files are served without a cache lifetime, and Chrome kept a phone layout fix away
    /// from a reload (Oct 2026). A file the web root does not have is linked as it was.</summary>
    private string V(string path)
    {
        var file = Env.WebRootFileProvider.GetFileInfo(path);
        return file.Exists ? $"{path}?v={file.LastModified.UtcTicks:x}" : path;
    }
}
