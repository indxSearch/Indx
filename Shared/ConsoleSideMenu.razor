@* The side column's menu (Notes/Anders/console-shell-plan-2026-10-13.md, stage 1): groups of
   ghost Buttons straight on the page, the open one primary, as the active tab is today. Only a
   page with sections of its own has it: one that sets them through SideMenuState (the dataset
   page, from stage 2), or an area whose sections are read off the URL (admin, account). The team
   page has no column; its pages are buttons on the page itself. Role rules hide, "not yet"
   disables with the reason, as the tab bar did. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IndxServer.Services.SideMenuState Menu

@if (_groups.Count > 0)
{
<aside class="shell-side">
<nav class="side-menu" aria-label="Sections">
    @foreach (var group in _groups)
    {
        <div class="side-menu-group">
            @if (!string.IsNullOrEmpty(group.Title))
            {
                <div class="side-menu-title">@group.Title</div>
            }
            @foreach (var item in group.Items)
            {
                var active = item.Key == _active;
                <span class="side-menu-item @(active ? "side-menu-item--active" : null)">
                    @if (Menu.OnSelect != null && item.Href == null)
                    {
                        <Button Variant="@(active ? "primary" : "ghost")" Size="micro" IconLeft="@item.Icon" Disabled="@item.Disabled" title="@item.Title"
                                aria-current="@(active ? "page" : null)" @onclick="() => Menu.OnSelect?.Invoke(item.Key)">@Label(item)</Button>
                    }
                    else
                    {
                        <Button Variant="@(active ? "primary" : "ghost")" Size="micro" IconLeft="@item.Icon" Disabled="@item.Disabled" title="@item.Title"
                                aria-current="@(active ? "page" : null)" Href="@item.Href">@Label(item)</Button>
                    }
                </span>
            }
        </div>
    }
</nav>
</aside>
}

@code {
    private IReadOnlyList<SideMenuGroup> _groups = [];
    private string? _active;

    private static readonly RenderFragment<int> _iconObservr = size => @<Observr Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconUser = size => @<UserId Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconKey = size => @<Key Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconBell = size => @<Bell Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconLock = size => @<Lock Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconLab = size => @<LabExperiment Size="size" Color="currentColor" />;

    private static RenderFragment Label(SideMenuItem item) => builder =>
    {
        builder.AddContent(0, item.Label);
        if (item.Badge != null)
        {
            builder.OpenElement(1, "span");
            builder.AddAttribute(2, "class", "side-menu-badge");
            builder.AddAttribute(3, "title", item.BadgeTitle);
            builder.AddContent(4, item.Badge);
            builder.CloseElement();
        }
        if (item.Experimental)
        {
            builder.OpenElement(5, "span");
            builder.AddAttribute(6, "class", "side-menu-experimental");
            builder.AddAttribute(7, "title", "Experimental");
            builder.AddContent(8, _iconLab(14));
            builder.CloseElement();
        }
    };

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        Menu.Changed += OnMenuChanged;
        Resolve();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) { Resolve(); InvokeAsync(StateHasChanged); }
    private void OnMenuChanged() { Resolve(); _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        Menu.Changed -= OnMenuChanged;
    }

    private void Resolve()
    {
        if (Menu.Groups != null)
        {
            _groups = Menu.Groups;
            _active = Menu.Active;
            return;
        }
        (_groups, _active) = ForUrl(NavigationManager.Uri);
    }

    /// <summary>The area's sections when no page set them: admin, account. Read off the URL so the
    /// hop between pages shows the right list in the gap.</summary>
    public static (IReadOnlyList<SideMenuGroup> Groups, string? Active) ForUrl(string uri)
    {
        var path = new Uri(uri).AbsolutePath.Trim('/');
        var lower = path.ToLowerInvariant();
        if (lower.StartsWith("admin"))
        {
            var active = AdminNav.Items.FirstOrDefault(i => i.Href != null && lower.StartsWith(i.Href.Trim('/').ToLowerInvariant()))?.Value;
            return ([new SideMenuGroup("Admin", AdminNav.Items.Select(i => new SideMenuItem(i.Value, i.Label, i.Icon, i.Href)).ToList())], active);
        }
        if (lower.StartsWith("account"))
        {
            var active = lower switch
            {
                var p when p.StartsWith("account/api-key") => "keys",
                var p when p.StartsWith("account/notifications") => "notifications",
                var p when p.StartsWith("account/observr") => "observr",
                var p when p.StartsWith("account/change-password") => "password",
                _ => "account",
            };
            return ([new SideMenuGroup("Account", [
                new("account", "Account", _iconUser, "/account/manage"),
                new("keys", "API keys", _iconKey, "/account/api-key"),
                new("notifications", "Notifications", _iconBell, "/account/notifications"),
                new("observr", "Observr", _iconObservr, "/account/observr"),
                new("password", "Change password", _iconLock, "/account/change-password"),
            ])], active);
        }
        return ([], null);
    }
}
