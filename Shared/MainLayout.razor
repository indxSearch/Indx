@inherits LayoutComponentBase

@* The console's frame (Notes/Anders/console-shell-plan-2026-10-13.md, stage 1): a header with the
   brand over the column's width and the trail at the content's edge; a side column with the
   page's sections where the page has any (the dataset page, the admin and account areas), none
   on the team page; and, at the right, the Agent panel (stage 5), the window's full height beside
   the header and the page, which it pushes in when it opens. Notifications,
   the account and the Agent button are at the header's right. The layout itself renders
   statically; the header, the column and the panel are interactive islands that decide what they
   show. *@

<PageTitle>indx Rest API</PageTitle>

<div class="layout">
    <div class="layout-page">
        <header class="header">
            <NavMenu />
        </header>

        <div class="shell">
            <ConsoleSideMenu />
            <main class="content">
                @Body
            </main>
        </div>
    </div>
    @* The Agent at the right, the window's full height, beside the page rather than inside it:
       opening it pushes the page in. *@
    <AgentPanel />
</div>
