@using System.Reflection
@using Indx.Api
@* Shared admin section header + tab bar. Pass the active tab's key via Active. *@
<div style="margin-bottom: 24px;">
    <h1>Indx Cloud API @_apiVersion</h1>
    <p style="color: var(--lv5); margin-top: 4px;">Powered by Indx @_indxVersion</p>
</div>
<div style="display: flex; gap: 8px; margin-bottom: 40px; border-bottom: 1px solid var(--lv2); padding-bottom: 0;">
    @foreach (var tab in _tabs)
    {
        var active = tab.Key == Active;
        <a href="@tab.Href"
           style="padding: 8px 14px; font-size: 13px; font-weight: 500; color: @(active ? "var(--lv6)" : "var(--lv5)"); text-decoration: none; border-bottom: 2px solid @(active ? "var(--lv6)" : "transparent"); margin-bottom: -1px;">@tab.Label</a>
    }
</div>

@code {
    /// <summary>Key of the active tab: Users | Teams | Datasets | Settings | EmailPreview.</summary>
    [Parameter] public string Active { get; set; } = "";

    // Version banner (moved here from the Datasets page so it heads the admin area).
    private static readonly string _indxVersion =
        Assembly.GetAssembly(typeof(SearchEngine))?.GetName().Version?.ToString(3) ?? "";

    private static readonly string _apiVersion = GetApiVersion();

    private static string GetApiVersion()
    {
        var version = Assembly.GetExecutingAssembly()
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "";
        var plusIndex = version.IndexOf('+');
        return plusIndex > 0 ? version[..plusIndex] : version;
    }

    private static readonly (string Key, string Label, string Href)[] _tabs =
    [
        ("Users", "Users", "/admin/users"),
        ("Teams", "Teams", "/admin/teams"),
        ("Datasets", "Datasets", "/admin/datasets"),
        ("Settings", "Settings", "/admin/settings"),
        ("EmailPreview", "Email Preview", "/admin/email-preview"),
    ];
}
