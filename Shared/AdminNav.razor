@using System.Reflection
@using Indx.Api
@* The admin area: the same tab bar the dataset page uses (systm Tabs, button variant), here in
   link mode since each section is its own route. The header's trail reads "Admin"; this bar is
   the in-section navigation. Pass the active tab's key. The bar stays on one line and scrolls
   sideways when it does not fit; the version text drops to its own line below it. *@
<div class="admin-nav">
    <div class="admin-nav-tabs">
        <Tabs Items="_items" Active="@Active" Size="micro" Variant="button" Scrollable Bleed="var(--page-gutter)" AriaLabel="Admin sections" />
    </div>
    <span class="admin-version" title="Server @_apiVersion · Core @_indxVersion">Indx @_apiVersion · Core @_indxVersion</span>
</div>

@code {
    /// <summary>Key of the active tab: Users | Teams | Datasets | Activity | Settings | License | EmailPreview.</summary>
    [Parameter] public string Active { get; set; } = "";

    // Version banner (moved here from the Datasets page so it heads the admin area).
    private static readonly string _indxVersion =
        Assembly.GetAssembly(typeof(SearchEngine))?.GetName().Version?.ToString(3) ?? "";

    private static readonly string _apiVersion = GetApiVersion();

    private static string GetApiVersion()
    {
        var version = Assembly.GetExecutingAssembly()
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "";
        var plusIndex = version.IndexOf('+');
        return plusIndex > 0 ? version[..plusIndex] : version;
    }

    private static RenderFragment<int> Of<T>() where T : IComponent => size => b =>
    {
        b.OpenComponent<T>(0);
        b.AddAttribute(1, "Size", size);
        b.AddAttribute(2, "Color", "currentColor");
        b.CloseComponent();
    };

    private static readonly Tabs.TabItem[] _items =
    [
        new("Users", "Users", Of<Users>(), Href: "/admin/users"),
        new("Teams", "Teams", Of<UserGroup>(), Href: "/admin/teams"),
        new("Datasets", "Datasets", Of<Database>(), Href: "/admin/datasets"),
        new("Activity", "Activity", Of<Analytics>(), Href: "/admin/activity"),
        new("Settings", "Settings", Of<SlidersHorizontal>(), Href: "/admin/settings"),
        new("License", "License", Of<DocumentOrFile>(), Href: "/admin/license"),
        new("Email preview", "EmailPreview", Of<Bell>(), Href: "/admin/email-preview"),
    ];
}
