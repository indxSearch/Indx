@* A header menu: a ghost trigger and a systm Popover menu of ghost buttons, lined up with the
   trigger's right edge. The Popover closes it on a press outside, Escape or navigation. The label
   sits in its own span so a narrow header can hide it and keep icon plus caret; the aria-label
   carries the name when it does. *@

<span class="nav-dropdown">
<Popover Role="menu" AriaLabel="@(Title ?? Label)" Class="nav-dropdown-menu">
    <Trigger>
        <Button Variant="ghost" Size="micro" IconLeft="@Icon" IconRight="@_caret" title="@Title" aria-label="@(Title ?? Label)"><span class="nav-dropdown-label">@Label</span></Button>
    </Trigger>
    <ChildContent>@ChildContent</ChildContent>
</Popover>
</span>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment<int>? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static readonly RenderFragment<int> _caret = size => @<ChevronDown Size="size" Color="currentColor" />;
}
