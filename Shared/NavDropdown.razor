@* A header menu: a ghost trigger and a right-anchored Surface of ghost buttons — the same
   pattern the breadcrumb switchers use. Close on backdrop click, Escape, or navigation. *@
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="nav-dropdown">
    <Button Variant="ghost" Size="micro" IconLeft="@Icon" IconRight="@_caret" title="@Title" aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")" @onclick="() => _open = !_open" @onkeydown="OnKeyDown">@Label</Button>
    @if (_open)
    {
        <div class="nav-dropdown-backdrop" @onclick="() => _open = false"></div>
        <Surface Class="nav-dropdown-menu">@ChildContent</Surface>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment<int>? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _open;
    private static readonly RenderFragment<int> _caret = size => @<ChevronDown Size="size" Color="currentColor" />;

    protected override void OnInitialized() => NavigationManager.LocationChanged += OnLocationChanged;
    private void OnLocationChanged(object? s, LocationChangedEventArgs e) { if (_open) { _open = false; InvokeAsync(StateHasChanged); } }
    private void OnKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") _open = false; }
    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
