@* The header is the breadcrumb. Left: the Indx mark as the home link, with the instance name.
   Middle: whatever the current page put in HeaderState (the console's team › dataset trail),
   else a label derived from the URL. Right: notifications and one personal menu (Account,
   API keys, Admin for admins, Docs, Swagger, Log out). The menu only enters a section; the
   admin area navigates with its own tab bar under the "Admin" crumb. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IndxServer.Services.InstanceSettingsService InstanceSettingsService
@inject IndxServer.Services.IEditionService Edition
@inject IndxServer.Services.HeaderState Header

<nav class="nav">
    <a href="/" class="nav-home" title="@_instanceName">
        <IndxLogo Size="21" Color="currentColor" />
        <span class="nav-instance">@_instanceName</span>
    </a>

    <div class="nav-crumbs">
        @if (Header.Breadcrumb != null)
        {
            @Header.Breadcrumb
        }
        else
        {
            <Breadcrumbs Items="_pageCrumb" Size="micro" />
        }
    </div>

    <div class="nav-right">
        <AuthorizeView>
            <Authorized>
                <NotificationPanel />
                <NavDropdown Label="@ShortName(context.User.Identity?.Name)" Title="@context.User.Identity?.Name" Icon="_iconUser">
                    <Button Variant="ghost" Size="micro" Href="account/manage" IconLeft="_iconUser" >Account</Button>
                    <Button Variant="ghost" Size="micro" Href="account/api-key" IconLeft="_iconKey" >API keys</Button>
                    <AuthorizeView Roles="Admin" Context="admin">
                        <div class="nav-menu-divider"></div>
                        <Button Variant="ghost" Size="micro" Href="admin" IconLeft="_iconInstance" >Admin</Button>
                    </AuthorizeView>
                    <div class="nav-menu-divider"></div>
                    <Button Variant="ghost" Size="micro" Href="https://v5.docs.indx.co" IconLeft="_iconBook" >Docs ↗</Button>
                    <Button Variant="ghost" Size="micro" Href="swagger" IconLeft="_iconApi" >Swagger ↗</Button>
                    <div class="nav-menu-divider"></div>
                    <form method="post" action="account/logout" class="nav-menu-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="" />
                        <Button Type="submit" Variant="ghost" Size="micro" IconLeft="_iconLogout" >Log out</Button>
                    </form>
                </NavDropdown>
            </Authorized>
            <NotAuthorized>
                <Button Href="account/register" Variant="secondary" Size="micro">Register</Button>
                <Button Href="account/login" Variant="secondary" Size="micro">Log in</Button>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    private string _instanceName = "Indx";
    private List<Breadcrumbs.BreadcrumbItem> _pageCrumb = new();

    private RenderFragment<int> _iconInstance => size => @<Shield Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconUsers    => size => @<Users Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconDatabase => size => @<Database Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconSliders  => size => @<SlidersHorizontal Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconKey      => size => @<Key Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconBell     => size => @<Bell Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconUser     => size => @<UserId Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconApi      => size => @<Api Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconBook     => size => @<Book Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconLogout   => size => @<Logout Size="size" Color="currentColor" />;

    protected override void OnInitialized()
    {
        _instanceName = InstanceSettingsService.Load().InstanceName;
        NavigationManager.LocationChanged += OnLocationChanged;
        Header.Changed += OnHeaderChanged;
        _pageCrumb = PageCrumb();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _pageCrumb = PageCrumb();
        InvokeAsync(StateHasChanged);
    }

    private void OnHeaderChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        Header.Changed -= OnHeaderChanged;
    }

    private static string ShortName(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "Account";
        var at = name.IndexOf('@');
        return at > 0 ? name[..at] : name;
    }

    // Pages outside the console: one unlinked crumb naming the page. The console pages replace
    // this through HeaderState with their own trail.
    private List<Breadcrumbs.BreadcrumbItem> PageCrumb()
    {
        var path = new Uri(NavigationManager.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
        (string label, RenderFragment<int> icon) = path switch
        {
            var p when p.StartsWith("account/api-key") => ("API keys", _iconKey),
            var p when p.StartsWith("account/notifications") => ("Notifications", _iconBell),
            var p when p.StartsWith("account/change-password") => ("Change password", _iconKey),
            var p when p.StartsWith("account/") => ("Account", _iconUser),
            var p when p.StartsWith("admin") => ("Admin", _iconInstance),
            var p when p.StartsWith("swagger") => ("Swagger", _iconApi),
            _ => ("Datasets", _iconDatabase),
        };
        return [new Breadcrumbs.BreadcrumbItem("page", label) { Icon = icon }];
    }
}
