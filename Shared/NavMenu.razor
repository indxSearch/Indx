@* The header (Notes/Anders/console-shell-plan-2026-10-13.md, stage 1). Left, over the side
   column: the Indx mark as the home link, with a chip for the instance's standing as the
   licence portal reports it (Free, Pro, Enterprise; Managed on a managed deployment). Then the
   trail, at the content's edge: whatever the current page put in HeaderState (the console's
   team › dataset trail), else a label derived from the URL. Right: Admin (for instance admins;
   it is a page that needs a role, not a personal page), the bell, the personal menu, Observr. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IndxServer.Services.InstanceSettingsService InstanceSettingsService
@inject IndxServer.Services.IEditionService Edition
@inject IndxServer.Services.HeaderState Header
@inject IndxServer.Services.Observr.ObservrSubscription Subscription
@inject AuthenticationStateProvider AuthState

<nav class="nav">
    <div class="nav-brand">
        <a href="/" class="nav-home" title="@_instanceName">
            <IndxLogo Size="21" Color="currentColor" />
            <span class="nav-instance">@_instanceName</span>
        </a>
        @if (Standing() is { } standing)
        {
            <Chip Color="var(--lv2)" TextColor="var(--lv6)">@standing</Chip>
        }
    </div>

    <div class="nav-main">
    <div class="nav-crumbs">
        @if (Header.Breadcrumb != null)
        {
            @Header.Breadcrumb
        }
        else
        {
            <Breadcrumbs Items="_pageCrumb" Size="micro" Overflow="truncate" />
        }
    </div>

    <div class="nav-right">
        <AuthorizeView>
            <Authorized>
                @if (_admin)
                {
                    <Button Variant="ghost" Size="micro" Href="admin" IconLeft="_iconInstance" title="Admin" aria-label="Admin"><span class="nav-dropdown-label">Admin</span></Button>
                }
                <NotificationPanel />
                <NavDropdown Label="@ShortName(_name)" Title="@_name" Icon="_iconUser">
                    <Button Variant="ghost" Size="micro" Href="account/manage" IconLeft="_iconUser">Account</Button>
                    <Button Variant="ghost" Size="micro" Href="account/api-key" IconLeft="_iconKey">API keys</Button>
                    <div class="nav-menu-divider"></div>
                    <Button Variant="ghost" Size="micro" Href="https://docs.indx.co" IconLeft="_iconBook">Docs ↗</Button>
                    <Button Variant="ghost" Size="micro" Href="swagger" IconLeft="_iconApi">Swagger ↗</Button>
                    <div class="nav-menu-divider"></div>
                    <form method="post" action="account/logout" class="nav-menu-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="" />
                        <Button Type="submit" Variant="ghost" Size="micro" IconLeft="_iconLogout">Log out</Button>
                    </form>
                </NavDropdown>
                <ObservrPanel />
            </Authorized>
            <NotAuthorized>
                <Button Href="account/register" Variant="secondary" Size="micro">Register</Button>
                <Button Href="account/login" Variant="secondary" Size="micro">Log in</Button>
            </NotAuthorized>
        </AuthorizeView>
    </div>
    </div>
</nav>

@code {
    private string _instanceName = "Indx";
    private List<Breadcrumbs.BreadcrumbItem> _pageCrumb = new();
    private string _name = "Account";
    private bool _admin;

    private RenderFragment<int> _iconInstance => size => @<Shield Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconUsers    => size => @<Users Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconDatabase => size => @<Database Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconSliders  => size => @<SlidersHorizontal Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconKey      => size => @<Key Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconBell     => size => @<Bell Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconUser     => size => @<UserId Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconApi      => size => @<Api Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconBook     => size => @<Book Size="size" Color="currentColor" />;
    private RenderFragment<int> _iconLogout   => size => @<Logout Size="size" Color="currentColor" />;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated == true)
        {
            _name = auth.User.Identity.Name ?? "Account";
            _admin = auth.User.IsInRole("Admin");
        }
        _instanceName = InstanceSettingsService.Load().InstanceName;
        NavigationManager.LocationChanged += OnLocationChanged;
        Header.Changed += OnHeaderChanged;
        _pageCrumb = PageCrumb();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _pageCrumb = PageCrumb();
        InvokeAsync(StateHasChanged);
    }

    private void OnHeaderChanged() => _ = InvokeAsync(StateHasChanged);

    private static string ShortName(string name)
    {
        var at = name.IndexOf('@');
        return at > 0 ? name[..at] : name;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        Header.Changed -= OnHeaderChanged;
    }

    /// <summary>The chip beside the mark: the instance's standing. Nothing until the portal has
    /// answered, which the first page after a start asks for in the background.</summary>
    private string? Standing()
    {
        if (Edition.Edition == IndxEdition.Managed) return "Managed";
        Subscription.EnsureChecked();
        var s = Subscription.Current;
        if (!s.Known) return null;
        return s.Tier switch
        {
            "FreeDeveloper" => "Free",
            "Internal" => "Indx",
            "" => null,
            var t => t,
        };
    }

    // The fallback trail when no page has set one. For console URLs it is read off the URL —
    // team › dataset, linked but without switchers — so the hop between console pages (the
    // island is rebuilt, and the new page sets its trail only after resolving the team) shows
    // the right names in the gap rather than a placeholder. Other pages get one unlinked crumb.
    private List<Breadcrumbs.BreadcrumbItem> PageCrumb()
    {
        var path = new Uri(NavigationManager.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
        var seg = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (seg.Length >= 2 && seg[0] == "teams")
        {
            var team = Uri.UnescapeDataString(seg[1]);
            var items = new List<Breadcrumbs.BreadcrumbItem>
            {
                new("team", team) { Href = TeamRoutes.Team(team), Icon = _iconUsers },
            };
            if (seg.Length >= 4 && seg[2] == "datasets")
            {
                var dataset = Uri.UnescapeDataString(seg[3]);
                items.Add(new("dataset", dataset) { Href = TeamRoutes.Dataset(team, dataset), Icon = _iconDatabase });
            }
            else if (seg.Length >= 3 && seg[2] == "settings")
            {
                items.Add(new("page", "Settings"));
            }
            return items;
        }
        (string label, RenderFragment<int> icon) = path switch
        {
            var p when p.StartsWith("account/api-key") => ("API keys", _iconKey),
            var p when p.StartsWith("account/notifications") => ("Notifications", _iconBell),
            var p when p.StartsWith("account/change-password") => ("Change password", _iconKey),
            var p when p.StartsWith("account/") => ("Account", _iconUser),
            var p when p.StartsWith("admin") => ("Admin", _iconInstance),
            var p when p.StartsWith("swagger") => ("Swagger", _iconApi),
            _ => ("Datasets", _iconDatabase),
        };
        return [new Breadcrumbs.BreadcrumbItem("page", label) { Icon = icon }];
    }
}
