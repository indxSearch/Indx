@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IndxCloudApi.Services.InstanceSettingsService InstanceSettingsService

<nav class="nav">
    <span class="nav-current-page">
        @CurrentPage.Icon(14)
        @CurrentPage.Label
    </span>

    <div class="nav-items @(_menuOpen ? "open" : "")">
        <Button Href="/" Variant="@NavVariant("/", exact: true)" Size="micro" IconLeft="_iconHome">Datasets</Button>
        <AuthorizeView>
            <Authorized>
                <Button Href="Account/ApiKey" Variant="@NavVariant("Account/ApiKey")" Size="micro" IconLeft="_iconKey">API Key</Button>
                <Button Href="Account/License" Variant="@NavVariant("Account/License")" Size="micro" IconLeft="_iconDoc">License</Button>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin">
            <Button Href="Admin/Users" Variant="@NavVariant("Admin")" Size="micro" IconLeft="_iconAdmin">Admin</Button>
        </AuthorizeView>
        <div class="nav-external-links">
            <Button Href="swagger" Variant="ghost" Size="micro" IconLeft="_iconApi">Swagger ↗</Button>
            <Button Href="https://v5.docs.indx.co" Variant="ghost" Size="micro" IconLeft="_iconBook">Docs ↗</Button>
        </div>
    </div>

    <div class="nav-right">
        <AuthorizeView>
            <Authorized>
                <NotificationPanel />
                <Button Href="Account/Manage" Variant="@NavVariant("Account/Manage")" Size="micro" IconLeft="_iconUser">@context.User.Identity?.Name</Button>
            </Authorized>
            <NotAuthorized>
                <a href="Account/Register" class="btn btn-secondary btn-micro">Register</a>
                <a href="Account/Login" class="btn btn-secondary btn-micro">Log in</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    <button class="nav-hamburger" @onclick="ToggleMenu" aria-label="Menu">
        @if (_menuOpen)
        {
            <XOrError Size="16" />
        }
        else
        {
            <Menu Size="16" />
        }
    </button>

    @if (_menuOpen)
    {
        <div class="nav-backdrop" @onclick="CloseMenu"></div>
    }
</nav>

@code {
    private bool _menuOpen;
    private string _instanceName = "Indx";

    private RenderFragment<int> _iconHome  => size => @<Database Size="size" />;
    private RenderFragment<int> _iconKey   => size => @<Key Size="size" />;
    private RenderFragment<int> _iconUser  => size => @<UserId Size="size" />;
    private RenderFragment<int> _iconDoc   => size => @<DocumentOrFile Size="size" />;
    private RenderFragment<int> _iconApi   => size => @<Api Size="size" />;
    private RenderFragment<int> _iconBook  => size => @<Book Size="size" />;
    private RenderFragment<int> _iconAdmin => size => @<Shield Size="size" />;
    private RenderFragment<int> _iconBell  => size => @<Bell Size="size" />;

    protected override void OnInitialized()
    {
        _instanceName = InstanceSettingsService.Load().InstanceName;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private (string Label, RenderFragment<int> Icon) CurrentPage
    {
        get
        {
            var path = new Uri(NavigationManager.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
            if (path == "") return ("Datasets", _iconHome);
            if (path.StartsWith("account/apikey")) return ("API Key", _iconKey);
            if (path.StartsWith("account/license")) return ("License", _iconDoc);
            if (path.StartsWith("account/manage")) return ("Account", _iconUser);
            if (path.StartsWith("swagger")) return ("Swagger", _iconApi);
            if (path.StartsWith("admin")) return ("Admin", _iconAdmin);
            return ("Datasets", _iconHome);
        }
    }

    private string NavVariant(string href, bool exact = false)
    {
        var current = new Uri(NavigationManager.Uri).AbsolutePath.Trim('/');
        var target = href.Trim('/');
        var isActive = exact
            ? current.Equals(target, StringComparison.OrdinalIgnoreCase)
            : current.StartsWith(target, StringComparison.OrdinalIgnoreCase) && target.Length > 0;
        return isActive ? "primary" : "ghost";
    }
}
