@* The team page's dataset section: a card per dataset (state at a glance, link into the
   dataset page) and the "new dataset" form. Replaces the tab strip the console used to be.
   Cards read the keep-alive view and the in-memory instance only — never GetState, which would
   wake every timed dataset of the team just to list it. *@
@using Indx.Api
@inject IDatasetEngines Engines
@inject NavigationManager NavigationManager
@inject ILogger<DatasetList> Logger
@implements IDisposable

<div class="indx-datasets-heading">
    <h2>Datasets</h2>
    @* The page action pattern (app.css): the primary "New …" leads the actions on top. The empty
       state carries the button itself, as its call to action, so it is not repeated here. *@
    @if (CanCreate && _rows.Count > 0)
    {
        <Button Variant="primary" Size="micro" IconLeft="DatasetIcons.PanelAdd" @onclick="OpenNewDataset">New dataset</Button>
    }
    @HeadingActions
</div>

@if (_rows.Count == 0)
{
    <div class="indx-empty-state">
        <p class="indx-empty-intro">A dataset holds your JSON documents and search index. Create one here to get started.</p>
        @if (CanCreate)
        {
            <Button Variant="primary" Size="micro" IconLeft="DatasetIcons.PanelAdd" @onclick="OpenNewDataset">New dataset</Button>
        }
        <div class="indx-empty-skill">
            <p class="indx-empty-intro indx-empty-intro--tight">Using an LLM to set up your search? Get the skill.</p>
            <Button Variant="secondary" Size="micro" IconLeft="DatasetIcons.Agent" Href="https://www.skills.sh/indxsearch/skill-indx-search/indx-search">Indx Agent Skill ↗</Button>
        </div>
    </div>
}
else
{
    <div class="indx-dataset-grid">
        @foreach (var row in _rows)
        {
            <a class="indx-dataset-card" href="@TeamRoutes.Dataset(TeamName, row.Name)">
                <span class="indx-dataset-card-head">
                    <Database Size="14" Color="currentColor" />
                    <span class="indx-dataset-card-name">@row.Name</span>
                </span>
                @* Everything below is read from the keep-alive view and the in-memory instance, so
                   a hibernated dataset simply has less to show rather than being woken to fill it.
                   A row is omitted when its value is unknown: a blank value reads as zero. *@
                @if (!row.Pending && row.HasDetail)
                {
                    @* The Status tab's shape (StatusTab.razor.css): a label column in --lv4 at a
                       fixed width, values in --lv6 beside it. One row per fact rather than facts
                       packed onto a line -- which is what made this read as loose text. *@
                    <span class="indx-dataset-card-detail">
                        @if (row.LastIndexed is { } indexed)
                        {
                            <span class="indx-dataset-card-term">Last indexed</span>
                            <span class="indx-dataset-card-value"><TimeAgo Value="indexed" /></span>
                        }
                        @if (row.LastUsed is { } used)
                        {
                            <span class="indx-dataset-card-term">Last used</span>
                            <span class="indx-dataset-card-value"><TimeAgo Value="used" /></span>
                        }
                        <span class="indx-dataset-card-term">Keep-alive</span>
                        <span class="indx-dataset-card-value">@row.KeepAlive</span>
                        @* Last, so the rows above it are the ones every dataset has. A hibernated
                           dataset has no engine to read a field shape from, and putting it here
                           means its card is this one minus the tail rather than a different
                           shape. *@
                        @if (row.Fields is { } f)
                        {
                            <span class="indx-dataset-card-term">Fields</span>
                            <span class="indx-dataset-card-value">@f.Total</span>
                            @* The Search preview's facet chips (SearchPreviewTab): a label and
                               its count in one chip, the count set off and dimmer. Wraps, so the
                               four roles read as a set. *@
                            <span class="indx-dataset-card-fields">
                                <Chip Color="var(--lv2)" TextColor="var(--lv7)"><span>searchable</span><span class="indx-dataset-card-rolecount">@f.Searchable</span></Chip>
                                <Chip Color="var(--lv2)" TextColor="var(--lv7)"><span>filterable</span><span class="indx-dataset-card-rolecount">@f.Filterable</span></Chip>
                                <Chip Color="var(--lv2)" TextColor="var(--lv7)"><span>facetable</span><span class="indx-dataset-card-rolecount">@f.Facetable</span></Chip>
                                <Chip Color="var(--lv2)" TextColor="var(--lv7)"><span>preloaded</span><span class="indx-dataset-card-rolecount">@f.Preloaded</span></Chip>
                            </span>
                        }
                    </span>
                }
                <span class="indx-dataset-card-foot">
                    @if (row.Pending)
                    {
                        <span class="indx-dataset-card-count"><Spinner Size="12" /></span>
                    }
                    else
                    {
                        <Chip Size="small" Color="@row.Chip.Color" TextColor="@row.Chip.TextColor" Icon="@row.Chip.Icon">@row.ChipLabel</Chip>
                        @if (row.Count is { } n)
                        {
                            <span class="indx-dataset-card-count">@n.ToString("N0") @row.CountNoun</span>
                        }
                    }
                </span>
            </a>
        }
    </div>
}

<Modal Open="_showNewDatasetForm" OpenChanged="@(open => { if (!open) CancelNewDataset(); })" Title="New dataset"
       Description="Name it now; the JSON upload is the first step on its page.">
    <div class="indx-modal-form">
        <InputField Label="Dataset name" placeholder="e.g. products" @bind-Value="_newDatasetName"
                    @oninput="OnNewDatasetInput" @onkeydown="OnNewDatasetKeyDown" />
        @if (!string.IsNullOrEmpty(_createError))
        {
            <p class="indx-create-error">@_createError</p>
        }
        <div class="indx-form-actions">
            <Button Variant="primary" Size="micro" @onclick="CreateDataset" disabled="@string.IsNullOrWhiteSpace(_newDatasetName)">Create</Button>
            <Button Variant="secondary" Size="micro" @onclick="CancelNewDataset">Cancel</Button>
        </div>
    </div>
</Modal>

@code {
    [Parameter, EditorRequired] public string TeamId { get; set; } = "";
    [Parameter, EditorRequired] public string TeamName { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    /// <summary>Rendered at the right end of the "Datasets" heading row.</summary>
    [Parameter] public RenderFragment? HeadingActions { get; set; }

    private bool CanCreate => TeamRoles.CanWrite(Role);

    /// <summary>How the dataset is configured, for the card. Only knowable while an engine is
    /// loaded, which is why it is optional rather than zeroed.</summary>
    private sealed record FieldShape(int Total, int Searchable, int Filterable, int Facetable, int Preloaded);

    private sealed record Row(string Name, string Label, DatasetStateChip Chip, int? Count, int? Percent = null,
                              FieldShape? Fields = null, DateTime? LastIndexed = null,
                              DateTime? LastUsed = null, int KeepAliveHrs = int.MaxValue,
                              bool CountsAreOnDisk = false)
    {
        /// <summary>Documents when the engine holds them, records on disk when it does not. The
        /// noun changes with it, because "41,562 documents" on a hibernated dataset would claim
        /// they are searchable.</summary>
        public string CountNoun => CountsAreOnDisk
            ? (Count == 1 ? "record on disk" : "records on disk")
            : (Count == 1 ? "document" : "documents");

        public string KeepAlive => KeepAliveHrs switch
        {
            int.MaxValue => "pinned",
            0 => "off (manual)",
            1 => "1 hour idle",
            _ => $"{KeepAliveHrs} hours idle",
        };

        /// <summary>Keep-alive is always known, so a settled card always has a detail block; a
        /// transitional one does not, since its figures are about to change anyway.</summary>
        public bool HasDetail => Label is not ("Loading" or "Loaded" or "Indexing" or "Waking" or "Hibernating" or "Unknown");

        /// <summary>"Indexing 42%" while there is progress to report, otherwise just the state.
        /// A percentage only appears once the monitor has one, so the chip does not flash 0%.</summary>
        public string ChipLabel => Percent is > 0 and { } pct ? $"{Label} {pct}%" : Label;

        /// <summary>Status not read yet — the card shows the name and a spinner.</summary>
        public bool Pending { get; init; }
        public static Row PendingFor(string name) => new(name, "", DatasetStateChip.Empty, null) { Pending = true };
    }

    private CancellationTokenSource? _describeCts;

    private List<Row> _rows = new();
    private string _newDatasetName = string.Empty;
    private bool _showNewDatasetForm;
    private string? _createError;
    private string? _loadedFor;

    protected override void OnParametersSet()
    {
        if (_loadedFor == TeamId) return;
        _loadedFor = TeamId;
        _showNewDatasetForm = false;
        _newDatasetName = string.Empty;
        _createError = null;
        Reload();
    }

    /// <summary>Re-read the team's datasets: the names render at once, each card's state is
    /// filled in off the circuit thread as it is read (a record count per dataset is a COUNT(*)
    /// on disk — cheap, but not free on a large dataset, and never worth blocking the page for).</summary>
    public void Reload()
    {
        List<string> names;
        try { names = string.IsNullOrEmpty(TeamId) ? [] : Engines.GetTeamDataSets(TeamId); }
        catch { names = []; }
        _rows = names.Select(Row.PendingFor).ToList();

        _describeCts?.Cancel();
        var cts = _describeCts = new CancellationTokenSource();
        var teamId = TeamId;
        _ = Task.Run(async () =>
        {
            foreach (var name in names)
            {
                if (cts.IsCancellationRequested) return;
                var row = Describe(name, teamId);
                await InvokeAsync(() =>
                {
                    if (cts.IsCancellationRequested) return;
                    var i = _rows.FindIndex(r => r.Name == name);
                    if (i >= 0) _rows[i] = row;
                    StateHasChanged();
                });
            }

            // Keep the moving ones moving. The loop re-describes only the rows that were in a
            // transient state and stops as soon as none are, so a settled team page costs nothing:
            // no timer runs once everything is Ready, Hibernated or Empty.
            await ProgressPoller.RunAsync(TimeSpan.FromMilliseconds(600),
                tick: () =>
                {
                    if (cts.IsCancellationRequested) return false;
                    bool stillMoving = false;
                    for (var i = 0; i < _rows.Count; i++)
                    {
                        if (!IsTransient(_rows[i])) continue;
                        _rows[i] = Describe(_rows[i].Name, teamId);
                        stillMoving |= IsTransient(_rows[i]);
                    }
                    return stillMoving;
                },
                render: () => InvokeAsync(StateHasChanged),
                ct: cts.Token);
        }, cts.Token);
    }

    public void Dispose() => _describeCts?.Cancel();

    /// <summary>A row that is still going to change on its own: something is loading, indexing or
    /// rebuilding, or warm-up has not reached it yet. Only these are re-read while the page is
    /// open; anything else is settled until the user acts.</summary>
    private static bool IsTransient(Row row) =>
        row.Percent is not null || row.Label is "Loading" or "Loaded" or "Indexing" or "Waking" or "Hibernating";

    private Row Describe(string name, string teamId)
    {
        try
        {
            var ka = Engines.GetKeepAliveInfo(name, teamId);
            var engine = Engines.FindSearchEngine(name, teamId);
            var state = engine is { IsDisposed: false } ? engine.Status.SystemState : (SystemState?)null;
            var lastUsed = ka.LastUsedUtc?.UtcDateTime;
            if (state == SystemState.Ready)
            {
                // A Ready dataset can still be rebuilding on a shadow engine while it keeps serving.
                var rebuilding = Engines.GetProgressPercent(name, teamId);
                // The count stays: a rebuild runs on a shadow engine while this one keeps serving, so
                // the documents it reports are real and still being searched.
                return rebuilding is { } pct
                    ? new Row(name, "Rebuilding", DatasetStateChip.Working(SystemState.Indexing), engine!.Status.DocumentCount, pct)
                    : new Row(name, "Ready", DatasetStateChip.For(SystemState.Ready), engine!.Status.DocumentCount,
                              Fields: Shape(engine), LastIndexed: engine!.Status.TimeOfLastIndexBuild,
                              LastUsed: lastUsed, KeepAliveHrs: ka.KeepAliveTimeHrs);
            }
            // A wake being cancelled leaves its engine in Error (load) or Loaded (index) until it is
            // disposed a moment later. Asked first, so neither is reported as the dataset's state.
            if (Engines.GetWakeProgress(name, teamId) is { Cancelling: true })
                return new Row(name, "Hibernating", DatasetStateChip.Hibernated, ka.RecordCount);
            if (state is SystemState.Loading or SystemState.Loaded or SystemState.Indexing)
                return new Row(name, state.ToString()!, DatasetStateChip.For(state.Value), null,
                               Engines.GetProgressPercent(name, teamId));
            if (state == SystemState.Error)
                return new Row(name, "Error", DatasetStateChip.For(SystemState.Error), null);
            // Data on disk and not loaded is hibernated, whatever the keep-alive policy says: that
            // is what the word means to the reader, and the engine shell being registered or not is
            // an implementation detail. The one case that is genuinely different is a dataset
            // something is working on right now, which used to read "Hibernated" while warm-up was
            // actively loading it. Ask for that directly rather than inferring it from the state.
            if (ka.RecordCount > 0)
                return Engines.IsWorkInProgress(name, teamId)
                    ? new Row(name, "Waking", DatasetStateChip.Working(), ka.RecordCount, Engines.GetProgressPercent(name, teamId))
                    // No engine, so no field shape and no last-index time. The count is what is on
                    // disk, which CountNoun says rather than calling them documents.
                    : new Row(name, "Hibernated", DatasetStateChip.Hibernated, ka.RecordCount,
                              LastUsed: lastUsed, KeepAliveHrs: ka.KeepAliveTimeHrs, CountsAreOnDisk: true);
            return new Row(name, "Empty", DatasetStateChip.Empty, null,
                           LastUsed: lastUsed, KeepAliveHrs: ka.KeepAliveTimeHrs);
        }
        catch
        {
            return new Row(name, "Unknown", DatasetStateChip.Empty, null);
        }
    }

    /// <summary>The field configuration as three counts. Read from the engine already in hand, so
    /// it costs a dictionary walk and never wakes anything; null when there is no engine or it has
    /// no configuration yet, which is what keeps the row off a hibernated card.</summary>
    private static FieldShape? Shape(IServerSearchEngine? engine)
    {
        try
        {
            var fields = engine?.GetFieldConfiguration();
            if (fields is not { Length: > 0 }) return null;
            return new FieldShape(
                fields.Length,
                fields.Count(f => f.Searchable == true),
                fields.Count(f => f.Filterable == true),
                fields.Count(f => f.Facetable == true),
                fields.Count(f => f.PreloadFilters == true));
        }
        catch
        {
            return null;   // a card is not worth an exception
        }
    }

    // ── Create dataset ──────────────────────────────────────────────────────

    // Live on every keystroke so Create enables immediately (bind-Value alone commits on blur).
    private void OnNewDatasetInput(ChangeEventArgs e) => _newDatasetName = e.Value?.ToString() ?? string.Empty;

    private async Task OnNewDatasetKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateDataset();
    }

    private void OpenNewDataset()
    {
        _createError = null;
        _showNewDatasetForm = true;
    }

    private void CancelNewDataset()
    {
        _showNewDatasetForm = false;
        _newDatasetName = string.Empty;
        _createError = null;
    }

    private Task CreateDataset()
    {
        _createError = DatasetCreation.TryCreate(_newDatasetName, TeamId, Logger, out var name);
        if (_createError != null) return Task.CompletedTask;
        _newDatasetName = string.Empty;
        _showNewDatasetForm = false;
        // A new dataset's first step is the upload, which lives on its page.
        NavigationManager.NavigateTo(TeamRoutes.Dataset(TeamName, name));
        return Task.CompletedTask;
    }
}
