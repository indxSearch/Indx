@* Quick search against the live engine (with the dataset's boost rules applied, as real
   searches see them) plus an engine-side timing loop. Reads the edited field configuration
   from the context to pick which fields to show per hit. *@
@using System.Text.Json
@using Indx.Api
@using IndxServer.Models

@inherits DatasetTabBase
@if (!Active) { return; }

@if (Ctx.EngineState == SystemState.Ready)
{
    <div class="indx-search-panel">
        @if (string.IsNullOrEmpty(_text))
        {
