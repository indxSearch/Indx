@* Field configuration for a Ready dataset: the editable table, key field, import/export,
   and Save — which reindexes on a shadow engine when the change requires it, with progress. *@
@using Indx.Api
@using IndxServer.Models
@using IndxServer.Services

@inherits DatasetTabBase
@inject IndxServer.Services.Observr.AgentPanelState Agent
@inject IServiceProvider Services
@inject IndxServer.Services.FieldProfileStore ProfileStore
@if (!Active) { return; }

@if (!Ctx.IsSaving)
{
    <FieldConfigToolbar @bind-Filter="_filter" @bind-ShowUnused="_showUnused" @bind-ShowAdvanced="_showAdvanced">
        @if (Ctx.IsEditor && Ctx.EditedFields != null)
        {
            <Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.Sliders" @onclick="() => _managing = true">Profile manager</Button>
        }
        <ObservrPageAction Label="Review my setup" OnClick="ReviewInAgent" Disabled="@Ctx.IsDirty" />
    </FieldConfigToolbar>
}

@if (!string.IsNullOrEmpty(_saveError))
{
    <p class="fc-error">@_saveError</p>
}

@if (Ctx.IsSaving)
{
    <div class="indx-field-config-saving">
        <ProgressBar Value="Ctx.ShadowBuildPercent" ShowLabel FulfilledColor />
        <p class="indx-field-config-saving-label">@(Ctx.ShadowBuildPercent == 0 ? "Preparing…" : "Reindexing…")</p>
    </div>
}
else if (Ctx.EditedFields is { } fields)
{
    <FieldConfigTable Fields="fields" Editable="@Ctx.IsEditor" ShowUnused="_showUnused" ShowAdvanced="_showAdvanced" Filter="@_filter"
                      Scoring="@(Ctx.FindEngine()?.Scoring ?? ScoringSetup.Default)"
                      @bind-SearchableTouched="_searchableTouched" OnChanged="Ctx.NotifyChanged"
                      Profiles="@Ctx.EditedProfiles" OnEditProfile="EditProfile" OnNewProfile="NewProfileFor" />
    @if (_editing is { } editing)
    {
        <FieldProfileModal Open="true" OpenChanged="@(o => { if (!o) { _editing = null; _newFor = null; BackToManager(); } })" Profile="editing"
                           Before="@(_editingField == null && editing.Id.Length > 0 ? SavedProfile(editing.Id) : null)"
                           CustomField="@_editingField?.FieldName"
                           UsedBy="@(_editingField != null ? [_editingField.FieldName] : UsedBy(editing.Id, patternOnly: false))"
                           UsedByPattern="@(_editingField != null ? (_editingField.PatternMatching == true ? [_editingField.FieldName] : []) : UsedBy(editing.Id, patternOnly: true))"
                           Editable="@Ctx.IsEditor" OnSave="SaveProfile"
                           OnDelete="@(_editingField == null && editing.Id.Length > 0 ? EventCallback.Factory.Create(this, DeleteProfile) : default)" />
    }
    @if (_managing && Ctx.EditedProfiles is { } own)
    {
        <FieldProfileManagerModal Open="true" OpenChanged="@(o => _managing = o)" Profiles="own" Fields="fields" Editable="@Ctx.IsEditor"
                                  OnEdit="EditFromManager" OnNew="NewFromManager" OnChanged="Ctx.NotifyChanged" />
    }
    @* The page action pattern (app.css): Save / Cancel in a bar that appears once something
       changed and sticks to the window bottom, since this table is often taller than the screen.
       Export and import close the page. The document key follows below. *@
    @if (ChangedUnderEdit)
    {
        <Alert Variant="warning">
            <Title>Observr changed the saved field setup</Title>
            <Description>You have unsaved changes here. Save keeps yours; Cancel shows the ones Observr applied.</Description>
        </Alert>
    }
    <SaveBar Visible="@(Ctx.IsEditor && Ctx.IsDirty)" Message="Unsaved changes">
        <Button Variant="primary" Size="micro" IconLeft="DatasetIcons.Save" @onclick="Save" disabled="@(!Ctx.HasSearchable)">Save</Button>
        <Button Variant="secondary" Size="micro" @onclick="Cancel">Cancel</Button>
        @if (_searchableTouched && !Ctx.HasSearchable)
        {
            <span class="indx-field-config-error">At least one field must be searchable</span>
        }
    </SaveBar>
    <div class="indx-file-actions">
        <FieldConfigFileActions CanImport="@Ctx.IsEditor" IdSuffix="-ready" OnImported="StateHasChanged" />
    </div>
    <KeyFieldRow Editable="@Ctx.IsEditor" />
}

@code {

    private bool _showUnused;
    /// <summary>The review runs in the Agent panel as a turn; a Yes there applies the field
    /// changes through the same path as Save. While that rebuilds, the tab shows its progress bar
    /// as it does for its own Save; after, it re-reads the engine's fields.</summary>
    private void ReviewInAgent() => Agent.Run(new IndxServer.Services.Observr.AgentAction("Review my field setup",
        ct => Observr().AskFieldReviewAsync(Ctx.TeamId, Ctx.Name, ct),
        OnApplied: () => InvokeAsync(() =>
        {
            _applyPolling?.Cancel();
            _applyPolling = null;
            Ctx.RefreshFieldsFromEngine();
            Ctx.IsSaving = false;
            Ctx.ShadowBuildPercent = 0;
            Ctx.RefreshStatus();
            Ctx.NotifyChanged();
        }),
        OnApplying: () => InvokeAsync(() =>
        {
            Ctx.IsSaving = true;
            Ctx.ShadowBuildPercent = 0;
            Ctx.NotifyChanged();
            _applyPolling = new CancellationTokenSource();
            _ = ProgressPoller.RunAsync(TimeSpan.FromMilliseconds(100),
                () => { Ctx.ShadowBuildPercent = Ctx.Engines.GetShadowBuildPercent(Ctx.Name, Ctx.TeamId); return true; },
                () => InvokeAsync(() => { StateHasChanged(); Ctx.NotifyChanged(); }), _applyPolling.Token);
        })));
    private CancellationTokenSource? _applyPolling;
    private IndxServer.Services.Observr.ObservrClient Observr() => Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions.GetRequiredService<IndxServer.Services.Observr.ObservrClient>(Services);

    private string? _filter;
    private bool _showAdvanced;
    private bool _searchableTouched;
    private string? _saveError;
    private CancellationTokenSource? _pollCts;

    // ── Field profiles (Nov 2026) ─────────────────────────────────────────
    // The editor is open on this profile; with _editingField set, on that field's own values
    // (Custom). Saving writes into the context's working copy, which Save sends on.
    private FieldProfile? _editing;
    private FieldProxy? _editingField;
    // A new profile started from a field's Profile menu: that field has it once it is made.
    private FieldProxy? _newFor;
    // The profile manager is open; with _fromManager, the editor was opened from it and closing
    // the editor goes back to it.
    private bool _managing;
    private bool _fromManager;

    private void EditFromManager(string id)
    {
        if (FieldProfiles.All(Ctx.EditedProfiles).FirstOrDefault(p => p.Id == id) is not { } profile) return;
        _managing = false;
        _fromManager = true;
        _editingField = null;
        _newFor = null;
        _editing = profile;
    }

    private void NewFromManager()
    {
        _managing = false;
        _fromManager = true;
        NewProfile();
    }

    private void BackToManager()
    {
        if (!_fromManager) return;
        _fromManager = false;
        _managing = true;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Active && Ctx.EditedProfiles == null)
            Ctx.SetSavedProfiles(ProfileStore.Load(Ctx.TeamId, Ctx.Name));
    }

    private FieldProfile? SavedProfile(string id) => FieldProfiles.All(Ctx.SavedProfiles).FirstOrDefault(p => p.Id == id);

    /// <summary>The searched fields that have the profile; with patternOnly, those with
    /// PatternMatching on, the ones that read its pattern setup.</summary>
    private IReadOnlyList<string> UsedBy(string id, bool patternOnly) =>
        (Ctx.EditedFields ?? []).Where(f => FieldProfiles.IsSearched(f) && (!patternOnly || f.PatternMatching == true)
                                            && FieldProfiles.ProfileOf(f, Ctx.EditedProfiles)?.Id == id)
                                .Select(f => f.FieldName).ToList();

    private void NewProfile()
    {
        _editingField = null;
        _newFor = null;
        _editing = new FieldProfile { Id = "", Name = "" };
    }

    private void NewProfileFor(FieldProxy field)
    {
        NewProfile();
        _newFor = field;
    }

    /// <summary>Edit in a field's Profile menu: the profile on that row, chosen for the field or
    /// not; with no id, the field's own values while it is Custom.</summary>
    private void EditProfile(FieldConfigTable.ProfileEdit edit)
    {
        _newFor = null;
        if (edit.ProfileId is { } id && FieldProfiles.All(Ctx.EditedProfiles).FirstOrDefault(p => p.Id == id) is { } profile)
        {
            _editingField = null;
            _editing = profile;
        }
        else
        {
            _editingField = edit.Field;
            _editing = FieldProfiles.FromField(edit.Field);
        }
    }

    private void SaveProfile(FieldProfile edited)
    {
        if (Ctx.EditedProfiles is { } own && Ctx.EditedFields is { } fields)
            FieldProfiles.SaveEdit(own, fields, _editingField, edited, _newFor);
        _editing = null;
        _editingField = null;
        _newFor = null;
        BackToManager();
        Ctx.NotifyChanged();
    }

    private void DeleteProfile()
    {
        if (_editing is { } p && Ctx.EditedProfiles is { } own && UsedBy(p.Id, patternOnly: false).Count == 0)
        {
            own.Profiles.RemoveAll(x => x.Id == p.Id);
            foreach (var key in own.Assignments.Where(a => a.Value == p.Id).Select(a => a.Key).ToList())
                own.Assignments.Remove(key);
        }
        _editing = null;
        BackToManager();
        Ctx.NotifyChanged();
    }

    private void Cancel()
    {
        Ctx.CancelEdits();
        Ctx.NotifyChanged();
    }

    private void Save()
    {
        var edited = Ctx.EditedFields;
        if (edited == null || !Ctx.HasSearchable) return;

        Ctx.IsSaving = true;
        Ctx.ShadowBuildPercent = 0;
        _saveError = null;
        Ctx.NotifyChanged();

        _ = RunSaveAsync(edited);
    }

    private async Task RunSaveAsync(FieldProxy[] edited)
    {
        _pollCts?.Dispose();
        _pollCts = new CancellationTokenSource();
        var pollingTask = ProgressPoller.RunAsync(TimeSpan.FromMilliseconds(100),
            () => { Ctx.ShadowBuildPercent = Ctx.Engines.GetShadowBuildPercent(Ctx.Name, Ctx.TeamId); return true; },
            Render, _pollCts.Token);

        try
        {
            await Task.Run(() =>
            {
                var engine = Ctx.FindEngine();
                if (engine == null) return;
                var df = engine.DocumentFields;
                // Refused as a whole and before anything is changed, as the HTTP route does. A
                // refusal throws with the reason, which the catch below shows.
                if (!engine.TryValidateFieldConfiguration(edited, out var invalid))
                    throw new ArgumentException(invalid);
                // Also for a field getting its first role: see FieldConfigurationChange.
                bool needsReindex = df != null && FieldConfigurationChange.NeedsRebuild(df, edited);
                // Before applying: afterwards the old configuration is gone and there is nothing
                // left to diff against.
                FieldConfigurationChange.Announce(df, edited, Ctx.Name, Ctx.TeamId);
                if (needsReindex && engine.Status.SystemState == SystemState.Ready)
                    Ctx.Engines.RunFieldConfigurationOnShadow(Ctx.Name, Ctx.TeamId, edited);
                else
                    FieldConfigurationChange.ApplyInPlace(engine, edited, Ctx.Name, Ctx.TeamId);
            });

            Ctx.RefreshFieldsFromEngine();
            // The profiles after the fields: a profile names values the engine now has.
            if (Ctx.EditedProfiles is { } profiles)
            {
                ProfileStore.Save(Ctx.TeamId, Ctx.Name, profiles);
                Ctx.SetSavedProfiles(profiles);
            }
        }
        catch (ShadowBusyException)
        {
            _saveError = "A shadow build is already in progress. Please wait for it to complete.";
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            _saveError = $"Save failed: {ex.Message}";
        }
        finally
        {
            _pollCts.Cancel();
            try { await pollingTask; } catch { }
            Ctx.IsSaving = false;
            Ctx.ShadowBuildPercent = 0;
            Ctx.RefreshStatus();
            try { await Render(); }
            catch (ObjectDisposedException) { }
        }
    }

    /// <summary>Set when Observr changed the saved fields while the working copy held unsaved edits.</summary>
    private bool _changedUnderEdit;
    /// <summary>The notice, while the edits it is about are still unsaved: a Save or a Cancel ends
    /// them, and with them the notice, so a later edit does not show it for an old change.</summary>
    private bool ChangedUnderEdit { get { if (!Ctx.IsDirty) _changedUnderEdit = false; return _changedUnderEdit; } }

    /// <summary>A field change Observr applied (the rebuild is done by then): the fields are read
    /// again, unless the working copy holds edits, which stay with a notice.</summary>
    protected override void OnObservrApplied(IReadOnlySet<string> kinds)
    {
        if (!kinds.Contains(IndxServer.Services.Observr.ObservrProposal.FieldKind)) return;
        if (Ctx.IsDirty) { _changedUnderEdit = true; return; }
        _changedUnderEdit = false;
        Ctx.RefreshFieldsFromEngine();
        Ctx.RefreshStatus();
    }

    public override void Dispose()
    {
        base.Dispose();
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }
}
