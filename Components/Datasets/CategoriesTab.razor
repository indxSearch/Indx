@* The dataset's categories as a tree, across the width: a hierarchy group (fields that each hold
   a level, "category.department › section › type") or a path field ("Apparel > Shoes > Running
   shoes") drawn on a TreeCanvas with the products in each category counted. The chosen category's
   products float in a panel over the canvas. Sources are found from the field configuration and
   one facet read, so the picker offers only what draws a tree. A path field's histogram is the
   engine's cached empty search with facets; a group's comes from a pass over the documents. Both
   run off the circuit thread with a timeout, only while the dataset is Ready, never waking one.
   The tree lists categories, never products: those come twenty at a time for the chosen one.
   Marks on a node (a boost rule, never selected, never purchased in the statistics window) are
   quiet: the figures are Observr's business, the tree is for seeing the catalogue. *@
@using System.Text.Json
@using Indx.Api
@using IndxServer.Services
@inherits DatasetTabBase
@inject DatasetMetadataStore Metadata
@inject BoostRuleStore BoostStore
@inject StatisticsService Stats
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (!Active) { return; }

<div class="browse-tab">
    @if (_sources == null)
    {
        <p class="browse-note">@(_error ?? "Reading the fields…")</p>
    }
    else if (_sources.Count == 0)
    {
        @* No hierarchy among the facetable fields: the page is the guide, in the shape of the
           datasets page's first visit. The two shapes the tree reads, each drawn as the tree it
           would make, and the step to Field configuration for an editor. *@
        <div class="browse-empty">
            <div class="browse-empty-message">
                <span class="browse-empty-icon"><NodeTree Size="70" Color="var(--lv4)" /></span>
                <div class="browse-empty-title">No hierarchy to browse</div>
                <div class="browse-empty-detail">
                    The tree is drawn from a facetable field whose values are paths, or from fields that each hold a level. This dataset has neither marked Facetable yet.
                </div>
            </div>
            <div class="browse-empty-shapes">
                <div class="browse-empty-shape">
                    <h4 class="browse-empty-shape-title">A path in one field</h4>
                    <p class="browse-empty-shape-text">One value per product with the levels in it, the way a Google product feed writes <code>product_type</code> and <code>google_product_category</code>. Any separator the values agree on works.</p>
                    <pre class="browse-empty-code">"product_type": "@_pathSample"</pre>
                    <div class="browse-empty-tree"><TreeCanvas Roots="_pathExample" DefaultExpanded="_pathOpen" AriaLabel="A tree from a path field" /></div>
                </div>
                <div class="browse-empty-shape">
                    <h4 class="browse-empty-shape-title">A level per field</h4>
                    <p class="browse-empty-shape-text">Fields that share a prefix and each hold one level, as a nested object does. Two or more of them, marked Facetable, make a group.</p>
                    <pre class="browse-empty-code">"category": { "department": "@_groupSample[0]", "section": "@_groupSample[1]", "type": "@_groupSample[2]" }</pre>
                    <div class="browse-empty-tree"><TreeCanvas Roots="_groupExample" DefaultExpanded="_groupOpen" AriaLabel="A tree from level fields" /></div>
                </div>
            </div>
            @if (Ctx.IsEditor)
            {
                <div class="browse-empty-actions">
                    <Button Variant="primary" Size="micro" IconLeft="DatasetIcons.Fields" @onclick="@(() => { Ctx.ActiveTab = "fields"; Ctx.NotifyChanged(); })">Open Field configuration</Button>
                    <span class="browse-empty-hint">Mark the field, or the group's fields, Facetable and save; the tree reads them at once.</span>
                </div>
            }
        </div>
    }
    else
    {

        @if (_error != null)
        {
            <Alert Variant="warning"><Title>The categories could not be read</Title><Description>@_error</Description></Alert>
        }
        @if (_tree != null && _tree.Cut > 0)
        {
            <p class="browse-note">@_tree.Cut.ToString("N0") path@(_tree.Cut == 1 ? "" : "s") deeper than @CategoryHierarchy.MaxDepth levels @(_tree.Cut == 1 ? "is" : "are") cut at level @CategoryHierarchy.MaxDepth.</p>
        }
        <div class="browse-frame" @ref="_frame">
        <div class="indx-list-toolbar browse-toolbar">
            <div class="browse-tb-source">
                <SelectField Size="micro" Variant="ghost" Options="SourceOptions" Value="@_source?.Key" ValueChanged="OnSourceChanged" aria-label="Hierarchy" />
                @if (Ctx.IsEditor && _source is { IsGroup: false })
                {
                    <span class="browse-label">Separator</span>
                    <SelectField Size="micro" Variant="ghost" Options="SeparatorOptions" Value="@SeparatorValue" ValueChanged="OnSeparatorChanged" aria-label="Level separator" />
                }
            </div>
            @if (_tree != null)
            {
                <div class="browse-tb-filter">
                    <SearchField Size="micro" Placeholder="Filter categories" Value="@_filter" ValueChanged="OnFilterChanged" aria-label="Filter categories by name" />
                </div>
            }
            <div class="browse-tb-controls">
                @if (_tree != null)
                {
                    <span class="browse-count">@_tree.Nodes.ToString("N0") categories, @(_tree.Depth) level@(_tree.Depth == 1 ? "" : "s")</span>
                    @if (_tree.Depth > 1)
                    {
                        <span class="browse-label">Open to</span>
                        <SegmentedControl Size="micro" AriaLabel="Open to level" Value="@_openDepth.ToString()" ValueChanged="@(v => _openDepth = int.Parse(v))" Items="DepthItems()" />
                    }
                    <SegmentedControl Size="micro" AriaLabel="Zoom" Value="@_zoom" ValueChanged="@(v => _zoom = v)" Items="_zooms" />
                }
                <SegmentedControl Size="micro" AriaLabel="View" @bind-Value="_view" Items="_views" />
            </div>
            <span class="browse-tb-full">
                <Button Variant="ghost" Size="micro" IconLeft="@(_fullscreen ? DatasetIcons.Minimize : DatasetIcons.Maximize)" aria-label="@(_fullscreen ? "Leave full screen" : "Full screen")" title="@(_fullscreen ? "Leave full screen" : "Full screen")" @onclick="ToggleFullscreen" />
            </span>
        </div>
        @if (_error != null)
        {
        }
        else if (_reading && _tree == null)
        {
            <p class="browse-note browse-pad">Reading the categories…</p>
        }
        else if (_declined)
        {
            <div class="browse-pad"><Alert Variant="info">
                <Title>Too many values to draw</Title>
                <Description>@_source!.Label has more than @CategoryHierarchy.MaxValues.ToString("N0") distinct paths. A category tree has hundreds; this looks like a name or a code. Choose another hierarchy above.</Description>
            </Alert></div>
        }
        else if (_tree != null)
        {
            <div class="browse-stage">
                <TreeCanvas Roots="_nodes" Selected="@_selected" SelectedChanged="OnSelected" View="@_view" Visible="VisiblePredicate"
                            Zoom="@ZoomFactor" OpenDepth="@_openDepth" AriaLabel="@($"Categories of {Ctx.Name} by {_source!.Label}")" />
                @if (_selectedNode != null)
                {
                    var n = _selectedNode;
                    <Surface Class="browse-panel">
                        <div class="browse-panel-head">
                            <div>
                                <div class="browse-panel-title">@n.Label</div>
                                @if (n.Id.Contains(Separator))
                                {
                                    <div class="browse-panel-path">@n.Id</div>
                                }
                            </div>
                            <Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.No" AriaLabel="Close" @onclick="@(() => { _selected = null; _selectedNode = null; _products = null; })" />
                        </div>
                        <div class="browse-stats">
                            <Stat Label="Products" Value="@n.Count.ToString("N0")" />
                            @if (n.Children.Count > 0)
                            {
                                <Stat Label="Filed here" Value="@n.Own.ToString("N0")" />
                                <Stat Label="Subcategories" Value="@n.Children.Count.ToString("N0")" />
                            }
                        </div>
                        @if (_health != null && (_health.IsBoosted(n.Id) || _health.AnySelects || _health.AnyConverts))
                        {
                            var f = _health.FiguresOf(n.Id);
                            <div class="browse-figures">
                                @if (_health.IsBoosted(n.Id)) { <span class="browse-figure">@DatasetIcons.Boost(14) boosted by a rule</span> }
                                @if (_health.AnySelects) { <span class="browse-figure">@(f.Selects == 0 ? "never selected" : $"{f.Selects:N0} selections") in @Stats.RetentionDays days</span> }
                                @if (_health.AnyConverts) { <span class="browse-figure">@(f.Converts == 0 ? "never purchased" : $"{f.Converts:N0} purchases") in @Stats.RetentionDays days</span> }
                            </div>
                        }
                        @if (Ctx.IsEditor && IsFilterable)
                        {
                            <div class="browse-actions">
                                <Button Variant="secondary" Size="micro" IconLeft="DatasetIcons.Boost" @onclick="BoostThis">Boost this category</Button>
                            </div>
                        }
                        <div class="browse-products-title">Products in this category</div>
                        @if (!IsFilterable)
                        {
                            <p class="browse-note">Mark @(_source!.IsGroup ? "the group's fields" : $"{_source.Key}") Filterable under Field configuration to list the products here, and to boost a category.</p>
                        }
                        else if (_products == null)
                        {
                            <p class="browse-note">Reading…</p>
                        }
                        else if (_products.Count == 0)
                        {
                            <p class="browse-note">No products found with this exact value.</p>
                        }
                        else
                        {
                            <ul class="browse-products">
                                @foreach (var p in _products)
                                {
                                    <li class="browse-product"><span class="browse-product-title">@p.Title</span><span class="browse-product-key">@p.Key</span></li>
                                }
                            </ul>
                            @if (n.Count > _products.Count)
                            {
                                <p class="browse-note">The first @_products.Count of @n.Count.ToString("N0").</p>
                            }
                        }
                    </Surface>
                }
            </div>
        }
        </div>
    }
</div>

@code {
    private const int ProductsShown = 20;
    private const int ReadTimeoutMs = 10_000;
    private const string Detect = "detect";
    private const string Flat = "flat";

    private static readonly SegmentedControl.Item[] _views = { new("tree", "Tree", DatasetIcons.TreeView), new("list", "List", DatasetIcons.ListView) };
    private static readonly SegmentedControl.Item[] _zooms = { new("50", "50%"), new("75", "75%"), new("100", "100%") };
    private static readonly SelectField.SelectOption[] SeparatorOptions =
    {
        new("Detect", Detect),
        new("\" > \"  (Google)", " > "),
        new("\" / \"", " / "),
        new("\"/\"", "/"),
        new("\"|\"", "|"),
        new("\">\"", ">"),
        new("\" - \"", " - "),
        new("Flat, no levels", Flat),
    };

    private sealed record Product(long Key, string Title);

    private string _view = "tree";
    private string _zoom = "100";
    private ElementReference _frame;
    private bool _fullscreen;
    private bool _watching;
    private DotNetObjectReference<CategoriesTab>? _self;
    private int _openDepth = 2;
    private DatasetMetadataStore.CategorySetting? _setting;
    private IReadOnlyList<CategorySource>? _sources;
    private CategorySource? _source;
    private string? _separator;          // path fields: null detects, "" is flat
    private CategoryHierarchy.Tree? _tree;
    private IReadOnlyList<TreeCanvas.Node> _nodes = Array.Empty<TreeCanvas.Node>();
    private Dictionary<string, CategoryHierarchy.Node> _byId = new();
    private bool _declined;
    private bool _reading;
    private string? _error;
    private object? _readFor;            // the saved field configuration the sources were found under
    private string? _selected;
    private CategoryHierarchy.Node? _selectedNode;
    private IReadOnlyList<Product>? _products;
    private readonly LatestOnly _reads = new();
    private readonly LatestOnly _productReads = new();
    private CategoryHealth? _health;
    private string _filter = "";
    private HashSet<string>? _nameMatches;   // node ids whose label the filter finds; null when no filter
    private readonly FieldNameFilter _names = new();

    // The empty state's examples: made-up categories, different for the two shapes, run through the
    // real builder, so the pictures are what the tab would draw and cannot drift from it. Built
    // once per tab, from a fixed seed, so a page does not change under the reader.
    private static readonly string[] Depts = { "Furniture", "Lighting", "Kitchen", "Outdoor", "Textiles", "Storage" };
    private static readonly string[] Sections = { "Chairs", "Tables", "Sofas", "Lamps", "Cookware", "Shelving", "Rugs", "Beds", "Benches", "Planters" };
    private static readonly string[] Types = { "Office", "Dining", "Lounge", "Folding", "Pendant", "Floor", "Cast iron", "Oak", "Wool", "Wall" };
    private readonly IReadOnlyList<TreeCanvas.Node> _pathExample;
    private readonly IReadOnlyList<TreeCanvas.Node> _groupExample;
    private readonly string[] _pathOpen;
    private readonly string[] _groupOpen;
    private readonly string _pathSample;
    private readonly string[] _groupSample;

    public CategoriesTab()
    {
        (_pathExample, _pathOpen, var pathPaths) = Example(seed: 7, roots: 2, perRoot: 3, deeper: true);
        (_groupExample, _groupOpen, var groupPaths) = Example(seed: 23, roots: 2, perRoot: 2, deeper: false);
        _pathSample = pathPaths[0];
        _groupSample = CategoryHierarchy.Split(groupPaths[0], " > ").ToArray();
    }

    /// <summary>A made-up histogram of paths and the tree the builder makes of it; the first root
    /// and its first child open. Deeper trees get a fourth level here and there.</summary>
    private static (IReadOnlyList<TreeCanvas.Node> Nodes, string[] Open, List<string> Paths) Example(int seed, int roots, int perRoot, bool deeper)
    {
        var rng = new Random(seed);
        var paths = new List<string>();
        var values = new List<KeyValuePair<string, int>>();
        var depts = Depts.OrderBy(_ => rng.Next()).Take(roots).ToList();
        foreach (var dept in depts)
        {
            foreach (var section in Sections.OrderBy(_ => rng.Next()).Take(perRoot))
            {
                foreach (var type in Types.OrderBy(_ => rng.Next()).Take(rng.Next(1, 4)))
                {
                    var path = $"{dept} > {section} > {type} {section.ToLowerInvariant()}";
                    if (deeper && rng.Next(3) == 0) path += $" > {Types[rng.Next(Types.Length)]}";
                    paths.Add(path);
                    values.Add(new KeyValuePair<string, int>(path, rng.Next(8, 400)));
                }
            }
        }
        var tree = CategoryHierarchy.Build(values, " > ")!;
        static TreeCanvas.Node Plain(CategoryHierarchy.Node n) =>
            new(n.Id, n.Label, n.Count, n.Children.Count > 0 ? n.Children.Select(Plain).ToList() : null);
        var nodes = tree.Roots.Select(Plain).ToList();
        var first = tree.Roots[0];
        var open = new[] { first.Id, first.Children[0].Id };
        return (nodes, open, paths);
    }

    private static readonly TreeCanvas.Mark BoostedMark = new(DatasetIcons.Boost, "Boosted by a rule");
    private static readonly TreeCanvas.Mark NeverSelectedMark = new(DatasetIcons.NeverSelected, "Never selected in the statistics window");
    private static readonly TreeCanvas.Mark NeverPurchasedMark = new(DatasetIcons.NeverPurchased, "Never purchased in the statistics window");

    private double ZoomFactor => int.Parse(_zoom) / 100.0;
    private string Separator => _source is { IsGroup: true } ? CategorySource.GroupSeparator : _tree?.Separator ?? "\0";
    private string SeparatorValue => _separator == null ? Detect : _separator == "" ? Flat : _separator;
    private bool IsFilterable => _source != null && _source.Fields.All(f => Ctx.SavedFields?.FirstOrDefault(x => x.FieldName == f)?.Filterable == true);
    private List<SelectField.SelectOption> SourceOptions => _sources?.Select(s => new SelectField.SelectOption(s.Label, s.Key)).ToList() ?? new();

    private List<SegmentedControl.Item> DepthItems() =>
        Enumerable.Range(1, Math.Min(_tree?.Depth ?? 1, CategoryHierarchy.MaxDepth)).Select(d => new SegmentedControl.Item(d.ToString(), d.ToString())).ToList();

    private Func<TreeCanvas.Node, bool>? VisiblePredicate => _nameMatches is { } names ? n => names.Contains(n.Id) : null;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Ctx.DocumentsReplaced += Invalidate;
    }

    protected override void OnParametersSet()
    {
        if (!Active) return;
        _setting ??= Metadata.LoadCategory(Ctx.TeamId, Ctx.Name);
        // Found on first show, and again after the field configuration is saved.
        if (Ctx.SavedFields != null && !ReferenceEquals(_readFor, Ctx.SavedFields) && !_reading)
            _ = FindSourcesAsync();
    }

    private void Invalidate()
    {
        _tree = null; _declined = false; _error = null; _products = null; _sources = null; _readFor = null;
        _ = FindSourcesAsync();
    }

    /// <summary>The hierarchies this dataset offers, and the first read of the chosen one: the
    /// dataset's saved choice when it is still offered, else the first.</summary>
    private async Task FindSourcesAsync()
    {
        var fields = Ctx.SavedFields;
        if (fields == null) return;
        if (Ctx.EngineState != SystemState.Ready) { _error = "The dataset is not ready."; _sources ??= Array.Empty<CategorySource>(); return; }
        var ticket = _reads.Begin();
        _reading = true; _error = null;
        try
        {
            var facets = await Task.Run(() => ReadFacets());
            if (!_reads.IsCurrent(ticket)) return;
            _readFor = fields;
            _sources = CategorySource.Find(fields, facets);
            _source = _sources.FirstOrDefault(s => s.Key == _setting!.Field) ?? _sources.FirstOrDefault();
            _separator = _source != null && _source.Key == _setting!.Field ? _setting.Separator : null;
            _reading = false;
            if (_source != null) await ReadAsync(facets);
            else await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            if (_reads.IsCurrent(ticket)) { _error = ex.Message; _sources ??= Array.Empty<CategorySource>(); _reading = false; try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { } }
        }
    }

    private Task OnSourceChanged(string? key)
    {
        var source = _sources?.FirstOrDefault(s => s.Key == key);
        if (source == null || source == _source) return Task.CompletedTask;
        _source = source;
        _separator = null;
        _selected = null; _selectedNode = null; _products = null;
        Remember();
        return ReadAsync(null);
    }

    private Task OnSeparatorChanged(string? value)
    {
        _separator = value == Detect || value == null ? null : value == Flat ? "" : value;
        _selected = null; _selectedNode = null; _products = null;
        Remember();
        return ReadAsync(null);
    }

    /// <summary>Keeps the choice for the dataset. Editors only; a viewer's picks live in the tab.</summary>
    private void Remember()
    {
        if (!Ctx.IsEditor || _source == null) return;
        try { Metadata.SaveCategory(Ctx.TeamId, Ctx.Name, new DatasetMetadataStore.CategorySetting(_source.Key, _separator)); }
        catch (Exception ex) { Console.WriteLine($"[Categories] could not save the category setting for {Ctx.Name}: {ex.Message}"); }
    }

    /// <summary>Reads the chosen hierarchy's histogram and builds the tree and its marks.</summary>
    private async Task ReadAsync(IReadOnlyDictionary<string, KeyValuePair<string, int>[]>? facets)
    {
        var source = _source;
        if (source == null) return;
        if (Ctx.EngineState != SystemState.Ready) { _error = "The dataset is not ready."; return; }
        var ticket = _reads.Begin();
        var separator = source.IsGroup ? CategorySource.GroupSeparator : _separator;
        _reading = true; _error = null;
        try
        {
            var values = await Task.Run(() =>
            {
                if (source.IsGroup)
                {
                    var engine = Ctx.FindEngine();
                    return engine == null ? null : CategorySource.GroupHistogram(engine, source.Fields);
                }
                facets ??= ReadFacets();
                return facets != null && facets.TryGetValue(source.Key, out var v) ? v : null;
            });
            if (!_reads.IsCurrent(ticket)) return;
            if (values == null) { _error = $"No values came back for {source.Label}. The field may be empty, or the read timed out."; _tree = null; _health = null; }
            else
            {
                var tree = CategoryHierarchy.Build(values, separator);
                _declined = tree == null;
                _tree = tree;
                _health = tree == null ? null : await Task.Run(() => ReadHealth(tree, source));
                if (!_reads.IsCurrent(ticket)) return;
                _byId = new Dictionary<string, CategoryHierarchy.Node>(StringComparer.Ordinal);
                _nodes = tree == null ? Array.Empty<TreeCanvas.Node>() : tree.Roots.Select(ToNode).ToList();
                _openDepth = Math.Min(_openDepth, Math.Max(1, tree?.Depth ?? 1));
                if (_selected != null && _byId.TryGetValue(_selected, out var again)) { _selectedNode = again; _ = ReadProductsAsync(again); }
                else { _selected = null; _selectedNode = null; _products = null; }
            }
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            if (_reads.IsCurrent(ticket)) _error = ex.Message;
        }
        finally
        {
            if (_reads.IsCurrent(ticket)) { _reading = false; try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { } }
        }
    }

    /// <summary>Every facetable field's histogram over the whole dataset: an empty search with
    /// facets on, which the engine answers from its cache after the first read.</summary>
    private IReadOnlyDictionary<string, KeyValuePair<string, int>[]>? ReadFacets()
    {
        var query = new global::Indx.Http.QueryProxy { Text = string.Empty, MaxNumberOfRecordsToReturn = 1, EnableFacets = true, TimeOutLimitMilliseconds = ReadTimeoutMs };
        var result = Ctx.Engines.Search(query, Ctx.Name, Ctx.TeamId);
        return result.Facets;
    }

    private TreeCanvas.Node ToNode(CategoryHierarchy.Node n)
    {
        _byId[n.Id] = n;
        List<TreeCanvas.Mark>? marks = null;
        if (_health != null)
        {
            if (_health.IsBoosted(n.Id)) (marks ??= new()).Add(BoostedMark);
            if (_health.IsNeverSelected(n.Id)) (marks ??= new()).Add(NeverSelectedMark);
            if (_health.IsNeverPurchased(n.Id)) (marks ??= new()).Add(NeverPurchasedMark);
        }
        return new TreeCanvas.Node(n.Id, n.Label, n.Count, n.Children.Count > 0 ? n.Children.Select(ToNode).ToList() : null, marks);
    }

    /// <summary>The marks' sources: the saved boost rules, and every document selected or converted
    /// in the statistics window with the categories it is filed under, read from the engine by key.
    /// The window's distinct documents bound the work; a dataset without statistics gets the
    /// boost marks alone. For a group, a document's path is its levels joined.</summary>
    private CategoryHealth ReadHealth(CategoryHierarchy.Tree tree, CategorySource source)
    {
        var rules = BoostStore.Load(Ctx.TeamId, Ctx.Name);
        var activity = new List<(CategoryHealth.Activity, IReadOnlyList<string>)>();
        var engine = Ctx.FindEngine();
        if (Stats.Enabled && Stats.Store is { } store && engine != null)
        {
            try
            {
                var zone = store.ZoneOf(Ctx.TeamId, Ctx.Name);
                long toDay = StatisticsDays.Today(zone);
                foreach (var d in store.TopDocuments(Ctx.TeamId, Ctx.Name, toDay - Stats.RetentionDays, toDay, int.MaxValue))
                {
                    var json = engine.GetJsonDataOfKey(d.DocumentKey);
                    if (string.IsNullOrEmpty(json)) continue;
                    IReadOnlyList<string> paths;
                    try
                    {
                        using var doc = JsonDocument.Parse(json);
                        if (source.IsGroup)
                        {
                            var levels = new List<string>();
                            foreach (var field in source.Fields)
                            {
                                var value = DocumentInspection.Values(doc.RootElement, field).FirstOrDefault(v => v.Trim().Length > 0);
                                if (value == null) break;
                                levels.Add(value.Trim());
                            }
                            paths = [string.Join(CategorySource.GroupSeparator, levels)];
                        }
                        else paths = DocumentInspection.Values(doc.RootElement, source.Key);
                    }
                    catch { continue; }
                    activity.Add((new CategoryHealth.Activity(d.Selects, d.Converts), paths));
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Categories] statistics could not be read for {Ctx.Name}: {ex.Message}");
            }
        }
        // A group's rule is one condition per level; the first field names the boost for the health's purpose.
        return new CategoryHealth(tree, rules, source.IsGroup ? source.Fields[^1] : source.Key, DateOnly.FromDateTime(DateTime.Today), activity);
    }

    /// <summary>The name filter, as the field configuration's: a small engine over the labels, so a
    /// typo still finds the category, plus a plain substring match. A match on a label lights
    /// that node; the tree keeps the way down to it.</summary>
    private Task OnFilterChanged(string? text)
    {
        _filter = text ?? "";
        if (_filter.Trim().Length == 0) { _nameMatches = null; return Task.CompletedTask; }
        var all = _nodes.SelectMany(Flatten).ToList();
        var labels = all.Select(n => n.Label).Distinct(StringComparer.Ordinal).ToList();
        var hit = _names.Match(labels, _filter);
        _nameMatches = all.Where(n => hit.Contains(n.Label)).Select(n => n.Id).ToHashSet(StringComparer.Ordinal);
        // The chosen category follows the filter: the first match, unless it is still in view.
        if (_selected != null && _nameMatches.Contains(_selected)) return Task.CompletedTask;
        var first = all.FirstOrDefault(n => _nameMatches.Contains(n.Id));
        return first != null ? OnSelected(first.Id) : Task.CompletedTask;
    }

    private static IEnumerable<TreeCanvas.Node> Flatten(TreeCanvas.Node n)
    {
        yield return n;
        if (n.Children != null) foreach (var c in n.Children) foreach (var d in Flatten(c)) yield return d;
    }

    private Task OnSelected(string id)
    {
        _selected = id;
        _selectedNode = _byId.TryGetValue(id, out var n) ? n : null;
        _products = null;
        return _selectedNode != null && IsFilterable ? ReadProductsAsync(_selectedNode) : Task.CompletedTask;
    }

    /// <summary>The first products filed under this category, by the engine's own value filters:
    /// one on the path field, or one per level of a group, which needs the fields Filterable.</summary>
    private async Task ReadProductsAsync(CategoryHierarchy.Node node)
    {
        var ticket = _productReads.Begin();
        try
        {
            var products = await Task.Run(() => ReadProducts(node));
            if (!_productReads.IsCurrent(ticket)) return;
            _products = products;
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"[Categories] products failed for {Ctx.Name}: {ex.Message}");
            if (_productReads.IsCurrent(ticket)) { _products = Array.Empty<Product>(); _ = InvokeAsync(StateHasChanged); }
        }
    }

    /// <summary>The field and value of each condition that picks this category out.</summary>
    private List<(string Field, string Value)> ConditionsOf(CategoryHierarchy.Node node)
    {
        if (_source is not { IsGroup: true })
            return [(_source!.Key, node.Id == CategoryHierarchy.NoCategory && node.Label == CategoryHierarchy.NoCategory ? "" : node.Id)];
        var levels = CategoryHierarchy.Split(node.Id, CategorySource.GroupSeparator);
        return levels.Select((v, i) => (_source.Fields[Math.Min(i, _source.Fields.Count - 1)], v)).ToList();
    }

    private IReadOnlyList<Product> ReadProducts(CategoryHierarchy.Node node)
    {
        var engine = Ctx.FindEngine();
        if (engine == null || _source == null) return Array.Empty<Product>();
        global::Indx.Api.Filter? filter = null;
        foreach (var (field, value) in ConditionsOf(node))
        {
            var one = engine.CreateValueFilter(field, value, isCaseSensitive: false, out var error);
            if (one == null) throw new InvalidOperationException(error ?? "The filter could not be made.");
            filter = filter == null ? one : filter & one;
        }
        if (filter == null) return Array.Empty<Product>();
        var query = new global::Indx.Http.QueryProxy
        {
            Text = string.Empty, MaxNumberOfRecordsToReturn = ProductsShown, EnableFacets = true,
            Filter = new global::Indx.Http.FilterProxy(filter.SerializedKey), TimeOutLimitMilliseconds = ReadTimeoutMs,
        };
        var result = Ctx.Engines.Search(query, Ctx.Name, Ctx.TeamId);
        var fields = Ctx.SavedFields ?? Array.Empty<FieldProxy>();
        var list = new List<Product>();
        foreach (var record in result.Records.Take(ProductsShown))
        {
            var json = engine.GetJsonDataOfKey(record.DocumentKey);
            list.Add(new Product(record.DocumentKey, TitleOf(json, fields) ?? $"#{record.DocumentKey}"));
        }
        return list;
    }

    /// <summary>The heaviest searchable field's first value: a title, a name.</summary>
    private static string? TitleOf(string? json, IReadOnlyList<FieldProxy> fields)
    {
        if (string.IsNullOrEmpty(json)) return null;
        try
        {
            using var doc = JsonDocument.Parse(json);
            var inspected = DocumentInspection.Build(doc.RootElement, fields);
            var value = inspected.Indexed.FirstOrDefault(f => f.Values.Count > 0 && f.Field.Embeddable != true)?.Values[0];
            return value == null ? null : value.Length > 80 ? value[..79] + "…" : value;
        }
        catch { return null; }
    }

    /// <summary>Hands a rule on this category to the Boost rules tab and opens it.</summary>
    private void BoostThis()
    {
        if (_selectedNode == null || _source == null) return;
        Ctx.BoostDraft = new DatasetContext.BoostDraftRule(_selectedNode.Label, ConditionsOf(_selectedNode));
        Ctx.ActiveTab = "boosts";
        Ctx.NotifyChanged();
    }

    /// <summary>The frame to the browser's full screen and back (wwwroot/js/fullscreen.js).</summary>
    private async Task ToggleFullscreen()
    {
        try
        {
            if (!_watching)
            {
                _self = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("indxFullscreen.watch", _frame, _self);
                _watching = true;
            }
            await JS.InvokeVoidAsync("indxFullscreen.toggle", _frame);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public void OnFullscreenChanged(bool on)
    {
        if (_fullscreen == on) return;
        _fullscreen = on;
        _ = InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        _names.Dispose();
        Ctx.DocumentsReplaced -= Invalidate;
        base.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        if (_watching)
        {
            try { await JS.InvokeVoidAsync("indxFullscreen.unwatch", _frame); }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
        }
        _self?.Dispose();
    }
}
