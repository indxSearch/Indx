@* Per-dataset ranking rules, boost and bury in one list (Nov 2026; two tabs of this component from
   25 Oct 2026). Each rule's strength is one scale from Bury high to Boost high, so a rule changes
   direction by its slider; the rules are still kept apart where they are stored (BoostRuleStore,
   BuryRuleStore), as the HTTP API has them. They apply to every search (6.0; until then only to
   one sent with enableBoost or enableBury). The condition
   builder reads the *edited* field configuration from the context, so an unsaved Filterable toggle
   in the Fields tab immediately changes what can be picked here. *@
@using IndxServer.Models
@using Indx.Api
@inherits DatasetTabBase
@inject BoostRuleStore BoostStore
@inject BuryRuleStore BuryStore
@inject IEditionService Edition
@inject BrowserFiles Files

@if (!Active) { return; }

<div class="boost-tab">
    <p class="boost-intro">
        Ranking rules lift matching documents, or bury them, in every search of this dataset. Conditions use filterable fields; rules stack.
    </p>

    @{ var fieldOpts = FieldOptions(); }

    @if (fieldOpts.Count == 0)
    {
        <Alert Variant="warning">
            <Title>No filterable fields on this dataset</Title>
            <Description>Boost rules match on filterable fields. Mark a field <strong>Filterable</strong> under Field configuration, then come back here.</Description>
        </Alert>
    }
    else
    {
        @* A new rule lands at the top of the list, next to the button that made it. *@
        <div class="indx-list-toolbar">
            @if (Ctx.IsEditor)
            {
                <Button Variant="primary" Size="micro" IconLeft="DatasetIcons.PanelAdd" @onclick="AddRule">New boost rule</Button>
            }
            @if (_rules.Count > 0)
            {
                <span class="indx-list-toolbar-end">@_rules.Count rule@(_rules.Count == 1 ? "" : "s")</span>
            }
        </div>
        @if (_rules.Count == 0)
        {
            <EmptyState Size="compact" Icon="DatasetIcons.Boost" Title="No boost rules yet">A rule lifts the records it matches, or buries them, on every search or between two dates.</EmptyState>
        }
        else
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var expired = _rules.Select(e => e.Rule).Count(r => r.Enabled && r.ActiveUntil is { } u && u < today);
            var scheduled = _rules.Select(e => e.Rule).Count(r => r.Enabled && r.ActiveFrom is { } f && f > today);
            var disabled = _rules.Count(e => !e.Rule.Enabled);
            var active = _rules.Count(e => e.Rule.IsActiveOn(today));
            @if (expired + scheduled + disabled > 0)
            {
                <p class="boost-summary">
                    <strong>@active</strong> of @_rules.Count rule(s) applying today.
                    @if (expired > 0) { <span class="boost-summary-expired">@expired expired</span> }
                    @if (scheduled > 0) { <span>@scheduled not started yet</span> }
                    @if (disabled > 0) { <span>@disabled switched off</span> }
                </p>
            }
        }

        <ReadOnlyArea Editable="@Ctx.IsEditor">
        <div class="boost-rules">
            @foreach (var entry in _rules)
            {
                var rule = entry.Rule;
                var status = RuleStatus(rule);
                <div class="boost-rule @(status?.Label.StartsWith("Expired") == true ? "boost-rule--expired" : "")">
                    <div class="boost-rule-head">
                        <ToggleSwitch @bind-Checked="rule.Enabled" AriaLabel="@(string.IsNullOrWhiteSpace(rule.Name) ? "Rule enabled" : $"Rule enabled: {rule.Name}")" />
                        <div class="boost-grow"><InputField placeholder="Rule name" aria-label="Rule name" @bind-Value="rule.Name" /></div>
                        @if (status != null)
                        {
                            <Chip Color="@status.Value.Color" TextColor="@status.Value.TextColor">@status.Value.Label</Chip>
                        }
                        <Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.Delete" aria-label="Delete rule" @onclick="@(() => _rules.Remove(entry))" />
                    </div>

                    @* One scale for both directions: Bury high to Boost high, six steps and no middle. *@
                    <div class="boost-strength">
                        <span class="boost-strength-now">@(entry.Bury ? DatasetIcons.Bury(14) : DatasetIcons.Boost(14))@StrengthName(entry)</span>
                        <div class="boost-strength-scale">
                            <Slider Min="0" Max="5" Step="1" Value="@StepOf(entry)" AriaLabel="@($"Strength: {rule.Name}")" Disabled="@(!Ctx.IsEditor)"
                                    ValueChanged="@(v => SetStep(entry, (int)Math.Round(v)))" />
                            <div class="boost-strength-labels" aria-hidden="true">
                                <span>High</span><span>Medium</span><span>Low</span><span>Low</span><span>Medium</span><span>High</span>
                            </div>
                            <div class="boost-strength-sides" aria-hidden="true"><span>Bury</span><span>Boost</span></div>
                        </div>
                    </div>

                    <div class="boost-conditions">
                        @for (int ci = 0; ci < rule.Conditions.Count; ci++)
                        {
                            var cond = rule.Conditions[ci];
                            <div class="boost-condition">
                                <div class="boost-w190"><Combobox Size="micro" Options="FieldOptionsForCondition(cond.Field)" Search="q => _fieldSearch.Find(FieldOptionsForCondition(cond.Field), q)" SearchPlaceholder="Search the fields" AriaLabel="Field" Value="@cond.Field" ValueChanged="@(v => OnConditionFieldChanged(cond, v))" /></div>
                                @if (IsNumericField(cond.Field))
                                {
                                    <span class="boost-label">between</span>
                                    <div class="boost-w90"><InputField placeholder="min" @bind-Value="cond.MinText" /></div>
                                    <span class="boost-label">and</span>
                                    <div class="boost-w90"><InputField placeholder="max" @bind-Value="cond.MaxText" /></div>
                                }
                                else if (IsBooleanField(cond.Field))
                                {
                                    <span class="boost-label">is</span>
                                    <ToggleSwitch Label="@(cond.Value == "true" ? "true" : "false")" Checked="@(cond.Value == "true")" CheckedChanged="@(v => cond.Value = v ? "true" : "false")" />
                                }
                                else
                                {
                                    <span class="boost-label">equals</span>
                                    <div class="boost-grow boost-value"><InputField placeholder="value" @bind-Value="cond.Value" /></div>
                                }
                                @if (rule.Conditions.Count > 1)
                                {
                                    <Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.Delete" @onclick="@(() => rule.Conditions.Remove(cond))" />
                                }
                            </div>
                            @if (ci < rule.Conditions.Count - 1)
                            {
                                <div class="boost-w130"><SelectField Size="micro" Options="JoinOptions" Value="@rule.Join.ToString()" ValueChanged="@(v => rule.Join = ParseJoin(v))" /></div>
                            }
                        }
                        <div><Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.PanelAdd" @onclick="@(() => rule.Conditions.Add(NewCondition(fieldOpts[0].Value)))">Add condition</Button></div>
                    </div>

                    @if (Edition.IsEnabled(EditionFeature.BoostRuleScheduling))
                    {
                        <div class="boost-schedule">
                            <Checkbox Label="Time limit" Checked="@IsTimeLimited(rule)" CheckedChanged="@(v => SetTimeLimited(rule, v))" />
                            @if (IsTimeLimited(rule))
                            {
                                <div class="boost-dates">
                                    <div><span class="boost-date-label">Active from</span><DatePicker @bind-Value="rule.ActiveFrom" AriaLabel="Active from" /></div>
                                    <div><span class="boost-date-label">Active until</span><DatePicker @bind-Value="rule.ActiveUntil" AriaLabel="Active until" /></div>
                                </div>
                            }
                            else
                            {
                                <span class="boost-hint">Always active</span>
                            }
                        </div>
                    }

                    @{ var badFields = rule.Conditions.Where(c => !string.IsNullOrEmpty(c.Field) && !FilterableFieldNames().Contains(c.Field)).Select(c => c.Field).Distinct().ToList(); }
                    @if (badFields.Count > 0)
                    {
                        <div class="boost-rule-alert">
                            <Alert Variant="warning">
                                <Title>Rule not applied</Title>
                                <Description>It references non-filterable field@(badFields.Count == 1 ? "" : "s") @string.Join(", ", badFields). Mark @(badFields.Count == 1 ? "it" : "them") Filterable under Field configuration, or edit the rule.</Description>
                            </Alert>
                        </div>
                    }
                </div>
            }
        </div>

        </ReadOnlyArea>

        @if (!string.IsNullOrEmpty(_importNote))
        {
            <p class="boost-note">@_importNote</p>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="boost-error">@_error</p>
        }

        <SaveBar Visible="@(IsDirty && Ctx.IsEditor)" Message="Unsaved changes">
            <Button Variant="primary" Size="micro" IconLeft="DatasetIcons.Save" Loading="@_saving" @onclick="SaveAsync">Save</Button>
            <Button Variant="secondary" Size="micro" Disabled="@_saving" @onclick="Cancel">Cancel</Button>
        </SaveBar>
        <div class="indx-file-actions">
            @if (_rules.Count > 0)
            {
                <Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.Download" @onclick="ExportAsync">Export as json</Button>
            }
            @if (Ctx.IsEditor)
            {
                <InputFile OnChange="ImportAsync" accept=".json" style="display:none" id="@ImportInputId" />
                <Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.DynamicJson" @onclick="() => Files.TriggerFileInputAsync(ImportInputId)">Import from json</Button>
            }
        </div>
    }
</div>

@code {
    /// <summary>One rule in the list and which way it goes. A bury rule is a BuryRule and a boost
    /// rule a BoostRule, as they are stored; turning one round makes it the other kind.</summary>
    // The two stores through the interface they share, which is where their rule methods are.
    private IRankingRuleStore Boosts => BoostStore;
    private IRankingRuleStore Buries => BuryStore;

    private sealed class RuleEntry(IRankingRule rule, bool bury)
    {
        public IRankingRule Rule { get; set; } = rule;
        public bool Bury { get; set; } = bury;
    }

    private static readonly IEnumerable<SelectField.SelectOption> JoinOptions =
        [new("AND", "And"), new("OR", "Or")];

    // The strength scale's six steps, left to right: Bury high, medium, low, then Boost low, medium,
    // high. A step is a rule's direction and its strength (Low 1 to High 3) in one.
    private static int StepOf(RuleEntry e) => e.Bury ? 3 - e.Rule.StrengthValue : 2 + e.Rule.StrengthValue;

    private static string StrengthName(RuleEntry e) =>
        $"{(e.Bury ? "Bury" : "Boost")} {e.Rule.StrengthValue switch { 1 => "low", 3 => "high", _ => "medium" }}";

    private void SetStep(RuleEntry e, int step)
    {
        step = Math.Clamp(step, 0, 5);
        bool bury = step <= 2;
        int strength = bury ? 3 - step : step - 2;
        if (bury != e.Bury)
        {
            e.Rule = Turned(e.Rule, bury);
            e.Bury = bury;
        }
        e.Rule.StrengthValue = strength;
    }

    /// <summary>The rule as the other kind, everything else kept.</summary>
    private IRankingRule Turned(IRankingRule rule, bool toBury)
    {
        var turned = (toBury ? Buries : Boosts).NewRule();
        turned.Name = rule.Name;
        turned.Enabled = rule.Enabled;
        turned.Conditions = rule.Conditions;
        turned.Join = rule.Join;
        turned.StrengthValue = rule.StrengthValue;
        turned.ActiveFrom = rule.ActiveFrom;
        turned.ActiveUntil = rule.ActiveUntil;
        if (_ruleTimeLimited.Remove(rule)) _ruleTimeLimited.Add(turned);
        return turned;
    }

    private bool _loaded;
    private List<RuleEntry> _rules = new();
    private string? _savedJson;
    private string? _error;
    private string? _importNote;

    private string ImportInputId => $"boost-rules-import-{Ctx.Name}";

    // Rules with no schedule are "always active". The Time-limit checkbox reveals the date
    // pickers; a rule is considered time-limited if the box was ticked or it already carries a date.
    private readonly HashSet<IRankingRule> _ruleTimeLimited = new();

    protected override void OnParametersSet()
    {
        if (Active && !_loaded) Load();
        if (Active && Ctx.BoostDraft is { } draft)
        {
            // From the Categories tab: a rule on one category, at the top like a new rule, unsaved.
            Ctx.BoostDraft = null;
            _error = null;
            _rules.Insert(0, new RuleEntry(new BoostRule { Name = draft.Name, Conditions = draft.Conditions.Select(c => new BoostCondition { Field = c.Field, Value = c.Value }).ToList() }, bury: false));
        }
    }

    private void Load()
    {
        _loaded = true;
        _rules = Entries(Boosts.LoadRules(Ctx.TeamId, Ctx.Name), Buries.LoadRules(Ctx.TeamId, Ctx.Name));
        _savedJson = Serialized(_rules);
    }

    /// <summary>The boost rules, then the bury rules, as one list.</summary>
    private List<RuleEntry> Entries(IEnumerable<IRankingRule> boosts, IEnumerable<IRankingRule> buries) =>
        [.. Boosts.Deserialize(Boosts.Serialize(boosts)).Select(r => new RuleEntry(r, false)),
         .. Buries.Deserialize(Buries.Serialize(buries)).Select(r => new RuleEntry(r, true))];

    /// <summary>Both kinds as the stores write them, for the dirty check and the export.</summary>
    private string Serialized(IEnumerable<RuleEntry> rules, bool indented = false)
    {
        var boosts = Boosts.Serialize(rules.Where(e => !e.Bury).Select(e => e.Rule), indented);
        var buries = Buries.Serialize(rules.Where(e => e.Bury).Select(e => e.Rule), indented);
        return $"{{\"boosts\":{boosts},\"buries\":{buries}}}";
    }

    // The conditions' field pickers search with Indx, over one micro index for the tab.
    private readonly IndxServer.Components.Shared.OptionSearch _fieldSearch = new();

    public override void Dispose()
    {
        base.Dispose();
        _fieldSearch.Dispose();
    }

    private List<string> FilterableFieldNames() =>
        Ctx.EditedFields?.Where(x => x.Filterable == true).Select(x => x.FieldName).ToList() ?? new();

    private List<SelectField.SelectOption> FieldOptions() =>
        FilterableFieldNames().Select(n => new SelectField.SelectOption(n, n)).ToList();

    /// <summary>Field options for one condition's picker. If the condition references a field
    /// that is no longer filterable (or gone), keep it in the list — labelled "(unavailable)" —
    /// so its stored name still shows instead of a blank dropdown.</summary>
    private List<SelectField.SelectOption> FieldOptionsForCondition(string? currentField)
    {
        var opts = FieldOptions();
        if (!string.IsNullOrEmpty(currentField) && !opts.Any(o => o.Value == currentField))
            opts.Add(new SelectField.SelectOption($"{currentField} (unavailable)", currentField));
        return opts;
    }

    private string? FieldType(string field) => Ctx.EditedFields?.FirstOrDefault(x => x.FieldName == field)?.FieldType;
    private bool IsNumericField(string field) => FieldType(field) == "Number";
    private bool IsBooleanField(string field) => FieldType(field) == "Boolean";

    private BoostCondition NewCondition(string field)
    {
        var c = new BoostCondition { Field = field };
        if (IsBooleanField(field)) c.Value = "false";
        else if (!IsNumericField(field)) c.Value = "";
        return c;
    }

    private void OnConditionFieldChanged(BoostCondition cond, string? newField)
    {
        cond.Field = newField ?? "";
        if (IsNumericField(cond.Field)) { cond.Value = null; }
        else if (IsBooleanField(cond.Field))
        {
            cond.Min = null; cond.Max = null;
            if (cond.Value != "true" && cond.Value != "false") cond.Value = "false";
        }
        else { cond.Min = null; cond.Max = null; cond.Value ??= ""; }
    }

    private void AddRule()
    {
        if (!Ctx.IsEditor) return;
        _error = null;
        var first = FilterableFieldNames().FirstOrDefault() ?? "";
        var rule = Boosts.NewRule();
        rule.Name = "New rule";
        rule.Conditions = new() { NewCondition(first) };
        _rules.Insert(0, new RuleEntry(rule, bury: false));
    }

    private static BoostJoin ParseJoin(string? v) => Enum.TryParse<BoostJoin>(v, out var j) ? j : BoostJoin.And;

    /// <summary>A chip for rules that are not applying right now; null for an active rule.
    /// Expired is the one that matters most: a campaign that quietly ended looks live otherwise.</summary>
    private static (string Label, string Color, string TextColor)? RuleStatus(IRankingRule rule)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (!rule.Enabled) return ("Off", "var(--lv3)", "var(--lv5)");
        if (rule.ActiveUntil is { } until && until < today) return ($"Expired {until:yyyy-MM-dd}", "var(--CSignal)", "var(--lv0)");
        if (rule.ActiveFrom is { } from && from > today) return ($"Starts {from:yyyy-MM-dd}", "var(--CLightBlue)", "#080809");
        return null;
    }

    private bool IsTimeLimited(IRankingRule rule) =>
        _ruleTimeLimited.Contains(rule) || rule.ActiveFrom.HasValue || rule.ActiveUntil.HasValue;

    private void SetTimeLimited(IRankingRule rule, bool on)
    {
        if (on) _ruleTimeLimited.Add(rule);
        else { _ruleTimeLimited.Remove(rule); rule.ActiveFrom = null; rule.ActiveUntil = null; }
    }

    private bool IsDirty => _loaded && Serialized(_rules) != _savedJson;

    private bool _saving;

    private async Task SaveAsync()
    {
        MarkStep("tune");
        if (!Ctx.IsEditor) return;
        if (_saving) return;
        _error = null;
        foreach (var r in _rules.Select(e => e.Rule))
        {
            if (string.IsNullOrWhiteSpace(r.Name)) { _error = "Every rule needs a name."; return; }
            if (r.Conditions.Count == 0) { _error = $"Rule \"{r.Name}\" needs at least one condition."; return; }
            foreach (var c in r.Conditions)
            {
                if (string.IsNullOrWhiteSpace(c.Field)) { _error = $"Rule \"{r.Name}\" has a condition with no field."; return; }
                if (IsNumericField(c.Field))
                {
                    if (c.Min == null && c.Max == null) { _error = $"Rule \"{r.Name}\": set a min or max for {c.Field}."; return; }
                }
                else if (string.IsNullOrWhiteSpace(c.Value)) { _error = $"Rule \"{r.Name}\": enter a value for {c.Field}."; return; }
            }
        }
        var rules = _rules.ToList();
        _saving = true;
        try
        {
            await Task.Run(() =>
            {
                Boosts.SaveRules(Ctx.TeamId, Ctx.Name, rules.Where(e => !e.Bury).Select(e => e.Rule).ToList());
                Buries.SaveRules(Ctx.TeamId, Ctx.Name, rules.Where(e => e.Bury).Select(e => e.Rule).ToList());
            });
            _savedJson = Serialized(rules);
        }
        finally { _saving = false; }
        Ctx.NotifyChanged(); // the panel's nav badge (expired count) reads the store
    }

    private void Cancel()
    {
        _error = null;
        _importNote = null;
        if (_savedJson != null)
            _rules = FromFile(_savedJson);
    }

    // ── Import / export ───────────────────────────────────────────────────────
    // One file for both kinds: {"boosts": [...], "buries": [...]}, each array the shape GET/PUT
    // …/boosts and …/buries take. A plain array, as exported before Nov 2026, reads as boost rules.
    // Import replaces the working copy (like field config and synonyms do) and leaves it unsaved,
    // so Save commits and Cancel reverts. Rules naming fields this dataset lacks are kept — they
    // show the existing "references non-filterable field" warning and stay dormant until the field
    // appears.

    private async Task ExportAsync()
    {
        await Files.DownloadAsync($"{Ctx.Name}-boost-rules.json", Serialized(_rules, indented: true));
    }

    private List<RuleEntry> FromFile(string json)
    {
        using var doc = System.Text.Json.JsonDocument.Parse(json);
        if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Array)
            return Entries(Boosts.Deserialize(json), []);
        string Part(string name) => doc.RootElement.TryGetProperty(name, out var p) ? p.GetRawText() : "[]";
        return Entries(Boosts.Deserialize(Part("boosts")), Buries.Deserialize(Part("buries")));
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        if (!Ctx.IsEditor) return;
        _error = null;
        _importNote = null;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 1_000_000);
            using var reader = new StreamReader(stream);
            var imported = FromFile(await reader.ReadToEndAsync());
            var filterable = FilterableFieldNames();
            var dormant = imported.Count(e => e.Rule.Conditions.Any(c => !string.IsNullOrEmpty(c.Field) && !filterable.Contains(c.Field)));
            _rules = imported;
            _ruleTimeLimited.Clear();
            _importNote = imported.Count == 0
                ? $"Imported an empty list: save to remove all boost and bury rules."
                : $"Imported {imported.Count} rule(s), replacing the current list. Save to apply."
                  + (dormant > 0 ? $" {dormant} reference field(s) this dataset does not have (filterable) and will stay dormant until it does." : "");
        }
        catch (Exception ex)
        {
            _importNote = $"Failed to import: {ex.Message}";
        }
    }
}
