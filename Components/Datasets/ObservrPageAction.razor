@* A dataset page's one Observr action ("Review my setup", "Suggest synonyms", "Help me set this
   up"): top right, at the end of the page's top row, under the header's Agent button where its
   answer opens (28 Oct 2026; until then each page placed it its own way, two on a row of their own
   at the left, one beside "New synonym"). The page puts it last in its top row: the toolbar, or
   on Search or ask the intro beside the Experimental chip. Nothing for a viewer, an instance
   without Observr, or a dataset where Observr or its buttons are off. *@
@using IndxServer.Services.Observr
@inject ObservrFindingStore ObservrStore
@inject ObservrSubscription ObservrSubscription

@if (Ctx.IsEditor && ObservrSubscription.Visible && ObservrStore.IsEnabled(Ctx.TeamId, Ctx.Name))
{
    <span class="indx-observr indx-page-action"><Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.Observr" Disabled="@Disabled" @onclick="OnClick">@Label</Button></span>
}

@code {
    [CascadingParameter] public DatasetContext Ctx { get; set; } = default!;
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public EventCallback OnClick { get; set; }
    /// <summary>While the page has unsaved changes, for an action that reads the saved settings.</summary>
    [Parameter] public bool Disabled { get; set; }
}
