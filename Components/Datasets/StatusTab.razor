@* Diagnostics for a Ready dataset: counts, timings, keep-alive, and the engine's last error.
   Everyone on the team can read it; the only action is clearing the last error, for editors
   (keep-alive is changed under Options). Licensing is instance-wide and lives on the License
   page; a limit breach still surfaces in the alert banner. *@
@using Indx.Api
@using IndxServer.Models
@using IndxServer.Engine
@inherits DatasetTabBase

@if (!Active) { return; }

@if (Ctx.Status is { } status)
{
    var ka = Ctx.KeepAlive;
    <div class="status-tab">
        @if (!string.IsNullOrEmpty(status.ErrorMessage))
        {
            <div class="status-heading-row">
                <h3 class="status-heading">Last error</h3>
                @if (Ctx.IsEditor)
                {
                    <Button Variant="ghost" Size="micro" @onclick="ClearError">Clear</Button>
                }
            </div>
            <Alert Variant="warning">
                <Description>
                    <span class="status-last-error-text">@status.ErrorMessage</span>
                    <span class="status-last-error-help">The last operation the engine refused. It stays until it is cleared or a newer error replaces it; the dataset itself is unaffected.</span>
                </Description>
            </Alert>
        }

        @* Stats, as the statistics overview: a label over a value, the width of the page. Fixed
           columns, so the Agent panel sliding in resizes the tiles rather than reflowing them;
           the as-many-as-fit grid snapped through 6, 5 and 4 columns during the slide. *@
        <h3 class="status-heading@(string.IsNullOrEmpty(status.ErrorMessage) ? "" : " status-heading--section")">Index</h3>
        <StatGroup Columns="6">
            @{ var stateChip = DatasetStateChip.For(status.SystemState); }
            @Tile("State", @<Chip Size="large" Color="@stateChip.Color" TextColor="@stateChip.TextColor" Icon="@stateChip.Icon">@status.SystemState</Chip>)
            @Tile("Documents", @<text>@status.DocumentCount.ToString("N0")</text>)
            @Tile("Records on disk", @<text>@((ka?.RecordCount ?? 0).ToString("N0"))</text>)
            @Tile("Last index build", @<TimeAgo Value="status.TimeOfLastIndexBuild" />)
            @Tile("Seconds to index", @<text>@status.SecondsToIndex.ToString("0.##")s</text>)
            @Tile("Instance created", @<TimeAgo Value="status.TimeOfInstanceCreation" />)
        </StatGroup>

        <h3 class="status-heading status-heading--section">Usage</h3>
        <StatGroup Columns="3">
            @Tile("Searches since load", @<text>@status.SearchCounter.ToString("N0")</text>)
            @Tile("Keep-alive", @<text>@KeepAliveLabel(ka)</text>)
            @if (ka?.LastUsedUtc is { } used)
            {
                @Tile("Last used", @<TimeAgo At="used" />)
            }
        </StatGroup>
    </div>
}

@code {
    private static RenderFragment Tile(string label, RenderFragment value) => @<Stat Label="@label" ValueContent="value" />;

    // ClearErrorMessage raises Changed, which re-renders this tab and the rest of the panel.
    private void ClearError() => Ctx.ClearErrorMessage();

    private static string KeepAliveLabel(IndxServerInternalApi.KeepAliveInfo? ka)
    {
        if (ka == null) return "—";
        return ka.KeepAliveTimeHrs switch
        {
            int.MaxValue => "Always on",
            0 => "Client managed",
            var h when ka.Remaining is { } r => $"{h}h · {Math.Max(0, (int)Math.Ceiling(r.TotalMinutes))} min left",
            var h => $"{h}h",
        };
    }

}
