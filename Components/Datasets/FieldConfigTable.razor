@* The field-configuration editor table. Mutates the FieldProxy objects in place (they are the
   context's shared working copy) and raises OnChanged so the owner can re-render. Used both
   for a freshly analyzed upload (always editable) and a Ready dataset (editable for editors). *@
@using System.Globalization
@using Indx.Api

@{ var rows = RenderRows(); }

@* systm Table: the frame scrolls sideways and the field column stays pinned, so on a narrow
   screen the reader always knows which field a checkbox belongs to. *@
<div class="indx-fields-table">
    <Table Scrollable StickyFirstColumn AriaLabel="Field configuration">
        <thead>
            <tr>
                <th>Field and type</th>
                <th><span class="indx-th-tip" data-tooltip="Included in full-text search. At least one field must be searchable.">Searchable</span></th>
                <th><span class="indx-th-tip" data-tooltip="Can be used to filter results by exact value or range.">Filterable</span></th>
                <th><span class="indx-th-tip" data-tooltip="Field values are counted and returned as facets for building filter UI.">Facetable</span></th>
                <th><span class="indx-th-tip" data-tooltip="Results can be sorted by this field's value.">Sortable</span></th>
                @if (ShowAdvanced)
                {
                    <th><span class="indx-th-tip" data-tooltip="Enables word-level matching. Useful for categories, tags, and enum values.">WordIndexing</span></th>
                    <th><span class="indx-th-tip" data-tooltip="Field is included in vector embeddings for semantic and AI-powered search.">Embeddable</span></th>
                    <th><span class="indx-th-tip" data-tooltip="Filter bitsets are pre-computed at load time for faster filtering on large datasets.">PreloadFilters</span></th>
                    <th><span class="indx-th-tip" data-tooltip="Sharper matching for run-together or split-word queries. Coverage already matches these; high resolution improves precision — recommended only for key fields such as titles.">HighResolution</span></th>
                }
                <th><span class="indx-th-tip" data-tooltip="Relevance weight for this field (recommended range 0.5–3.0). Typical: title 3.0, heading 2.0, metadata 1.5, body 1.0.">Weight</span></th>
                @if (ShowAdvanced)
                {
                    <th><span class="indx-th-tip" data-tooltip="BM25F length normalisation (0–1). Higher values penalise longer fields more. Activates BM25F multi-field scoring.">BM25b</span></th>
                    <th><span class="indx-th-tip" data-tooltip="BM25F term saturation factor. Higher values give more weight to repeated terms in this field.">BM25k1</span></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                var field = row.Field;
                <tr class="@(row.IsContainer ? "indx-group-row" : null)"
                    title="@(!Editable && !row.IsContainer && !HasNoValue(field) ? "Read-only. Editor access is required to change field configuration." : null)">
                    <td>
                        @* The depth is a variable, not a pixel value, so a narrow screen can use a
                           smaller step per level. The name gives way from the left: its last part
                           is what identifies a nested field, and the full name is in the tooltip. *@
                        <div class="indx-cell-inner" style="@(row.Depth > 0 ? $"--depth:{row.Depth}" : null)">
                            @FieldName(field)
                            @* The type badge carries the detail: hovering it shows a sample of what the
                               field holds, or for a container the nested fields its data lives on. *@
                            <span class="indx-cell-value indx-sample-tip @(HasNoValue(field) ? "indx-cell-value-faint" : null)"><span class="indx-type-label">@FieldTypeLabel(field)</span>@if (TypeIcon(field) is { } typeIcon) { @typeIcon(14) }<span class="indx-field-pop">
                                        @if (IsContainer(field))
                                        {
                                            <span class="indx-field-pop-value">@NestedNames(field)</span>
                                        }
                                        else if (field.SampleValue is { } sample)
                                        {
                                            <span class="indx-field-pop-value">@sample</span>
                                        }
                                        else if (HasNoValue(field))
                                        {
                                            <span class="indx-field-pop-note">No value read for this field in the dataset, so its type is unknown and it cannot be configured. Load data that carries a value for it and analyze again.</span>
                                        }
                                        @if (PopoverFlags(field) is { } flags)
                                        {
                                            <span class="indx-field-pop-flag">@flags</span>
                                        }
                                    </span></span>
                        </div>
                    </td>
                    @if (row.IsContainer)
                    {
                        @* A container holds no value of its own, so every capability here would be
                           an inert control. Ticking Searchable on it indexes nothing: the text lives
                           on the nested fields below, and those are what can be configured. *@
                        <td colspan="@TrailingColumnCount" class="indx-group-note">Configured on the nested fields below</td>
                    }
                    else if (HasNoValue(field))
                    {
                        @* A field that was null in every record has no type, and a field with no
                           type is not configurable (decided Sep 2026, with the library refusing it
                           on its side). The row stays so the user can see the field exists, and the
                           badge popover says why. *@
                        <td colspan="@TrailingColumnCount" class="indx-group-note">Not configurable</td>
                    }
                    else
                    {
                    @foreach (var cap in VisibleCaps)
                    {
                        <td class="indx-table-check">@CapBox(field, cap)</td>
                    }
                    <td>@WeightControl(field, "t")</td>
                    @if (ShowAdvanced)
                    {
                        <td>@Bm25bControl(field, "t")</td>
                        <td>@Bm25k1Control(field, "t")</td>
                    }
                    }
                </tr>
            }
            @if (rows.Count == 0)
            {
                <tr><td colspan="@(TrailingColumnCount + 1)" class="indx-group-note">@(FilterActive ? "No field matches the filter." : "No fields to show.")</td></tr>
            }
        </tbody>
    </Table>
</div>

@* The same rows for a narrow screen (the stylesheet shows one or the other). A twelve-column
   table cannot be read on a phone, pinned column or not, so each field is a row that opens onto
   its own small table: label on the left, control on the right. Closed, a row says what is
   switched on, which keeps a long list browsable. A closed row renders no controls at all, so
   carrying both renderings costs little. Same row model, same fragments, same handlers as the
   table above, so the two cannot drift. *@
<div class="indx-fields-cards">
    @foreach (var row in rows)
    {
        var field = row.Field;
        <div class="indx-field-card" style="@(row.Depth > 0 ? $"--depth:{row.Depth}" : null)" @key="@($"card-{field.FieldName}")">
            @if (row.IsContainer)
            {
                <div class="indx-field-card-heading">
                    @FieldName(field)
                    <span class="indx-cell-value">Object@(DatasetIcons.NestedObjectType(14))</span>
                </div>
            }
            else if (HasNoValue(field))
            {
                <div class="indx-field-card-heading">
                    @FieldName(field)
                    <span class="indx-cell-value indx-cell-value-faint">Not configurable@(DatasetIcons.NoValueType(14))</span>
                </div>
            }
            else
            {
                <Disclosure Open="@_open.Contains(field.FieldName)" OpenChanged="@(v => SetOpen(field.FieldName, v == true))">
                    <Summary>
                        <span class="indx-field-card-summary">
                            <span class="indx-field-card-title">
                                @FieldName(field)
                                @if (TypeIcon(field) is { } icon) { <span class="indx-cell-value" title="@FieldTypeLabel(field)">@icon(14)</span> }
                            </span>
                            <span class="indx-field-card-state">@Summarize(field)</span>
                        </span>
                    </Summary>
                    <ChildContent>
                        <div class="indx-field-card-detail">
                            <span>@FieldTypeLabel(field)@(PopoverFlags(field) is { } flags ? $" · {flags}" : null)</span>
                            @if (field.SampleValue is { } sample) { <span class="indx-field-card-sample">@sample</span> }
                        </div>
                        <Table AriaLabel="@($"Settings for {field.FieldName}")">
                            <tbody>
                                @foreach (var pair in VisibleCaps.Chunk(2))
                                {
                                    <TableRow>
                                        @foreach (var cap in pair)
                                        {
                                            <TableCell Label="@cap.Label" colspan="@(pair.Length == 1 ? 2 : null)">@CapBox(field, cap)</TableCell>
                                        }
                                    </TableRow>
                                }
                                <TableRow>
                                    <TableCell Label="Weight" colspan="2">@WeightControl(field, "c")</TableCell>
                                </TableRow>
                                @if (ShowAdvanced)
                                {
                                    <TableRow>
                                        <TableCell Label="BM25b">@Bm25bControl(field, "c")</TableCell>
                                        <TableCell Label="BM25k1">@Bm25k1Control(field, "c")</TableCell>
                                    </TableRow>
                                }
                            </tbody>
                        </Table>
                    </ChildContent>
                </Disclosure>
            }
        </div>
    }
    @if (rows.Count == 0)
    {
        <p class="indx-fields-empty">@(FilterActive ? "No field matches the filter." : "No fields to show.")</p>
    }
</div>

@implements IDisposable

@code {
    [Parameter, EditorRequired] public FieldProxy[] Fields { get; set; } = [];

    /// <summary>Show only fields whose name matches this text (fuzzy, like the synonyms filter).
    /// While a filter is active the unused-fields rule is ignored: looking for a field in order
    /// to switch it on is the main reason to search, and that field is unused by definition.</summary>
    [Parameter] public string? Filter { get; set; }

    private bool FilterActive => !string.IsNullOrWhiteSpace(Filter);
    private readonly FieldNameFilter _nameFilter = new();
    public void Dispose() => _nameFilter.Dispose();

    /// <summary>Which field rows are open in the narrow rendering. Kept by name, so it survives
    /// a re-render, a filter change and an import.</summary>
    private readonly HashSet<string> _open = new(StringComparer.Ordinal);
    private void SetOpen(string name, bool open) { if (open) _open.Add(name); else _open.Remove(name); }

    /// <summary>One capability: its label, whether it belongs to the advanced set, and how to
    /// read and write it. Both renderings walk this list, in column order, so a capability added
    /// here appears in both.</summary>
    private sealed record Cap(string Label, bool Advanced, Func<FieldProxy, bool?> Get, Action<FieldProxy, bool> Put, bool IsSearchable = false);

    private static readonly Cap[] Caps =
    [
        new("Searchable", false, f => f.Searchable, (f, v) => f.Searchable = v, IsSearchable: true),
        new("Filterable", false, f => f.Filterable, (f, v) => f.Filterable = v),
        new("Facetable", false, f => f.Facetable, (f, v) => f.Facetable = v),
        new("Sortable", false, f => f.Sortable, (f, v) => f.Sortable = v),
        new("WordIndexing", true, f => f.WordIndexing, (f, v) => f.WordIndexing = v),
        new("Embeddable", true, f => f.Embeddable, (f, v) => f.Embeddable = v),
        new("PreloadFilters", true, f => f.PreloadFilters, (f, v) => f.PreloadFilters = v),
        new("HighResolution", true, f => f.HighResolution, (f, v) => f.HighResolution = v),
    ];

    private Cap[] VisibleCaps => ShowAdvanced ? Caps : Caps.Where(c => !c.Advanced).ToArray();

    private RenderFragment CapBox(FieldProxy field, Cap cap) => __builder =>
    {
        <Checkbox Checked="@(cap.Get(field) == true)" Disabled="@(!Editable)" aria-label="@($"{cap.Label}: {field.FieldName}")"
                  CheckedChanged="@(v => Set(() => { cap.Put(field, v); if (cap.IsSearchable) SearchableTouched = true; }))" />
    };

    /// <summary>The field name: dimmed parent path, then the leaf, giving way from the left.</summary>
    private RenderFragment FieldName(FieldProxy field) => __builder =>
    {
        <Truncate Side="start" Title="@field.FieldName" Class="indx-field-name">@if (ParentPath(field.FieldName) is { } parentPath) { <span class="indx-field-path">@parentPath</span> }@LeafName(field.FieldName)</Truncate>
    };

    /// <summary>What a closed row says: the capabilities that are on, and the weight when it is
    /// not the default.</summary>
    private string Summarize(FieldProxy f)
    {
        var parts = Caps.Where(c => c.Get(f) == true).Select(c => c.Label).ToList();
        if (f.Weight is { } w && Math.Abs(w - 1f) > 0.001f) parts.Add("Weight " + w.ToString("0.0#", CultureInfo.InvariantCulture));
        return parts.Count == 0 ? "Unused" : string.Join(" · ", parts);
    }

    private RenderFragment WeightControl(FieldProxy field, string scope) => __builder =>
    {
        @if (!ShowAdvanced && IsSliderWeight(field.Weight))
        {
            <div class="indx-weight-slider">
                <Slider Min="0.5" Max="3" Step="0.25" AriaLabel="@($"Weight: {field.FieldName}")" Disabled="@(!Editable)"
                        Value="@(field.Weight ?? 1.0f)"
                        ValueChanged="@(v => Set(() => field.Weight = (float)v))" />
                <span class="indx-weight-value">@((field.Weight ?? 1.0f).ToString("0.0#", CultureInfo.InvariantCulture))</span>
            </div>
        }
        else
        {
            <input class="indx-num-input" type="number" step="0.1" min="0" disabled="@(!Editable)" aria-label="@($"Weight: {field.FieldName}")"
                   value="@(field.Weight.HasValue ? field.Weight.Value.ToString("0.0##", CultureInfo.InvariantCulture) : "")"
                   @onchange="@(e => Set(() => field.Weight = ParseFloat(e.Value?.ToString(), 0f, null)))"
                   @key="@($"{scope}-weight-{field.FieldName}-{_clampTick}")" />
        }
    };

    private RenderFragment Bm25bControl(FieldProxy field, string scope) => __builder =>
    {
        <input class="indx-num-input" type="number" step="0.01" min="0" max="1" disabled="@(!Editable)" aria-label="@($"BM25b: {field.FieldName}")"
               value="@(field.BM25b.HasValue ? field.BM25b.Value.ToString("G4", CultureInfo.InvariantCulture) : "")"
               @onchange="@(e => Set(() => field.BM25b = ParseFloat(e.Value?.ToString(), 0f, 1f)))"
               @key="@($"{scope}-bm25b-{field.FieldName}-{_clampTick}")" />
    };

    private RenderFragment Bm25k1Control(FieldProxy field, string scope) => __builder =>
    {
        <input class="indx-num-input" type="number" step="0.1" min="0" disabled="@(!Editable)" aria-label="@($"BM25k1: {field.FieldName}")"
               value="@(field.BM25k1.HasValue ? field.BM25k1.Value.ToString("G4", CultureInfo.InvariantCulture) : "")"
               @onchange="@(e => Set(() => field.BM25k1 = ParseFloat(e.Value?.ToString(), 0f, null)))"
               @key="@($"{scope}-bm25k1-{field.FieldName}-{_clampTick}")" />
    };

    // Names that are the parent of at least one other field, e.g. "series" when "series.title"
    // exists. Analyze flattens nested JSON onto dotted names and registers the parent itself with
    // no type and no value, so without this a container row shows no type badge at all. Rebuilt
    // whenever the field list changes; a set beats scanning every row against every other row.
    private HashSet<string> _containers = new(StringComparer.Ordinal);
    private FieldProxy[]? _containersBuiltFor;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_containersBuiltFor, Fields)) return;
        _containersBuiltFor = Fields;
        _containers = new HashSet<string>(StringComparer.Ordinal);
        foreach (var f in Fields)
        {
            // Add every ancestor, so "a.b.c" marks both "a.b" and "a" as containers.
            var dot = f.FieldName.LastIndexOf('.');
            while (dot > 0)
            {
                _containers.Add(f.FieldName[..dot]);
                dot = f.FieldName.LastIndexOf('.', dot - 1);
            }
        }
    }

    private bool IsContainer(FieldProxy f) => _containers.Contains(f.FieldName);

    /// <summary>One table row: the field, how deep its dotted name sits, and whether it is a
    /// container rather than something configurable.</summary>
    private sealed record FieldRow(FieldProxy Field, int Depth, bool IsContainer);

    /// <summary>
    /// The rows to render, with every nested field placed directly under its container. Analyze
    /// returns the flattened names in its own order and puts a container wherever it first saw one,
    /// which for gyldendal-sanity is after all its children, so the list has to be rebuilt rather
    /// than filtered.
    /// <para>A container is emitted only when at least one of its children is visible, so hiding
    /// unused fields cannot leave an empty group behind. It is also synthesized when absent from
    /// the field list: Analyze registers a parent name only if some document carried it as a
    /// scalar or null, so most nested data has children with no parent field at all.</para>
    /// </summary>
    private List<FieldRow> RenderRows()
    {
        var byName = new Dictionary<string, FieldProxy>(StringComparer.Ordinal);
        foreach (var f in Fields) byName[f.FieldName] = f;

        var rows = new List<FieldRow>(Fields.Length);
        var emitted = new HashSet<string>(StringComparer.Ordinal);

        var matches = FilterActive
            ? _nameFilter.Match(Fields.Where(f => !IsContainer(f)).Select(f => f.FieldName).ToList(), Filter!)
            : null;

        foreach (var f in Fields)
        {
            if (IsContainer(f)) continue;               // emitted above its children, not in place
            if (matches != null) { if (!matches.Contains(f.FieldName)) continue; }
            else if (!ShowUnused && IsUnused(f)) continue;

            foreach (var ancestor in Ancestors(f.FieldName))
            {
                if (!emitted.Add(ancestor)) continue;
                var parent = byName.TryGetValue(ancestor, out var existing)
                    ? existing
                    : new FieldProxy { FieldName = ancestor };
                rows.Add(new FieldRow(parent, Depth(ancestor), true));
            }

            rows.Add(new FieldRow(f, Depth(f.FieldName), false));
            emitted.Add(f.FieldName);
        }
        return rows;
    }

    /// <summary>"a.b.c" yields "a" then "a.b", outermost first, so a group opens before it nests.</summary>
    private static IEnumerable<string> Ancestors(string name)
    {
        var dot = name.IndexOf('.');
        while (dot > 0)
        {
            yield return name[..dot];
            dot = name.IndexOf('.', dot + 1);
        }
    }

    /// <summary>The dotted path up to and including the last dot ("cover.asset.metadata." for
    /// "cover.asset.metadata.dimensions"), or null for a top-level name. Rendered dimmed so the
    /// leaf, which is what the row configures, is what the eye lands on. The row is already
    /// indented under its container; this keeps the full name readable without it competing.</summary>
    private static string? ParentPath(string name)
    {
        var dot = name.LastIndexOf('.');
        return dot > 0 ? name[..(dot + 1)] : null;
    }

    private static string LeafName(string name)
    {
        var dot = name.LastIndexOf('.');
        return dot > 0 ? name[(dot + 1)..] : name;
    }

    private static int Depth(string name)
    {
        var depth = 0;
        foreach (var ch in name) if (ch == '.') depth++;
        return depth;
    }

    /// <summary>Columns after the first, for the container row's spanning cell.</summary>
    private int TrailingColumnCount => ShowAdvanced ? 11 : 5;

    /// <summary>The badge icon: the type's own icon, the nested-object icon for a container, and
    /// the stop icon for a field with no value, which has no type and cannot be configured.</summary>
    private RenderFragment<int>? TypeIcon(FieldProxy f) =>
        f.FieldType != null ? DatasetIcons.ForFieldType(f.FieldType, f.IsArray)
        : IsContainer(f) ? DatasetIcons.NestedObjectType
        : DatasetIcons.NoValueType;

    /// <summary>The nested field names under a container, with the shared prefix removed:
    /// "series" gives "partNumber, title". This is where a container's data actually lives.</summary>
    private string NestedNames(FieldProxy f)
    {
        var prefix = f.FieldName + ".";
        return string.Join(", ", Fields
            .Where(o => o.FieldName.StartsWith(prefix, StringComparison.Ordinal))
            .Select(o => o.FieldName[prefix.Length..]));
    }
    [Parameter] public bool Editable { get; set; } = true;
    /// <summary>Also list fields with no capability ticked.</summary>
    [Parameter] public bool ShowUnused { get; set; }
    /// <summary>Show the WordIndexing / Embeddable / PreloadFilters / HighResolution / BM25 columns
    /// and switch the weight control from slider to number input.</summary>
    [Parameter] public bool ShowAdvanced { get; set; }
    /// <summary>Set once the user has touched a Searchable box — the owner uses it to decide
    /// when to show the "at least one searchable field" error.</summary>
    [Parameter] public bool SearchableTouched { get; set; }
    [Parameter] public EventCallback<bool> SearchableTouchedChanged { get; set; }
    /// <summary>Raised after any edit (the FieldProxy objects are mutated in place).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task Set(Action mutate)
    {
        var touchedBefore = SearchableTouched;
        mutate();
        if (SearchableTouched != touchedBefore) await SearchableTouchedChanged.InvokeAsync(SearchableTouched);
        await OnChanged.InvokeAsync();
    }

    public static bool IsUnused(FieldProxy f) =>
        f.Searchable != true && f.Filterable != true && f.Facetable != true &&
        f.Sortable != true && f.WordIndexing != true && f.Embeddable != true &&
        f.PreloadFilters != true && f.HighResolution != true;

    /// <summary>Parses a numeric cell, clamping to the range the scoring can represent. The
    /// <c>min</c>/<c>max</c> attributes on <c>input type="number"</c> only constrain the steppers
    /// and mark the element <c>:invalid</c>; a typed 2 in the BM25b cell still reaches here. The
    /// engine refuses it (<c>ArgumentOutOfRangeException</c>, since IndxSearchLib 5.0.0-RC170926,
    /// because out-of-range values silently corrupted rankings), which surfaces as a failed save
    /// after the user has edited several fields. Clamping here means the cell shows what will
    /// actually be applied, at the moment it is typed.</summary>
    /// <summary>Bumped whenever a typed value was clamped, and part of each numeric input's
    /// <c>@key</c>. Without it Blazor will not repaint a cell whose clamped value equals what it
    /// last rendered — type 2 into a BM25b already at 1 and the model holds 1 while the box keeps
    /// showing 2. Changing the key recreates the element, so the box shows what was applied.</summary>
    private int _clampTick;

    private float? ParseFloat(string? s, float? min = null, float? max = null)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        if (!float.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var f)) return null;
        if (float.IsNaN(f)) return null;
        var clamped = f;
        if (min.HasValue && clamped < min.Value) clamped = min.Value;
        if (max.HasValue && clamped > max.Value) clamped = max.Value;
        if (clamped != f) _clampTick++;
        return clamped;
    }

    /// <summary>The flag line under the sample, or null when the field needs neither flag.
    /// "Blank" means Analyze found no value anywhere, so there is nothing to sample; "Optional"
    /// means it found the field missing or empty in at least one document. A field can be both.
    /// <para>A container is never "Blank": holding no value of its own is what it is, not a gap
    /// in the data, and its nested fields are listed instead.</para></summary>
    private string? PopoverFlags(FieldProxy f)
    {
        var parts = new List<string>(2);
        // "Blank" means the type is known but no usable value was ever read, which is worth saying.
        // A container has no value of its own, and a field with no value at all says so in full
        // above, so neither needs the flag as well.
        if (f.SampleValue == null && !IsContainer(f) && !HasNoValue(f)) parts.Add("Blank");
        if (f.Optional == true) parts.Add("Optional");
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    /// <summary>"String", "Array (Strings)", "Object" for a field whose value is the nested fields
    /// under it, and "No value" for one that never carried a value in any analyzed document, which
    /// is why Analyze could not learn a type for it.</summary>
    private string FieldTypeLabel(FieldProxy f) =>
        f.FieldType == null
            ? (IsContainer(f) ? "Object" : "No value")
            : f.IsArray == true ? $"Array ({f.FieldType}s)" : f.FieldType;

    /// <summary>True when Analyze never saw a value for this field, so it has no type. Such a
    /// field is not configurable: without a type there is nothing to index or filter on, and
    /// the row renders a note in place of its controls, like a container.</summary>
    private bool HasNoValue(FieldProxy f) => f.FieldType == null && !IsContainer(f);

    // The simple-mode weight slider (0.5-3.0, step 0.25) only renders values it can show
    // truthfully; anything off-grid or out of range (advanced mode, imported configs, the
    // API) keeps the numeric input so a stored value is never silently rounded.
    private static bool IsSliderWeight(float? weight)
    {
        var v = weight ?? 1.0f;
        if (v < 0.5f || v > 3.0f) return false;
        var quartered = v * 4f;
        return Math.Abs(quartered - Math.Round(quartered)) < 0.001f;
    }
}
