@* One dataset of the active team: status table, tab nav and the tab components. Owns the
   DatasetContext the tabs share, loads status/field config on first display, and polls the
   engine while it is loading or indexing in the background.

   Hosted by Pages/DatasetPage.razor, one panel per page. Visible is kept as a parameter so a
   host can mount the panel hidden and show it later (the tests do); status loads on the first
   visible render. *@
@using Indx.Api
@implements IDisposable
@inject IDatasetEngines Engines
@inject BoostRuleStore BoostStore

@* The header slot (the console's breadcrumb row, with DatasetStatus in its actions) sits
   outside the Surface so it lands at exactly the same spot as on the team page — the
   Surface's own padding would otherwise nudge it. *@
@if (Header != null)
{
    <div hidden="@(!Visible)">@Header(Ctx)</div>
}

<div class="indx-dataset-card" hidden="@(!Visible)">
    <div class="indx-dataset-card-inner">
        <Surface Transparent>
            <CascadingValue Value="Ctx" IsFixed>

                @* ── Alerts — only rendered when the engine reports one. ── *@
                <DatasetAlerts Ctx="Ctx" />

                @* ── Dataset tab nav (hidden when hibernated: that view is just Wake up / Delete) ── *@
                @{
                    var engineState = Ctx.EngineState;
                    var isReady = engineState == SystemState.Ready;
                    var showNav = isReady || (Ctx.IsAnalyzed && !Ctx.IsLoadIndexing && Ctx.IsEditor) || (engineState == SystemState.Error && Ctx.IsAdmin && !Ctx.IsLoadIndexing);
                    var tab = Ctx.ActiveTab;
                    // Not Ready and not Error: the not-yet tabs are shown disabled.
                    var pending = !isReady && engineState != SystemState.Error;
                }
                @if (showNav && Ctx.HasStatus)
                {
                    @* The full tab set is always laid out in the same order. Tabs that need a
                       built index are disabled (with the reason) until the dataset is Ready, so
                       the bar keeps its shape from the first upload onward. Error shows only what
                       can act on it. Role rules hide, never disable: disabled means "not yet". *@
                    <div class="indx-dataset-nav">
                        <Tabs Items="NavItems(isReady, pending)" Active="@tab" ActiveChanged="@(v => SelectTab(v ?? tab))"
                              Size="micro" Variant="button" Scrollable Bleed="calc(var(--page-gutter) + 5px)" />
                    </div>
                }

                @* ── Tabs. All stay mounted so edit state survives switching; only the active one renders. ── *@
                <UploadFlow Active="@(tab == "fields")" />
                <FieldConfigTab Active="@(tab == "fields" && isReady)" />
                <SearchPreviewTab Active="@(tab == "search")" />
                <StatusTab Active="@(tab == "status")" />
                <OptionsTab Active="@(tab == "options")" />
                <BoostRulesTab Active="@(tab == "boosts")" />
                <SynonymsTab Active="@(tab == "synonyms")" />

            </CascadingValue>
        </Surface>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string TeamId { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [Parameter] public IReadOnlyList<(Data.Team Team, string Role)> MyTeams { get; set; } = [];
    /// <summary>Whether this is the selected dataset. Hidden panels stay mounted.</summary>
    [Parameter] public bool Visible { get; set; }
    /// <summary>Rendered above everything with this panel's context — the console puts its
    /// breadcrumb row here so the row can show the dataset's state.</summary>
    [Parameter] public RenderFragment<DatasetContext>? Header { get; set; }
    /// <summary>The dataset was deleted, transferred or hibernated; the shell reloads its list.</summary>
    [Parameter] public EventCallback OnDatasetListChanged { get; set; }
    /// <summary>The dataset was renamed; the host navigates to the new name.</summary>
    [Parameter] public EventCallback<string> OnRenamed { get; set; }
    /// <summary>Called once with the panel's context, so the host can render state (the header
    /// breadcrumb's status chip) outside the panel.</summary>
    [Parameter] public Action<DatasetContext>? OnContextCreated { get; set; }

    public DatasetContext Ctx { get; private set; } = default!;

    private bool _loaded;
    private CancellationTokenSource? _pollCts;

    protected override void OnInitialized()
    {
        Ctx = new DatasetContext(Engines, Name, TeamId, Role, MyTeams);
        Ctx.Changed += OnCtxChanged;
        Ctx.DatasetListChanged += () => OnDatasetListChanged.InvokeAsync();
        Ctx.Renamed += newName => OnRenamed.InvokeAsync(newName);
        OnContextCreated?.Invoke(Ctx);
    }

    protected override void OnParametersSet()
    {
        Ctx.MyTeams = MyTeams;
        if (Visible && !_loaded)
        {
            _loaded = true;
            Ctx.RefreshStatus();
            if (Ctx.EngineState == SystemState.Ready)
            {
                Ctx.EnsureFieldsLoaded();
                Ctx.ActiveTab = "status"; // a Ready dataset opens on Status; Created opens on the upload flow
            }
            StartPollingIfTransitional();
            // The tab components rendered once already (before status was known) and Blazor
            // skips children whose parameters did not change — tell them the context moved.
            Ctx.NotifyChanged();
        }
    }

    private void OnCtxChanged()
    {
        StartPollingIfTransitional();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SelectTab(string tab)
    {
        Ctx.ActiveTab = tab;
    }

    private const string NotYet = "Available after the index is built";

    /// <summary>The tab bar. One line at any width: systm Tabs scrolls sideways when it does not
    /// fit, so the labels never wrap and the page never scrolls horizontally. A tab that needs a
    /// Ready engine is disabled with the reason; role rules leave a tab out instead.</summary>
    private List<Tabs.TabItem> NavItems(bool isReady, bool pending)
    {
        var items = new List<Tabs.TabItem>(6);
        Tabs.TabItem Tab(string value, string label, RenderFragment<int> icon, bool enabled, string? badge = null, string? badgeTitle = null) =>
            new(label, value, icon, Disabled: !enabled, Title: enabled ? null : NotYet, Badge: badge, BadgeTitle: badgeTitle);

        if (isReady || pending) items.Add(Tab("status", "Status", DatasetIcons.Status, isReady));
        items.Add(Tab("fields", "Field configuration", DatasetIcons.Fields, true));
        if (isReady || pending) items.Add(Tab("search", "Search preview", DatasetIcons.Search, isReady));
        if ((isReady || pending) && Ctx.IsEditor)
        {
            var expired = isReady ? ExpiredBoostRules() : 0;
            items.Add(Tab("boosts", "Boost rules", DatasetIcons.Boost, isReady,
                expired > 0 ? expired.ToString() : null,
                expired > 0 ? $"{expired} expired boost rule(s), no longer applying" : null));
            items.Add(Tab("synonyms", "Synonyms", DatasetIcons.Synonym, isReady));
        }
        if (Ctx.IsAdmin) items.Add(Tab("options", "Options", DatasetIcons.Sliders, true));
        return items;
    }

    /// <summary>Enabled rules whose window has closed — the ones an editor most needs to notice,
    /// since they look live until someone opens the tab. The store caches, so this is cheap.</summary>
    private int ExpiredBoostRules()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return BoostStore.Load(Ctx.TeamId, Ctx.Name).Count(r => r.Enabled && r.ActiveUntil is { } u && u < today);
    }

    /// <summary>While the engine loads or indexes in the background (a load started from the API,
    /// or a page reopened mid-operation), refresh the status once a second until it settles, and
    /// pick up the field configuration the moment it becomes Ready.</summary>
    private void StartPollingIfTransitional()
    {
        if (_pollCts != null || !Ctx.IsTransitional || Ctx.IsLoadIndexing) return;
        _pollCts = new CancellationTokenSource();
        var cts = _pollCts;
        _ = ProgressPoller.RunAsync(TimeSpan.FromSeconds(1),
            () =>
            {
                Ctx.RefreshStatus();
                if (Ctx.EngineState == SystemState.Ready) Ctx.EnsureFieldsLoaded();
                // Once the upload flow has attached to a wake it polls for itself, faster.
                return Ctx.IsTransitional && !Ctx.IsLoadIndexing;
            },
            () => InvokeAsync(() => { StateHasChanged(); Ctx.NotifyChanged(); }),
            cts.Token).ContinueWith(_ =>
            {
                if (ReferenceEquals(_pollCts, cts)) _pollCts = null;
                cts.Dispose();
            });
    }

    public void Dispose()
    {
        Ctx.Changed -= OnCtxChanged;
        _pollCts?.Cancel();
        Ctx.Dispose();
    }
}
