@* "Review my setup" on the Fields tab (Notes/Anders/observr-plan.md): the instance sends each
   field's roles and a summary of a sample (fill, distinct values, the commonest few), Observr
   answers with what it would change and why, and the editor picks which changes to apply. Apply
   goes through the same path as the tab's Save: validated as a whole, announced, on a shadow when
   a rebuild is needed, so the change is recorded as any other. *@
@using IndxServer.Services.Observr
@inject ObservrClient Observr

<div class="obs">
    <div class="obs-head">
        <span class="obs-icon">@DatasetIcons.Observr(16)</span>
        <span class="obs-title">Observr on the field setup</span>
        <span class="obs-spacer"></span>
        <Button Variant="ghost" Size="micro" @onclick="() => OnClose.InvokeAsync()">Close</Button>
    </div>
    @if (_outcome == null)
    {
        <p class="obs-wait">Observr is reading the fields and a sample of the records…</p>
    }
    else if (_outcome.Status != ObservrStatus.Ok)
    {
        <Alert Variant="default" Icon="null">
            <Description>@ObservrText.Refusal(_outcome, "to review")</Description>
        </Alert>
    }
    else
    {
        <p class="obs-answer">@_outcome.Answer!.Answer</p>
        @if (_changes.Count == 0)
        {
            <p class="obs-test">Nothing to change.</p>
        }
        else
        {
            @* One row per change: the checkbox is "apply this", labelled once above the rows since
               the field table below has checkboxes too, and those switch roles on. Then the field,
               its reason, and the change as chips: "+ searchable", "searchable off", "weight 1 → 3". *@
            <div class="obs-changes">
                @if (_decided == null) { <span class="obs-changes-head">Tick the changes to apply</span> }
                @foreach (var c in _changes)
                {
                    <div class="obs-change">
                        @if (_decided == null)
                        {
                            <Checkbox Checked="_selected.Contains(c.Field!.Name)" CheckedChanged="v => Select(c.Field!.Name, v)" Disabled="@_applying" aria-label="@($"Apply the change to {c.Field!.Name}")" />
                        }
                        <span class="obs-change-field">@c.Field!.Name</span>
                        <span class="obs-change-why">@c.Reason</span>
                        <span class="obs-change-chips">
                            @foreach (var (text, on) in ObservrText.Parts(c.Field!, Ctx.EditedFields?.FirstOrDefault(f => f.FieldName == c.Field!.Name)?.Weight))
                            {
                                @if (on) { <Chip Icon="DatasetIcons.ShowMore">@text</Chip> }
                                else { <Chip Color="var(--lv2)" TextColor="var(--lv5)">@text</Chip> }
                            }
                        </span>
                    </div>
                }
            </div>
            @if (_decided == "accepted")
            {
                <span class="obs-done">@(_applied == 0 ? "Nothing applied." : _applied == 1 ? "Applied." : $"{_applied} changes applied.")</span>
            }
            else if (_decided == "declined")
            {
                <span class="obs-done">Declined.</span>
            }
            else if (Ctx.IsEditor)
            {
                <div class="obs-actions">
                    <Button Variant="primary" Size="micro" Loading="@_applying" Disabled="@(_selected.Count == 0)" @onclick="() => DecideAsync(true)">
                        @(_selected.Count == _changes.Count ? "Apply" : $"Apply {_selected.Count} of {_changes.Count}")
                    </Button>
                    <Button Variant="ghost" Size="micro" Disabled="@_applying" @onclick="() => DecideAsync(false)">No</Button>
                    @if (_applying) { <span class="obs-test">@(Ctx.ShadowBuildPercent > 0 ? $"Reindexing, {Ctx.ShadowBuildPercent}%" : "Applying…")</span> }
                </div>
            }
        }
        @if (_applyError != null) { <p class="obs-error">@_applyError</p> }
    }
</div>

@code {
    [CascadingParameter] public DatasetContext Ctx { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    private ObservrOutcome? _outcome;
    private List<ObservrProposal> _changes = [];
    private readonly HashSet<string> _selected = [];
    private string? _decided;
    private bool _applying;
    private int _applied;
    private string? _applyError;

    protected override async Task OnInitializedAsync()
    {
        _outcome = await Observr.AskFieldReviewAsync(Ctx.TeamId, Ctx.Name, CancellationToken.None);
        _changes = _outcome.Answer?.Proposals.Where(p => p.Field != null).ToList() ?? [];
        foreach (var c in _changes) _selected.Add(c.Field!.Name);
    }

    private void Select(string name, bool on)
    {
        if (on) _selected.Add(name); else _selected.Remove(name);
    }

    private async Task DecideAsync(bool yes)
    {
        if (_outcome?.FindingId is not > 0 || _applying) return;
        _applying = true;
        _applyError = null;
        var chosen = _selected.ToList();
        var indices = _outcome.Answer!.Proposals.Select((p, i) => (p, i)).Where(x => x.p.Field != null && _selected.Contains(x.p.Field.Name)).Select(x => x.i).ToList();
        // The tab shows the progress bar while a rebuild runs, as it does for its own Save.
        if (yes) { Ctx.IsSaving = true; Ctx.ShadowBuildPercent = 0; Ctx.NotifyChanged(); }
        using var polling = new CancellationTokenSource();
        var poller = yes ? ProgressPoller.RunAsync(TimeSpan.FromMilliseconds(100),
            () => { Ctx.ShadowBuildPercent = Ctx.Engines.GetShadowBuildPercent(Ctx.Name, Ctx.TeamId); return true; },
            () => InvokeAsync(() => { StateHasChanged(); Ctx.NotifyChanged(); }), polling.Token) : Task.CompletedTask;
        try
        {
            _applyError = await Task.Run(() => Observr.Decide(_outcome.FindingId, yes, indices));
            if (_applyError == null) { _decided = yes ? "accepted" : "declined"; _applied = yes ? chosen.Count : 0; }
            if (yes && _applyError == null) Ctx.RefreshFieldsFromEngine();
        }
        finally
        {
            polling.Cancel();
            try { await poller; } catch { }
            _applying = false;
            if (yes) { Ctx.IsSaving = false; Ctx.ShadowBuildPercent = 0; Ctx.RefreshStatus(); Ctx.NotifyChanged(); }
        }
    }

}
