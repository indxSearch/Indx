@* The statistics dashboard for one dataset (Notes/statistics-design.md, "Presentation"):
   hero tiles for the window's totals and rates, one time-series chart (one axis - searches and
   selects share the unit), then one section at a time behind a tab bar, each with its own view
   settings: top queries, fuzzy search, top documents, browsing and changes. All reads go
   through StatisticsStore (the N-tier rule: no SQL here), on a background thread. Document
   titles come from the engine WITHOUT waking it: FindEngine only, a hibernated dataset shows
   keys - never resolve an engine from a dashboard. *@
@using IndxServer.Services
@inherits DatasetTabBase
@inject StatisticsService Stats

@if (!Active) { return; }

<div class="stats-tab">
@if (!Stats.Enabled || Stats.Store == null)
{
    <Alert Variant="info">Statistics are switched off on this instance (<code>Statistics:Enabled</code> in appsettings).</Alert>
}
else
{
    @* The Synonyms tab's pattern: what the tab is, and the chip that says it may still change. *@
    <div class="stats-intro">
        <p>
            Searches with text are counted by the server; clicks and conversions arrive when your storefront
            sends them to <code>events/select</code> and <code>events/convert</code>.
            Experimental: the numbers and their definitions may change.
        </p>
        <Chip Size="large" Color="var(--CTeal)" TextColor="#080809" Icon="DatasetIcons.Experimental">Experimental</Chip>
    </div>

    <div class="indx-list-toolbar">
        <Tabs Items="WindowItems" Active="@_days.ToString()" ActiveChanged="@(v => SetWindow(v))"
              Size="micro" Variant="button" />
        @* Shown once any search named its surface (?source=, intrface's source prop): the
           numbers below for one surface alone. The changes are the owners', not a surface's,
           so they stay whole. At the end of the row, where a "last 30 days" stood that only
           repeated the period buttons. *@
        @if (SourceOptions.Count > 1)
        {
            <div class="indx-list-toolbar-end"><SelectField Size="micro" Variant="ghost" Options="SourceOptions" Value="@(_source ?? "")" ValueChanged="SetSource" aria-label="Search surface" /></div>
        }
    </div>

    @if (!_loaded)
    {
        <p class="stats-empty">Loading statistics…</p>
    }
    else if (Empty)
    {
        <p class="stats-empty">@(_source == null ? $"No statistics in the last {_days} days." : $"No searches from {_source} in the last {_days} days.")</p>
    }
    else
    {
        @if (_source != null)
        {
            <p class="stats-help">
                Searches sent with source <code>@_source</code>. A click or conversion counts here when it names its search by <code>queryId</code>.
                @if (Stats.RetentionDays < _days) { <text>One surface is read from the last @Stats.RetentionDays days, as far back as single searches are kept.</text> }
            </p>
        }
        <div class="stats-tiles">
            <Surface Class="stats-tile">
                <Tooltip Content="Every search with text in the window, keystrokes collapsed."><span class="stats-tile-label">Searches</span></Tooltip>
                <span class="stats-tile-value">@N(_overview.Searches)</span>
            </Surface>
            <Surface Class="stats-tile">
                <Tooltip Content="Searches with typos too large for an exact match, where the visitor still chose a result fuzzy search found."><span class="stats-tile-label">Fuzzy finds</span></Tooltip>
                <span class="stats-tile-value">@N(_overview.UncoveredChosen)</span>
            </Surface>
            <Surface Class="stats-tile">
                <Tooltip Content="Share of searches that ended in a chosen result."><span class="stats-tile-label">Click-through</span></Tooltip>
                <span class="stats-tile-value">@Pct(_overview.ClickedSearches, _overview.Searches)</span>
            </Surface>
            <Surface Class="stats-tile">
                <Tooltip Content="Mean position of the chosen result. Lower means the right hit is nearer the top."><span class="stats-tile-label">Avg. click position</span></Tooltip>
                <span class="stats-tile-value">@AvgPos()</span>
            </Surface>
            <Surface Class="stats-tile">
                <Tooltip Content="Conversions the storefront reported for results found here."><span class="stats-tile-label">Conversions</span></Tooltip>
                <span class="stats-tile-value">@N(_overview.Converts)</span>
            </Surface>
        </div>

        <Chart Series="_series" Labels="_labels" Type="line" Height="180" Markers="Markers" />

        @* The overview above stays put; the detail is one section at a time, so each can carry
           its own view settings and a phone shows one table rather than five. *@
        <div class="stats-sections">
            <Tabs Items="SectionItems" Active="@_section" ActiveChanged="@(v => _section = v ?? "queries")"
                  Scrollable AriaLabel="Statistics sections" />
        </div>

        @if (_section == "queries")
        {
            <div class="stats-view">
                <div class="stats-view-select"><SelectField Size="micro" Options="QueryOrderOptions" Value="@_queryOrder.ToString()" ValueChanged="SetQueryOrder" aria-label="Order" /></div>
            </div>
            @if (_queryOrder != QueryOrder.Searches)
            {
                <p class="stats-help">Queries searched at least @StatisticsStore.ClickThroughMinSearches times.</p>
            }
            @if (_topQueries.Count == 0) { <p class="stats-empty">No searches with text in this period.</p> }
            else {
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Top queries" Class="stats-table">
                <thead><tr><th>Query</th><th class="stats-num">Searches</th><th class="stats-num">Click-through</th><th class="stats-num">Avg. position</th></tr></thead>
                <tbody>
                    @foreach (var q in _topQueries)
                    {
                        <tr>
                            <td>@QueryLabel(q.QueryText)</td>
                            <td class="stats-num">@N(q.Searches)</td>
                            <td class="stats-num">@Pct(q.ClickedSearches, q.Searches)</td>
                            <td class="stats-num">@(q.Selects > 0 ? ((double)q.PositionSum / q.Selects).ToString("0.0") : "–")</td>
                        </tr>
                    }
                </tbody>
            </Table>
            @if (_moreQueries)
            {
                <div class="stats-more">
                    <Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.ShowMore" @onclick="ShowMoreQueries">Show @QueryPage more</Button>
                </div>
            }
            }
        }

        @if (_section == "fuzzy")
        {
            @* What fuzzy search found that an exact match could not: coverage confirmed nothing, and
               the visitor chose a result anyway. One of the things Indx does that others do not, so
               the section leads with the finds; "All" adds the searches nothing was chosen from. *@
            <div class="stats-view">
                <Tabs Items="FuzzyItems" Active="@(_fuzzyAll ? "all" : "selected")" ActiveChanged="SetFuzzyView" Size="micro" Variant="button" AriaLabel="Fuzzy searches shown" />
            </div>
            <p class="stats-help">
                @if (_fuzzyAll) { <text>Every search with typos too large for an exact match, the ones nothing was chosen from included.</text> }
                else { <text>Searches with typos too large for an exact match, where fuzzy search still found what the visitor was looking for.</text> }
            </p>
            @if (_fuzzy.Count == 0)
            {
                <p class="stats-empty">@(_fuzzyAll ? "Every search in this period had an exact or near-exact match." : "No fuzzy finds in this period.")</p>
            }
            else {
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Fuzzy search" Class="stats-table">
                <thead><tr><th>Query</th><th class="stats-num">Searches</th><th class="stats-num">Chosen</th><th>Most chosen result</th></tr></thead>
                <tbody>
                    @foreach (var q in _fuzzy)
                    {
                        <tr>
                            <td>@QueryLabel(q.QueryText)</td>
                            <td class="stats-num">@N(q.Uncovered)</td>
                            <td class="stats-num">@(q.UncoveredChosen > 0 ? N(q.UncoveredChosen) : "–")</td>
                            <td>@(q.MostChosenDocument is long key ? TitleOf(key) : "")</td>
                        </tr>
                    }
                </tbody>
            </Table>
            }
        }

        @if (_section == "documents")
        {
            <div class="stats-view">
                <div class="stats-view-select"><SelectField Size="micro" Options="DocumentOrderOptions" Value="@(_documentsByConverts ? "converts" : "selects")" ValueChanged="SetDocumentOrder" aria-label="Order" /></div>
            </div>
            @if (_topDocuments.Count == 0 && _documentsByConverts) { <p class="stats-empty">No conversions in this period. They arrive when the storefront sends them to <code>events/convert</code>.</p> }
            else if (_topDocuments.Count == 0) { <p class="stats-empty">No results were chosen in this period. Clicks arrive when the storefront sends them to <code>events/select</code>.</p> }
            else {
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Top documents" Class="stats-table">
                <thead><tr><th>Document</th><th class="stats-num">Selects</th><th class="stats-num">Conversions</th></tr></thead>
                <tbody>
                    @foreach (var d in _topDocuments)
                    {
                        <tr>
                            <td>@TitleOf(d.DocumentKey)</td>
                            <td class="stats-num">@N(d.Selects)</td>
                            <td class="stats-num">@N(d.Converts)</td>
                        </tr>
                    }
                </tbody>
            </Table>
            }
        }

        @if (_section == "browsing")
        {
            <p class="stats-help">What people narrowed the catalogue by, with or without typing, and how often it left them nothing.</p>
            @if (_topFilters.Count == 0) { <p class="stats-empty">No filters were used in this period, or Browsing is switched off on the Options tab.</p> }
            else {
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Browsing" Class="stats-table">
                @* "Without results" only when something came back empty: a column of zeros says
                   nothing and takes the room. *@
                @{ var anyEmpty = _topFilters.Any(f => f.ZeroHits > 0); }
                <thead><tr><th>Filter</th><th class="stats-num">Uses</th>@if (anyEmpty) {<th class="stats-num">Without results</th>}</tr></thead>
                <tbody>
                    @foreach (var f in _topFilters)
                    {
                        <tr>
                            <td>@FilterLabel(f)</td>
                            <td class="stats-num">@N(f.Uses)</td>
                            @if (anyEmpty) {<td class="stats-num">@N(f.ZeroHits)</td>}
                        </tr>
                    }
                </tbody>
            </Table>
            }
        }

        @if (_section == "changes")
        {
            @* What the owners changed, beside what visitors did: the why behind a bend in the line
               (Notes/statistics-design.md, "Change events"). The blue squares on the chart are these. *@
            @if (ChangeKindOptions.Count > 2)
            {
                <div class="stats-view">
                    <div class="stats-view-select"><SelectField Size="micro" Options="ChangeKindOptions" Value="@(_changeKind ?? "")" ValueChanged="SetChangeKind" aria-label="Kind of change" /></div>
                </div>
            }
            @if (_changes.Count == 0) { <p class="stats-empty">No changes were made to the dataset in this period.</p> }
            @if (_changes.Count > 0)
            {
                <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Changes" Class="stats-table">
                    <thead><tr><th>When</th><th>What</th></tr></thead>
                    <tbody>
                        @foreach (var c in Enumerable.Reverse(ShownChanges))
                        {
                            <tr>
                                <td><TimeAgo Value="DateTimeOffset.FromUnixTimeMilliseconds(c.Timestamp).UtcDateTime" TooltipPosition="left" /></td>
                                <td>@ChangeDescriptions.Describe(c.Kind, c.Summary)</td>
                            </tr>
                        }
                    </tbody>
                </Table>
            }
            @if (_documentTotals.Inserted + _documentTotals.Updated + _documentTotals.Deleted > 0
                 && (_changeKind == null || _changeKind == DatasetChangeKind.Documents))
            {
                <p class="stats-help">
                    Documents in this period: @N(_documentTotals.Inserted) inserted, @N(_documentTotals.Updated) updated, @N(_documentTotals.Deleted) deleted.
                </p>
            }
        }
    }

}
</div>

@code {
    private int _days = 30;
    private bool _loaded;
    private OverviewStat _overview;
    private List<QueryStat> _topQueries = [];
    private List<QueryStat> _fuzzy = [];
    private string _section = "queries";
    private long _fromDay, _toDay;

    // Each section's view settings. They live as long as the tab does; a new window keeps them.
    private QueryOrder _queryOrder = QueryOrder.Searches;
    private const int QueryPage = 10;
    private int _queryRows = QueryPage;
    private bool _moreQueries;
    private bool _fuzzyAll;
    private bool _documentsByConverts;
    private string? _changeKind;
    // The surface the numbers are for (?source=), null for every surface.
    private string? _source;
    private List<SourceStat> _sources = [];

    private static readonly List<SelectField.SelectOption> QueryOrderOptions =
    [
        new("Most searched", nameof(QueryOrder.Searches)),
        new("Highest click-through", nameof(QueryOrder.HighestClickThrough)),
        new("Lowest click-through", nameof(QueryOrder.LowestClickThrough)),
    ];
    private static readonly List<Tabs.TabItem> FuzzyItems =
        [new("Selected", "selected", DatasetIcons.FuzzySelected), new("All", "all", DatasetIcons.FuzzyAll)];
    private static readonly List<SelectField.SelectOption> DocumentOrderOptions =
    [
        new("Most selected", "selects"),
        new("Most converted", "converts"),
    ];

    /// <summary>"All changes" and the kinds this window has, by name.</summary>
    private List<SelectField.SelectOption> ChangeKindOptions =>
    [
        new("All changes", ""),
        .. _changes.Select(c => c.Kind).Distinct()
            .Select(k => new SelectField.SelectOption(ChangeDescriptions.KindLabel(k), k))
            .OrderBy(o => o.Label),
    ];

    /// <summary>"All surfaces" and the surfaces searched from in the window, most searched first.
    /// A chosen surface stays listed when the window holds none of its searches, so the select
    /// still says what the zeros are for.</summary>
    private List<SelectField.SelectOption> SourceOptions
    {
        get
        {
            var named = _sources.Where(x => x.Source != null).Select(x => x.Source!).ToList();
            if (_source != null && !named.Contains(_source)) named.Add(_source);
            return [new("All surfaces", ""), .. named.Select(n => new SelectField.SelectOption(n, n))];
        }
    }

    private IEnumerable<ChangeStat> ShownChanges =>
        _changeKind == null ? _changes : _changes.Where(c => c.Kind == _changeKind);

    /// <summary>The chart's change markers follow the Changes filter, so picking a kind there
    /// shows where on the line those changes fell.</summary>
    private IReadOnlyList<Chart.ChartMarker> Markers => ShownChanges
        .Select(c => new Chart.ChartMarker((int)(StatisticsStore.DayOf(c.Timestamp) - _fromDay),
                                           ChangeDescriptions.Describe(c.Kind, c.Summary)))
        .ToList();

    /// <summary>The section to open on: queries, fuzzy, documents, browsing or changes.</summary>
    [Parameter] public string? InitialSection { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(InitialSection)) _section = InitialSection;
    }

    /// <summary>The detail sections, in the order they matter. Changes carries how many fell in
    /// the window, in the info blue of the chart's change markers: a change is information, not a
    /// warning, and the badge and the marks are the same thing. Over 99 it says 99+.</summary>
    private List<Tabs.TabItem> SectionItems =>
    [
        new("Top queries", "queries", DatasetIcons.TopQueries),
        new("Fuzzy search", "fuzzy", DatasetIcons.FuzzySearch),
        new("Top documents", "documents", DatasetIcons.TopDocuments),
        new("Browsing", "browsing", DatasetIcons.Browsing),
        new("Changes", "changes", DatasetIcons.Changes,
            Badge: _changes.Count switch { 0 => null, > 99 => "99+", var n => n.ToString() },
            BadgeTitle: $"{_changes.Count} changes in the last {_days} days", BadgeTone: "info"),
    ];
    private List<DocumentStat> _topDocuments = [];
    private List<FilterStat> _topFilters = [];
    private List<ChangeStat> _changes = [];
    private (long Inserted, long Updated, long Deleted) _documentTotals;
    private IReadOnlyList<Chart.ChartSeries> _series = [];
    private string[]? _labels;
    private Func<long, string?>? _label;
    private bool _wasActive;

    private static readonly List<Tabs.TabItem> WindowItems =
    [
        new("7 days", "7"), new("30 days", "30"), new("90 days", "90"),
    ];

    private bool Empty => _overview.Searches == 0 && _overview.Selects == 0 && _overview.Converts == 0
                          && _topFilters.Count == 0 && _changes.Count == 0
                          && _documentTotals.Inserted + _documentTotals.Updated + _documentTotals.Deleted == 0;

    protected override async Task OnParametersSetAsync()
    {
        // Awaited (not fire-and-forget) so static rendering - prerender and the render tests -
        // waits for the data; interactively Blazor still paints the loading state at the first
        // await and again on completion.
        if (Active && !_wasActive)
        {
            _wasActive = true;
            await LoadAsync();
        }
        if (!Active) _wasActive = false;
    }

    private void SetWindow(string? value)
    {
        if (value != null && int.TryParse(value, out var days) && days != _days)
        {
            _days = days;
            _ = LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var store = Stats.Store;
        if (store == null) return;
        _loaded = false;
        var (team, ds, days, source) = (Ctx.TeamId, Ctx.Name, _days, _source);
        await Task.Run(() =>
        {
            long toDay = StatisticsStore.DayOf(DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
            long fromDay = toDay - days + 1;
            (_fromDay, _toDay) = (fromDay, toDay);
            _sources = store.Sources(team, ds, fromDay, toDay);
            _overview = store.Overview(team, ds, fromDay, toDay, source);
            LoadLists(store);
            _topFilters = store.TopFilters(team, ds, fromDay, toDay, 10, source);
            _changes = store.Changes(team, ds, fromDay, toDay);
            if (_changeKind != null && !_changes.Any(c => c.Kind == _changeKind)) _changeKind = null;
            var documentDays = store.DocumentChanges(team, ds, fromDay, toDay);
            _documentTotals = (documentDays.Sum(d => d.Inserted), documentDays.Sum(d => d.Updated), documentDays.Sum(d => d.Deleted));

            var byDay = store.TimeSeries(team, ds, fromDay, toDay, source).ToDictionary(r => r.Day);
            var searches = new double[days];
            var selects = new double[days];
            var labels = new string[days];
            for (int i = 0; i < days; i++)
            {
                var day = fromDay + i;
                var row = byDay.GetValueOrDefault(day);
                searches[i] = row.Searches;
                selects[i] = row.Selects;
                labels[i] = DateOnly.FromDayNumber((int)day + DateOnly.Parse("1970-01-01").DayNumber).ToString("d MMM");
            }
            _series = new List<Chart.ChartSeries>
            {
                new("Searches", searches),
                new("Selects", selects, "var(--CTeal)"),
            };
            _labels = labels;
        });
        _label = null;   // the label field may have changed on the Options tab
        _loaded = true;
        await Render();
    }

    /// <summary>The lists whose rows depend on a section's view settings.</summary>
    private void LoadLists(StatisticsStore store)
    {
        var (team, ds, source) = (Ctx.TeamId, Ctx.Name, _source);
        // One row past the page says whether there is another page.
        var queries = store.TopQueries(team, ds, _fromDay, _toDay, _queryRows + 1, order: _queryOrder, source: source);
        _moreQueries = queries.Count > _queryRows;
        _topQueries = _moreQueries ? queries[.._queryRows] : queries;
        _fuzzy = store.TopQueries(team, ds, _fromDay, _toDay, 10, uncoveredOnly: true,
            order: _fuzzyAll ? QueryOrder.Searches : QueryOrder.ChosenAnyway, source: source);
        _topDocuments = store.TopDocuments(team, ds, _fromDay, _toDay, 10, byConverts: _documentsByConverts, source: source);
    }

    private async Task ReloadListsAsync()
    {
        var store = Stats.Store;
        if (store == null || !_loaded) return;
        await Task.Run(() => LoadLists(store));
        await Render();
    }

    private Task SetQueryOrder(string? value)
    {
        if (!Enum.TryParse<QueryOrder>(value, out var order) || order == _queryOrder) return Task.CompletedTask;
        _queryOrder = order;
        return ReloadListsAsync();
    }

    private Task ShowMoreQueries()
    {
        _queryRows += QueryPage;
        return ReloadListsAsync();
    }

    private Task SetFuzzyView(string? value)
    {
        var all = value == "all";
        if (all == _fuzzyAll) return Task.CompletedTask;
        _fuzzyAll = all;
        return ReloadListsAsync();
    }

    private Task SetDocumentOrder(string? value)
    {
        var byConverts = value == "converts";
        if (byConverts == _documentsByConverts) return Task.CompletedTask;
        _documentsByConverts = byConverts;
        return ReloadListsAsync();
    }

    private Task SetSource(string? value)
    {
        var source = string.IsNullOrEmpty(value) ? null : value;
        if (source == _source) return Task.CompletedTask;
        _source = source;
        _queryRows = QueryPage;
        return LoadAsync();
    }

    private void SetChangeKind(string? value) => _changeKind = string.IsNullOrEmpty(value) ? null : value;

    /// <summary>A browse (empty) search is counted too; give it a name rather than a blank cell.</summary>
    private static RenderFragment QueryLabel(string text) => __builder =>
    {
        if (string.IsNullOrWhiteSpace(text)) { <span class="stats-muted">(empty search)</span> }
        else { @text }
    };

    /// <summary>"genre: Poetry", "year (range)". The value comes out of the filter key, where a
    /// case-insensitive filter's value is lowercased, so the first letter is capitalised for
    /// reading; the real spelling is not in the key to restore.</summary>
    private static string FilterLabel(FilterStat f) =>
        f.Value.Length == 0
            ? $"{f.Field} (range)"
            : $"{f.Field}: {char.ToUpper(f.Value[0], System.Globalization.CultureInfo.CurrentCulture)}{f.Value[1..]}";

    private static string N(long n) => n.ToString("#,##0");

    private static string Pct(long numerator, long denominator) =>
        denominator == 0 ? "–" : ((double)numerator / denominator).ToString("0.0 %");

    private string AvgPos() =>
        _overview.Selects == 0 ? "–" : ((double)_overview.PositionSum / _overview.Selects).ToString("0.0");

    /// <summary>A readable name for a document: the label field the Options tab sets, else the
    /// first searchable field (StatisticsLabels, the rule the HTTP reads use too), read via
    /// FindEngine, which never wakes a hibernated dataset; then the key stands in.</summary>
    private string TitleOf(long key) =>
        (_label ??= StatisticsLabels.For(Ctx.FindEngine(), Stats.Store?.LabelField(Ctx.TeamId, Ctx.Name)))(key)
        ?? key.ToString();

}
