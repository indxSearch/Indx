@* The statistics dashboard for one dataset (Notes/statistics-design.md, "Presentation"):
   hero tiles for the window's totals and rates, one time-series chart (one axis - searches and
   selects share the unit), the zero-hit list, top queries and top documents. All reads go
   through StatisticsStore (the N-tier rule: no SQL here), on a background thread. Document
   titles come from the engine WITHOUT waking it: FindEngine only, a hibernated dataset shows
   keys - never resolve an engine from a dashboard. *@
@using System.Text.Json
@using IndxServer.Services
@inherits DatasetTabBase
@inject StatisticsService Stats

@if (!Active) { return; }

<div class="stats-tab">
@if (!Stats.Enabled || Stats.Store == null)
{
    <Alert Variant="info">Statistics are switched off on this instance (<code>Statistics:Enabled</code> in appsettings).</Alert>
}
else
{
    @* The Synonyms tab's pattern: what the tab is, and the chip that says it may still change. *@
    <div class="stats-intro">
        <p>
            Searches with text are counted by the server; clicks and conversions arrive when your storefront
            sends them to <code>events/select</code> and <code>events/convert</code>.
            Experimental: the numbers and their definitions may change.
        </p>
        <Chip Size="large" Color="var(--CTeal)" TextColor="#080809" Icon="DatasetIcons.Experimental">Experimental</Chip>
    </div>

    <div class="indx-list-toolbar">
        <Tabs Items="WindowItems" Active="@_days.ToString()" ActiveChanged="@(v => SetWindow(v))"
              Size="micro" Variant="button" />
        @if (_loaded && !Empty)
        {
            <span class="indx-list-toolbar-end">last @_days days</span>
        }
    </div>

    @if (!_loaded)
    {
        <p class="stats-empty">Loading statistics…</p>
    }
    else if (Empty)
    {
        <p class="stats-empty">No statistics in the last @_days days.</p>
    }
    else
    {
        <div class="stats-tiles">
            <Surface Class="stats-tile">
                <Tooltip Content="Every search with text in the window, keystrokes collapsed."><span class="stats-tile-label">Searches</span></Tooltip>
                <span class="stats-tile-value">@N(_overview.Searches)</span>
            </Surface>
            <Surface Class="stats-tile">
                <Tooltip Content="Share of searches coverage confirmed no result for: what was shown came from fuzzy matching alone, or nothing was."><span class="stats-tile-label">Without coverage</span></Tooltip>
                <span class="stats-tile-value">@Pct(_overview.Uncovered, _overview.Searches)</span>
            </Surface>
            <Surface Class="stats-tile">
                <Tooltip Content="Share of searches that ended in a chosen result."><span class="stats-tile-label">Click-through</span></Tooltip>
                <span class="stats-tile-value">@Pct(_overview.ClickedSearches, _overview.Searches)</span>
            </Surface>
            <Surface Class="stats-tile">
                <Tooltip Content="Mean position of the chosen result. Lower means the right hit is nearer the top."><span class="stats-tile-label">Avg. click position</span></Tooltip>
                <span class="stats-tile-value">@AvgPos()</span>
            </Surface>
            <Surface Class="stats-tile">
                <Tooltip Content="Conversions the storefront reported for results found here."><span class="stats-tile-label">Conversions</span></Tooltip>
                <span class="stats-tile-value">@N(_overview.Converts)</span>
            </Surface>
        </div>

        <Chart Series="_series" Labels="_labels" Type="line" Height="180" Markers="_markers" />

        @* The overview above stays put; the detail is one section at a time, so each can carry
           its own view settings and a phone shows one table rather than five. *@
        <Tabs Items="SectionItems" Active="@_section" ActiveChanged="@(v => _section = v ?? "queries")"
              Size="micro" Scrollable Bleed="calc(var(--page-gutter) + 5px)" AriaLabel="Statistics sections" />

        @if (_section == "queries")
        {
            @if (_topQueries.Count == 0) { <p class="stats-empty">No searches with text in this period.</p> }
            else {
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Top queries" Class="stats-table">
                <thead><tr><th>Query</th><th class="stats-num">Searches</th><th class="stats-num">Click-through</th><th class="stats-num">Avg. position</th></tr></thead>
                <tbody>
                    @foreach (var q in _topQueries)
                    {
                        <tr>
                            <td>@QueryLabel(q.QueryText)</td>
                            <td class="stats-num">@N(q.Searches)</td>
                            <td class="stats-num">@Pct(q.ClickedSearches, q.Searches)</td>
                            <td class="stats-num">@(q.Selects > 0 ? ((double)q.PositionSum / q.Selects).ToString("0.0") : "–")</td>
                        </tr>
                    }
                </tbody>
            </Table>
            }
        }

        @if (_section == "uncovered")
        {
            @* A fuzzy engine nearly always shows something, so "no results" is rare and says little.
               Without coverage is the signal: coverage confirmed nothing. A row nobody chose from is
               a gap in the catalogue or a missing synonym; a row with choices is a search fuzzy
               matching rescued, and the most chosen document says what the visitor meant. *@
            <p class="stats-help">Searches coverage confirmed nothing for. Chosen anyway means fuzzy matching found what the visitor meant: a synonym or spelling to add. Nothing chosen: a gap to fill.</p>
            @if (_uncovered.Count == 0) { <p class="stats-empty">Coverage confirmed a result for every search in this period.</p> }
            else {
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Searches without coverage" Class="stats-table">
                <thead><tr><th>Query</th><th class="stats-num">Searches</th><th class="stats-num">Chosen anyway</th><th>Most chosen</th></tr></thead>
                <tbody>
                    @foreach (var q in _uncovered)
                    {
                        <tr>
                            <td>@QueryLabel(q.QueryText)</td>
                            <td class="stats-num">@N(q.Uncovered)</td>
                            <td class="stats-num">@(q.UncoveredChosen > 0 ? N(q.UncoveredChosen) : "–")</td>
                            <td>@(q.MostChosenDocument is long key ? TitleOf(key) : "")</td>
                        </tr>
                    }
                </tbody>
            </Table>
            }
        }

        @if (_section == "documents")
        {
            @if (_topDocuments.Count == 0) { <p class="stats-empty">No results were chosen in this period. Clicks arrive when the storefront sends them to <code>events/select</code>.</p> }
            else {
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Top documents" Class="stats-table">
                <thead><tr><th>Document</th><th class="stats-num">Selects</th><th class="stats-num">Conversions</th></tr></thead>
                <tbody>
                    @foreach (var d in _topDocuments)
                    {
                        <tr>
                            <td>@TitleOf(d.DocumentKey)</td>
                            <td class="stats-num">@N(d.Selects)</td>
                            <td class="stats-num">@N(d.Converts)</td>
                        </tr>
                    }
                </tbody>
            </Table>
            }
        }

        @if (_section == "browsing")
        {
            <p class="stats-help">What people narrowed the catalogue by, with or without typing, and how often it left them nothing.</p>
            @if (_topFilters.Count == 0) { <p class="stats-empty">No filters were used in this period, or Browsing is switched off on the Options tab.</p> }
            else {
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Browsing" Class="stats-table">
                @* "Without results" only when something came back empty: a column of zeros says
                   nothing and takes the room. *@
                @{ var anyEmpty = _topFilters.Any(f => f.ZeroHits > 0); }
                <thead><tr><th>Filter</th><th class="stats-num">Uses</th>@if (anyEmpty) {<th class="stats-num">Without results</th>}</tr></thead>
                <tbody>
                    @foreach (var f in _topFilters)
                    {
                        <tr>
                            <td>@FilterLabel(f)</td>
                            <td class="stats-num">@N(f.Uses)</td>
                            @if (anyEmpty) {<td class="stats-num">@N(f.ZeroHits)</td>}
                        </tr>
                    }
                </tbody>
            </Table>
            }
        }

        @if (_section == "changes")
        {
            @* What the owners changed, beside what visitors did: the why behind a bend in the line
               (Notes/statistics-design.md, "Change events"). The blue squares on the chart are these. *@
            @if (_changes.Count == 0) { <p class="stats-empty">No changes were made to the dataset in this period.</p> }
            @if (_changes.Count > 0)
            {
                <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Changes" Class="stats-table">
                    <thead><tr><th>When</th><th>What</th></tr></thead>
                    <tbody>
                        @foreach (var c in Enumerable.Reverse(_changes))
                        {
                            <tr>
                                <td><TimeAgo Value="DateTimeOffset.FromUnixTimeMilliseconds(c.Timestamp).UtcDateTime" TooltipPosition="left" /></td>
                                <td>@ChangeDescriptions.Describe(c.Kind, c.Summary)</td>
                            </tr>
                        }
                    </tbody>
                </Table>
            }
            @if (_documentTotals.Inserted + _documentTotals.Updated + _documentTotals.Deleted > 0)
            {
                <p class="stats-help">
                    Documents in this period: @N(_documentTotals.Inserted) inserted, @N(_documentTotals.Updated) updated, @N(_documentTotals.Deleted) deleted.
                </p>
            }
        }
    }

}
</div>

@code {
    private int _days = 30;
    private bool _loaded;
    private OverviewStat _overview;
    private List<QueryStat> _topQueries = [];
    private List<QueryStat> _uncovered = [];
    private string _section = "queries";

    /// <summary>The section to open on: queries, uncovered, documents, browsing or changes.</summary>
    [Parameter] public string? InitialSection { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(InitialSection)) _section = InitialSection;
    }

    /// <summary>The detail sections, in the order they matter. Changes carries a count: a change
    /// is the thing worth noticing from the overview.</summary>
    private List<Tabs.TabItem> SectionItems =>
    [
        new("Top queries", "queries"),
        new("Without coverage", "uncovered"),
        new("Top documents", "documents"),
        new("Browsing", "browsing"),
        new("Changes", "changes", Badge: _changes.Count > 0 ? _changes.Count.ToString() : null),
    ];
    private List<DocumentStat> _topDocuments = [];
    private List<FilterStat> _topFilters = [];
    private List<ChangeStat> _changes = [];
    private (long Inserted, long Updated, long Deleted) _documentTotals;
    private IReadOnlyList<Chart.ChartMarker>? _markers;
    private IReadOnlyList<Chart.ChartSeries> _series = [];
    private string[]? _labels;
    private readonly Dictionary<long, string> _titles = [];
    private bool _wasActive;

    private static readonly List<Tabs.TabItem> WindowItems =
    [
        new("7 days", "7"), new("30 days", "30"), new("90 days", "90"),
    ];

    private bool Empty => _overview.Searches == 0 && _overview.Selects == 0 && _overview.Converts == 0
                          && _topFilters.Count == 0 && _changes.Count == 0
                          && _documentTotals.Inserted + _documentTotals.Updated + _documentTotals.Deleted == 0;

    protected override async Task OnParametersSetAsync()
    {
        // Awaited (not fire-and-forget) so static rendering - prerender and the render tests -
        // waits for the data; interactively Blazor still paints the loading state at the first
        // await and again on completion.
        if (Active && !_wasActive)
        {
            _wasActive = true;
            await LoadAsync();
        }
        if (!Active) _wasActive = false;
    }

    private void SetWindow(string? value)
    {
        if (value != null && int.TryParse(value, out var days) && days != _days)
        {
            _days = days;
            _ = LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var store = Stats.Store;
        if (store == null) return;
        _loaded = false;
        var (team, ds, days) = (Ctx.TeamId, Ctx.Name, _days);
        await Task.Run(() =>
        {
            long toDay = StatisticsStore.DayOf(DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
            long fromDay = toDay - days + 1;
            _overview = store.Overview(team, ds, fromDay, toDay);
            _topQueries = store.TopQueries(team, ds, fromDay, toDay, 10);
            _uncovered = store.TopQueries(team, ds, fromDay, toDay, 10, uncoveredOnly: true);
            _topDocuments = store.TopDocuments(team, ds, fromDay, toDay, 10);
            _topFilters = store.TopFilters(team, ds, fromDay, toDay, 10);
            _changes = store.Changes(team, ds, fromDay, toDay);
            var documentDays = store.DocumentChanges(team, ds, fromDay, toDay);
            _documentTotals = (documentDays.Sum(d => d.Inserted), documentDays.Sum(d => d.Updated), documentDays.Sum(d => d.Deleted));
            _markers = _changes
                .Select(c => new Chart.ChartMarker((int)(StatisticsStore.DayOf(c.Timestamp) - fromDay),
                                                   ChangeDescriptions.Describe(c.Kind, c.Summary)))
                .ToList();

            var byDay = store.TimeSeries(team, ds, fromDay, toDay).ToDictionary(r => r.Day);
            var searches = new double[days];
            var selects = new double[days];
            var labels = new string[days];
            for (int i = 0; i < days; i++)
            {
                var day = fromDay + i;
                var row = byDay.GetValueOrDefault(day);
                searches[i] = row.Searches;
                selects[i] = row.Selects;
                labels[i] = DateOnly.FromDayNumber((int)day + DateOnly.Parse("1970-01-01").DayNumber).ToString("d MMM");
            }
            _series = new List<Chart.ChartSeries>
            {
                new("Searches", searches),
                new("Selects", selects, "var(--CTeal)"),
            };
            _labels = labels;
        });
        _titles.Clear();
        _loaded = true;
        await Render();
    }

    /// <summary>A browse (empty) search is counted too; give it a name rather than a blank cell.</summary>
    private static RenderFragment QueryLabel(string text) => __builder =>
    {
        if (string.IsNullOrWhiteSpace(text)) { <span class="stats-muted">(empty search)</span> }
        else { @text }
    };

    /// <summary>"genre: Poetry", "year (range)". The value comes out of the filter key, where a
    /// case-insensitive filter's value is lowercased, so the first letter is capitalised for
    /// reading; the real spelling is not in the key to restore.</summary>
    private static string FilterLabel(FilterStat f) =>
        f.Value.Length == 0
            ? $"{f.Field} (range)"
            : $"{f.Field}: {char.ToUpper(f.Value[0], System.Globalization.CultureInfo.CurrentCulture)}{f.Value[1..]}";

    private static string N(long n) => n.ToString("#,##0");

    private static string Pct(long numerator, long denominator) =>
        denominator == 0 ? "–" : ((double)numerator / denominator).ToString("0.0 %");

    private string AvgPos() =>
        _overview.Selects == 0 ? "–" : ((double)_overview.PositionSum / _overview.Selects).ToString("0.0");

    /// <summary>A readable name for a document, from the engine's stored JSON — via FindEngine,
    /// which never wakes a hibernated dataset; then the key stands in.</summary>
    private string TitleOf(long key)
    {
        if (_titles.TryGetValue(key, out var cached)) return cached;
        string title = key.ToString();
        try
        {
            var json = Ctx.FindEngine()?.GetJsonDataOfKey(key);
            if (!string.IsNullOrEmpty(json))
            {
                using var doc = JsonDocument.Parse(json);
                string? best = null;
                foreach (var property in doc.RootElement.EnumerateObject())
                {
                    if (property.Value.ValueKind != JsonValueKind.String) continue;
                    best ??= property.Value.GetString();
                    var name = property.Name.ToLowerInvariant();
                    if (name is "title" or "name" or "displayname") { best = property.Value.GetString(); break; }
                }
                if (!string.IsNullOrWhiteSpace(best))
                    title = best.Length > 80 ? best[..80] + "…" : best;
            }
        }
        catch (JsonException) { }
        _titles[key] = title;
        return title;
    }
}
