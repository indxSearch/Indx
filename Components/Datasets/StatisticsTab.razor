@* The statistics dashboard for one dataset (Notes/statistics-design.md, "Presentation"):
   hero tiles for the window's totals and rates, one time-series chart (one axis - searches and
   selects share the unit), then one section at a time behind a tab bar, each with its own view
   settings: top queries, fuzzy search, top documents, browsing and changes. All reads go
   through StatisticsStore (the N-tier rule: no SQL here), on a background thread. Document
   titles come from the engine WITHOUT waking it: FindEngine only, a hibernated dataset shows
   keys - never resolve an engine from a dashboard. *@
@using IndxServer.Services
@inherits DatasetTabBase
@inject StatisticsService Stats
@inject IndxServer.Services.Observr.ObservrFindingStore ObservrStore
@inject IndxServer.Services.Observr.ObservrSubscription ObservrSubscription
@inject IndxServer.Services.Observr.AgentPanelState Agent
@inject IServiceProvider Services

@if (!Active) { return; }

<div class="stats-tab">
@if (!Stats.Enabled || Stats.Store == null)
{
    <Alert Variant="info">Statistics are switched off on this instance (<code>Statistics:Enabled</code> in appsettings).</Alert>
}
else
{
    @* The bar over the content (Notes/Anders/console-shell-plan-2026-10-13.md, stage 2): what
       belongs to everything below, the tiles and the chart included, the surface and the period.
       The detail sections are tabs just above their table, further down. *@
    <div class="indx-context-bar">
        <SegmentedControl Items="WindowItems" Value="@_days.ToString()" ValueChanged="@(v => SetWindow(v))" AriaLabel="Period" />
        <div class="indx-context-bar-end">
            @* Shown once any search named its surface (?source=, intrface's source prop): the
               numbers below for one surface alone. The changes are the owners', not a surface's,
               so they stay whole. *@
            @if (SourceOptions.Count > 1)
            {
                <SelectField Size="micro" Variant="ghost" Options="SourceOptions" Value="@(_source ?? "")" ValueChanged="SetSource" aria-label="Search surface" />
            }
        </div>
    </div>

    @* What the tab is, and where its numbers come from. *@
    <div class="stats-intro">
        <p>
            Searches with text are counted by the server; clicks and conversions arrive when your storefront
            sends them to <code>events/select</code> and <code>events/convert</code>.
        </p>
    </div>

    @if (!_loaded)
    {
        @* The shape of what is coming: the five tiles, the chart and the first rows of a table, so
           nothing jumps when the numbers land. Skeleton waits 0.15s before it shows, so a quick
           load (most of them) never flashes it. *@
        <div class="stats-loading" role="status" aria-busy="true" aria-label="Loading statistics">
            <StatGroup Columns="5">
                @for (var i = 0; i < 5; i++)
                {
                    var delay = i * 0.05;
                    <Stat>
                        <LabelContent><Skeleton Level="3" Width="60%" Delay="delay" /></LabelContent>
                        <ValueContent><Skeleton Level="3" Height="24px" Width="40%" Delay="delay" /></ValueContent>
                    </Stat>
                }
            </StatGroup>
            <Skeleton Height="180px" Delay="0.1" />
            <div class="stats-loading-rows">
                @foreach (var (width, i) in LoadingRowWidths.Select((w, i) => (w, i)))
                {
                    <Skeleton Width="@($"{width}%")" Delay="@(0.15 + i * 0.05)" />
                }
            </div>
        </div>
    }
    else if (Empty)
    {
        <p class="stats-empty">@(_source == null ? $"No statistics in the last {_days} days." : $"No searches from {_source} in the last {_days} days.")</p>
    }
    else
    {
        @if (_source != null)
        {
            <p class="stats-help">
                Searches sent with source <code>@_source</code>. A click or conversion counts here when it names its search by <code>queryId</code>.
                @if (Stats.RetentionDays < _days) { <text>One surface is read from the last @Stats.RetentionDays days, as far back as single searches are kept.</text> }
            </p>
        }
        <StatGroup Columns="5">
            <Stat Label="Searches" Hint="Every search with text in the window, keystrokes collapsed."><ValueContent>@N(_overview.Searches)</ValueContent></Stat>
            <Stat Label="Fuzzy finds" Hint="Searches with typos too large for an exact match, where the visitor still chose a result fuzzy search found."><ValueContent>@N(_overview.UncoveredChosen)</ValueContent></Stat>
            <Stat Label="Click-through" Hint="Share of searches that ended in a chosen result."><ValueContent>@Pct(_overview.ClickedSearches, _overview.Searches)</ValueContent></Stat>
            <Stat Label="Avg. click position" Hint="Mean position of the chosen result. Lower means the right hit is nearer the top."><ValueContent>@AvgPos()</ValueContent></Stat>
            <Stat Label="Conversions" Hint="Conversions the storefront reported for results found here."><ValueContent>@N(_overview.Converts)</ValueContent></Stat>
        </StatGroup>

        @* The window day by day: searches as an area with the selects on it, against a value axis,
           as a line or as bars. *@
        <div class="stats-chart-head">
            <span class="stats-chart-title">Per day</span>
            <SegmentedControl Items="ChartTypeItems" @bind-Value="_chartType" AriaLabel="Chart type" />
        </div>
        <Chart Series="_series" Labels="_labels" Type="@_chartType" Height="180" Markers="Markers" YAxis="right" />

        @* The detail sections, one at a time, just above the table they choose: each can carry its
           own view settings, and a phone shows one table rather than five. *@
        <div class="stats-sections">
            <Tabs Items="SectionItems" Active="@_section" ActiveChanged="@(v => _section = v ?? "overview")"
                  Scrollable AriaLabel="Statistics sections" />
        </div>

        @if (_section == "overview")
        {
            @* A third each, as the stat tiles above: stretched across the page the heatmap and the
               row looked lost. No surface under them: the heatmap's empty cells are the Base tone.
               The typing panel, the tallest, comes last, so it never leaves a gap under a short
               neighbour: the grid aligns to the top and masonry is not shipped. *@
            <div class="stats-overview">
        @* When people search: the week by hour in the dataset's own time zone, a day per row and
           an hour per column, a cell's tone its searches. Nights, weekends and the evening peak
           show at a glance (25 Oct 2026; the Overview section, first, in the place searches by surface had: the
           surface select above narrows this as it does the rest). *@
        @if (_weekHour is { Total: > 0 } week)
        {
            <div class="stats-overview-item">
            <div class="stats-chart-head">
                <span class="stats-chart-title">When people search</span>
            </div>
            <p class="stats-help">@WeekHourSummary(week)@(Stats.RetentionDays < _days ? $" From the last {Stats.RetentionDays} days, as far back as single searches are kept." : "")</p>
            <Heatmap Values="WeekHourCells(week)" Rows="7" ColumnLabels="HourLabels" RowLabels="WeekdayLabels"
                     Format="@((v, i) => $"{WeekdayNames[i % 7]} {i / 7:00}:00-{(i / 7 + 1) % 24:00}:00: {N((long)v)} {(v == 1 ? "search" : "searches")}")"
                     AriaLabel="Searches by weekday and hour" Cell="9" />
            </div>
        }

        @* Searches by surface, the window day by day stacked by the surface that sent them: the
           named ones in the ink and the patterns, the unnamed rest dim. Only for the whole dataset
           (one surface chosen above leaves nothing to split) and once there is more than one. *@
        @if (_source == null && _bySurface.Count > 1)
        {
            <div class="stats-overview-item">
            <div class="stats-chart-head">
                <span class="stats-chart-title">Searches by surface</span>
            </div>
            <p class="stats-help">Where the searches came from, day by day: the surface each page names with <code>source</code>.</p>
            <Chart Series="_bySurface" Labels="_labels" Type="bar" Stacked="true" Height="140" />
            </div>
        }

        @* Which result is chosen: the clicks by the position of what was clicked. Most on the first
           says the ranking puts the right thing on top; many from far down, that it can do better. *@
        @if (_positions is { Total: > 0 } positions)
        {
            <div class="stats-overview-item">
            <div class="stats-chart-head">
                <span class="stats-chart-title">Which result is chosen</span>
            </div>
            <p class="stats-help">The first result in @Pct(positions.First, positions.Total) of @N(positions.Total) clicks@(positions.BelowTen > 0 ? $", and one below the tenth in {Pct(positions.BelowTen, positions.Total)}" : "").</p>
            <BarMeter Segments="PositionSegments(positions)" Labels="legend" Format="@(v => Pct((long)v, positions.Total))" />
            </div>
        }

        @* Languages: the language of the page each search came from, as the storefront reports
           it, the searches that named none as the unnamed rest. *@
        @if (_locales.Count > 0 && _locales.Any(l => l.Locale != null))
        {
            <div class="stats-overview-item">
            <div class="stats-chart-head">
                <span class="stats-chart-title">Languages</span>
            </div>
            <p class="stats-help">The language of the page the search was typed on, as the page reports it; a cell is a percent.</p>
            <Waffle Segments="LocaleSegments(_locales)" Format="@((f, v) => Pct((long)v, _locales.Sum(l => l.Searches)))" AriaLabel="Searches by language" />
            </div>
        }

        @* How people type: the searches by their word count as a small bar chart, whose shape says
           it (a catalogue is a tall first bar, a help site a hump at three), and four figures: the
           median length, the share with a filter, the share that settled on a partial word (search
           as you type paying off) and the median keystrokes before a settled search. A word is what
           a space separates. *@
        @if (_typing is { Total: > 0 } typing)
        {
            <div class="stats-overview-item">
            <div class="stats-chart-head">
                <span class="stats-chart-title">How people type</span>
            </div>
            <p class="stats-help">Words per search, a word being what a space separates.</p>
            <Chart Type="bar" Labels="WordLabels" Height="110" ShowLegend="false"
                   Series="@(new List<Chart.ChartSeries> { new("Searches", typing.Words.Select(w => (double)w).ToArray()) })" />
            <div class="stats-typing-figures">
                <Stat Label="Median length" Value="@($"{typing.MedianLength} chars")" />
                <Stat Label="With a filter" Value="@Pct(typing.WithFilter, typing.Total)" />
                <Stat Label="Settled mid-word" Hint="Searches that stopped on a partial word, pika for pikachu, because the results were already right: search as you type paying off. Counted where someone else went on to type the whole word, so a lower bound." Value="@Pct(typing.MidWord, typing.Total)" />
                <Stat Label="Keystrokes" Hint="The searches a visitor's typing sent before the one that settled, in the middle; over the searches that carried a session, which the console and plain API calls do not." Value="@(typing.WithSession > 0 ? N(typing.Keystrokes) : "–")">
                    @if (typing.WithSession > 0) { <text>of @N(typing.WithSession) with a session</text> }
                </Stat>
            </div>
            </div>
        }

            </div>
            @if (_weekHour is not { Total: > 0 } && _positions is not { Total: > 0 } && _typing is not { Total: > 0 })
            {
                <p class="stats-empty">No searches with text in this period.</p>
            }
        }

        @if (_section == "queries")
        {
            <div class="stats-view">
                <div class="stats-view-select"><SelectField Size="micro" Options="QueryOrderOptions" Value="@(_zeroHits ? ZeroHitsView : _queryOrder.ToString())" ValueChanged="SetQueryOrder" aria-label="Order" /></div>
                @if (_listsLoading) { <span class="stats-view-busy" aria-live="polite"><Spinner Size="14" /> Loading…</span> }
            </div>
            @if (_zeroHits)
            {
                <p class="stats-help">Searches that found nothing, most often first.@((ObservrSubscription.Visible && ObservrStore.IsEnabled(Ctx.TeamId, Ctx.Name)) ? " Ask Observr what went wrong and what to do about it." : "")</p>
            }
            else if (_queryOrder != QueryOrder.Searches)
            {
                <p class="stats-help">Queries searched at least @StatisticsStore.ClickThroughMinSearches times.</p>
            }
            @if (_topQueries.Count == 0) { <p class="stats-empty">@(_zeroHits ? "Every search found something in this period." : "No searches with text in this period.")</p> }
            else {
            @if (_zeroHits)
            {
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Searches that found nothing" Class="stats-table">
                <thead><tr><th>Query</th><th class="stats-num">Found nothing</th><th></th></tr></thead>
                <tbody>
                    @foreach (var q in _topQueries)
                    {
                        <tr>
                            <td>@QueryLabel(q.QueryText)</td>
                            <td class="stats-num">@N(q.ZeroHits)</td>
                            <td class="stats-action">
                                @if (Ctx.IsEditor && (ObservrSubscription.Visible && ObservrStore.IsEnabled(Ctx.TeamId, Ctx.Name)))
                                {
                                    var zero = q;
                                    <span class="indx-observr"><Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.Observr" @onclick="() => AskZeroHit(zero)">Why nothing?</Button></span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </Table>
            }
            else
            {
            var lowClick = _queryOrder == QueryOrder.LowestClickThrough && Ctx.IsEditor && (ObservrSubscription.Visible && ObservrStore.IsEnabled(Ctx.TeamId, Ctx.Name));
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Top queries" Class="stats-table">
                <thead><tr><th>Query</th><th class="stats-num">Searches</th><th class="stats-num">Click-through</th><th class="stats-num">Avg. position</th>@if (lowClick) { <th></th> }</tr></thead>
                <tbody>
                    @foreach (var q in _topQueries)
                    {
                        <tr>
                            <td>@QueryLabel(q.QueryText)</td>
                            <td class="stats-num">@N(q.Searches)</td>
                            <td class="stats-num">@Pct(q.ClickedSearches, q.Searches)</td>
                            <td class="stats-num">@(q.Selects > 0 ? ((double)q.PositionSum / q.Selects).ToString("0.0") : "–")</td>
                            @if (lowClick)
                            {
                                <td class="stats-action">
                                    @{ var stat = q; }
                                    <span class="indx-observr"><Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.Observr" @onclick="() => AskLowClick(stat)">Why isn't this working?</Button></span>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </Table>
            }
            @if (_moreQueries)
            {
                <div class="stats-more">
                    <Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.ShowMore" Loading="@_listsLoading" @onclick="ShowMoreQueries">Show @QueryPage more</Button>
                </div>
            }
            }
        }

        @if (_section == "fuzzy")
        {
            @* What fuzzy search found that an exact match could not: coverage confirmed nothing, and
               the visitor chose a result anyway. One of the things Indx does that others do not, so
               the section leads with the finds; "All" adds the searches nothing was chosen from. *@
            <div class="stats-view">
                <Tabs Items="FuzzyItems" Active="@(_fuzzyAll ? "all" : "selected")" ActiveChanged="SetFuzzyView" Size="micro" Variant="button" AriaLabel="Fuzzy searches shown" />
                @if (_listsLoading) { <span class="stats-view-busy" aria-live="polite"><Spinner Size="14" /> Loading…</span> }
            </div>
            <p class="stats-help">
                @if (_fuzzyAll) { <text>Every search with typos too large for an exact match, the ones nothing was chosen from included.</text> }
                else { <text>Searches with typos too large for an exact match, where fuzzy search still found what the visitor was looking for.</text> }
            </p>
            @if (_fuzzy.Count == 0)
            {
                <p class="stats-empty">@(_fuzzyAll ? "Every search in this period had an exact or near-exact match." : "No fuzzy finds in this period.")</p>
            }
            else {
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Fuzzy search" Class="stats-table">
                <thead><tr><th>Query</th><th class="stats-num">Searches</th><th class="stats-num">Chosen</th><th>Most chosen result</th></tr></thead>
                <tbody>
                    @foreach (var q in _fuzzy)
                    {
                        <tr>
                            <td>@QueryLabel(q.QueryText)</td>
                            <td class="stats-num">@N(q.Uncovered)</td>
                            <td class="stats-num">@(q.UncoveredChosen > 0 ? N(q.UncoveredChosen) : "–")</td>
                            <td>@(q.MostChosenDocument is long key ? TitleOf(key) : "")</td>
                        </tr>
                    }
                </tbody>
            </Table>
            }
        }

        @if (_section == "documents")
        {
            <div class="stats-view">
                <div class="stats-view-select"><SelectField Size="micro" Options="DocumentOrderOptions" Value="@(_documentsByConverts ? "converts" : "selects")" ValueChanged="SetDocumentOrder" aria-label="Order" /></div>
                @if (_listsLoading) { <span class="stats-view-busy" aria-live="polite"><Spinner Size="14" /> Loading…</span> }
            </div>
            @if (_topDocuments.Count == 0 && _documentsByConverts) { <p class="stats-empty">No conversions in this period. They arrive when the storefront sends them to <code>events/convert</code>.</p> }
            else if (_topDocuments.Count == 0) { <p class="stats-empty">No results were chosen in this period. Clicks arrive when the storefront sends them to <code>events/select</code>.</p> }
            else {
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Top documents" Class="stats-table">
                <thead><tr><th>Document</th><th class="stats-num">Selects</th><th class="stats-num">Conversions</th></tr></thead>
                <tbody>
                    @foreach (var d in _topDocuments)
                    {
                        <tr>
                            <td>@TitleOf(d.DocumentKey)</td>
                            <td class="stats-num">@N(d.Selects)</td>
                            <td class="stats-num">@N(d.Converts)</td>
                        </tr>
                    }
                </tbody>
            </Table>
            }
        }

        @if (_section == "search-or-ask")
        {
            @* Search or ask (Notes/search-or-ask-server.md). The questions the content did not
               answer lead: they are what to write next. Offers lists the texts an offer was shown
               beside, so a false one can be found. Code in StatisticsTab.SearchOrAsk.cs. *@
            <StatGroup Columns="@(CitesSources ? 6 : 5)">
                <Stat Label="Offers shown" Hint="Searches an offer to ask was shown beside, each once however many pauses judged it."><ValueContent>@N(_ask.Offers)</ValueContent></Stat>
                <Stat Label="Questions asked" Hint="Questions asked, and how many per offer shown."><ValueContent>@N(_ask.Asks) <span class="stats-tile-sub">@Pct(_ask.Asks, _ask.Offers)</span></ValueContent></Stat>
                <Stat Label="Not answered" Hint="Questions the search found nothing for, or whose sources the judge doubted could answer them."><ValueContent>@N(_ask.Unanswered) <span class="stats-tile-sub">@Pct(_ask.Unanswered, _ask.Asks)</span></ValueContent></Stat>
                @if (CitesSources)
                {
                    <Stat Label="Sources opened" Hint="Cited sources opened from an answer."><ValueContent>@N(_ask.SourcesOpened)</ValueContent></Stat>
                }
                @{ var setup = SearchOrAsk.Setup; }
                <Stat Label="Cost" Hint="@(setup.CostsReported
                    ? "What the AI behind Search or ask cost: the judge, the answers, and the filters the model makes while visitors type, as OpenRouter reports it for each call. An answer a visitor leaves before it is written has no cost reported and is not counted. Median time to an answer's first words beside it."
                    : $"{string.Join(" and ", setup.UnpricedProviders)} {(setup.UnpricedProviders.Count == 1 ? "does" : "do")} not report what a call costs, only its tokens, so no cost is shown here rather than an estimate that may be wrong. Your bill is in that provider's own console. Median time to an answer's first words beside it.")"><ValueContent>@(setup.CostsReported ? Usd(_ask.Cost + _askBudget.Cost) : "—") <span class="stats-tile-sub">@Seconds(_ask.MedianFirstTextMs)</span></ValueContent></Stat>
                <Stat Label="Calls" Hint="Calls against the daily budget: each judgement, each question asked and each filter the model made while typing, the console's tester included. On a day the budget ran out, the calls after it were turned away, and visitors saw no offers until midnight UTC."><ValueContent>@N(_askBudget.Calls) <span class="stats-tile-sub">@BudgetLine</span></ValueContent></Stat>
            </StatGroup>
            <div class="stats-view">
                <Tabs Items="AskViewItems" Active="@_askView" ActiveChanged="@(v => _askView = v ?? "overview")" Size="micro" Variant="button" AriaLabel="Search or ask view" />
            </div>
            @if (_askView == "overview")
            {
                @* The Overview view: the section's pictures, in the overview's grid. How the asks ended,
                   offers and asks against the day's budget, today against the budget, when people ask,
                   and what it cost day by day where the provider reports it. *@
                <div class="stats-overview stats-ask-panels">
                    @if (_ask.Asks > 0)
                    {
                        <div class="stats-overview-item">
                            <div class="stats-chart-head"><span class="stats-chart-title">How the asks ended</span></div>
                            <p class="stats-help">Answered in @Pct(_ask.Answered, _ask.Asks) of @N(_ask.Asks) asks.</p>
                            <BarMeter Segments="AskOutcomeSegments()" Labels="legend" Format="@(v => Pct((long)v, _ask.Asks))" />
                        </div>
                    }
                    @if (_askDays.Count > 0)
                    {
                        var days = AskDaySeries();
                        var budget = AskBudgetSeries();
                        <div class="stats-overview-item">
                            <div class="stats-chart-head"><span class="stats-chart-title">Offers and asks per day</span></div>
                            <p class="stats-help">Searches an offer was shown beside, and the questions asked. The calls against the day's budget beside them: past the budget the rest of the day's visitors saw no offers.</p>
                            <Chart Type="line" Labels="days.Labels" Height="150" YAxis="right"
                                   Series="@(new List<Chart.ChartSeries> {
                                       new("Offers", days.Offers, Fill: "solid"),
                                       new("Asks", days.Asks, "var(--CTeal)"),
                                       new("Calls", budget.Calls, "var(--lv5)", Step: true),
                                   })"
                                   References="@(budget.Budget > 0 ? new List<Chart.ChartReference> { new(budget.Budget, "budget", "var(--CSignal)", Signal: true) } : null)" />
                        </div>
                    }
                    @if (_askBudgetToday > 0)
                    {
                        <div class="stats-overview-item">
                            <div class="stats-chart-head"><span class="stats-chart-title">Today against the budget</span></div>
                            <p class="stats-help">Calls so far today, UTC, of the daily budget set under Options. Past it, visitors see no offers until midnight.</p>
                            <BarMeter Value="_askCallsToday" Max="_askBudgetToday" Format="@(v => N((long)v))" MaxLabel="@($"of {N(_askBudgetToday)} calls")"
                                      Color="@(_askCallsToday >= _askBudgetToday * 0.85 ? "var(--CSignal)" : null)" />
                        </div>
                    }
                    @if (_askWeekHour is { Total: > 0 } askWeek)
                    {
                        <div class="stats-overview-item">
                            <div class="stats-chart-head"><span class="stats-chart-title">When people ask</span></div>
                            <p class="stats-help">The week by hour in the dataset's time zone: whether questions come when nobody is there to answer them.</p>
                            <Heatmap Values="WeekHourCells(askWeek)" Rows="7" ColumnLabels="HourLabels" RowLabels="WeekdayLabels"
                                     Format="@((v, i) => $"{WeekdayNames[i % 7]} {i / 7:00}:00-{(i / 7 + 1) % 24:00}:00: {N((long)v)} {(v == 1 ? "ask" : "asks")}")"
                                     AriaLabel="Asks by weekday and hour" Cell="9" />
                        </div>
                    }
                    @if (SearchOrAsk.Setup.CostsReported && _askDays.Any(d => d.Cost > 0))
                    {
                        var days = AskDaySeries();
                        <div class="stats-overview-item">
                            <div class="stats-chart-head"><span class="stats-chart-title">Cost per day</span></div>
                            <p class="stats-help">What the judge, the answers and the filters cost each day, as the provider reports it.</p>
                            <Chart Type="bar" Labels="days.Labels" Height="120" ShowLegend="false" YAxis="right" YFormat="@(v => v < 0.01 && v > 0 ? "< $0.01" : v.ToString("$0.00"))"
                                   Series="@(new List<Chart.ChartSeries> { new("Cost", days.Cost) })" />
                        </div>
                    }
                </div>
            }
            else if (_askView == "questions")
            {
                <p class="stats-help">The questions visitors asked. The ones the content did not answer come first: they are what to write next.</p>
                @if (_askQuestions.Count == 0) { <p class="stats-empty">No questions asked in this period.</p> }
                else {
                <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Questions asked" Class="stats-table">
                    <thead><tr><th>Question</th><th class="stats-num">Asked</th><th>Outcome</th><th class="stats-num">Answerable</th>@if (CitesSources) {<th class="stats-num">Sources opened</th>}</tr></thead>
                    <tbody>
                        @foreach (var q in _askQuestions)
                        {
                            <tr>
                                <td>@q.Question</td>
                                <td class="stats-num">@N(q.Asks)</td>
                                <td>@QuestionOutcome(q)</td>
                                <td class="stats-num">@Score(q.Answerability)</td>
                                @if (CitesSources) { <td class="stats-num">@(q.SourcesOpened > 0 ? N(q.SourcesOpened) : "–")</td> }
                            </tr>
                        }
                    </tbody>
                </Table>
                }
            }
            else
            {
                <p class="stats-help">What visitors had typed when an offer to ask was shown. A lookup high on this list is a false offer: raise the thresholds or sharpen the site description.</p>
                @if (_askOffers.Count == 0) { <p class="stats-empty">No offers shown in this period.</p> }
                else {
                <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Offers shown" Class="stats-table">
                    <thead><tr><th>Typed</th><th class="stats-num">Offers</th><th class="stats-num">Strong</th><th class="stats-num">Highest score</th><th class="stats-num">Asked</th></tr></thead>
                    <tbody>
                        @foreach (var o in _askOffers)
                        {
                            <tr>
                                <td>@QueryLabel(o.Text)</td>
                                <td class="stats-num">@N(o.Offers)</td>
                                <td class="stats-num">@N(o.Strong)</td>
                                <td class="stats-num">@Score(o.MaxP)</td>
                                <td class="stats-num">@(o.Asked > 0 ? N(o.Asked) : "–")</td>
                            </tr>
                        }
                    </tbody>
                </Table>
                }
            }
        }

        @if (_section == "browsing")
        {
            <p class="stats-help">What people narrowed the catalogue by, with or without typing, and how often it left them nothing.</p>
            @if (_topFilters.Count == 0) { <p class="stats-empty">No filters were used in this period, or Browsing is switched off on the Options tab.</p> }
            else {
            <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Browsing" Class="stats-table">
                @* "Without results" only when something came back empty: a column of zeros says
                   nothing and takes the room. *@
                @{ var anyEmpty = _topFilters.Any(f => f.ZeroHits > 0); }
                <thead><tr><th>Filter</th><th class="stats-num">Uses</th>@if (anyEmpty) {<th class="stats-num">Without results</th>}</tr></thead>
                <tbody>
                    @foreach (var f in _topFilters)
                    {
                        <tr>
                            <td>@FilterLabel(f)</td>
                            <td class="stats-num">@N(f.Uses)</td>
                            @if (anyEmpty) {<td class="stats-num">@N(f.ZeroHits)</td>}
                        </tr>
                    }
                </tbody>
            </Table>
            }
        }

        @if (_section == "changes")
        {
            @* What the owners changed, beside what visitors did: the why behind a bend in the line
               (Notes/statistics-design.md, "Change events"). The blue squares on the chart are these. *@
            @if (ChangeKindOptions.Count > 2)
            {
                <div class="stats-view">
                    <div class="stats-view-select"><SelectField Size="micro" Options="ChangeKindOptions" Value="@(_changeKind ?? "")" ValueChanged="SetChangeKind" aria-label="Kind of change" /></div>
                </div>
            }
            @if (_changes.Count == 0) { <p class="stats-empty">No changes were made to the dataset in this period.</p> }
            @if (_changes.Count > 0)
            {
                var askChange = Ctx.IsEditor && (ObservrSubscription.Visible && ObservrStore.IsEnabled(Ctx.TeamId, Ctx.Name));
                <Table Scrollable StickyFirstColumn BleedEnd="calc(var(--page-gutter) + 5px)" AriaLabel="Changes" Class="stats-table">
                    <thead><tr><th>When</th><th>What</th>@if (askChange) { <th></th> }</tr></thead>
                    <tbody>
                        @foreach (var c in Enumerable.Reverse(ShownChanges))
                        {
                            <tr>
                                <td><TimeAgo Value="DateTimeOffset.FromUnixTimeMilliseconds(c.Timestamp).UtcDateTime" TooltipPosition="left" /></td>
                                <td>@ChangeDescriptions.Describe(c.Kind, c.Summary)</td>
                                @if (askChange)
                                {
                                    <td class="stats-action">
                                        @* A week after is what "help" is judged on; sooner there is nothing to compare. *@
                                        @if (c.Timestamp < DateTimeOffset.UtcNow.AddDays(-1).ToUnixTimeMilliseconds())
                                        {
                                            var change = c;
                                            <span class="indx-observr"><Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.Observr" @onclick="() => AskChange(change)">Did this help?</Button></span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </Table>
            }
            @if (_documentTotals.Inserted + _documentTotals.Updated + _documentTotals.Deleted > 0
                 && (_changeKind == null || _changeKind == DatasetChangeKind.Documents))
            {
                <p class="stats-help">
                    Documents in this period: @N(_documentTotals.Inserted) inserted, @N(_documentTotals.Updated) updated, @N(_documentTotals.Deleted) deleted.
                </p>
            }
        }
    }

}
</div>

@code {
    private int _days = 30;
    private bool _loaded;
    /// <summary>The loading skeleton's table rows, as wide as query text tends to be.</summary>
    private static readonly int[] LoadingRowWidths = [58, 72, 46, 64, 52, 68];
    private OverviewStat _overview;
    private List<QueryStat> _topQueries = [];
    private List<QueryStat> _fuzzy = [];
    private string _section = "overview";
    private long _fromDay, _toDay;

    // Each section's view settings. They live as long as the tab does; a new window keeps them.
    private QueryOrder _queryOrder = QueryOrder.Searches;
    private const int QueryPage = 10;
    private int _queryRows = QueryPage;
    private bool _moreQueries;
    private bool _fuzzyAll;
    private bool _documentsByConverts;
    private string? _changeKind;
    // The surface the numbers are for (?source=), null for every surface.
    private string? _source;
    private List<SourceStat> _sources = [];

    private static readonly List<SelectField.SelectOption> QueryOrderOptions =
    [
        new("Most searched", nameof(QueryOrder.Searches)),
        new("Highest click-through", nameof(QueryOrder.HighestClickThrough)),
        new("Lowest click-through", nameof(QueryOrder.LowestClickThrough)),
        new("Found nothing", ZeroHitsView),
    ];
    // The zero-hit report is a view of the same list, not an order: the searches that found nothing,
    // most often first, each with Ask Observr for an editor.
    private const string ZeroHitsView = "ZeroHits";
    private bool _zeroHits;
    private IndxServer.Services.Observr.ObservrClient Observr() => Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions.GetRequiredService<IndxServer.Services.Observr.ObservrClient>(Services);
    // The Observr buttons run their ask in the Agent panel, as a turn of its thread; a Yes there
    // applies the proposal and the tab reloads.
    private void AskZeroHit(QueryStat q) => Agent.Run(new IndxServer.Services.Observr.AgentAction($"Why does \"{q.QueryText}\" find nothing?",
        ct => Observr().AskZeroHitAsync(Ctx.TeamId, Ctx.Name, q.QueryText, q.ZeroHits, ct), () => InvokeAsync(LoadAsync)));
    private void AskLowClick(QueryStat q) => Agent.Run(new IndxServer.Services.Observr.AgentAction($"Why isn't \"{q.QueryText}\" working?",
        ct => Observr().AskLowClickAsync(Ctx.TeamId, Ctx.Name, q, _fromDay, _toDay, ct), () => InvokeAsync(LoadAsync)));
    private void AskChange(ChangeStat c) => Agent.Run(new IndxServer.Services.Observr.AgentAction($"Did this help: {ChangeDescriptions.Describe(c.Kind, c.Summary)}?",
        ct => Observr().AskChangeAsync(Ctx.TeamId, Ctx.Name, c, ct)));
    private static readonly List<Tabs.TabItem> FuzzyItems =
        [new("Selected", "selected", DatasetIcons.FuzzySelected), new("All", "all", DatasetIcons.FuzzyAll)];
    private static readonly List<SelectField.SelectOption> DocumentOrderOptions =
    [
        new("Most selected", "selects"),
        new("Most converted", "converts"),
    ];

    /// <summary>"All changes" and the kinds this window has, by name.</summary>
    private List<SelectField.SelectOption> ChangeKindOptions =>
    [
        new("All changes", ""),
        .. _changes.Select(c => c.Kind).Distinct()
            .Select(k => new SelectField.SelectOption(ChangeDescriptions.KindLabel(k), k))
            .OrderBy(o => o.Label),
    ];

    /// <summary>"All surfaces" and the surfaces searched from in the window, most searched first.
    /// A chosen surface stays listed when the window holds none of its searches, so the select
    /// still says what the zeros are for.</summary>
    private List<SelectField.SelectOption> SourceOptions
    {
        get
        {
            var named = _sources.Where(x => x.Source != null).Select(x => x.Source!).ToList();
            if (_source != null && !named.Contains(_source)) named.Add(_source);
            return [new("All surfaces", ""), .. named.Select(n => new SelectField.SelectOption(n, n))];
        }
    }

    private IEnumerable<ChangeStat> ShownChanges =>
        _changeKind == null ? _changes : _changes.Where(c => c.Kind == _changeKind);

    /// <summary>The chart's change markers follow the Changes filter, so picking a kind there
    /// shows where on the line those changes fell.</summary>
    private IReadOnlyList<Chart.ChartMarker> Markers => ShownChanges
        .Select(c => new Chart.ChartMarker((int)(StatisticsDays.DayOf(_zone, c.Timestamp) - _fromDay),
                                           ChangeDescriptions.Describe(c.Kind, c.Summary)))
        .ToList();

    /// <summary>The section to open on: queries, fuzzy, documents, browsing or changes.</summary>
    [Parameter] public string? InitialSection { get; set; }
    /// <summary>The Search or ask view to open on: overview, questions or offers.</summary>
    [Parameter] public string? InitialAskView { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(InitialSection)) _section = InitialSection;
        if (!string.IsNullOrEmpty(InitialAskView)) _askView = InitialAskView;
    }

    /// <summary>The detail sections, in the order they matter. Changes carries how many fell in
    /// the window, in the info blue of the chart's change markers: a change is information, not a
    /// warning, and the badge and the marks are the same thing. Over 99 it says 99+.</summary>
    private List<Tabs.TabItem> SectionItems =>
    [
        new("Overview", "overview", DatasetIcons.Statistics),
        new("Top queries", "queries", DatasetIcons.TopQueries),
        new("Fuzzy search", "fuzzy", DatasetIcons.FuzzySearch),
        new("Top documents", "documents", DatasetIcons.TopDocuments),
        .. SearchOrAskSection,
        new("Browsing", "browsing", DatasetIcons.Browsing),
        new("Changes", "changes", DatasetIcons.Changes,
            Badge: _changes.Count switch { 0 => null, > 99 => "99+", var n => n.ToString() },
            BadgeTitle: $"{_changes.Count} changes in the last {_days} days", BadgeTone: "info"),
    ];
    private List<DocumentStat> _topDocuments = [];
    private List<FilterStat> _topFilters = [];
    private List<ChangeStat> _changes = [];
    private (long Inserted, long Updated, long Deleted) _documentTotals;
    private IReadOnlyList<Chart.ChartSeries> _series = [];
    private string[]? _labels;
    private Func<long, string?>? _label;
    private TimeZoneInfo _zone = TimeZoneInfo.Utc;
    private bool _wasActive;

    private static readonly List<SegmentedControl.Item> WindowItems =
    [
        new("7", "7 days"), new("30", "30 days"), new("90", "90 days"),
    ];

    private string _chartType = "line";
    private static readonly List<SegmentedControl.Item> ChartTypeItems =
    [
        new("line", Icon: size => @<Indx.Systm.Blazor.Icons.Graph Size="size" Color="currentColor" />, AriaLabel: "Line"),
        new("bar", Icon: size => @<Indx.Systm.Blazor.Icons.Analytics Size="size" Color="currentColor" />, AriaLabel: "Bars"),
    ];

    // The searches per day split by the surface that sent them. The named surfaces are read one
    // by one (the store filters on a name); the unnamed rest is what is left of the total.
    private WeekHourStat? _weekHour;
    private PositionStat? _positions;
    private TypingStat? _typing;
    private List<LocaleStat> _locales = [];
    // The searches per day split by the surface that sent them. The named surfaces are read one
    // by one (the store filters on a name); the unnamed rest is what is left of the total.
    private IReadOnlyList<Chart.ChartSeries> _bySurface = [];
    private static readonly string[] SurfaceFills = ["solid", "hatch", "dots", "checker"];

    private static readonly string[] WordLabels = ["1 word", "2", "3", "4", "5 or more"];

    /// <summary>Most first, as the store orders them; the unnamed rest last and dim; a tag shown as
    /// its language's own name where the runtime knows it ("norsk bokmål (Norge)"), else as sent.</summary>
    private static IReadOnlyList<Waffle.Segment> LocaleSegments(List<LocaleStat> locales) =>
        locales.Where(l => l.Searches > 0)
            .Select(l => l.Locale == null ? new Waffle.Segment("Unnamed", l.Searches, "var(--lv2)") : new Waffle.Segment(LocaleName(l.Locale), l.Searches))
            .ToList();

    private static string LocaleName(string tag)
    {
        try { return System.Globalization.CultureInfo.GetCultureInfo(tag).NativeName; }
        catch (System.Globalization.CultureNotFoundException) { return tag; }
    }

    /// <summary>One series per surface that named itself, the first solid and the patterns after,
    /// and the unnamed rest in the dim tone when there is any; empty unless the dataset has more
    /// than one surface to show.</summary>
    private List<Chart.ChartSeries> BySurface(StatisticsStore store, string team, string ds, long fromDay, long toDay, int days, double[] total)
    {
        var named = _sources.Where(x => x.Source != null && x.Searches > 0).Select(x => x.Source!).ToList();
        if (named.Count == 0 || (named.Count == 1 && !_sources.Any(x => x.Source == null && x.Searches > 0))) return [];
        var rest = (double[])total.Clone();
        var series = new List<Chart.ChartSeries>();
        for (int n = 0; n < named.Count; n++)
        {
            var byDay = store.TimeSeries(team, ds, fromDay, toDay, named[n]).ToDictionary(r => r.Day);
            var data = new double[days];
            for (int i = 0; i < days; i++)
            {
                data[i] = byDay.GetValueOrDefault(fromDay + i).Searches;
                rest[i] = Math.Max(0, rest[i] - data[i]);
            }
            series.Add(new(named[n], data, Fill: SurfaceFills[n % SurfaceFills.Length]));
        }
        if (rest.Any(v => v > 0)) series.Add(new("Unnamed", rest, "var(--lv3)"));
        return series;
    }

    private static readonly string[] WeekdayNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
    private static readonly IReadOnlyList<Heatmap.Label> HourLabels =
        [new(0, "00"), new(6, "06"), new(12, "12"), new(18, "18"), new(23, "23")];
    private static readonly IReadOnlyList<Heatmap.Label> WeekdayLabels =
        [new(0, "Mon"), new(1, "Tue"), new(2, "Wed"), new(3, "Thu"), new(4, "Fri"), new(5, "Sat"), new(6, "Sun")];

    /// <summary>The grid as the Heatmap reads it: column by column (an hour each), top to bottom
    /// (Monday to Sunday).</summary>
    private static IReadOnlyList<double?> WeekHourCells(WeekHourStat week)
    {
        var cells = new double?[7 * 24];
        for (int hour = 0; hour < 24; hour++)
            for (int day = 0; day < 7; day++)
                cells[hour * 7 + day] = week.Searches[day, hour];
        return cells;
    }

    /// <summary>The busiest hour of the week, and how much of the searching is at night.</summary>
    private static string WeekHourSummary(WeekHourStat week)
    {
        int bestDay = 0, bestHour = 0;
        long night = 0;
        for (int day = 0; day < 7; day++)
            for (int hour = 0; hour < 24; hour++)
            {
                if (week.Searches[day, hour] > week.Searches[bestDay, bestHour]) (bestDay, bestHour) = (day, hour);
                if (hour < 6) night += week.Searches[day, hour];
            }
        long weekend = 0;
        for (int hour = 0; hour < 24; hour++) weekend += week.Searches[5, hour] + week.Searches[6, hour];
        return $"Busiest on {WeekdayNames[bestDay]}s from {bestHour:00}:00. {Pct(night, week.Total)} of searches are between 00:00 and 06:00, {Pct(weekend, week.Total)} at the weekend.";
    }

    private static IReadOnlyList<BarMeter.Segment> PositionSegments(PositionStat p) =>
    [
        new("1st", p.First), new("2nd", p.Second), new("3rd", p.Third), new("4th to 10th", p.FourToTen), new("Below 10th", p.BelowTen),
    ];

    private bool Empty => _overview.Searches == 0 && _overview.Selects == 0 && _overview.Converts == 0
                          && _topFilters.Count == 0 && _changes.Count == 0 && !HasSearchOrAsk
                          && _documentTotals.Inserted + _documentTotals.Updated + _documentTotals.Deleted == 0;

    protected override async Task OnParametersSetAsync()
    {
        // Awaited (not fire-and-forget) so static rendering - prerender and the render tests -
        // waits for the data; interactively Blazor still paints the loading state at the first
        // await and again on completion.
        if (Active && !_wasActive)
        {
            _wasActive = true;
            await LoadAsync();
        }
        if (!Active) _wasActive = false;
    }

    private void SetWindow(string? value)
    {
        if (value != null && int.TryParse(value, out var days) && days != _days)
        {
            _days = days;
            _ = LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var store = Stats.Store;
        if (store == null) return;
        _loaded = false;
        var (team, ds, days, source) = (Ctx.TeamId, Ctx.Name, _days, _source);
        await Task.Run(() =>
        {
            // Days in the dataset's statistics time zone (Options tab), as the API counts them.
            _zone = store.ZoneOf(team, ds);
            long toDay = StatisticsDays.Today(_zone);
            long fromDay = toDay - days + 1;
            (_fromDay, _toDay) = (fromDay, toDay);
            _sources = store.Sources(team, ds, fromDay, toDay);
            _overview = store.Overview(team, ds, fromDay, toDay, source);
            LoadSearchOrAsk(store, team, ds, fromDay, toDay, source);
            LoadLists(store);
            _topFilters = store.TopFilters(team, ds, fromDay, toDay, 10, source);
            _changes = store.Changes(team, ds, fromDay, toDay);
            if (_changeKind != null && !_changes.Any(c => c.Kind == _changeKind)) _changeKind = null;
            var documentDays = store.DocumentChanges(team, ds, fromDay, toDay);
            _documentTotals = (documentDays.Sum(d => d.Inserted), documentDays.Sum(d => d.Updated), documentDays.Sum(d => d.Deleted));

            var byDay = store.TimeSeries(team, ds, fromDay, toDay, source).ToDictionary(r => r.Day);
            // Search or ask's calls beside the searches, while the dataset has it: shown here and
            // switched on, or with calls in the window. A dataset without it gets no empty line.
            var askCalls = SearchOrAsk.ShownFor(team, ds) ? store.BudgetCallsByDay(team, ds, fromDay, toDay) : [];
            var withCalls = askCalls.Count > 0 || (SearchOrAsk.ShownFor(team, ds) && SearchOrAsk.Settings(team, ds).Enabled);
            var calls = new double[days];
            var searches = new double[days];
            var selects = new double[days];
            var labels = new string[days];
            for (int i = 0; i < days; i++)
            {
                var day = fromDay + i;
                var row = byDay.GetValueOrDefault(day);
                searches[i] = row.Searches;
                selects[i] = row.Selects;
                calls[i] = askCalls.GetValueOrDefault(day);
                labels[i] = DateOnly.FromDayNumber((int)day + DateOnly.Parse("1970-01-01").DayNumber).ToString("d MMM");
            }
            _series = new List<Chart.ChartSeries>
            {
                new("Searches", searches, Fill: "solid"),
                new("Selects", selects, "var(--CTeal)"),
            };
            // Raw rows only, so no further back than they are kept.
            long rawFrom = Math.Max(fromDay, toDay - Stats.RetentionDays + 1);
            _weekHour = store.SearchesByWeekHour(team, ds, rawFrom, toDay, source);
            _positions = store.SelectPositions(team, ds, rawFrom, toDay, source);
            _typing = store.Typing(team, ds, rawFrom, toDay, source);
            _locales = store.Locales(team, ds, rawFrom, toDay, source);
            _bySurface = source == null ? BySurface(store, team, ds, fromDay, toDay, days, searches) : [];
            // One step stronger than the searches' grey (--lv4), not a colour: it is a count beside
            // them, and the blue drew the eye from the searches the chart is about.
            if (withCalls) _series = [.. _series, new("Search or ask calls", calls, "var(--lv5)")];
            _labels = labels;
        });
        _label = null;   // the label field may have changed on the Options tab
        _loaded = true;
        await Render();
    }

    /// <summary>The lists whose rows depend on a section's view settings.</summary>
    private void LoadLists(StatisticsStore store)
    {
        var (team, ds, source) = (Ctx.TeamId, Ctx.Name, _source);
        // One row past the page says whether there is another page.
        var queries = store.TopQueries(team, ds, _fromDay, _toDay, _queryRows + 1, zeroHitsOnly: _zeroHits, order: _queryOrder, source: source);
        _moreQueries = queries.Count > _queryRows;
        _topQueries = _moreQueries ? queries[.._queryRows] : queries;
        _fuzzy = store.TopQueries(team, ds, _fromDay, _toDay, 10, uncoveredOnly: true,
            order: _fuzzyAll ? QueryOrder.Searches : QueryOrder.ChosenAnyway, source: source);
        _topDocuments = store.TopDocuments(team, ds, _fromDay, _toDay, 10, byConverts: _documentsByConverts, source: source);
    }

    // The lists keep their rows while they reload (re-ordering, "Show more", the fuzzy view) and
    // say so beside their controls: on a busy dataset over 90 days the queries take a while.
    private bool _listsLoading;

    private async Task ReloadListsAsync()
    {
        var store = Stats.Store;
        if (store == null || !_loaded) return;
        _listsLoading = true;
        await Render();
        try { await Task.Run(() => LoadLists(store)); }
        finally { _listsLoading = false; }
        await Render();
    }

    private Task SetQueryOrder(string? value)
    {
        if (value == ZeroHitsView)
        {
            if (_zeroHits) return Task.CompletedTask;
            _zeroHits = true;
            _queryOrder = QueryOrder.Searches;
            return ReloadListsAsync();
        }
        if (!Enum.TryParse<QueryOrder>(value, out var order) || (order == _queryOrder && !_zeroHits)) return Task.CompletedTask;
        _zeroHits = false;
        _queryOrder = order;
        return ReloadListsAsync();
    }

    private Task ShowMoreQueries()
    {
        _queryRows += QueryPage;
        return ReloadListsAsync();
    }

    private Task SetFuzzyView(string? value)
    {
        var all = value == "all";
        if (all == _fuzzyAll) return Task.CompletedTask;
        _fuzzyAll = all;
        return ReloadListsAsync();
    }

    private Task SetDocumentOrder(string? value)
    {
        var byConverts = value == "converts";
        if (byConverts == _documentsByConverts) return Task.CompletedTask;
        _documentsByConverts = byConverts;
        return ReloadListsAsync();
    }

    private Task SetSource(string? value)
    {
        var source = string.IsNullOrEmpty(value) ? null : value;
        if (source == _source) return Task.CompletedTask;
        _source = source;
        _queryRows = QueryPage;
        return LoadAsync();
    }

    private void SetChangeKind(string? value) => _changeKind = string.IsNullOrEmpty(value) ? null : value;

    /// <summary>A browse (empty) search is counted too; give it a name rather than a blank cell.</summary>
    private static RenderFragment QueryLabel(string text) => __builder =>
    {
        if (string.IsNullOrWhiteSpace(text)) { <span class="stats-muted">(empty search)</span> }
        else { @text }
    };

    /// <summary>"genre: Poetry", "year (range)". The value comes out of the filter key, where a
    /// case-insensitive filter's value is lowercased, so the first letter is capitalised for
    /// reading; the real spelling is not in the key to restore.</summary>
    private static string FilterLabel(FilterStat f) =>
        f.Value.Length == 0
            ? $"{f.Field} (range)"
            : $"{f.Field}: {char.ToUpper(f.Value[0], System.Globalization.CultureInfo.CurrentCulture)}{f.Value[1..]}";

    private static string N(long n) => n.ToString("#,##0");

    private static string Pct(long numerator, long denominator) =>
        denominator == 0 ? "–" : ((double)numerator / denominator).ToString("0.0 %");

    private string AvgPos() =>
        _overview.Selects == 0 ? "–" : ((double)_overview.PositionSum / _overview.Selects).ToString("0.0");

    /// <summary>A readable name for a document: the label field the Options tab sets, else the
    /// first searchable field (StatisticsLabels, the rule the HTTP reads use too), read via
    /// FindEngine, which never wakes a hibernated dataset; then the key stands in.</summary>
    private string TitleOf(long key) =>
        (_label ??= StatisticsLabels.For(Ctx.FindEngine(), Stats.Store?.LabelField(Ctx.TeamId, Ctx.Name)))(key)
        ?? key.ToString();

}
