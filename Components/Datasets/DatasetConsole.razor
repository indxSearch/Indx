@* The dataset console: the team's dataset list as a tab strip, the "new dataset" form, and
   one DatasetPanel per dataset. Hosted by Pages/Index.razor (which owns the route and render
   mode); kept separate so it can be rendered in tests. *@
@using System.Security.Claims
@using Indx.Storage
@using Indx.Utilities
@using IndxCloudApi.Data
@using IndxCloudApi.Models
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject InstanceSettingsService InstanceSettingsService
@inject ActiveTeamState ActiveTeam
@inject IDatasetEngines Engines
@implements IDisposable

<div class="indx-datasets-heading">
    <h2>Datasets</h2>
    <TeamSwitcher />
    @if (!_isLoading)
    {
        @if (_showNewDatasetForm)
        {
            <div class="indx-new-dataset">
                <input class="indx-text-input" placeholder="Dataset name" value="@_newDatasetName" @oninput="e => _newDatasetName = e.Value?.ToString() ?? string.Empty" @onkeydown="OnNewDatasetKeyDown" />
                <Button Variant="primary" Size="micro" @onclick="CreateDataset" disabled="@string.IsNullOrWhiteSpace(_newDatasetName)">Create</Button>
                <Button Variant="secondary" Size="micro" @onclick="CancelNewDataset">Cancel</Button>
            </div>
            @if (!string.IsNullOrEmpty(_createError))
            {
                <p class="indx-create-error">@_createError</p>
            }
        }
        else
        {
            <Button Variant="secondary" Size="micro" IconLeft="DatasetIcons.PanelAdd" @onclick="() => _showNewDatasetForm = true">New dataset</Button>
        }
    }
</div>

@if (_isLoading)
{
    <p>Loading datasets...</p>
}
else if (_datasets.Length == 0)
{
    <div class="indx-empty-state">
        <p class="indx-empty-intro">A dataset holds your JSON documents and search index. Create one here to get started.</p>
        <div class="indx-new-dataset">
            <input class="indx-text-input" placeholder="Dataset name" value="@_newDatasetName" @oninput="e => _newDatasetName = e.Value?.ToString() ?? string.Empty" @onkeydown="OnNewDatasetKeyDown" />
            <Button Variant="primary" Size="default" @onclick="CreateDataset" disabled="@string.IsNullOrWhiteSpace(_newDatasetName)">Create your first dataset</Button>
        </div>
        @if (!string.IsNullOrEmpty(_createError))
        {
            <p class="indx-create-error">@_createError</p>
        }

        <div class="indx-empty-skill">
            <p class="indx-empty-intro indx-empty-intro--tight">Using an LLM to set up your search? Get the skill.</p>
            <Button Variant="secondary" Size="micro" IconLeft="DatasetIcons.Agent" Href="https://www.skills.sh/indxsearch/skill-indx-search/indx-search">Indx Agent Skill ↗</Button>
        </div>
    </div>
}
else
{
    <Tabs Items="@_datasets.Select(d => new Tabs.TabItem(d, d))"
          Active="@_selectedDataset"
          ActiveChanged="SelectDataset"
          Scrollable="true" />

    @* Every panel stays mounted so work in progress on one dataset survives switching to another.
       Keyed by team + name: a team switch replaces them all, which disposes buffered uploads and
       filter engines and drops every cached view — no cross-team bleed. *@
    @foreach (var name in _datasets)
    {
        <DatasetPanel @key="@($"{_activeTeamId}/{name}")"
                      Name="@name"
                      TeamId="@(_activeTeamId ?? "")"
                      Role="@_activeRole"
                      MyTeams="_myTeams"
                      Visible="@(name == _selectedDataset)"
                      OnDatasetListChanged="ReloadDatasets" />
    }
}

@code {
    /// <summary>Dataset to select once the list is loaded (falls back to the first one).</summary>
    [Parameter] public string? InitialDataset { get; set; }

    private string[] _datasets = [];
    private bool _isLoading = true;
    private string? _selectedDataset;

    private List<(Team Team, string Role)> _myTeams = new();
    private string? _activeTeamId;
    private string? _activeRole;

    private string _newDatasetName = string.Empty;
    private bool _showNewDatasetForm;
    private string? _createError;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }
        // Onboarding not finished (admin account exists but instance not configured yet) → finish it.
        if (!InstanceSettingsService.Load().SetupComplete)
        {
            NavigationManager.NavigateTo("/Account/Setup/Configure", forceLoad: true);
            return;
        }
        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId))
        {
            _isLoading = false;
            return;
        }
        await ActiveTeam.EnsureInitializedAsync(userId);
        ActiveTeam.OnChange += HandleTeamChanged;
        SyncFromActiveTeam();
        _routedDataset = InitialDataset;
        LoadDatasetNames();
        SyncUrl();
    }

    // Mirror the shared ActiveTeamState into the local fields the shell reads.
    private void SyncFromActiveTeam()
    {
        _myTeams = ActiveTeam.Teams.ToList();
        _activeTeamId = ActiveTeam.ActiveTeamId?.ToString();
        _activeRole = ActiveTeam.ActiveRole;
    }

    // Active team switched elsewhere (Team page / nav) — re-mirror and reload this team's datasets.
    // The panels are keyed by team, so the old team's panels are disposed on the next render.
    private async void HandleTeamChanged()
    {
        SyncFromActiveTeam();
        _selectedDataset = null;
        LoadDatasetNames();
        SyncUrl();
        await InvokeAsync(StateHasChanged);
    }

    // Browser back/forward between /datasets/{a} and /datasets/{b} re-renders this same instance
    // with a new InitialDataset; follow it. (First render is handled in OnInitializedAsync.)
    private string? _routedDataset;
    protected override void OnParametersSet()
    {
        if (_isLoading || InitialDataset == _routedDataset) return;
        _routedDataset = InitialDataset;
        if (InitialDataset != null && _datasets.Contains(InitialDataset) && InitialDataset != _selectedDataset)
            _selectedDataset = InitialDataset;
    }

    private void LoadDatasetNames()
    {
        _isLoading = true;
        try
        {
            _datasets = string.IsNullOrEmpty(_activeTeamId)
                ? []
                : Engines.GetTeamDataSets(_activeTeamId).ToArray();
        }
        catch
        {
            _datasets = [];
        }
        finally
        {
            _isLoading = false;
            if (_selectedDataset == null && InitialDataset != null && _datasets.Contains(InitialDataset))
                _selectedDataset = InitialDataset;
            if (_selectedDataset == null || !_datasets.Contains(_selectedDataset))
                _selectedDataset = _datasets.FirstOrDefault();
        }
    }

    private Task ReloadDatasets()
    {
        LoadDatasetNames();
        SyncUrl();
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Selecting a dataset (tab click) updates the URL to /datasets/{name} without a
    /// page load, so a refresh or a shared link reopens the same dataset.</summary>
    private void SelectDataset(string? name)
    {
        _selectedDataset = name;
        SyncUrl();
    }

    private void SyncUrl()
    {
        var target = _selectedDataset == null ? "/" : $"/datasets/{Uri.EscapeDataString(_selectedDataset)}";
        var current = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (current.TrimEnd('/') != target.TrimEnd('/'))
            NavigationManager.NavigateTo(target, replace: true);
    }

    // ── Create dataset ──────────────────────────────────────────────────────

    private async Task OnNewDatasetKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateDataset();
    }

    private void CancelNewDataset()
    {
        _showNewDatasetForm = false;
        _newDatasetName = string.Empty;
        _createError = null;
    }

    private Task CreateDataset()
    {
        _createError = null;
        var name = _newDatasetName.Trim();
        if (string.IsNullOrEmpty(name)) return Task.CompletedTask;
        if (!FileNameValidity.IsValid(name))
        {
            _createError = "Invalid dataset name.";
            return Task.CompletedTask;
        }
        try
        {
            var persistence = new Persistence(IndxCloudInternalApi.SearchDbConnectionString, name, _activeTeamId!);
            if (persistence.DataSetExists())
            {
                _createError = $"Dataset '{name}' already exists.";
                return Task.CompletedTask;
            }
            persistence.CreateOrOpenDataSet(400);
            _newDatasetName = string.Empty;
            _showNewDatasetForm = false;
            LoadDatasetNames();
            _selectedDataset = name;
            SyncUrl();
        }
        catch (Exception ex)
        {
            _createError = $"Failed to create dataset: {ex.Message}";
        }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        ActiveTeam.OnChange -= HandleTeamChanged;
    }
}
