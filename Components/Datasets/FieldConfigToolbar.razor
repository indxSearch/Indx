@* Import / export of the field configuration as JSON plus the two view toggles. Shared by the
   analyzed-upload view and the Ready view; import merges by field name into the context's
   working copy. *@
@using System.Text.Json
@using Indx.Api
@inject BrowserFiles Files

<div class="indx-field-config-toolbar indx-field-config-toolbar--split">
    <div class="indx-field-config-toolbar-group">
        @if (ExportFirst)
        {
            <Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.Download" @onclick="ExportAsync">Export field configuration as json</Button>
        }
        @if (CanImport)
        {
            <InputFile OnChange="ImportAsync" accept=".json" style="display:none" id="@ImportInputId" />
            <Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.DynamicJson" @onclick="() => Files.TriggerFileInputAsync(ImportInputId)">Import field configuration</Button>
            @if (_importWarning != null)
            {
                <span class="indx-field-config-import-warning">@_importWarning</span>
            }
        }
    </div>
    <div class="indx-field-config-toolbar-group indx-field-config-toolbar-group--wide">
        <ToggleSwitch Checked="@ShowUnused" CheckedChanged="ShowUnusedChanged" Label="Show unused fields" Elevated />
        <ToggleSwitch Checked="@ShowAdvanced" CheckedChanged="ShowAdvancedChanged" Label="Show advanced settings" Elevated />
    </div>
</div>

@code {
    [CascadingParameter] public DatasetContext Ctx { get; set; } = default!;
    [Parameter] public bool CanImport { get; set; } = true;
    /// <summary>Ready view lists Export before Import; the analyzed view keeps Export next to the Load button.</summary>
    [Parameter] public bool ExportFirst { get; set; }
    [Parameter] public bool ShowUnused { get; set; }
    [Parameter] public EventCallback<bool> ShowUnusedChanged { get; set; }
    [Parameter] public bool ShowAdvanced { get; set; }
    [Parameter] public EventCallback<bool> ShowAdvancedChanged { get; set; }
    /// <summary>Raised after an import changed the working copy.</summary>
    [Parameter] public EventCallback OnImported { get; set; }
    /// <summary>Distinguishes the two InputFile ids when both views exist for one dataset.</summary>
    [Parameter] public string IdSuffix { get; set; } = "";

    private string ImportInputId => $"fieldconfig-import{IdSuffix}-{Ctx.Name}";
    private string? _importWarning;

    public async Task ExportAsync()
    {
        var fields = Ctx.EditedFields;
        if (fields == null) return;
        var json = JsonSerializer.Serialize(fields, new JsonSerializerOptions { WriteIndented = true });
        await Files.DownloadAsync($"{Ctx.Name}-field-config.json", json);
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        _importWarning = null;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 1_000_000);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var imported = JsonSerializer.Deserialize<FieldProxy[]>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (imported == null || imported.Length == 0)
            {
                _importWarning = "Invalid or empty configuration file.";
                return;
            }
            var current = Ctx.EditedFields;
            if (current == null) return;

            var currentByName = current.ToDictionary(f => f.FieldName);
            int matched = 0, unmatched = 0;
            foreach (var imp in imported)
            {
                if (currentByName.TryGetValue(imp.FieldName, out var existing))
                {
                    existing.Searchable = imp.Searchable;
                    existing.Filterable = imp.Filterable;
                    existing.Facetable = imp.Facetable;
                    existing.Sortable = imp.Sortable;
                    existing.WordIndexing = imp.WordIndexing;
                    existing.Embeddable = imp.Embeddable;
                    existing.PreloadFilters = imp.PreloadFilters;
                    existing.HighResolution = imp.HighResolution;
                    existing.Weight = imp.Weight;
                    existing.BM25b = imp.BM25b;
                    existing.BM25k1 = imp.BM25k1;
                    matched++;
                }
                else unmatched++;
            }

            if (matched == 0)
                _importWarning = "No matching fields found. This config may be for a different dataset.";
            else if (unmatched > imported.Length / 3)
                _importWarning = $"{matched} field(s) applied, {unmatched} not found in this dataset and were skipped.";

            await OnImported.InvokeAsync();
        }
        catch (Exception ex)
        {
            _importWarning = $"Failed to import: {ex.Message}";
        }
    }
}
