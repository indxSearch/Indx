    // ── Transfer ─────────────────────────────────────────────────────────────

    private bool _transferOpen;

    private void OpenTransfer()
    {
        _transferTargetTeamId = "";
        _transferOpen = true;
    }

    private IReadOnlyList<string> TransferConsequences
    {
        get
        {
            var target = Ctx.MyTeams.FirstOrDefault(t => t.Team.Id.ToString() == _transferTargetTeamId).Team?.Name ?? "(the team you choose)";
            return
            [
                $"{Ctx.Name} moves from {Ctx.TeamName} to {target}, with its documents, field configuration, boost rules and synonyms. Members of {Ctx.TeamName} lose it.",
                $"Its address in the API changes from /api/teams/{Ctx.TeamName}/datasets/{Ctx.Name} to /api/teams/{target}/datasets/{Ctx.Name}. Websites and apps calling the old address get errors until they are updated.",
                $"API keys for {Ctx.TeamName} no longer reach it. {target} needs keys of its own.",
            ];
        }
    }

    /// <summary>Null on success (the dataset leaves this view), else the reason, shown in the modal.</summary>
    private async Task<string?> TransferAsync()
    {
        if (string.IsNullOrEmpty(_transferTargetTeamId)) return "Choose a team.";
        var target = _transferTargetTeamId;
        try
        {
            // (Name, team) is the dataset's primary key, so a target team that already has this
            // name fails on the constraint mid-transaction and surfaces as raw SQL. Rename
            // pre-checks its target; do the same here, while the dataset is still untouched.
            var taken = await Task.Run(() => Ctx.Engines.GetTeamDataSets(target));
            if (taken.Any(n => string.Equals(n, Ctx.Name, StringComparison.OrdinalIgnoreCase)))
                return $"That team already has a dataset called '{Ctx.Name}'. Rename one of them first.";

            // TransferOwnership evicts the source engine (can be slow) — run off the circuit.
            await Task.Run(() => Ctx.Engines.TransferOwnership(Ctx.Name, Ctx.TeamId, target));
        }
        catch (Exception ex)
        {
            return $"Transfer failed: {ex.Message}";
        }
        _transferTargetTeamId = "";
        await Ctx.NotifyDatasetListChangedAsync(); // dataset now belongs to another team — drops off this view
        return null;
    }

