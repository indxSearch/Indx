@* Dataset options for team admins: description (MCP context), keep-alive policy, manual
   hibernate, atomic Replace, transfer to another team, and the danger-zone delete. *@
@using Indx.Api
@using IndxServer.Models
@inherits DatasetTabBase
@inject DatasetMetadataStore DatasetMeta

@if (!Active) { return; }

<div class="opt-tab">

    @* ── Description (domain context for AI agents over MCP) ── *@
    @if (Ctx.IsEditor)
    {
        <h3 class="indx-section-heading indx-section-heading--first">Description</h3>
        <p class="indx-section-help">
            Domain context shown to AI agents that use this dataset over MCP (<code>describe_dataset</code>) — e.g. what the records are and what key fields mean.
        </p>
        <div class="opt-narrow">
            <Textarea @bind-Value="_descEdit" Rows="3" placeholder="What is this dataset? Any field caveats an agent should know?" />
        </div>
        @if (_descEdit != _descSaved)
        {
            <div class="opt-row opt-row--top">
                <Button Variant="primary" Size="micro" IconLeft="DatasetIcons.Save" @onclick="SaveDescriptionAsync">Save description</Button>
                <Button Variant="ghost" Size="micro" @onclick="() => _descEdit = _descSaved">Cancel</Button>
            </div>
        }
    }

    @* ── Keep-alive (team admins manage their dataset's memory lifecycle) ── *@
    <h3 class="indx-section-heading">Keep-alive</h3>
    <p class="indx-section-help">
        Controls how long this dataset stays loaded in memory. <strong>Pinned</strong> keeps it always loaded; <strong>Off</strong> lets the client load it on demand; <strong>Timed</strong> unloads it after inactivity and reloads it automatically on next use.
    </p>
    @{ var ka = Ctx.KeepAlive; }
    @if (_editingKeepAlive)
    {
        <div class="opt-row">
            <div class="opt-w220"><SelectField @bind-Value="_keepAliveEditMode" Options="KeepAliveModes" /></div>
            @if (_keepAliveEditMode == "timed")
            {
                <div class="opt-w80"><InputField @bind-Value="_keepAliveEditHours" placeholder="hours" /></div>
            }
            <Button Variant="primary" Size="micro" @onclick="SaveKeepAlive">Save</Button>
            <Button Variant="ghost" Size="micro" @onclick="() => _editingKeepAlive = false">Cancel</Button>
        </div>
    }
    else
    {
        <div class="opt-row">
            <span class="opt-tabular">@KeepAliveLabel(ka?.KeepAliveTimeHrs ?? int.MaxValue)</span>
            <span class="opt-muted">@RemainingLabel(ka)</span>
            <Button Variant="ghost" Size="micro" @onclick="BeginEditKeepAlive">Edit</Button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_keepAliveError) && _editingKeepAlive)
    {
        <p class="opt-error">@_keepAliveError</p>
    }

    @* Manual hibernate — frees memory now. Only durable for Off (client-managed) datasets;
       timed/pinned would auto-reload on the next access. *@
    @if (Ctx.EngineState == SystemState.Ready)
    {
        @if (ka?.KeepAliveTimeHrs == 0)
        {
            <div class="opt-row opt-row--top10">
                <Button Variant="secondary" Size="micro" IconLeft="DatasetIcons.Hibernate" @onclick="HibernateAsync" disabled="@_hibernating">
                    @(_hibernating ? "Hibernating…" : "Hibernate now")
                </Button>
                <span class="opt-muted">Unloads from memory; data stays on disk. Wake it from the Field configuration tab.</span>
            </div>
        }
        else
        {
            <p class="opt-muted opt-row--top10">Set keep-alive to <strong>Off</strong> to hibernate this dataset manually.</p>
        }
    }

    @* ── Replace data (atomic full reload) ── *@
    @if (Ctx.IsEditor)
    {
        <h3 class="indx-section-heading">Replace data</h3>
        <p class="indx-section-help">
            Atomically reload the whole dataset from a new JSON file. The current data keeps serving with zero downtime until the new index is ready; field configuration, boost rules and the description are preserved. If the new file fails to load, the current data is left untouched.
        </p>
        @if (_replaceBusy)
        {
            @* The steps of the shadow build, in order. The live engine keeps serving throughout;
               the new one is only swapped in at the last step. *@
            <Surface Class="opt-steps-surface">
            <ol class="opt-steps" aria-live="polite">
                @foreach (var (step, label) in ReplaceSteps)
                {
                    var state = StepState(step);
                    <li class="opt-step opt-step--@state">
                        <span class="opt-step-mark" aria-hidden="true">
                            @if (state == "done") { <Check Size="14" /> }
                            else if (state == "active") { <Spinner Name="circle-rotate" Size="14" /> }
                            else { <span class="opt-step-dot"></span> }
                        </span>
                        <span class="opt-step-label">@label</span>
                        @if (state == "active" && _replaceProgress?.Percent >= 0)
                        {
                            <span class="opt-step-pct">@_replaceProgress.Percent%</span>
                        }
                    </li>
                }
            </ol>
            <div class="opt-row opt-steps-foot">
                <p class="opt-muted opt-steps-note">Search keeps serving the current data until the new index is swapped in.</p>
                @if (CanCancelReplace)
                {
                    <Button Variant="secondary" Size="micro" @onclick="CancelReplaceTransfer">Cancel</Button>
                }
                else
                {
                    <span class="opt-muted" title="The build runs on a separate engine; the current data is not affected until the swap.">Can't cancel after transfer</span>
                }
            </div>
            </Surface>
        }
        else
        {
            <div class="opt-row">
                <InputFile OnChange="OnReplaceFileSelected" accept=".json" style="display:none" id="@ReplaceInputId" />
                <label for="@ReplaceInputId" class="indx-upload-label">
                    <Json Size="14" />
                    @if (_replaceFile != null)
                    {
                        <span>@_replaceFile.Name (@DatasetContext.FormatBytes(_replaceFile.Size))</span>
                    }
                    else
                    {
                        <span>Choose JSON…</span>
                    }
                </label>
                @if (_replaceFile != null)
                {
                    <Button Variant="secondary" Size="micro" @onclick="RunReplaceAsync">Replace all data</Button>
                    <Button Variant="ghost" Size="micro" @onclick="() => _replaceFile = null">Cancel</Button>
                }
            </div>
        }
        @if (!string.IsNullOrEmpty(_replaceResult))
        {
            <p class="opt-success">@_replaceResult</p>
        }
        @if (!string.IsNullOrEmpty(_replaceWarning))
        {
            <p class="opt-warning">@_replaceWarning</p>
        }
        @if (!string.IsNullOrEmpty(_replaceError))
        {
            <p class="opt-error opt-error--6">@_replaceError</p>
        }
    }

    @* ── Rename ── *@
    <h3 class="indx-section-heading">Rename</h3>
    <p class="indx-section-help">
        The name is the dataset's address: every API call, MCP client and link that uses the old name stops working. A loaded dataset is reloaded under the new name, which takes as long as an index build.
    </p>
    @if (!Ctx.IsBusy)
    {
        <div class="opt-row">
            <div class="opt-w240">
                <InputField placeholder="New dataset name" @bind-Value="_renameInput"
                            @oninput="e => _renameInput = e.Value?.ToString() ?? string.Empty" @onkeydown="OnRenameKeyDown" />
            </div>
            @if (!_renameConfirm)
            {
                <Button Variant="secondary" Size="micro" disabled="@(!RenameReady)" @onclick="() => { _renameError = null; _renameConfirm = true; }">Rename</Button>
            }
            else
            {
                <span class="opt-danger-text">Rename "@Ctx.Name" to "@_renameInput.Trim()"? Clients using the old name will break.</span>
                <Button Variant="primary" Size="micro" disabled="@_renaming" @onclick="RenameAsync">@(_renaming ? "Renaming…" : "Confirm rename")</Button>
                <Button Variant="ghost" Size="micro" disabled="@_renaming" @onclick="() => _renameConfirm = false">Cancel</Button>
            }
        </div>
        @if (!string.IsNullOrEmpty(_renameError))
        {
            <p class="opt-error">@_renameError</p>
        }
    }
    else
    {
        <p class="opt-muted">Cannot rename while an operation is in progress.</p>
    }

    @* ── Transfer to another team ── *@
    @{
        var transferTargets = Ctx.MyTeams
            .Where(t => t.Team.Id.ToString() != Ctx.TeamId && TeamRoles.CanAdmin(t.Role))
            .ToList();
    }
    @if (transferTargets.Count > 0)
    {
        <h3 class="indx-section-heading">Transfer to another team</h3>
        <p class="indx-section-help">Move this dataset to another team you administer. The current team loses access.</p>
        @if (!_transferConfirm)
        {
            <div class="opt-row">
                <div class="opt-w240">
                    <SelectField Size="micro" Placeholder="Select a team…" @bind-Value="_transferTargetTeamId"
                                 Options="@transferTargets.Select(t => new SelectField.SelectOption(t.Team.Name, t.Team.Id.ToString())).ToList()" />
                </div>
                <Button Variant="secondary" Size="micro" disabled="@string.IsNullOrEmpty(_transferTargetTeamId)" @onclick="() => { _transferError = null; _transferConfirm = true; }">Transfer</Button>
            </div>
        }
        else
        {
            <div class="opt-row">
                <span class="opt-danger-text">Move "@Ctx.Name" to the selected team? This team loses access.</span>
                <Button Variant="primary" Size="micro" @onclick="TransferAsync">Confirm transfer</Button>
                <Button Variant="ghost" Size="micro" @onclick="() => _transferConfirm = false">Cancel</Button>
            </div>
        }
        @if (!string.IsNullOrEmpty(_transferError))
        {
            <p class="opt-error">@_transferError</p>
        }
    }

    @* ── Danger zone ── *@
    @if (Ctx.IsAdmin)
    {
        @if (Ctx.EngineState == SystemState.Ready)
        {
            <h3 class="indx-section-heading indx-section-heading--danger">Danger Zone</h3>
        }
        @if (!Ctx.IsBusy)
        {
            <ConfirmButton Label="Delete dataset" Icon="DatasetIcons.Delete" Prompt="Are you sure?" ConfirmLabel="Yes, Delete"
                           TriggerVariant="@(Ctx.EngineState == SystemState.Ready ? "secondary" : "ghost")"
                           Open="@Ctx.DeleteConfirmOpen" OpenChanged="v => { Ctx.DeleteConfirmOpen = v; Ctx.NotifyChanged(); }"
                           OnConfirm="DeleteAsync" />
        }
        else
        {
            <p class="opt-muted">Cannot delete while an operation is in progress.</p>
        }
    }
</div>

@code {

    private static readonly IEnumerable<SelectField.SelectOption> KeepAliveModes =
    [
        new("∞ Pinned — always loaded", "max"),
        new("Off — client-managed", "0"),
        new("Timed — idle eviction", "timed"),
    ];

    private string ReplaceInputId => $"replace-input-{Ctx.Name}";

    // Description
    private bool _descLoaded;
    private string _descEdit = "";
    private string _descSaved = "";

    // Keep-alive
    private bool _editingKeepAlive;
    private string _keepAliveEditMode = "max";   // "max" (∞ pinned) | "0" (manual) | "timed"
    private string _keepAliveEditHours = "24";
    private string? _keepAliveError;
    private bool _hibernating;

    // Replace
    private IBrowserFile? _replaceFile;
    private bool _replaceBusy;
    private string? _replaceResult;
    private string? _replaceWarning;
    private string? _replaceError;
    private ReplaceProgress? _replaceProgress;
    private CancellationTokenSource? _replacePollCts;
    private CancellationTokenSource? _replaceTransferCts;
    private bool CanCancelReplace => _replaceProgress?.Step == ReplaceStep.Uploading;

    private void CancelReplaceTransfer() => _replaceTransferCts?.Cancel();

    private static readonly (ReplaceStep Step, string Label)[] ReplaceSteps =
    [
        (ReplaceStep.Uploading,   "Transfer the file to the server"),
        (ReplaceStep.Preparing,   "Prepare a new engine"),
        (ReplaceStep.Analyzing,   "Analyze the new file's fields"),
        (ReplaceStep.Reconciling, "Carry over field configuration and key field"),
        (ReplaceStep.Loading,     "Load documents"),
        (ReplaceStep.Indexing,    "Build the index"),
        (ReplaceStep.Swapping,    "Swap in and dispose the old engine"),
    ];

    private string StepState(ReplaceStep step)
    {
        var current = _replaceProgress?.Step ?? ReplaceStep.Uploading;
        if (current == ReplaceStep.Done || step < current) return "done";
        return step == current ? "active" : "pending";
    }

    // Transfer
    private string _transferTargetTeamId = "";
    private bool _transferConfirm;
    private string? _transferError;

    protected override void OnParametersSet()
    {
        if (Active && Ctx.IsEditor && !_descLoaded)
        {
            _descLoaded = true;
            _descEdit = _descSaved = DatasetMeta.Load(Ctx.TeamId, Ctx.Name);
        }
    }

    // ── Description ──────────────────────────────────────────────────────────

    private async Task SaveDescriptionAsync()
    {
        var text = _descEdit ?? "";
        await Task.Run(() => DatasetMeta.Save(Ctx.TeamId, Ctx.Name, text));
        _descSaved = text;
    }

    // ── Keep-alive ───────────────────────────────────────────────────────────

    private static string KeepAliveLabel(int hrs) => hrs switch
    {
        int.MaxValue => "∞ pinned",
        0 => "Off (manual)",
        _ => $"{hrs} h",
    };

    private static string RemainingLabel(IndxServerInternalApi.KeepAliveInfo? ka)
    {
        if (ka is null || ka.KeepAliveTimeHrs is int.MaxValue or 0) return "";
        if (!ka.Ready) return "(not loaded)";
        if (ka.Remaining is { } rem)
            return rem.TotalHours >= 1 ? $"~{(int)rem.TotalHours}h {rem.Minutes}m left" : $"~{rem.Minutes}m left";
        return "";
    }

    private void BeginEditKeepAlive()
    {
        _keepAliveError = null;
        (_keepAliveEditMode, _keepAliveEditHours) = (Ctx.KeepAlive?.KeepAliveTimeHrs ?? int.MaxValue) switch
        {
            int.MaxValue => ("max", "24"),
            0 => ("0", "24"),
            var h => ("timed", h.ToString()),
        };
        _editingKeepAlive = true;
    }

    private void SaveKeepAlive()
    {
        _keepAliveError = null;

        int hrs;
        switch (_keepAliveEditMode)
        {
            case "max": hrs = int.MaxValue; break;
            case "0": hrs = 0; break;
            default:
                if (!int.TryParse((_keepAliveEditHours ?? "").Trim(), out hrs) || hrs < 1)
                {
                    _keepAliveError = $"\"{_keepAliveEditHours}\" is not a valid number of hours — enter a whole number of 1 or more.";
                    return;
                }
                break;
        }

        // Team-scoped: SetKeepAliveHrs only affects this team's dataset; the Options tab is
        // already gated to team Admins.
        if (Ctx.Engines.SetKeepAliveHrs(Ctx.Name, Ctx.TeamId, hrs))
        {
            _editingKeepAlive = false;
            Ctx.RefreshStatus();
            Ctx.NotifyChanged();
        }
        else
        {
            _keepAliveError = $"Could not update keep-alive for \"{Ctx.Name}\".";
        }
    }

    private async Task HibernateAsync()
    {
        _hibernating = true;
        StateHasChanged();
        try
        {
            await Ctx.HibernateAsync();
        }
        finally
        {
            _hibernating = false;
            Ctx.NotifyChanged();
        }
    }

    // ── Replace ──────────────────────────────────────────────────────────────

    private void OnReplaceFileSelected(InputFileChangeEventArgs e)
    {
        _replaceFile = e.File;
        _replaceResult = _replaceWarning = _replaceError = null;
    }

    private async Task RunReplaceAsync()
    {
        if (_replaceFile == null) return;
        var file = _replaceFile;
        _replaceFile = null;
        _replaceResult = _replaceWarning = _replaceError = null;
        _replaceBusy = true;
        _replaceProgress = new ReplaceProgress(ReplaceStep.Uploading, 0);
        _replaceTransferCts?.Dispose();
        _replaceTransferCts = new CancellationTokenSource();
        StateHasChanged();

        // Poll the build's step/percent while the replace runs off the circuit. During the
        // transfer the manager has no progress yet, so the local Uploading state stands.
        _replacePollCts?.Dispose();
        _replacePollCts = new CancellationTokenSource();
        var pollTask = ProgressPoller.RunAsync(TimeSpan.FromMilliseconds(200),
            () => { _replaceProgress = Ctx.Engines.GetReplaceProgress(Ctx.Name, Ctx.TeamId) ?? _replaceProgress; return true; },
            () => InvokeAsync(StateHasChanged), _replacePollCts.Token);

        FileStream? fs = null;
        try
        {
            // Stream the browser file to a temp file in chunks, reporting transfer progress. This
            // is the one phase the user can cancel: nothing has touched the engine yet.
            var tempPath = Path.Combine(Path.GetTempPath(), $"indx-replace-{Guid.NewGuid():N}.tmp");
            fs = new FileStream(tempPath, FileMode.Create, FileAccess.ReadWrite, FileShare.None, 65536, FileOptions.DeleteOnClose);
            var buffer = new byte[65536];
            long totalRead = 0;
            var ct = _replaceTransferCts.Token;
            await using (var stream = file.OpenReadStream(maxAllowedSize: 2_000_000_000L, ct))
            {
                int read;
                while ((read = await stream.ReadAsync(buffer, ct)) > 0)
                {
                    await fs.WriteAsync(buffer.AsMemory(0, read), ct);
                    totalRead += read;
                    var pct = file.Size > 0 ? (int)(100L * totalRead / file.Size) : 0;
                    if (pct != _replaceProgress?.Percent)
                        _replaceProgress = new ReplaceProgress(ReplaceStep.Uploading, pct);
                }
            }
            fs.Position = 0;
            _replaceProgress = new ReplaceProgress(ReplaceStep.Preparing, -1);

            var localFs = fs;
            var summary = await Task.Run(() => Ctx.Engines.RunReplaceFromJson(Ctx.Name, Ctx.TeamId, localFs));

            Ctx.RefreshStatus();
            // The shadow build re-ran Init and reconciled the field config against the new schema:
            // fields that survived keep their roles, new fields arrive unconfigured. Pull that
            // result into the Fields tab, otherwise it keeps showing the pre-replace working copy.
            Ctx.RefreshFieldsFromEngine();
            Ctx.NotifyDocumentsReplaced(); // preview now points at stale docs

            var parts = new List<string>();
            if (summary.Added.Count > 0) parts.Add($"added {string.Join(", ", summary.Added)}");
            if (summary.Removed.Count > 0) parts.Add($"removed {string.Join(", ", summary.Removed)}");
            if (summary.TypeChanged.Count > 0) parts.Add($"type changed {string.Join(", ", summary.TypeChanged)}");
            _replaceResult = parts.Count > 0
                ? $"Data replaced. Schema changes: {string.Join("; ", parts)}."
                  + (summary.Added.Count > 0 ? " New fields are not searchable or filterable until you configure them in Field configuration." : "")
                : "Data replaced.";
            // A configured field that vanished is a behaviour change, not a schema footnote:
            // searches, filters and boost rules that relied on it now silently miss.
            var warnings = new List<string>();
            if (summary.LostRoles.Count > 0)
                warnings.Add($"Configured fields no longer in the data: {string.Join("; ", summary.LostRoles)}. Searches and filters that used them will no longer match; boost rules referencing them are dormant.");
            if (summary.KeyFieldFallback != null)
                warnings.Add(summary.KeyFieldFallback + " Change it under Field configuration → Document key if that is not what you want.");
            _replaceWarning = warnings.Count > 0 ? string.Join(" ", warnings) : null;
        }
        catch (OperationCanceledException)
        {
            _replaceResult = "Replace cancelled during transfer. The dataset is unchanged.";
        }
        catch (Exception ex)
        {
            _replaceError = $"Replace failed: {ex.Message}";
        }
        finally
        {
            _replacePollCts?.Cancel();
            try { await pollTask; } catch { }
            fs?.Dispose();
            _replaceBusy = false;
            _replaceProgress = null;
            Ctx.NotifyChanged();
        }
    }

    public override void Dispose()
    {
        base.Dispose();
        _replaceTransferCts?.Cancel();
        _replaceTransferCts?.Dispose();
        _replacePollCts?.Cancel();
        _replacePollCts?.Dispose();
    }

    // ── Rename ───────────────────────────────────────────────────────────────

    private string _renameInput = "";
    private bool _renameConfirm;
    private bool _renaming;
    private string? _renameError;

    private bool RenameReady => !string.IsNullOrWhiteSpace(_renameInput) && _renameInput.Trim() != Ctx.Name;

    private async Task OnRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && RenameReady)
        {
            if (_renameConfirm) await RenameAsync();
            else { _renameError = null; _renameConfirm = true; }
        }
        if (e.Key == "Escape") _renameConfirm = false;
    }

    private async Task RenameAsync()
    {
        if (!RenameReady || _renaming) return;
        _renameError = null;
        _renaming = true;
        await Render();
        try
        {
            _renameError = await Ctx.RenameAsync(_renameInput);
        }
        catch (Exception ex)
        {
            _renameError = $"Rename failed: {ex.Message}";
        }
        finally
        {
            _renaming = false;
            if (_renameError == null) { _renameInput = ""; _renameConfirm = false; }
        }
        await Render();
    }

    // ── Transfer ─────────────────────────────────────────────────────────────

    private async Task TransferAsync()
    {
        _transferError = null;
        if (string.IsNullOrEmpty(_transferTargetTeamId)) return;
        try
        {
            // TransferOwnership evicts the source engine (can be slow) — run off the circuit.
            var target = _transferTargetTeamId;
            await Task.Run(() => Ctx.Engines.TransferOwnership(Ctx.Name, Ctx.TeamId, target));
        }
        catch (Exception ex)
        {
            _transferError = $"Transfer failed: {ex.Message}";
            return;
        }
        _transferTargetTeamId = "";
        _transferConfirm = false;
        await Ctx.NotifyDatasetListChangedAsync(); // dataset now belongs to another team — drops off this view
    }

    // ── Delete ───────────────────────────────────────────────────────────────

    private Task DeleteAsync() => Ctx.DeleteAsync();
}
