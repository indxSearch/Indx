@page "/Account/License"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Indx.Api
@using IndxCloudApi.Models
@attribute [Authorize]
@inject ILogger<License> Logger
@inject Services.ILicenseBootstrapper Bootstrapper
@inject Services.InstanceSettingsService InstanceSettingsService

<PageTitle>License Information</PageTitle>

<h2>Indx License Information</h2>

@if (isLoading)
{
    <p>Loading license information...</p>
}
else if (licenseInfo != null)
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="padding: 20px; border: 1px solid var(--CSignal); border-radius: var(--radius); background: rgba(255, 66, 56, 0.1); margin: 20px 0;">
            <strong>Error:</strong> @errorMessage
        </div>
    }

    <div style="margin: 40px 0;">
        @if (isSourceBuild)
        {
            <div style="padding: 20px; border: 1px solid var(--CLightBlue); border-radius: var(--radius); background: rgba(107, 158, 255, 0.1); margin: 20px 0;">
                <h3>Source Build</h3>
                <p>Running from source. License validation is only available in obfuscated NuGet builds.</p>
            </div>
        }
        else if (licenseInfo.Licensed && licenseInfo.ValidLicense)
        {
            <div style="padding: 20px; border: 1px solid var(--CTeal); border-radius: var(--radius); background: rgba(114, 245, 198, 0.1); margin: 20px 0;">
                <h3>✓ Licensed</h3>
                <p>Your Indx installation is properly licensed.</p>
            </div>
        }
        else if (licenseInfo.Licensed && !licenseInfo.ValidLicense)
        {
            <div style="padding: 20px; border: 1px solid var(--CSignal); border-radius: var(--radius); background: rgba(255, 66, 56, 0.1); margin: 20px 0;">
                <h3>⚠ License Expired</h3>
                <p>Your license has expired. Please contact <a href="https://indx.co" target="_blank">indx.co</a> to renew.</p>
            </div>
        }
        else
        {
            <div style="padding: 20px; border: 1px solid var(--CLightBlue); border-radius: var(--radius); background: rgba(107, 158, 255, 0.1); margin: 20px 0;">
                <h3>ℹ Running Without License</h3>
                <p>You are running with the default 100,000 document limit.</p>
                <p style="margin-top: 10px;">
                    <strong>To remove this limit:</strong><br />
                    1. Register at <a href="https://indx.co" target="_blank" style="color: var(--CLightBlue);">indx.co</a><br />
                    2. Request your free extended license<br />
                    3. Place the license file in <code style="background: var(--lv1); padding: 2px 6px; border-radius: 3px;">./IndxData/</code> directory
                </p>
            </div>
        }

        @if (runningLicensedNoFile)
        {
            <div style="padding: 16px 20px; border: 1px solid var(--CWarning); border-radius: var(--radius); background: rgba(255,178,41,0.1); margin: 20px 0;">
                <h3 style="margin: 0 0 6px 0;">⚠ No license file on disk</h3>
                <p style="margin: 0;">
                    Existing datasets are still running with the license they loaded at startup, so search keeps working —
                    but there is no <code style="background: var(--lv1); padding: 2px 6px; border-radius: 3px;">.license</code>
                    file in <code style="background: var(--lv1); padding: 2px 6px; border-radius: 3px;">./IndxData/</code> anymore.
                    On the next restart these datasets will drop to the 100,000-document limit. Upload a license file or
                    configure auto-fetch below to keep them licensed.
                </p>
            </div>
        }

        <div style="margin-top: 30px;">
            <h3>License Details</h3>
            <div style="padding: 20px; border: 1px solid var(--lv3); border-radius: var(--radius); background: var(--lv0); margin: 20px 0;">
                <table style="width: 100%; border-collapse: collapse;">
                    <tbody>
                        <tr style="border-bottom: 1px solid var(--lv2);">
                            <td style="padding: 12px 0; font-weight: bold; width: 200px;">Licensed To:</td>
                            <td style="padding: 12px 0;">@licenseInfo.LicensedTo</td>
                        </tr>
                        <tr style="border-bottom: 1px solid var(--lv2);">
                            <td style="padding: 12px 0; font-weight: bold;">Type:</td>
                            <td style="padding: 12px 0;">@licenseInfo.Type</td>
                        </tr>
                        <tr style="border-bottom: 1px solid var(--lv2);">
                            <td style="padding: 12px 0; font-weight: bold;">Description:</td>
                            <td style="padding: 12px 0;">@licenseInfo.Description</td>
                        </tr>
                        <tr style="border-bottom: 1px solid var(--lv2);">
                            <td style="padding: 12px 0; font-weight: bold;">Document Limit:</td>
                            <td style="padding: 12px 0;">
                                @if (licenseInfo.DocumentLimit == int.MaxValue)
                                {
                                    <span>Unlimited</span>
                                }
                                else
                                {
                                    <span>@licenseInfo.DocumentLimit.ToString("N0")</span>
                                }
                                @if (licenseInfo.DocumentLimitExceeded)
                                {
                                    <span style="color: var(--CSignal); margin-left: 10px;">⚠ Limit Exceeded</span>
                                }
                            </td>
                        </tr>
                        <tr style="border-bottom: 1px solid var(--lv2);">
                            <td style="padding: 12px 0; font-weight: bold;">Expiration Date:</td>
                            <td style="padding: 12px 0;">
                                @if (licenseInfo.ExpirationDate.Year >= 3000)
                                {
                                    <span>Never</span>
                                }
                                else
                                {
                                    <span>@licenseInfo.ExpirationDate.ToString("yyyy-MM-dd")</span>
                                }
                            </td>
                        </tr>
                        <tr style="border-bottom: 1px solid var(--lv2);">
                            <td style="padding: 12px 0; font-weight: bold;">License File:</td>
                            <td style="padding: 12px 0; font-family: monospace; font-size: 12px;">@licenseInfo.LicenseFileName</td>
                        </tr>
                        <tr style="border-bottom: 1px solid var(--lv2);">
                            <td style="padding: 12px 0; font-weight: bold;">Auto-fetch:</td>
                            <td style="padding: 12px 0;">
                                @if (autoFetch is null || !autoFetch.UrlConfigured)
                                {
                                    <span style="color: var(--lv5);">Not configured</span>
                                    <span style="color: var(--lv5); margin-left: 8px; font-size: 12px;">
                                        (set <code style="background: var(--lv1); padding: 2px 6px; border-radius: 3px;">Indx:LicenseDownloadUrl</code> + <code style="background: var(--lv1); padding: 2px 6px; border-radius: 3px;">Indx:LicenseToken</code>)
                                    </span>
                                }
                                else if (!autoFetch.TokenConfigured)
                                {
                                    <span style="color: var(--CSignal);">⚠ URL set — token missing</span>
                                }
                                else
                                {
                                    <span style="color: var(--CTeal);">✓ Configured</span>
                                    <span style="color: var(--lv5); margin-left: 8px; font-size: 12px;">token set · re-fetched on every startup</span>
                                    @if (autoFetch.FileExists)
                                    {
                                        <span style="color: var(--lv5); margin-left: 8px; font-size: 12px;">
                                            · last fetched @(autoFetch.LastWriteUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")) (@FormatBytes(autoFetch.FileBytes))
                                        </span>
                                    }
                                }
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 12px 0; font-weight: bold;">Valid:</td>
                            <td style="padding: 12px 0;">
                                @if (licenseInfo.ValidLicense)
                                {
                                    <span style="color: var(--CTeal);">✓ Yes</span>
                                }
                                else
                                {
                                    <span style="color: var(--CSignal);">✗ No</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @if (!licenseInfo.Licensed || !licenseInfo.ValidLicense)
        {
            <div style="margin-top: 30px; padding: 20px; border: 1px solid var(--lv3); border-radius: var(--radius); background: var(--lv0);">
                <h3>Getting a License</h3>
                <div style="margin-top: 15px;">
                    <h4>Option 1: Free Extended License (Recommended)</h4>
                    <ul style="line-height: 1.8;">
                        <li>Register an account at <a href="https://indx.co" target="_blank" style="color: var(--CLightBlue);">https://indx.co</a></li>
                        <li>Request your free extended license</li>
                        <li>No restrictions - use for any purpose including production</li>
                        <li>Place file in <code style="background: var(--lv1); padding: 2px 6px; border-radius: 3px;">./IndxData/indx-developer.license</code></li>
                    </ul>

                    <h4 style="margin-top: 20px;">Option 2: Paid Company License</h4>
                    <ul style="line-height: 1.8;">
                        <li>For organizations requiring SLA and technical support</li>
                        <li>Includes service level guarantees and priority support</li>
                        <li>Same document capacity as extended license</li>
                        <li>Contact <a href="https://indx.co" target="_blank" style="color: var(--CLightBlue);">indx.co</a> for pricing</li>
                    </ul>
                </div>
            </div>
        }

        @* ── LICENSE FILE MANAGEMENT (admin only) ── *@
        <AuthorizeView Roles="Admin">
        <div style="margin-top: 40px;">
            <h3>License Files</h3>

            @if (!string.IsNullOrEmpty(fileOpMessage))
            {
                <div style="padding: 14px 18px; border: 1px solid var(--CTeal); border-radius: var(--radius); background: rgba(114,245,198,0.08); margin: 16px 0;">
                    @fileOpMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(fileOpError))
            {
                <div style="padding: 14px 18px; border: 1px solid var(--CSignal); border-radius: var(--radius); background: rgba(255,66,56,0.08); margin: 16px 0;">
                    @fileOpError
                </div>
            }

            @if (licenseFiles.Count > 0)
            {
                <table style="width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 13px;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--lv3); color: var(--lv5);">
                            <th style="text-align: left; padding: 8px 12px; font-weight: 500;">File</th>
                            <th style="padding: 8px 12px; font-weight: 500;">Status</th>
                            <th style="padding: 8px 12px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in licenseFiles)
                        {
                            <tr style="border-bottom: 1px solid var(--lv2);">
                                <td style="padding: 10px 12px; font-family: monospace; color: var(--lv6);">@f.Filename</td>
                                <td style="padding: 10px 12px; text-align: center;">
                                    @if (f.IsActive)
                                    {
                                        <Chip Color="var(--CTeal)" TextColor="#080809">Active</Chip>
                                    }
                                    else
                                    {
                                        <Chip Color="var(--lv3)" TextColor="var(--lv5)">Inactive</Chip>
                                    }
                                </td>
                                <td style="padding: 10px 12px; text-align: right;">
                                    <button class="btn-secondary" style="font-size: 12px; padding: 4px 10px; color: var(--CSignal);"
                                            @onclick="() => ConfirmDelete(f.Filename)">Delete</button>
                                </td>
                            </tr>
                            @if (deleteConfirmFile == f.Filename)
                            {
                                <tr>
                                    <td colspan="3" style="padding: 12px; background: rgba(255,178,41,0.06); border-bottom: 1px solid var(--lv2);">
                                        <div style="display: flex; align-items: center; gap: 16px;">
                                            <span style="font-size: 13px;">Delete <strong>@f.Filename</strong>? This cannot be undone.</span>
                                            <button class="btn-secondary" style="font-size: 12px; padding: 4px 10px; color: var(--CSignal);"
                                                    @onclick="ExecuteDelete">Yes, delete</button>
                                            <button class="btn-secondary" style="font-size: 12px; padding: 4px 10px;"
                                                    @onclick="() => deleteConfirmFile = null">Cancel</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="color: var(--lv5); font-size: 13px; margin: 16px 0;">No license files in <code style="background: var(--lv1); padding: 2px 6px; border-radius: 3px;">./IndxData/</code>.</p>
            }

            @* ── UPLOAD ── *@
            <div style="margin-top: 12px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <InputFile OnChange="HandleFileSelected" accept=".license" style="display:none" id="license-file-input" />
                <label for="license-file-input" class="indx-upload-label">
                    <Card Size="14" />
                    @if (selectedFile != null)
                    {
                        <span>@selectedFile.Name (@((selectedFile.Size / 1024.0).ToString("F1")) KB)</span>
                    }
                    else
                    {
                        <span>Choose a .license file to upload</span>
                    }
                </label>
                @if (selectedFile != null)
                {
                    <Button Variant="primary" Size="micro" @onclick="UploadFile" Disabled="@isUploading">
                        @(isUploading ? "Uploading…" : "Upload")
                    </Button>
                    <Button Variant="ghost" Size="micro" @onclick="() => { selectedFile = null; fileOpError = null; }">Cancel</Button>
                }
            </div>

            @* ── AUTO-FETCH FROM LICENSE SERVER ── *@
            <div style="margin-top: 32px;">
                <h4 style="margin-bottom: 4px;">Auto-fetch from license server</h4>
                <p style="color: var(--lv5); font-size: 13px; margin-bottom: 12px;">
                    With a URL and token set, a fresh license is fetched automatically on every startup.
                    Use <strong>Fetch now</strong> to pull one immediately.
                </p>
                <div style="display: flex; flex-direction: column; gap: 8px; max-width: 520px;">
                    <InputField @bind-Value="_licenseUrl" placeholder="https://license.indx.co/…" />
                    <InputField @bind-Value="_licenseTokenInput" type="password"
                                placeholder="@(autoFetch?.TokenConfigured == true ? "Token set — leave blank to keep" : "Paste license token")" />
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <Button Variant="primary" Size="micro" @onclick="SaveAutoFetch" Disabled="@_isFetching">Save</Button>
                        <Button Variant="secondary" Size="micro" @onclick="FetchNow"
                                Disabled="@(_isFetching || autoFetch?.UrlConfigured != true)">
                            @(_isFetching ? "Fetching…" : "Fetch now")
                        </Button>
                    </div>
                    @if (!string.IsNullOrEmpty(_fetchMessage))
                    {
                        <p style="color: var(--CTeal); font-size: 12px; margin: 0;">@_fetchMessage</p>
                    }
                    @if (!string.IsNullOrEmpty(_fetchError))
                    {
                        <p style="color: var(--CSignal); font-size: 12px; margin: 0;">@_fetchError</p>
                    }
                </div>
            </div>
        </div>
        </AuthorizeView>
    </div>
}
else
{
    <div style="padding: 20px; border: 1px solid var(--CSignal); border-radius: var(--radius); background: rgba(255, 66, 56, 0.1); margin: 20px 0;">
        <strong>Error:</strong> Unable to load license information.
    </div>
}

@code {
    private LicenseInfo? licenseInfo;
    private Services.LicenseAutoFetchStatus? autoFetch;
    private string? errorMessage;
    private bool isLoading = true;
#if SOURCE_BUILD
    private bool isSourceBuild = true;
#else
    private bool isSourceBuild = false;
#endif

    private List<IndxCloudInternalApi.LicenseFileInfo> licenseFiles = [];
    private bool runningLicensedNoFile;
    private string? deleteConfirmFile;
    private string? fileOpMessage;
    private string? fileOpError;
    private IBrowserFile? selectedFile;
    private bool isUploading;

    // Auto-fetch editor state.
    private string _licenseUrl = "";
    private string _licenseTokenInput = "";
    private string? _fetchMessage;
    private string? _fetchError;
    private bool _isFetching;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var authState = await AuthState;
            isAdmin = authState.User.IsInRole("Admin");
        }
        autoFetch = Bootstrapper.GetStatus();
        _licenseUrl = autoFetch?.Url ?? "";
        await Task.WhenAll(LoadLicenseInfo(), LoadLicenseFiles());
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):0.#} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes} B";
    }

    private async Task LoadLicenseInfo()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            await Task.Run(() =>
            {
                licenseInfo = IndxCloudInternalApi.Manager.GetLicenseInfo();
            });

            if (licenseInfo == null)
            {
                errorMessage = "GetLicenseInfo returned null - this should not happen";
                Logger.LogWarning("GetLicenseInfo returned null");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Exception: {ex.Message}";
            Logger.LogError(ex, "Error loading license information");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLicenseFiles()
    {
        await Task.Run(() =>
        {
            licenseFiles = [.. IndxCloudInternalApi.Manager.GetLicenseFiles()];
            // No license file on disk, yet engines built earlier still hold a valid license:
            // search keeps working now, but a restart drops them to the free-tier limit.
            runningLicensedNoFile =
                licenseFiles.Count == 0 && IndxCloudInternalApi.Manager.AnyRunningInstanceLicensed();
        });
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        fileOpMessage = null;
        fileOpError = null;
    }

    private void SaveAutoFetch()
    {
        _fetchMessage = null; _fetchError = null;
        if (!isAdmin)
        {
            _fetchError = "Only administrators can change the license source.";
            return;
        }

        var settings = InstanceSettingsService.Load();
        settings.LicenseDownloadUrl = string.IsNullOrWhiteSpace(_licenseUrl) ? null : _licenseUrl.Trim();
        // Only overwrite the token when a new one is entered; a blank field keeps the existing one.
        if (!string.IsNullOrWhiteSpace(_licenseTokenInput))
            settings.LicenseToken = _licenseTokenInput.Trim();
        InstanceSettingsService.Save(settings);

        _licenseTokenInput = "";
        autoFetch = Bootstrapper.GetStatus();
        _fetchMessage = "Saved.";
    }

    private async Task FetchNow()
    {
        _fetchMessage = null; _fetchError = null;
        if (!isAdmin)
        {
            _fetchError = "Only administrators can fetch the license.";
            return;
        }

        _isFetching = true;
        StateHasChanged();
        try
        {
            var result = await Bootstrapper.EnsureLocalLicenseAsync();
            await Task.WhenAll(LoadLicenseFiles(), LoadLicenseInfo());
            autoFetch = Bootstrapper.GetStatus();
            if (result.Succeeded)
                _fetchMessage = result.Message;
            else
                _fetchError = result.Message;
        }
        catch (Exception ex)
        {
            _fetchError = $"Fetch failed: {ex.Message}";
            Logger.LogError(ex, "Manual license fetch failed");
        }
        finally
        {
            _isFetching = false;
        }
    }

    private async Task UploadFile()
    {
        if (selectedFile == null) return;

        if (!isAdmin)
        {
            fileOpError = "Only administrators can upload license files.";
            Logger.LogWarning("Non-admin attempted to upload license file {Filename}", selectedFile.Name);
            return;
        }

        if (!selectedFile.Name.EndsWith(".license", StringComparison.OrdinalIgnoreCase))
        {
            fileOpError = "Only .license files are accepted.";
            return;
        }
        if (selectedFile.Size > 1_048_576)
        {
            fileOpError = "File is too large. Maximum size is 1 MB.";
            return;
        }

        isUploading = true;
        fileOpMessage = null;
        fileOpError = null;
        StateHasChanged();

        try
        {
            using var stream = selectedFile.OpenReadStream(1_048_576);
            await IndxCloudInternalApi.Manager.SaveLicenseFileAsync(selectedFile.Name, stream);
            fileOpMessage = $"'{selectedFile.Name}' uploaded. New datasets will use this license immediately. Restart the server to apply to existing datasets.";
            selectedFile = null;
            await Task.WhenAll(LoadLicenseFiles(), LoadLicenseInfo());
        }
        catch (Exception ex)
        {
            fileOpError = $"Upload failed: {ex.Message}";
            Logger.LogError(ex, "Error uploading license file");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private void ConfirmDelete(string filename)
    {
        deleteConfirmFile = filename;
        fileOpMessage = null;
        fileOpError = null;
    }

    private async Task ExecuteDelete()
    {
        if (deleteConfirmFile == null) return;
        var name = deleteConfirmFile;
        deleteConfirmFile = null;

        if (!isAdmin)
        {
            fileOpError = "Only administrators can delete license files.";
            Logger.LogWarning("Non-admin attempted to delete license file {Filename}", name);
            return;
        }

        try
        {
            IndxCloudInternalApi.Manager.DeleteLicenseFile(name);
            fileOpMessage = $"'{name}' deleted. Restart the server to apply to existing datasets.";
            await Task.WhenAll(LoadLicenseFiles(), LoadLicenseInfo());
        }
        catch (Exception ex)
        {
            fileOpError = $"Delete failed: {ex.Message}";
            Logger.LogError(ex, "Error deleting license file {Filename}", name);
        }
        StateHasChanged();
    }
}
