@page "/admin/license"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Indx.Api
@using IndxServer.Models
@using IndxServer.Engine
@attribute [Authorize(Roles = "Admin")]
@inject ILogger<License> Logger
@inject Services.ILicenseBootstrapper Bootstrapper
@inject Services.InstanceSettingsService InstanceSettingsService
@inject Services.IEditionService Edition
@inject Indx.Systm.Blazor.ToastService Toasts
@using IndxServer.Components.Datasets

<PageTitle>License</PageTitle>

@* The console's half of the license (Nov 2026), drawn as the license portal draws the other half:
   the license on the left, how it reaches this server on the right, in the portal's words for a token
   and a fetch. The limit without a license is per dataset (a dataset past it takes its first 100,000
   documents), so the page names the datasets it cuts and never adds documents across them. *@
<div class="license-head">
    <h2>License</h2>
    <p>The license this server runs on, and how it gets a new one.</p>
</div>

@if (!Edition.LicensingVisible)
{
    <Alert Variant="info">
        <Title>Managed by Indx</Title>
        <Description>Licensing is handled by Indx on a managed deployment, so there is nothing to set here. Your plan decides the capacity.</Description>
    </Alert>
}
else if (isLoading)
{
    <p class="license-loading"><Spinner Size="14" /> Loading the license…</p>
}
else if (licenseInfo is null)
{
    <Alert Variant="destructive">
        <Title>The license could not be read</Title>
        <Description>@(errorMessage ?? "Try again in a moment, or see the server log.")</Description>
    </Alert>
}
else
{
    <div class="license-page">
        @* What needs doing, only when something does. *@
        @if (isSourceBuild)
        {
            <Alert Variant="info">
                <Title>Built from source</Title>
                <Description>
                    This server runs the Indx engine from source, where no license is checked: no dataset has a document limit
                    and the license file is not read. Customers run the published IndxSearchLib; build with
                    <code class="license-code">-p:IndxFromNuGet=true</code> to see this page as they do.
                </Description>
            </Alert>
        }
        else if (licenseInfo.Licensed && !licenseInfo.ValidLicense)
        {
            <Alert Variant="destructive">
                <Title>The license ended <TimeAgo Value="licenseInfo.ExpirationDate" /></Title>
                <Description>A dataset loaded since then takes at most @Limit.ToString("N0") documents. Renew it at @PortalHost, or connect a token so this server renews it by itself.</Description>
            </Alert>
        }
        else if (OverLimit.Count > 0)
        {
            <Alert Variant="warning">
                <Title>@(OverLimit.Count == 1 ? "1 dataset is" : $"{OverLimit.Count} datasets are") over the @Limit.ToString("N0") document limit</Title>
                <Description>Each takes its first @Limit.ToString("N0") documents and leaves the rest out of search. A free license from @PortalHost lifts the limit.</Description>
            </Alert>
        }
        else if (!licenseInfo.Licensed && autoFetch?.TokenConfigured == true)
        {
            <Alert Variant="info">
                <Title>A token is set, and no license has come yet</Title>
                <Description>Fetch now to get it at once. It applies to each dataset the next time it is loaded or indexed.</Description>
            </Alert>
        }
        @if (runningLicensedNoFile && !isSourceBuild)
        {
            <Alert Variant="warning">
                <Title>No license file on disk</Title>
                <Description>
                    The datasets running now keep the license they loaded, so search goes on.
                    @(autoFetch?.TokenConfigured == true
                        ? "A token is set, so a new file is fetched on start and daily; Fetch now restores it at once."
                        : "After a restart they drop to the free limit: connect a token or upload a license file.")
                </Description>
            </Alert>
        }

        <div class="license-columns">
            <div class="license-column">
                <h3>@(isSourceBuild ? "Source build" : licenseInfo.Licensed ? "Your Indx license" : "No license yet")</h3>
                @if (!licenseInfo.Licensed && !isSourceBuild)
                {
                    <p class="license-text">Indx runs without a license, with up to @Limit.ToString("N0") documents in each dataset. A free license from @PortalHost lifts the limit, for any use.</p>
                }
                <div class="license-facts">
                    <span class="license-faint">Edition</span>
                    <span>
                        @if (licenseInfo.Licensed && licenseInfo.ValidLicense && !isSourceBuild)
                        {
                            <Chip Color="var(--CLightBlue)" TextColor="#080809">@EditionLabel</Chip>
                        }
                        else
                        {
                            <Chip Color="var(--lv2)" TextColor="var(--lv6)">@(isSourceBuild ? "Source build" : licenseInfo.Licensed ? $"{EditionLabel}, ended" : "No license")</Chip>
                        }
                    </span>
                    @if (isSourceBuild)
                    {
                        <span class="license-faint">Checked</span>
                        <span>No, a source build does not check licenses</span>
                    }
                    @if (licenseInfo.Licensed && !string.IsNullOrWhiteSpace(licenseInfo.LicensedTo))
                    {
                        <span class="license-faint">Licensed to</span>
                        <span>@licenseInfo.LicensedTo</span>
                    }
                    @if (licenseInfo.Licensed && licenseInfo.ExpirationDate.Year < 3000)
                    {
                        <span class="license-faint">@(licenseInfo.ValidLicense ? "Renews" : "Ended")</span>
                        <span><TimeAgo Value="licenseInfo.ExpirationDate" /></span>
                    }
                    <span class="license-faint">Documents</span>
                    <span>@(isSourceBuild ? "No limit, as built" : Limited ? $"At most {Limit:N0} per dataset" : "No limit")</span>
                </div>

                @if (OverLimit.Count > 0)
                {
                    <div class="license-over">
                        <span class="license-faint">Over the limit</span>
                        @foreach (var d in OverLimit)
                        {
                            <div class="license-over-row">
                                <span class="license-mono">@d.Name</span>
                                <BarMeter Value="Limit" Max="d.Documents" Color="var(--CSignal)" Format="@(v => v.ToString("N0"))"
                                          MaxLabel="@($"of {d.Documents:N0} searched")" />
                            </div>
                        }
                    </div>
                }

                <div class="license-links">
                    <a class="license-link" href="@PortalUrl" target="_blank" rel="noopener">@DatasetIcons.User(14)<span>Your license at @PortalHost</span>@DatasetIcons.Open(14)</a>
                    <a class="license-link" href="https://v6.docs.indx.co" target="_blank" rel="noopener">@DatasetIcons.Documents(14)<span>Licensing in the documentation</span>@DatasetIcons.Open(14)</a>
                </div>
            </div>

            <div class="license-column">
                @* How the license reaches this server: a token from the portal, fetched on start and daily. *@
                <div class="license-card">
                    <h3>From @PortalHost</h3>
                    @if (autoFetch?.TokenConfigured == true && !_editingToken)
                    {
                        <div class="license-connected">
                            <span class="license-tick">@DatasetIcons.Fixed(14)</span>
                            <span class="license-connected-text">
                                <span>Connected with a token</span>
                                <span class="license-faint">
                                    @if (autoFetch.FileExists)
                                    {
                                        <text>Last fetched </text><TimeAgo Value="autoFetch.LastWriteUtc" /><text>. It fetches on start and once a day.</text>
                                    }
                                    else
                                    {
                                        <text>Nothing fetched yet. It fetches on start and once a day.</text>
                                    }
                                </span>
                            </span>
                        </div>
                        <div class="license-inline">
                            <Button Variant="secondary" Size="micro" IconLeft="DatasetIcons.Restore" Loading="@_isFetching"
                                    Disabled="@(autoFetch?.UrlConfigured != true)" @onclick="FetchNow">Fetch now</Button>
                            <Button Variant="ghost" Size="micro" Disabled="@_isFetching" @onclick="BeginEditToken">Change token</Button>
                            <ConfirmButton Label="Remove" Title="Remove the token?" ConfirmLabel="Remove token" Disabled="@_isFetching"
                                           Prompt="This server stops fetching the license. The license file it has keeps working until it ends."
                                           OnConfirm="RemoveToken" />
                        </div>
                    }
                    else
                    {
                        <p class="license-text">Create a token on your license page at @PortalHost and paste it here. This server then fetches the license, and a new one whenever it renews.</p>
                        <div><Button Href="@PortalUrl" Variant="ghost" Size="micro" IconLeft="DatasetIcons.Open" target="_blank" rel="noopener">Open @PortalHost</Button></div>
                        <InputField Label="Token" type="password" Immediate @bind-Value="_licenseTokenInput"
                                    placeholder="@(autoFetch?.TokenConfigured == true ? "Paste the new token" : "Paste the token")" />
                        <div class="license-inline">
                            <Button Variant="primary" Size="micro" IconLeft="DatasetIcons.Key" Loading="@_isFetching"
                                    Disabled="@string.IsNullOrWhiteSpace(_licenseTokenInput)" @onclick="SaveToken">Save and fetch</Button>
                            @if (_editingToken)
                            {
                                <Button Variant="secondary" Size="micro" Disabled="@_isFetching" @onclick="CancelEditToken">Cancel</Button>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_fetchError))
                    {
                        <Alert Variant="destructive">@_fetchError</Alert>
                    }
                </div>

                <div class="license-card">
                    <h3>License files</h3>
                    <p class="license-text">In IndxData. A fetched license is written here; a server that cannot reach the portal takes one uploaded by hand.</p>
                    @if (licenseFiles.Count > 0)
                    {
                        <div class="license-files">
                            <Table AriaLabel="License files">
                                <thead>
                                    <tr>
                                        <th scope="col">File</th>
                                        <th scope="col">Status</th>
                                        <th scope="col" aria-label="Actions"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in licenseFiles)
                                    {
                                        var name = f.Filename;
                                        <tr>
                                            <td class="license-mono">@name</td>
                                            <td>
                                                @if (f.IsActive)
                                                {
                                                    <Chip Color="var(--lv8)" TextColor="var(--lv0)">In use</Chip>
                                                }
                                                else
                                                {
                                                    <Chip Color="var(--lv2)" TextColor="var(--lv5)">Not used</Chip>
                                                }
                                            </td>
                                            <td class="license-actions">
                                                <ConfirmButton Label="Delete" Title="@($"Delete {name}?")" ConfirmLabel="Delete file"
                                                               Prompt="Datasets keep the license they loaded until the server restarts."
                                                               OnConfirm="() => DeleteFile(name)" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </Table>
                        </div>
                    }
                    else
                    {
                        <p class="license-faint">No license file yet.</p>
                    }

                    <div class="license-inline">
                        <InputFile OnChange="HandleFileSelected" accept=".license" style="display:none" id="license-file-input" />
                        <label for="license-file-input" class="indx-upload-label">
                            <Card Size="14" />
                            <span>@(selectedFile is null ? "Upload a .license file" : $"{selectedFile.Name} ({selectedFile.Size / 1024.0:F1} KB)")</span>
                        </label>
                        @if (selectedFile is not null)
                        {
                            <Button Variant="primary" Size="micro" Loading="@isUploading" @onclick="UploadFile">Upload</Button>
                            <Button Variant="secondary" Size="micro" Disabled="@isUploading" @onclick="() => { selectedFile = null; fileOpError = null; }">Cancel</Button>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(fileOpError))
                    {
                        <Alert Variant="destructive">@fileOpError</Alert>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private LicenseInfo? licenseInfo;
    private Services.LicenseAutoFetchStatus? autoFetch;
    private string? errorMessage;
    private bool isLoading = true;
#if SOURCE_BUILD
    private bool isSourceBuild = true;
#else
    private bool isSourceBuild = false;
#endif

    private List<IndxServerInternalApi.LicenseFileInfo> licenseFiles = [];
    private bool runningLicensedNoFile;
    private string? fileOpError;

    private sealed record DatasetOver(string Name, int Documents);
    /// <summary>The datasets the limit cuts: the limit is per dataset, and one past it takes its first
    /// Limit documents. Empty with a license, or in a source build, which has no limit.</summary>
    private List<DatasetOver> OverLimit = [];
    private int Limit => licenseInfo?.DocumentLimit ?? 100_000;
    private bool Limited => !isSourceBuild && licenseInfo is not null && licenseInfo.DocumentLimit != int.MaxValue;
    /// <summary>The license's type as people say it: "FreeDeveloper" is Free Developer.</summary>
    private string EditionLabel => licenseInfo?.Type switch
    {
        null or "" => "Licensed",
        "FreeDeveloper" => "Free Developer",
        var t => t,
    };
    private IBrowserFile? selectedFile;
    private bool isUploading;

    // Friendly portal host derived from the hardcoded fetch endpoint, so the UI shows
    // "license.indx.co" instead of the raw …/api/license/current and stays in sync if it changes.
    private static readonly Uri PortalUri = new(Services.LicenseBootstrapper.DefaultDownloadUrl);
    private static string PortalHost => PortalUri.Host;
    private static string PortalUrl => $"{PortalUri.Scheme}://{PortalUri.Host}";

    // Auto-fetch editor state.
    private string _licenseTokenInput = "";
    private string? _fetchError;
    private bool _isFetching;
    private bool _editingToken;        // true while replacing an existing token (input shown)

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        // Managed deployments don't surface licensing — skip the probe work entirely.
        if (!Edition.LicensingVisible)
        {
            isLoading = false;
            return;
        }

        if (AuthState is not null)
        {
            var authState = await AuthState;
            isAdmin = authState.User.IsInRole("Admin");
        }
        autoFetch = Bootstrapper.GetStatus();
        await Task.WhenAll(LoadLicenseInfo(), LoadLicenseFiles());
        await LoadOverLimit();
    }

    /// <summary>Off the circuit thread: a sleeping dataset's records are a count, kept ten minutes.</summary>
    private async Task LoadOverLimit()
    {
        if (!Limited) { OverLimit = []; return; }
        var limit = Limit;
        OverLimit = await Task.Run(() => IndxServerInternalApi.Manager.GetAllDataSets()
            .Select(d => new DatasetOver(d.DataSetName, Services.DatasetRecordCounts.Get(d.DataSetName, d.TeamId)))
            .Where(d => d.Documents > limit)
            .OrderByDescending(d => d.Documents)
            .ToList());
    }

    private async Task LoadLicenseInfo()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            await Task.Run(() =>
            {
                licenseInfo = IndxServerInternalApi.Manager.GetLicenseInfo();
            });

            if (licenseInfo == null)
            {
                errorMessage = "GetLicenseInfo returned null - this should not happen";
                Logger.LogWarning("GetLicenseInfo returned null");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Exception: {ex.Message}";
            Logger.LogError(ex, "Error loading license information");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLicenseFiles()
    {
        await Task.Run(() =>
        {
            licenseFiles = [.. IndxServerInternalApi.Manager.GetLicenseFiles()];
            // No license file on disk, yet engines built earlier still hold a valid license:
            // search keeps working now, but a restart drops them to the free-tier limit.
            runningLicensedNoFile =
                licenseFiles.Count == 0 && IndxServerInternalApi.Manager.AnyRunningInstanceLicensed();
        });
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        fileOpError = null;
    }

    private async Task SaveToken()
    {
        _fetchError = null;
        if (!isAdmin)
        {
            _fetchError = "Only administrators can change the license source.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_licenseTokenInput))
        {
            _fetchError = "Enter a token to save.";
            return;
        }

        var settings = InstanceSettingsService.Load();
        settings.LicenseToken = _licenseTokenInput.Trim();
        InstanceSettingsService.Save(settings);

        _licenseTokenInput = "";
        _editingToken = false;
        autoFetch = Bootstrapper.GetStatus();

        // Immediately fetch with the new token so the license validates on the spot, instead of
        // making the admin click "Fetch now" or wait for the next startup/daily refresh.
        _isFetching = true;
        StateHasChanged();
        try
        {
            var result = await Bootstrapper.EnsureLocalLicenseAsync();
            await Task.WhenAll(LoadLicenseFiles(), LoadLicenseInfo());
            autoFetch = Bootstrapper.GetStatus();
            await LoadOverLimit();
            if (result.Succeeded)
                Toasts.Show("Token saved and the license fetched.", DatasetIcons.Key);
            else
                _fetchError = $"Token saved, but the license could not be fetched: {result.Message}";
        }
        catch (Exception ex)
        {
            _fetchError = $"Token saved, but the license fetch failed: {ex.Message}";
            Logger.LogError(ex, "License fetch immediately after saving token failed");
        }
        finally
        {
            _isFetching = false;
        }
    }

    private void BeginEditToken()
    {
        _fetchError = null;
        _licenseTokenInput = "";
        _editingToken = true;
    }

    private void CancelEditToken()
    {
        _editingToken = false;
        _licenseTokenInput = "";
        _fetchError = null;
    }

    private void RemoveToken()
    {
        _fetchError = null;
        if (!isAdmin)
        {
            _fetchError = "Only administrators can change the license source.";
            return;
        }

        var settings = InstanceSettingsService.Load();
        settings.LicenseToken = null;
        InstanceSettingsService.Save(settings);

        _licenseTokenInput = "";
        _editingToken = false;
        autoFetch = Bootstrapper.GetStatus();
        // A token may still come from the Indx:LicenseToken app setting (env/config), which the UI
        // cannot clear — say so instead of implying auto-fetch is fully off.
        Toasts.Show(autoFetch?.TokenConfigured == true
            ? "Token removed here. One is still set in the configuration (Indx:LicenseToken), so fetching stays on."
            : "Token removed. This server no longer fetches the license.", DatasetIcons.Key);
    }

    private async Task FetchNow()
    {
        _fetchError = null;
        if (!isAdmin)
        {
            _fetchError = "Only administrators can fetch the license.";
            return;
        }

        _isFetching = true;
        StateHasChanged();
        try
        {
            var result = await Bootstrapper.EnsureLocalLicenseAsync();
            await Task.WhenAll(LoadLicenseFiles(), LoadLicenseInfo());
            autoFetch = Bootstrapper.GetStatus();
            await LoadOverLimit();
            if (result.Succeeded)
                Toasts.Show(result.Message, DatasetIcons.Restore);
            else
                _fetchError = result.Message;
        }
        catch (Exception ex)
        {
            _fetchError = $"Fetch failed: {ex.Message}";
            Logger.LogError(ex, "Manual license fetch failed");
        }
        finally
        {
            _isFetching = false;
        }
    }

    private async Task UploadFile()
    {
        if (selectedFile == null) return;

        if (!isAdmin)
        {
            fileOpError = "Only administrators can upload license files.";
            Logger.LogWarning("Non-admin attempted to upload license file {Filename}", selectedFile.Name);
            return;
        }

        if (!selectedFile.Name.EndsWith(".license", StringComparison.OrdinalIgnoreCase))
        {
            fileOpError = "Only .license files are accepted.";
            return;
        }
        if (selectedFile.Size > 1_048_576)
        {
            fileOpError = "File is too large. Maximum size is 1 MB.";
            return;
        }

        isUploading = true;
        fileOpError = null;
        StateHasChanged();

        try
        {
            using var stream = selectedFile.OpenReadStream(1_048_576);
            await IndxServerInternalApi.Manager.SaveLicenseFileAsync(selectedFile.Name, stream);
            Toasts.Show($"Uploaded {selectedFile.Name}. Datasets take it when they are next loaded or indexed.", DatasetIcons.Documents);
            selectedFile = null;
            await Task.WhenAll(LoadLicenseFiles(), LoadLicenseInfo());
            await LoadOverLimit();
        }
        catch (Exception ex)
        {
            fileOpError = $"Upload failed: {ex.Message}";
            Logger.LogError(ex, "Error uploading license file");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteFile(string name)
    {
        fileOpError = null;
        if (!isAdmin)
        {
            fileOpError = "Only administrators can delete license files.";
            Logger.LogWarning("Non-admin attempted to delete license file {Filename}", name);
            return;
        }

        try
        {
            IndxServerInternalApi.Manager.DeleteLicenseFile(name);
            Toasts.Show($"Deleted {name}. Datasets keep the license they loaded until the server restarts.", DatasetIcons.Documents);
            await Task.WhenAll(LoadLicenseFiles(), LoadLicenseInfo());
            await LoadOverLimit();
        }
        catch (Exception ex)
        {
            fileOpError = $"Delete failed: {ex.Message}";
            Logger.LogError(ex, "Error deleting license file {Filename}", name);
        }
    }
}
