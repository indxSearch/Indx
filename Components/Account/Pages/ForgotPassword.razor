@page "/Account/ForgotPassword"
@layout UnauthenticatedLayout
@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Identity.UI.Services
@using IndxCloudApi.Data
@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender EmailSender
@inject NavigationManager NavigationManager
@inject ILogger<ForgotPassword> Logger
@inject IndxCloudApi.Services.InstanceSettingsService InstanceSettingsService

<PageTitle>Forgot password</PageTitle>

<h3>Forgot your password?</h3>

@if (emailSent)
{
    <div style="padding: 20px; border: 1px solid var(--CTeal); border-radius: var(--radius); background: rgba(114, 245, 198, 0.1); margin: 20px 0;">
        <h4>Check your email</h4>
        <p>
            If an account exists with that email address, we've sent you a password reset link.
        </p>
    </div>

    <p>
        <strong>What to do next:</strong>
    </p>
    <ol>
        <li>Check your email inbox</li>
        <li>Click the "Reset Password" link in the email</li>
        <li>The link will expire in 1 hour for security</li>
    </ol>

    <div style="padding: 20px; border: 1px solid var(--CLightBlue); border-radius: var(--radius); background: rgba(107, 158, 255, 0.1); margin: 20px 0;">
        <strong>Didn't receive the email?</strong>
        <ul style="margin-bottom: 0;">
            <li>Check your spam/junk folder</li>
            <li>Make sure you entered the correct email address</li>
            <li>Wait a few minutes - it may take time to arrive</li>
        </ul>
    </div>

    <div style="margin-top: 40px;">
        <Button Href="/Account/Login" Variant="secondary">Back to log in</Button>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="padding: 20px; border: 1px solid var(--CSignal); border-radius: var(--radius); background: rgba(255, 66, 56, 0.1); margin: 20px 0;">
            @errorMessage
        </div>
    }

    <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" FormName="forgot-password">
        <DataAnnotationsValidator />

        <div style="margin-bottom: 20px;">
            <InputField @bind-Value="Input.Email"
                        type="email"
                        autocomplete="username"
                        placeholder="Email"
                        id="email" />
            <ValidationMessage For="() => Input.Email" />
        </div>

        <Button Type="submit" Variant="secondary" Disabled="@isProcessing">
            @if (isProcessing) { <span>Sending...</span> }
            else { <span>Send reset link</span> }
        </Button>

        <div style="margin-top: 40px; display: flex; flex-direction: column;">
            <a href="/Account/Login" style="font: var(--text-sm);">Back to log in</a>
        </div>
    </EditForm>
}

@code {
    private string? errorMessage;
    private bool isProcessing = false;
    private bool emailSent = false;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private async Task OnValidSubmitAsync()
    {
        isProcessing = true;
        errorMessage = null;

        try
        {
            var user = await UserManager.FindByEmailAsync(Input.Email);

            // Always show success (prevent email enumeration). Only require a confirmed
            // email when the instance enforces verification — otherwise users created
            // unconfirmed (verification off) could never reset.
            var requireVerification = InstanceSettingsService.Load().RequireEmailVerification;
            if (user != null && (!requireVerification || await UserManager.IsEmailConfirmedAsync(user)))
            {
                // Generate password reset token
                var code = await UserManager.GeneratePasswordResetTokenAsync(user);
                code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

                // Build reset URL
                var callbackUrl = NavigationManager.ToAbsoluteUri(
                    $"/Account/ResetPassword?code={code}").ToString();

                // Send email
                var instanceName = InstanceSettingsService.Load().InstanceName;
                await EmailSender.SendEmailAsync(
                    Input.Email,
                    IndxCloudApi.Services.EmailTemplates.Subject(instanceName, "Reset your password"),
                    IndxCloudApi.Services.EmailTemplates.ResetPassword(instanceName, callbackUrl));

                Logger.LogInformation("Password reset email sent to {Email}", Input.Email);
            }
            else
            {
                // User doesn't exist or email not confirmed - but we don't tell them
                Logger.LogWarning("Password reset requested for non-existent or unconfirmed email: {Email}", Input.Email);
            }

            // Show success message (security best practice - always show success)
            emailSent = true;
            isProcessing = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing forgot password request");
            errorMessage = "An error occurred while processing your request. Please try again.";
            isProcessing = false;
        }
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
