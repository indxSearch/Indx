@page "/admin/observr"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using IndxServer.Engine
@using IndxServer.Services
@using IndxServer.Services.Observr
@attribute [Authorize(Roles = "Admin")]
@inject ObservrSubscription Subscription
@inject ObservrFindingStore Findings
@inject ObservrClient Observr
@inject TeamService TeamService

<PageTitle>Admin — Observr</PageTitle>

<AdminNav Active="Observr" />

<div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
    <div>
        <h2 style="margin-bottom: 4px;">Observr</h2>
        <p style="color: var(--lv5); margin: 0;">
            Indx's agent for search owners: it reads a weekly summary of a dataset's statistics every day, puts what is worth
            attention in the Observr menu, and answers from the Statistics, Fields and Synonyms tabs. Never a record, never a visitor.
        </p>
    </div>
</div>

@* ── The subscription: what the licence portal says about this instance's token. ── *@
<div style="max-width: 720px; margin-bottom: 32px;">
    <h3>Subscription</h3>
    @if (!Observr.HasToken)
    {
        <p style="color: var(--lv5);">This instance has no licence token, so it cannot reach Observr. Add one under <a href="/admin/license">License</a>.</p>
    }
    else if (!_state.Known)
    {
        <p style="display:flex; align-items:center; gap:8px; color:var(--lv5);"><Spinner Size="14" /> Asking the licence portal…</p>
    }
    else if (_state.Tier == "Internal")
    {
        <p style="color: var(--lv6); margin: 0 0 8px;">This instance uses an Observr token of its own (<code>Indx:Observr:Token</code>), which Observr trusts by configuration. No licence is checked.</p>
    }
    else if (_state.Included)
    {
        <p style="color: var(--lv6); margin: 0 0 8px;">
            Observr is part of this licence: <strong>@_state.Tier</strong>@(string.IsNullOrEmpty(_state.LicensedTo) ? "" : $", {_state.LicensedTo}").
            <span style="color: var(--lv5);">Checked <TimeAgo Value="_state.CheckedUtc!.Value" />.</span>
        </p>
    }
    else
    {
        <p style="color: var(--lv6); margin: 0 0 8px;">
            @(_state.Reason switch
            {
                "unknownToken" => "The licence portal does not recognise this instance's token. Check it under License.",
                "expired" => "This licence has expired, so Observr is not included. Renew it to switch Observr on.",
                _ => "Observr is part of the Pro and Enterprise subscriptions. This instance's licence does not include it, so nothing of Observr is shown to its users.",
            })
            <span style="color: var(--lv5);">Checked <TimeAgo Value="_state.CheckedUtc!.Value" />.</span>
        </p>
    }
    @if (Observr.HasToken && _state.Tier != "Internal")
    {
        <Button Variant="ghost" Size="micro" IconLeft="DatasetIcons.Restore" Loading="@_checking" @onclick="CheckAsync">Check again</Button>
    }
</div>

@* ── Which datasets Observr is on for: opt-in per dataset, since a setup holds test copies nobody
   should be asked about. The buttons in a dataset's tabs show only where this is on. ── *@
@if (_state.Included)
{
    <h3>Datasets</h3>
    <p style="color: var(--lv5); margin: 0 0 16px;">
        Switch Observr on per dataset. A dataset with it on gets its summary sent every morning (@_digestHour:00 UTC) and
        the Ask Observr, Review my setup and Suggest synonyms buttons in its tabs. Each ask counts against the licence's
        daily allowance.
    </p>
    @if (_rows == null)
    {
        <p style="display:flex; align-items:center; gap:8px; color:var(--lv5);"><Spinner Size="14" /> Loading datasets…</p>
    }
    else if (_rows.Count == 0)
    {
        <p style="color: var(--lv5);">No datasets yet.</p>
    }
    else
    {
        <Table Scrollable StickyFirstColumn BleedEnd="var(--page-gutter)" AriaLabel="Observr per dataset">
            <thead>
                <tr><th scope="col">Dataset</th><th scope="col">Team</th><th scope="col">Observr</th><th scope="col" style="text-align:right;">Open findings</th><th scope="col"></th></tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td style="color: var(--lv6);">@row.DataSetName</td>
                        <td style="color: var(--lv5);">@(row.TeamName ?? row.TeamId)</td>
                        <td><ToggleSwitch Checked="row.Enabled" CheckedChanged="on => SetEnabled(row, on)" Label="@(row.Enabled ? "On" : "Off")" /></td>
                        <td style="text-align:right; color: var(--lv5); font-variant-numeric: tabular-nums;">@row.OpenFindings</td>
                        <td style="text-align:right;">
                            @if (row.Enabled) { <ObservrDigestButton TeamId="@row.TeamId" DatasetName="@row.DataSetName" /> }
                        </td>
                    </tr>
                }
            </tbody>
        </Table>
    }
}

@code {
    private sealed record Row(string DataSetName, string TeamId, string? TeamName, bool Enabled, int OpenFindings);

    private ObservrSubscriptionState _state = ObservrSubscriptionState.Unknown;
    private List<Row>? _rows;
    private bool _checking;
    private int _digestHour;

    [Inject] private IConfiguration Configuration { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _digestHour = Math.Clamp(Configuration.GetValue<int?>("Indx:Observr:DigestHourUtc") ?? 5, 0, 23);
        _state = await Subscription.GetAsync();
        if (_state.Included) await LoadAsync();
    }

    private async Task CheckAsync()
    {
        _checking = true;
        try
        {
            _state = await Subscription.GetAsync(force: true);
            if (_state.Included && _rows == null) await LoadAsync();
        }
        finally { _checking = false; }
    }

    private async Task LoadAsync()
    {
        var teams = (await TeamService.GetAllAsync()).ToDictionary(t => t.Id.ToString(), t => t.Name);
        // Rows from the registry's list and the finding store only: never through GetState, which
        // would load a sleeping dataset (see Admin/Datasets.razor).
        var all = IndxServerInternalApi.Manager.GetAllDataSets();
        _rows = await Task.Run(() => all
            .Select(d => new Row(d.DataSetName, d.TeamId, teams.GetValueOrDefault(d.TeamId), Findings.IsEnabled(d.TeamId, d.DataSetName),
                Findings.ListForDataset(d.TeamId, d.DataSetName, 50).Count(f => f.Status == ObservrFinding.Open)))
            .OrderByDescending(r => r.Enabled).ThenBy(r => r.TeamName ?? r.TeamId).ThenBy(r => r.DataSetName).ToList());
    }

    private void SetEnabled(Row row, bool on)
    {
        Findings.SetEnabled(row.TeamId, row.DataSetName, on);
        if (_rows != null) _rows[_rows.IndexOf(row)] = row with { Enabled = on };
    }
}
