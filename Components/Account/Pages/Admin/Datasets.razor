@page "/Admin/Datasets"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using IndxCloudApi.Data
@using IndxCloudApi.Models
@attribute [Authorize(Roles = "Admin")]
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Datasets> Logger

<PageTitle>Admin — Datasets</PageTitle>

<div style="display: flex; gap: 8px; margin-bottom: 40px; border-bottom: 1px solid var(--lv2); padding-bottom: 0;">
    <a href="/Admin/Users" style="padding: 8px 14px; font-size: 13px; font-weight: 500; color: var(--lv5); text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px;">Users</a>
    <a href="/Admin/Datasets" style="padding: 8px 14px; font-size: 13px; font-weight: 500; color: var(--lv6); text-decoration: none; border-bottom: 2px solid var(--lv6); margin-bottom: -1px;">Datasets</a>
    <a href="/Admin/Settings" style="padding: 8px 14px; font-size: 13px; font-weight: 500; color: var(--lv5); text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px;">Settings</a>
</div>

<div style="display: flex; align-items: center; gap: 16px; margin-bottom: 40px;">
    <div>
        <h2 style="margin-bottom: 4px;">Datasets</h2>
        <p style="color: var(--lv5);">All datasets across all users.</p>
    </div>
    <Button Variant="ghost" Size="micro" IconLeft="_iconRefresh" style="margin-left: auto;" @onclick="Load">Refresh</Button>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div style="padding: 14px 18px; border: 1px solid var(--CTeal); border-radius: var(--radius); background: rgba(114,245,198,0.08); margin-bottom: 24px;">
        @_message
    </div>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div style="padding: 14px 18px; border: 1px solid var(--CSignal); border-radius: var(--radius); background: rgba(255,66,56,0.08); margin-bottom: 24px;">
        @_errorMessage
    </div>
}

@if (_rows == null)
{
    <p>Loading...</p>
}
else if (_rows.Count == 0)
{
    <p style="color: var(--lv5);">No datasets found.</p>
}
else
{
    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
        <thead>
            <tr style="border-bottom: 1px solid var(--lv3); color: var(--lv5);">
                <th style="text-align: left; padding: 8px 12px; font-weight: 500;">Dataset</th>
                <th style="text-align: left; padding: 8px 12px; font-weight: 500;">Owner</th>
                <th style="padding: 8px 12px; font-weight: 500;">Shared with</th>
                <th style="padding: 8px 12px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr style="border-bottom: 1px solid var(--lv2);">
                    <td style="padding: 10px 12px; color: var(--lv6); font-family: monospace;">@row.DataSetName</td>
                    <td style="padding: 10px 12px; color: var(--lv5);">@(row.OwnerEmail ?? row.OwnerId)</td>
                    <td style="padding: 10px 12px; text-align: center; color: var(--lv5);">
                        @if (row.AccessCount > 0)
                        {
                            <IndxCloudApi.Components.Systm.Chip Color="var(--lv2)" TextColor="var(--lv5)">@row.AccessCount</IndxCloudApi.Components.Systm.Chip>
                        }
                        else
                        {
                            <span style="color: var(--lv3);">—</span>
                        }
                    </td>
                    <td style="padding: 10px 12px; text-align: right; display: flex; gap: 6px; justify-content: flex-end;">
                        @if (_deleteConfirmKey == row.Key)
                        {
                            <Button Variant="danger" Size="micro" @onclick="() => DeleteDataset(row.DataSetName, row.OwnerId)">Confirm Delete</Button>
                            <Button Variant="ghost" Size="micro" @onclick="() => _deleteConfirmKey = null">Cancel</Button>
                        }
                        else
                        {
                            <Button Variant="ghost" Size="micro" IconLeft="_iconDelete" @onclick="() => _deleteConfirmKey = row.Key" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private RenderFragment<int> _iconDelete  => size => @<UserX Size="size" />;
    private RenderFragment<int> _iconRefresh => size => @<Refresh Size="size" />;

    private record DatasetRow(string DataSetName, string OwnerId, string? OwnerEmail, int AccessCount)
    {
        public string Key => $"{OwnerId}/{DataSetName}";
    }

    private List<DatasetRow>? _rows;
    private string? _message;
    private string? _errorMessage;
    private string? _deleteConfirmKey;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        var userMap = await Task.Run(() =>
            UserManager.Users.ToDictionary(u => u.Id, u => u.Email));

        var all = IndxCloudInternalApi.Manager.GetAllDataSets();
        var rows = all.Select(r =>
        {
            var email = userMap.GetValueOrDefault(r.UserId);
            return new DatasetRow(r.DataSetName, r.UserId, email, r.AccessCount);
        });
        _rows = [.. rows.OrderBy(r => r.OwnerEmail ?? r.OwnerId).ThenBy(r => r.DataSetName)];
    }

    private async Task DeleteDataset(string dataSetName, string ownerId)
    {
        _message = null; _errorMessage = null;
        _deleteConfirmKey = null;
        var deleted = IndxCloudInternalApi.Manager.DeleteDataSet(dataSetName, ownerId);
        if (deleted)
        {
            Logger.LogInformation("Admin deleted dataset {DataSetName} owned by {OwnerId}", dataSetName, ownerId);
            _message = $"Dataset \"{dataSetName}\" deleted.";
            await Load();
        }
        else
        {
            _errorMessage = $"Could not delete \"{dataSetName}\" — it may have already been removed.";
        }
    }
}
