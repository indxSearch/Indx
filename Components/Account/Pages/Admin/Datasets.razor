@page "/admin/datasets"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using IndxServer.Data
@using IndxServer.Models
@using IndxServer.Engine
@using Indx.Api
@attribute [Authorize(Roles = "Admin")]
@inject UserManager<ApplicationUser> UserManager
@inject IndxServer.Services.TeamService TeamService
@inject ILogger<Datasets> Logger

<PageTitle>Admin — Datasets</PageTitle>



<div style="display: flex; align-items: center; gap: 16px; margin-bottom: 40px;">
    <div>
        <h2 style="margin-bottom: 4px;">Datasets</h2>
        <p style="color: var(--lv5);">All datasets across all teams.</p>
    </div>
    <Button Variant="ghost" Size="micro" IconLeft="_iconRefresh" style="margin-left: auto;" Loading="@_loading" @onclick="Load">Refresh</Button>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div style="padding: 14px 18px; border: 1px solid var(--CTeal); border-radius: var(--radius); background: rgba(114,245,198,0.08); margin-bottom: 24px;">
        @_message
    </div>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div style="padding: 14px 18px; border: 1px solid var(--CSignal); border-radius: var(--radius); background: rgba(255,66,56,0.08); margin-bottom: 24px;">
        @_errorMessage
    </div>
}

@if (_rows == null)
{
    <p style="display:flex; align-items:center; gap:8px; color:var(--lv5);"><Spinner Size="14" /> Loading datasets…</p>
}
else if (_rows.Count == 0)
{
    <p style="color: var(--lv5);">No datasets found.</p>
}
else
{
    @* Documents by dataset, the largest four and the rest: what the instance holds, read from the
       store, so a hibernated dataset counts too. Moved here from Monitor on 25 Oct 2026: it is
       about the datasets, not about how the instance is doing right now. *@
    @if (_rows.Any(r => r.RecordCount > 0))
    {
        <div class="admin-datasets-docs">
            <span class="admin-datasets-docs-title">Documents by dataset</span>
            <BarMeter Segments="DocumentsByDataset()" Labels="legend" Format="@(v => v.ToString("N0"))" />
        </div>
    }

    @* systm Table: seven columns do not fit a phone, so the table scrolls inside its own frame
       with the dataset name pinned, and reaches the right edge of the screen while it does. *@
    @* Carries the scope attribute that Datasets.razor.css's ::deep rules need above the table;
   systm Table's own wrapper does not have it, so without this the stylesheet matches nothing. *@
<div class="admin-datasets-table-wrap">
<Table Scrollable StickyFirstColumn BleedEnd="var(--page-gutter)" AriaLabel="All datasets" Class="admin-datasets-table">
        <thead>
            <tr>
                <th scope="col">Dataset</th>
                <th scope="col">Team</th>
                <th scope="col">State</th>
                <th scope="col" style="text-align: right;">Documents</th>
                <th scope="col">Last indexed</th>
                <th scope="col">Keep-alive</th>
                <th scope="col" aria-label="Actions"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr>
                    <td style="color: var(--lv6); font-family: var(--font-mono);">@row.DataSetName</td>
                    <td style="color: var(--lv5);">@(row.TeamName ?? row.TeamId)</td>
                    <td>
                        @if (row.Unknown)
                        {
                            <span style="color: var(--lv4);">—</span>
                        }
                        else if (row.Hibernated)
                        {
                            var chip = DatasetStateChip.Hibernated;
                            <Chip Size="large" Color="@chip.Color" TextColor="@chip.TextColor" Icon="@chip.Icon">Hibernated</Chip>
                        }
                        else
                        {
                            var chip = DatasetStateChip.For(row.State!.Value);
                            <Chip Size="large" Color="@chip.Color" TextColor="@chip.TextColor" Icon="@chip.Icon">@row.State.Value.ToString()</Chip>
                        }
                    </td>
                    <td style="text-align: right; color: var(--lv5); font-variant-numeric: tabular-nums;">
                        @(row.Unknown ? "—" : row.DisplayCount.ToString("N0"))
                    </td>
                    <td style="color: var(--lv5);">
                        <TimeAgo Value="row.LastIndexed" TooltipPosition="left" />
                    </td>
                    <td style="color: var(--lv5);">
                        @if (_editKey == row.Key)
                        {
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <div style="width: 190px;">
                                    <SelectField @bind-Value="_editMode" Options="_keepAliveModes" />
                                </div>
                                @if (_editMode == "timed")
                                {
                                    <div style="width: 72px;">
                                        <InputField @bind-Value="_editHours" placeholder="hours" />
                                    </div>
                                }
                                <Button Variant="primary" Size="micro" Loading="@_saving" @onclick="() => SaveKeepAlive(row.DataSetName, row.TeamId)">Save</Button>
                                <Button Variant="ghost" Size="micro" Disabled="@_saving" @onclick="() => _editKey = null">Cancel</Button>
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="font-variant-numeric: tabular-nums;">@KeepAliveLabel(row.KeepAliveTimeHrs)</span>
                                <span style="color: var(--lv4); font-size: 12px;">@RemainingLabel(row)</span>
                                <Button Variant="ghost" Size="micro" @onclick="() => BeginEdit(row)">Edit</Button>
                            </div>
                        }
                    </td>
                    <td style="text-align: right;">
                        <Button Variant="ghost" Size="micro" IconLeft="_iconDelete" title="Delete dataset" @onclick="() => { _deleting = row; _deleteOpen = true; }" />
                    </td>
                </tr>
            }
        </tbody>
    </Table>
</div>
}

<ConfirmModal @bind-Open="_deleteOpen" Title="@($"Delete {_deleting?.DataSetName}?")" Consequences="DeleteLines"
              TypeToConfirm="@_deleting?.DataSetName" ConfirmLabel="Delete dataset" ConfirmIcon="_iconDelete" OnConfirm="ConfirmDeleteDataset" />

@code {
    private RenderFragment<int> _iconDelete  => size => @<Delete Size="size" />;
    private RenderFragment<int> _iconRefresh => size => @<Refresh Size="size" />;

    private record DatasetRow(
        string DataSetName, string TeamId, string? TeamName,
        SystemState? State, int DocumentCount, DateTime? LastIndexed,
        int KeepAliveTimeHrs, bool Loaded, TimeSpan? Remaining, int RecordCount)
    {
        public string Key => $"{TeamId}/{DataSetName}";

        /// <summary>
        /// What the admin should see. The raw engine state says "Created" (or the engine
        /// is not instantiated at all) for a dataset whose documents live in indx.db with
        /// no index in memory - which is hibernation, not an empty dataset. The one shared
        /// sentence: Created (or no instance) with records on disk means hibernated.
        /// </summary>
        public bool Hibernated => (State is null or SystemState.Created) && RecordCount > 0;

        /// <summary>Nothing to show: no engine and nothing persisted either.</summary>
        public bool Unknown => State is null && !Hibernated;

        /// <summary>In-memory count when serving; persisted count when hibernated.</summary>
        public int DisplayCount => Hibernated ? RecordCount : DocumentCount;
    }

    private static string KeepAliveLabel(int hrs) => hrs switch
    {
        int.MaxValue => "∞ pinned",
        0 => "Off (manual)",
        _ => $"{hrs} h",
    };

    private static string RemainingLabel(DatasetRow row)
    {
        if (row.KeepAliveTimeHrs is int.MaxValue or 0)
            return "";
        if (!row.Loaded)
            return "(not loaded)";
        if (row.Remaining is { } rem)
            return rem.TotalHours >= 1 ? $"~{(int)rem.TotalHours}h {rem.Minutes}m left" : $"~{rem.Minutes}m left";
        return "";
    }

    private List<DatasetRow>? _rows;
    private string? _message;
    private string? _errorMessage;
    private bool _deleteOpen;
    private DatasetRow? _deleting;

    private IReadOnlyList<string> DeleteLines => _deleting is not { } row ? [] :
    [
        row.DisplayCount > 0
            ? $"Its {row.DisplayCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)} documents are deleted, with its field configuration, boost rules and synonyms."
            : "It is deleted, with its field configuration, boost rules and synonyms.",
        $"It belongs to {row.TeamName ?? "a team"}. Its members lose it, and websites and apps that search it get errors.",
        "API keys limited to this dataset no longer reach anything.",
        "This can't be undone.",
    ];

    /// <summary>Null on success, else the reason, shown in the modal.</summary>
    private async Task<string?> ConfirmDeleteDataset()
    {
        if (_deleting == null) return null;
        await DeleteDataset(_deleting.DataSetName, _deleting.TeamId);
        var error = _errorMessage;
        _errorMessage = null;
        return error;
    }
    private string? _editKey;
    private string _editMode = "max";   // "max" (∞ pinned) | "0" (manual) | "timed"
    private string _editHours = "24";

    private static readonly IEnumerable<SelectField.SelectOption> _keepAliveModes =
    [
        new("∞ Pinned — always loaded", "max"),
        new("Off — client-managed", "0"),
        new("Timed — idle eviction", "timed"),
    ];

    protected override async Task OnInitializedAsync() => await Load();

    // Refresh keeps the rows it has and shows the work on its button: the list only says
    // "Loading datasets…" the first time, and a reload is a COUNT(*) per dataset.
    private bool _loading, _saving;

    private async Task Load()
    {
        _loading = true;
        try { await LoadRows(); }
        finally { _loading = false; }
    }

    private async Task LoadRows()
    {
        // Owner keys are team ids; map them to team names for display.
        var teamMap = (await TeamService.GetAllAsync())
            .ToDictionary(t => t.Id.ToString(), t => t.Name);

        var all = IndxServerInternalApi.Manager.GetAllDataSets();
        // Off the circuit thread: the record count is a COUNT(*) per dataset, and this page must
        // never call GetState — that goes through ResolveEngine, which auto-loads a hibernated
        // timed/pinned dataset, so listing the admin page used to load and index every dataset
        // on disk before it could render. FindSearchEngine reads what is in memory only.
        var rows = await Task.Run(() => all.Select(r =>
        {
            var engine = IndxServerInternalApi.Manager.FindSearchEngine(r.DataSetName, r.TeamId);
            var status = engine is { IsDisposed: false } ? engine.Status : null;
            var ka = IndxServerInternalApi.Manager.GetKeepAliveInfo(r.DataSetName, r.TeamId);
            return new DatasetRow(
                r.DataSetName, r.TeamId, teamMap.GetValueOrDefault(r.TeamId),
                status?.SystemState, status?.DocumentCount ?? 0, status?.TimeOfLastIndexBuild,
                ka.KeepAliveTimeHrs, ka.Ready, ka.Remaining, ka.RecordCount);
        }).ToList());
        _rows = [.. rows.OrderBy(r => r.TeamName ?? r.TeamId).ThenBy(r => r.DataSetName)];
    }

    /// <summary>The largest four datasets by stored documents, the rest as one segment. A name may
    /// recur in another team, so a repeated one says whose it is.</summary>
    private List<BarMeter.Segment> DocumentsByDataset()
    {
        var rows = _rows!.Where(r => r.RecordCount > 0).OrderByDescending(r => r.RecordCount).ToList();
        var repeated = rows.GroupBy(r => r.DataSetName).Where(g => g.Count() > 1).Select(g => g.Key).ToHashSet();
        var top = rows.Take(4).Select(r => new BarMeter.Segment(
            repeated.Contains(r.DataSetName) ? $"{r.DataSetName} ({r.TeamName ?? r.TeamId})" : r.DataSetName, r.RecordCount)).ToList();
        var rest = rows.Skip(4).Sum(r => (double)r.RecordCount);
        if (rest > 0) top.Add(new("Others", rest));
        return top;
    }

    private void BeginEdit(DatasetRow row)
    {
        _message = null; _errorMessage = null;
        _editKey = row.Key;
        (_editMode, _editHours) = row.KeepAliveTimeHrs switch
        {
            int.MaxValue => ("max", "24"),
            0 => ("0", "24"),
            var h => ("timed", h.ToString()),
        };
    }

    private async Task SaveKeepAlive(string dataSetName, string teamId)
    {
        _message = null; _errorMessage = null;

        int hrs;
        switch (_editMode)
        {
            case "max": hrs = int.MaxValue; break;
            case "0": hrs = 0; break;
            default:
                if (!int.TryParse((_editHours ?? "").Trim(), out hrs) || hrs < 1)
                {
                    _errorMessage = $"\"{_editHours}\" is not a valid number of hours — enter a whole number of 1 or more.";
                    return;
                }
                break;
        }

        _saving = true;
        try
        {
            var ok = await Task.Run(() => IndxServerInternalApi.Manager.SetKeepAliveHrs(dataSetName, teamId, hrs));
            if (ok)
            {
                Logger.LogInformation("Admin set KeepAliveTimeHrs={Hrs} for dataset {DataSetName} team {TeamId}", hrs, dataSetName, teamId);
                _message = $"Keep-alive for \"{dataSetName}\" set to {KeepAliveLabel(hrs)}.";
                await Load();
                _editKey = null;
            }
            else
            {
                _errorMessage = $"Could not update keep-alive for \"{dataSetName}\".";
            }
        }
        finally { _saving = false; }
    }

    private async Task DeleteDataset(string dataSetName, string teamId)
    {
        _message = null; _errorMessage = null;
        // Engine disposal can take seconds; off the circuit, or the spinner cannot paint.
        var deleted = await Task.Run(() => IndxServerInternalApi.Manager.DeleteDataSet(dataSetName, teamId));
        if (deleted)
        {
            Logger.LogInformation("Admin deleted dataset {DataSetName} of team {Team}", dataSetName,
                _rows?.FirstOrDefault(r => r.TeamId == teamId)?.TeamName ?? "an unknown team");
            _message = $"Dataset \"{dataSetName}\" deleted.";
            await Load();
        }
        else
        {
            _errorMessage = $"Could not delete \"{dataSetName}\" — it may have already been removed.";
        }
    }
}
