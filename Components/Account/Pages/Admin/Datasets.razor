@page "/admin/datasets"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using IndxServer.Data
@using IndxServer.Models
@using Indx.Api
@attribute [Authorize(Roles = "Admin")]
@inject UserManager<ApplicationUser> UserManager
@inject IndxServer.Services.TeamService TeamService
@inject ILogger<Datasets> Logger

<PageTitle>Admin — Datasets</PageTitle>


<AdminNav Active="Datasets" />

<div style="display: flex; align-items: center; gap: 16px; margin-bottom: 40px;">
    <div>
        <h2 style="margin-bottom: 4px;">Datasets</h2>
        <p style="color: var(--lv5);">All datasets across all teams.</p>
    </div>
    <Button Variant="ghost" Size="micro" IconLeft="_iconRefresh" style="margin-left: auto;" @onclick="Load">Refresh</Button>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div style="padding: 14px 18px; border: 1px solid var(--CTeal); border-radius: var(--radius); background: rgba(114,245,198,0.08); margin-bottom: 24px;">
        @_message
    </div>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div style="padding: 14px 18px; border: 1px solid var(--CSignal); border-radius: var(--radius); background: rgba(255,66,56,0.08); margin-bottom: 24px;">
        @_errorMessage
    </div>
}

@if (_rows == null)
{
    <p style="display:flex; align-items:center; gap:8px; color:var(--lv5);"><Spinner Size="14" /> Loading datasets…</p>
}
else if (_rows.Count == 0)
{
    <p style="color: var(--lv5);">No datasets found.</p>
}
else
{
    @* systm Table: seven columns do not fit a phone, so the table scrolls inside its own frame
       with the dataset name pinned, and reaches the right edge of the screen while it does. *@
    <Table Scrollable StickyFirstColumn BleedEnd="var(--page-gutter)" AriaLabel="All datasets" Class="admin-datasets-table">
        <thead>
            <tr>
                <th scope="col">Dataset</th>
                <th scope="col">Team</th>
                <th scope="col">State</th>
                <th scope="col" style="text-align: right;">Documents</th>
                <th scope="col">Last indexed</th>
                <th scope="col">Keep-alive</th>
                <th scope="col" aria-label="Actions"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr>
                    <td style="color: var(--lv6); font-family: monospace;">@row.DataSetName</td>
                    <td style="color: var(--lv5);">@(row.TeamName ?? row.TeamId)</td>
                    <td>
                        @if (row.DisplayState is null)
                        {
                            <span style="color: var(--lv4);">—</span>
                        }
                        else
                        {
                            var chip = DatasetStateChip.For(row.DisplayState.Value);
                            <Chip Size="large" Color="@chip.Color" TextColor="@chip.TextColor" Icon="@chip.Icon">@row.DisplayState.Value.ToString()</Chip>
                        }
                    </td>
                    <td style="text-align: right; color: var(--lv5); font-variant-numeric: tabular-nums;">
                        @(row.DisplayState is null ? "—" : row.DisplayCount.ToString("N0"))
                    </td>
                    <td style="color: var(--lv5);">
                        <TimeAgo Value="row.LastIndexed" TooltipPosition="left" />
                    </td>
                    <td style="color: var(--lv5);">
                        @if (_editKey == row.Key)
                        {
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <div style="width: 190px;">
                                    <SelectField @bind-Value="_editMode" Options="_keepAliveModes" />
                                </div>
                                @if (_editMode == "timed")
                                {
                                    <div style="width: 72px;">
                                        <InputField @bind-Value="_editHours" placeholder="hours" />
                                    </div>
                                }
                                <Button Variant="primary" Size="micro" @onclick="() => SaveKeepAlive(row.DataSetName, row.TeamId)">Save</Button>
                                <Button Variant="ghost" Size="micro" @onclick="() => _editKey = null">Cancel</Button>
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="font-variant-numeric: tabular-nums;">@KeepAliveLabel(row.KeepAliveTimeHrs)</span>
                                <span style="color: var(--lv4); font-size: 12px;">@RemainingLabel(row)</span>
                                <Button Variant="ghost" Size="micro" @onclick="() => BeginEdit(row)">Edit</Button>
                            </div>
                        }
                    </td>
                    <td style="text-align: right;">
                        <ConfirmButton Label="" Title="Delete dataset" Icon="_iconDelete" ConfirmLabel="Confirm Delete" CancelVariant="ghost"
                                       Open="@(_deleteConfirmKey == row.Key)" OpenChanged="v => _deleteConfirmKey = v ? row.Key : null"
                                       OnConfirm="() => DeleteDataset(row.DataSetName, row.TeamId)" />
                    </td>
                </tr>
            }
        </tbody>
    </Table>
}

@code {
    private RenderFragment<int> _iconDelete  => size => @<Delete Size="size" />;
    private RenderFragment<int> _iconRefresh => size => @<Refresh Size="size" />;

    private record DatasetRow(
        string DataSetName, string TeamId, string? TeamName,
        SystemState? State, int DocumentCount, DateTime? LastIndexed,
        int KeepAliveTimeHrs, bool Loaded, TimeSpan? Remaining, int RecordCount)
    {
        public string Key => $"{TeamId}/{DataSetName}";

        /// <summary>
        /// What the admin should see. The raw engine state says "Created" (or the engine
        /// is not instantiated at all) for a dataset whose documents live in indx.db with
        /// no index in memory - which is hibernation, not an empty dataset. Same inference
        /// the user dashboard makes (Index.razor: Created + records on disk = hibernated).
        /// </summary>
        public SystemState? DisplayState =>
            (State is null or SystemState.Created) && RecordCount > 0
                ? SystemState.Hibernated
                : State;

        /// <summary>In-memory count when serving; persisted count when hibernated.</summary>
        public int DisplayCount => DisplayState == SystemState.Hibernated ? RecordCount : DocumentCount;
    }

    private static string KeepAliveLabel(int hrs) => hrs switch
    {
        int.MaxValue => "∞ pinned",
        0 => "Off (manual)",
        _ => $"{hrs} h",
    };

    private static string RemainingLabel(DatasetRow row)
    {
        if (row.KeepAliveTimeHrs is int.MaxValue or 0)
            return "";
        if (!row.Loaded)
            return "(not loaded)";
        if (row.Remaining is { } rem)
            return rem.TotalHours >= 1 ? $"~{(int)rem.TotalHours}h {rem.Minutes}m left" : $"~{rem.Minutes}m left";
        return "";
    }

    private List<DatasetRow>? _rows;
    private string? _message;
    private string? _errorMessage;
    private string? _deleteConfirmKey;
    private string? _editKey;
    private string _editMode = "max";   // "max" (∞ pinned) | "0" (manual) | "timed"
    private string _editHours = "24";

    private static readonly IEnumerable<SelectField.SelectOption> _keepAliveModes =
    [
        new("∞ Pinned — always loaded", "max"),
        new("Off — client-managed", "0"),
        new("Timed — idle eviction", "timed"),
    ];

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        // Owner keys are team ids; map them to team names for display.
        var teamMap = (await TeamService.GetAllAsync())
            .ToDictionary(t => t.Id.ToString(), t => t.Name);

        var all = IndxServerInternalApi.Manager.GetAllDataSets();
        // Off the circuit thread: the record count is a COUNT(*) per dataset, and this page must
        // never call GetState — that goes through ResolveEngine, which auto-loads a hibernated
        // timed/pinned dataset, so listing the admin page used to load and index every dataset
        // on disk before it could render. FindSearchEngine reads what is in memory only.
        var rows = await Task.Run(() => all.Select(r =>
        {
            var engine = IndxServerInternalApi.Manager.FindSearchEngine(r.DataSetName, r.TeamId);
            var status = engine is { IsDisposed: false } ? engine.Status : null;
            var ka = IndxServerInternalApi.Manager.GetKeepAliveInfo(r.DataSetName, r.TeamId);
            return new DatasetRow(
                r.DataSetName, r.TeamId, teamMap.GetValueOrDefault(r.TeamId),
                status?.SystemState, status?.DocumentCount ?? 0, status?.TimeOfLastIndexBuild,
                ka.KeepAliveTimeHrs, ka.Ready, ka.Remaining, ka.RecordCount);
        }).ToList());
        _rows = [.. rows.OrderBy(r => r.TeamName ?? r.TeamId).ThenBy(r => r.DataSetName)];
    }

    private void BeginEdit(DatasetRow row)
    {
        _message = null; _errorMessage = null;
        _editKey = row.Key;
        (_editMode, _editHours) = row.KeepAliveTimeHrs switch
        {
            int.MaxValue => ("max", "24"),
            0 => ("0", "24"),
            var h => ("timed", h.ToString()),
        };
    }

    private async Task SaveKeepAlive(string dataSetName, string teamId)
    {
        _message = null; _errorMessage = null;

        int hrs;
        switch (_editMode)
        {
            case "max": hrs = int.MaxValue; break;
            case "0": hrs = 0; break;
            default:
                if (!int.TryParse((_editHours ?? "").Trim(), out hrs) || hrs < 1)
                {
                    _errorMessage = $"\"{_editHours}\" is not a valid number of hours — enter a whole number of 1 or more.";
                    return;
                }
                break;
        }

        var ok = IndxServerInternalApi.Manager.SetKeepAliveHrs(dataSetName, teamId, hrs);
        if (ok)
        {
            Logger.LogInformation("Admin set KeepAliveTimeHrs={Hrs} for dataset {DataSetName} team {TeamId}", hrs, dataSetName, teamId);
            _message = $"Keep-alive for \"{dataSetName}\" set to {KeepAliveLabel(hrs)}.";
            _editKey = null;
            await Load();
        }
        else
        {
            _errorMessage = $"Could not update keep-alive for \"{dataSetName}\".";
        }
    }

    private async Task DeleteDataset(string dataSetName, string teamId)
    {
        _message = null; _errorMessage = null;
        // Engine disposal can take seconds; off the circuit, or the spinner cannot paint.
        var deleted = await Task.Run(() => IndxServerInternalApi.Manager.DeleteDataSet(dataSetName, teamId));
        _deleteConfirmKey = null;
        if (deleted)
        {
            Logger.LogInformation("Admin deleted dataset {DataSetName} owned by team {TeamId}", dataSetName, teamId);
            _message = $"Dataset \"{dataSetName}\" deleted.";
            await Load();
        }
        else
        {
            _errorMessage = $"Could not delete \"{dataSetName}\" — it may have already been removed.";
        }
    }
}
