@page "/Admin/Datasets"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using IndxCloudApi.Data
@using IndxCloudApi.Models
@using Indx.Api
@attribute [Authorize(Roles = "Admin")]
@inject UserManager<ApplicationUser> UserManager
@inject IndxCloudApi.Services.TeamService TeamService
@inject ILogger<Datasets> Logger

<PageTitle>Admin — Datasets</PageTitle>


<AdminNav Active="Datasets" />

<div style="display: flex; align-items: center; gap: 16px; margin-bottom: 40px;">
    <div>
        <h2 style="margin-bottom: 4px;">Datasets</h2>
        <p style="color: var(--lv5);">All datasets across all teams.</p>
    </div>
    <Button Variant="ghost" Size="micro" IconLeft="_iconRefresh" style="margin-left: auto;" @onclick="Load">Refresh</Button>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div style="padding: 14px 18px; border: 1px solid var(--CTeal); border-radius: var(--radius); background: rgba(114,245,198,0.08); margin-bottom: 24px;">
        @_message
    </div>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div style="padding: 14px 18px; border: 1px solid var(--CSignal); border-radius: var(--radius); background: rgba(255,66,56,0.08); margin-bottom: 24px;">
        @_errorMessage
    </div>
}

@if (_rows == null)
{
    <p>Loading...</p>
}
else if (_rows.Count == 0)
{
    <p style="color: var(--lv5);">No datasets found.</p>
}
else
{
    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
        <thead>
            <tr style="border-bottom: 1px solid var(--lv3); color: var(--lv5);">
                <th style="text-align: left; padding: 8px 12px; font-weight: 500;">Dataset</th>
                <th style="text-align: left; padding: 8px 12px; font-weight: 500;">Team</th>
                <th style="text-align: left; padding: 8px 12px; font-weight: 500;">State</th>
                <th style="text-align: right; padding: 8px 12px; font-weight: 500;">Documents</th>
                <th style="text-align: left; padding: 8px 12px; font-weight: 500;">Last indexed</th>
                <th style="text-align: left; padding: 8px 12px; font-weight: 500;">Keep-alive</th>
                <th style="padding: 8px 12px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr style="border-bottom: 1px solid var(--lv2);">
                    <td style="padding: 10px 12px; color: var(--lv6); font-family: monospace;">@row.DataSetName</td>
                    <td style="padding: 10px 12px; color: var(--lv5);">@(row.TeamName ?? row.TeamId)</td>
                    <td style="padding: 10px 12px;">
                        @if (row.State is null)
                        {
                            <span style="color: var(--lv4);">—</span>
                        }
                        else
                        {
                            <Chip Color="@StateColor(row.State.Value)" TextColor="#080809" Icon="@StateChipIcon(row.State.Value)">@row.State.Value.ToString()</Chip>
                        }
                    </td>
                    <td style="padding: 10px 12px; text-align: right; color: var(--lv5); font-variant-numeric: tabular-nums;">
                        @(row.State is null ? "—" : row.DocumentCount.ToString("N0"))
                    </td>
                    <td style="padding: 10px 12px; color: var(--lv5);">
                        @(row.LastIndexed is { } t && t > DateTime.MinValue ? t.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "—")
                    </td>
                    <td style="padding: 10px 12px; color: var(--lv5);">
                        @if (_editKey == row.Key)
                        {
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <div style="width: 190px;">
                                    <SelectField @bind-Value="_editMode" Options="_keepAliveModes" />
                                </div>
                                @if (_editMode == "timed")
                                {
                                    <div style="width: 72px;">
                                        <InputField @bind-Value="_editHours" placeholder="hours" />
                                    </div>
                                }
                                <Button Variant="primary" Size="micro" @onclick="() => SaveKeepAlive(row.DataSetName, row.TeamId)">Save</Button>
                                <Button Variant="ghost" Size="micro" @onclick="() => _editKey = null">Cancel</Button>
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="font-variant-numeric: tabular-nums;">@KeepAliveLabel(row.KeepAliveTimeHrs)</span>
                                <span style="color: var(--lv4); font-size: 12px;">@RemainingLabel(row)</span>
                                <Button Variant="ghost" Size="micro" @onclick="() => BeginEdit(row)">Edit</Button>
                            </div>
                        }
                    </td>
                    <td style="padding: 10px 12px; text-align: right; display: flex; gap: 6px; justify-content: flex-end;">
                        @if (_deleteConfirmKey == row.Key)
                        {
                            <Button Variant="danger" Size="micro" @onclick="() => DeleteDataset(row.DataSetName, row.TeamId)">Confirm Delete</Button>
                            <Button Variant="ghost" Size="micro" @onclick="() => _deleteConfirmKey = null">Cancel</Button>
                        }
                        else
                        {
                            <Tooltip Content="Delete dataset">
                                <Button Variant="ghost" Size="micro" IconLeft="_iconDelete" @onclick="() => _deleteConfirmKey = row.Key" />
                            </Tooltip>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private RenderFragment<int> _iconDelete  => size => @<UserX Size="size" />;
    private RenderFragment<int> _iconRefresh => size => @<Refresh Size="size" />;
    private RenderFragment<int> _iconFlag => size => @<Flag Size="size" />;
    private RenderFragment<int> _iconTrolley => size => @<Trolley Size="size" />;
    private RenderFragment<int> _iconHourGlass => size => @<HourGlass Size="size" />;
    private RenderFragment<int> _iconWarning => size => @<Warning Size="size" />;

    private RenderFragment<int>? StateChipIcon(SystemState state) => state switch
    {
        SystemState.Ready => _iconFlag,
        SystemState.Loading => _iconTrolley,
        SystemState.Indexing => _iconHourGlass,
        SystemState.Error => _iconWarning,
        _ => null,
    };

    private record DatasetRow(
        string DataSetName, string TeamId, string? TeamName,
        SystemState? State, int DocumentCount, DateTime? LastIndexed,
        int KeepAliveTimeHrs, bool Loaded, TimeSpan? Remaining)
    {
        public string Key => $"{TeamId}/{DataSetName}";
    }

    private static string KeepAliveLabel(int hrs) => hrs switch
    {
        int.MaxValue => "∞ pinned",
        0 => "Off (manual)",
        _ => $"{hrs} h",
    };

    private static string RemainingLabel(DatasetRow row)
    {
        if (row.KeepAliveTimeHrs is int.MaxValue or 0)
            return "";
        if (!row.Loaded)
            return "(not loaded)";
        if (row.Remaining is { } rem)
            return rem.TotalHours >= 1 ? $"~{(int)rem.TotalHours}h {rem.Minutes}m left" : $"~{rem.Minutes}m left";
        return "";
    }

    private static string StateColor(SystemState state) => state switch
    {
        SystemState.Ready => "var(--CTeal)",
        SystemState.Loaded => "var(--CLightBlue)",
        SystemState.Created => "var(--lv3)",
        _ => "var(--CWarning)",
    };

    private List<DatasetRow>? _rows;
    private string? _message;
    private string? _errorMessage;
    private string? _deleteConfirmKey;
    private string? _editKey;
    private string _editMode = "max";   // "max" (∞ pinned) | "0" (manual) | "timed"
    private string _editHours = "24";

    private static readonly IEnumerable<SelectField.SelectOption> _keepAliveModes =
    [
        new("∞ Pinned — always loaded", "max"),
        new("Off — client-managed", "0"),
        new("Timed — idle eviction", "timed"),
    ];

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        // Owner keys are team ids; map them to team names for display.
        var teamMap = (await TeamService.GetAllAsync())
            .ToDictionary(t => t.Id.ToString(), t => t.Name);

        var all = IndxCloudInternalApi.Manager.GetAllDataSets();
        var rows = all.Select(r =>
        {
            // In-memory status of the warmed engine (null if not currently instantiated).
            var status = IndxCloudInternalApi.Manager.GetState(r.DataSetName, r.TeamId);
            var ka = IndxCloudInternalApi.Manager.GetKeepAliveInfo(r.DataSetName, r.TeamId);
            return new DatasetRow(
                r.DataSetName, r.TeamId, teamMap.GetValueOrDefault(r.TeamId),
                status?.SystemState, status?.DocumentCount ?? 0, status?.TimeOfLastIndexBuild,
                ka.KeepAliveTimeHrs, ka.Loaded, ka.Remaining);
        });
        _rows = [.. rows.OrderBy(r => r.TeamName ?? r.TeamId).ThenBy(r => r.DataSetName)];
    }

    private void BeginEdit(DatasetRow row)
    {
        _message = null; _errorMessage = null;
        _editKey = row.Key;
        (_editMode, _editHours) = row.KeepAliveTimeHrs switch
        {
            int.MaxValue => ("max", "24"),
            0 => ("0", "24"),
            var h => ("timed", h.ToString()),
        };
    }

    private async Task SaveKeepAlive(string dataSetName, string teamId)
    {
        _message = null; _errorMessage = null;

        int hrs;
        switch (_editMode)
        {
            case "max": hrs = int.MaxValue; break;
            case "0": hrs = 0; break;
            default:
                if (!int.TryParse((_editHours ?? "").Trim(), out hrs) || hrs < 1)
                {
                    _errorMessage = $"\"{_editHours}\" is not a valid number of hours — enter a whole number of 1 or more.";
                    return;
                }
                break;
        }

        var ok = IndxCloudInternalApi.Manager.SetKeepAliveHrs(dataSetName, teamId, hrs);
        if (ok)
        {
            Logger.LogInformation("Admin set KeepAliveTimeHrs={Hrs} for dataset {DataSetName} team {TeamId}", hrs, dataSetName, teamId);
            _message = $"Keep-alive for \"{dataSetName}\" set to {KeepAliveLabel(hrs)}.";
            _editKey = null;
            await Load();
        }
        else
        {
            _errorMessage = $"Could not update keep-alive for \"{dataSetName}\".";
        }
    }

    private async Task DeleteDataset(string dataSetName, string teamId)
    {
        _message = null; _errorMessage = null;
        _deleteConfirmKey = null;
        var deleted = IndxCloudInternalApi.Manager.DeleteDataSet(dataSetName, teamId);
        if (deleted)
        {
            Logger.LogInformation("Admin deleted dataset {DataSetName} owned by team {TeamId}", dataSetName, teamId);
            _message = $"Dataset \"{dataSetName}\" deleted.";
            await Load();
        }
        else
        {
            _errorMessage = $"Could not delete \"{dataSetName}\" — it may have already been removed.";
        }
    }
}
