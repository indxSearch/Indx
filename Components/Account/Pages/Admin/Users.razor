@page "/admin"
@page "/admin/users"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using IndxServer.Data
@attribute [Authorize(Roles = "Admin")]
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Users> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IndxServer.Services.InstanceSettingsService SettingsService
@inject Microsoft.AspNetCore.Identity.UI.Services.IEmailSender EmailSender
@inject NavigationManager NavigationManager
@inject IndxServer.Services.IEditionService Edition

<PageTitle>Admin — Users</PageTitle>


<AdminNav Active="Users" />

<div style="display: flex; align-items: center; gap: 16px; margin-bottom: 40px;">
    <div>
        <h2 style="margin-bottom: 4px;">Users</h2>
        <p style="color: var(--lv5);">Manage user accounts and roles.</p>
    </div>
    <Button Variant="ghost" Size="micro" IconLeft="_iconRefresh" style="margin-left: auto;" @onclick="LoadUsers">Refresh</Button>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div style="padding: 14px 18px; border: 1px solid var(--CTeal); border-radius: var(--radius); background: rgba(114,245,198,0.08); margin-bottom: 24px;">
        @_message
    </div>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div style="padding: 14px 18px; border: 1px solid var(--CSignal); border-radius: var(--radius); background: rgba(255,66,56,0.08); margin-bottom: 24px;">
        @_errorMessage
    </div>
}

@if (_users == null)
{
    <p>Loading...</p>
}
else if (_users.Count == 0)
{
    <p style="color: var(--lv5);">No users found.</p>
}
else
{
    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
        <thead>
            <tr style="border-bottom: 1px solid var(--lv3); color: var(--lv5);">
                <th style="text-align: left; padding: 8px 12px; font-weight: 500;">Email</th>
                <th style="padding: 8px 12px; font-weight: 500;">Role</th>
                <th style="padding: 8px 12px; font-weight: 500;">Confirmed</th>
                <th style="padding: 8px 12px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in _users)
            {
                <tr style="border-bottom: 1px solid var(--lv2);">
                    <td style="padding: 10px 12px; color: var(--lv6);">@u.Email</td>
                    <td style="padding: 10px 12px; text-align: center;">
                        @if (u.IsAdmin)
                        {
                            <Chip Color="var(--CLightBlue)" TextColor="#080809">Admin</Chip>
                        }
                        else
                        {
                            <Chip Color="var(--lv3)" TextColor="var(--lv5)">Member</Chip>
                        }
                    </td>
                    <td style="padding: 10px 12px; text-align: center; color: @(u.EmailConfirmed ? "var(--CConfirmed)" : "var(--lv4)");">
                        @(u.EmailConfirmed ? "✓" : "–")
                    </td>
                    <td style="padding: 10px 12px; text-align: right; display: flex; gap: 6px; justify-content: flex-end;">
                        @if (u.IsAdmin)
                        {
                            @if (u.Id != _currentUserId && (_users?.Count(r => r.IsAdmin) ?? 0) > 1)
                            {
                                <Button Variant="ghost" Size="micro" Loading="@(_roleBusyId == u.Id)" @onclick="() => DemoteUser(u.Id)">Remove Admin</Button>
                            }
                        }
                        else
                        {
                            <Button Variant="ghost" Size="micro" Loading="@(_roleBusyId == u.Id)" @onclick="() => PromoteUser(u.Id)">Make Admin</Button>
                        }
                        <ConfirmButton Label="" Title="Delete user" Icon="_iconDelete" ConfirmLabel="Confirm Delete" CancelVariant="ghost"
                                       Open="@(_deleteConfirmId == u.Id)" OpenChanged="v => _deleteConfirmId = v ? u.Id : null"
                                       OnConfirm="() => DeleteUser(u.Id)" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!Edition.IsEnabled(IndxServer.Services.EditionFeature.MultipleUsers))
{
    <div style="margin-top: 48px;">
        <p style="color: var(--lv5); font: var(--text-xs);">
            This plan supports a single user. Upgrade to the Professional plan to invite teammates.
        </p>
    </div>
}
else if (_isInviteMode)
{
    <div style="margin-top: 48px;">
        <h3 style="margin-bottom: 4px;">Pending invites</h3>
        <p style="color: var(--lv5); margin: 8px 0 20px; font: var(--text-xs);">
            Invited addresses can register once. They are removed automatically after the account is created.
        </p>

        @if (_inviteEmails.Count > 0)
        {
            <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px;">
                <tbody>
                    @foreach (var email in _inviteEmails)
                    {
                        <tr style="border-bottom: 1px solid var(--lv2);">
                            <td style="padding: 8px 12px; color: var(--lv6);">@email</td>
                            <td style="padding: 8px 12px;">
                                <Chip Color="var(--lv2)" TextColor="var(--lv5)">Pending</Chip>
                            </td>
                            <td style="padding: 8px 12px; text-align: right;">
                                <Button Variant="ghost" Size="micro" @onclick="() => RevokeInvite(email)">Revoke</Button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p style="color: var(--lv4); font-size: 13px; margin-bottom: 16px;">No pending invites.</p>
        }

        @if (!_showAddInvite)
        {
            <Button Variant="secondary" Size="micro" IconLeft="_iconUserPlus" @onclick="() => { _showAddInvite = true; _inviteError = null; }">
                Invite a user
            </Button>
        }
        else
        {
            <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 4px;">
                <input class="indx-input"
                       placeholder="Email address"
                       @bind="_inviteEmailInput"
                       style="width: 220px;" />
                <Button Variant="primary" Size="micro"
                        Disabled="@(!IsValidEmail(_inviteEmailInput))" Loading="@_inviting"
                        @onclick="AddInviteAsync">@(_inviting ? "Sending…" : "Add")</Button>
                <Button Variant="ghost" Size="micro" Disabled="@_inviting"
                        @onclick="() => { _showAddInvite = false; _inviteEmailInput = string.Empty; _inviteError = null; }">Cancel</Button>
            </div>
            @if (!string.IsNullOrEmpty(_inviteError))
            {
                <p style="color: var(--CSignal); font: var(--text-xs); margin-top: 4px;">@_inviteError</p>
            }
        }
    </div>
}

@code {
    private RenderFragment<int> _iconDelete   => size => @<UserX Size="size" />;
    private RenderFragment<int> _iconRefresh  => size => @<Refresh Size="size" />;
    private RenderFragment<int> _iconUserPlus => size => @<UserPlus Size="size" />;

    private List<UserRow>? _users;
    private string? _message;
    private string? _errorMessage;
    private string? _deleteConfirmId;
    private string? _currentUserId;
    private bool _isInviteMode;
    private List<string> _inviteEmails = [];
    private string _inviteEmailInput = "";
    private bool _showAddInvite;
    private bool _inviting;
    private string? _roleBusyId;
    private string? _inviteError;

    private record UserRow(string Id, string? Email, bool IsAdmin, bool EmailConfirmed);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _currentUserId = UserManager.GetUserId(auth.User);
        LoadInvites();
        await LoadUsers();
    }

    private void LoadInvites()
    {
        var settings = SettingsService.Load();
        _isInviteMode = settings.RegistrationMode == IndxServer.Services.RegistrationMode.Invite;
        _inviteEmails = [.. settings.AllowedEmails];
    }

    private async Task AddInviteAsync()
    {
        if (_inviting) return;
        var email = _inviteEmailInput.Trim();
        if (!IsValidEmail(email)) return;
        if (_inviteEmails.Any(e => e.Equals(email, StringComparison.OrdinalIgnoreCase)))
        {
            _inviteError = "This email is already on the invite list.";
            return;
        }
        _inviteEmails.Add(email);
        _inviteError = null;
        PersistInvites();

        // Sending the email is the slow part (an SMTP/ACS round trip); keep the row up with a
        // spinner until it is done rather than collapsing it while nothing seems to happen.
        _inviting = true;
        var instanceName = SettingsService.Load().InstanceName;
        var registerUrl = NavigationManager.ToAbsoluteUri("/account/register").ToString();
        try
        {
            await EmailSender.SendEmailAsync(
                email,
                IndxServer.Services.EmailTemplates.Subject(instanceName, "You have been invited"),
                IndxServer.Services.EmailTemplates.Invite(instanceName, registerUrl));
            Logger.LogInformation("Invite sent to {Email}", email);
            _message = $"Invite sent to {email}.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send invite email to {Email}", email);
            _message = $"{email} added to invite list, but the email could not be sent.";
        }
        finally
        {
            _inviting = false;
            _inviteEmailInput = string.Empty;
            _showAddInvite = false;
        }
    }

    private void RevokeInvite(string email)
    {
        _inviteEmails.RemoveAll(e => e.Equals(email, StringComparison.OrdinalIgnoreCase));
        PersistInvites();
    }

    private void PersistInvites()
    {
        var settings = SettingsService.Load();
        settings.AllowedEmails = [.. _inviteEmails];
        SettingsService.Save(settings);
    }

    private static bool IsValidEmail(string email) =>
        !string.IsNullOrWhiteSpace(email) && email.Contains('@') && email.Contains('.');

    private async Task LoadUsers()
    {
        var all = UserManager.Users.ToList();
        var rows = new List<UserRow>();
        foreach (var u in all)
        {
            var isAdmin = await UserManager.IsInRoleAsync(u, "Admin");
            rows.Add(new UserRow(u.Id, u.Email, isAdmin, u.EmailConfirmed));
        }
        _users = [.. rows.OrderByDescending(r => r.IsAdmin).ThenBy(r => r.Email)];
    }

    private async Task PromoteUser(string userId)
    {
        if (_roleBusyId != null) return;
        _message = null; _errorMessage = null;
        _roleBusyId = userId;
        try
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (user == null) return;
            await UserManager.AddToRoleAsync(user, "Admin");
            Logger.LogInformation("Promoted {Email} to Admin", user.Email);
            _message = $"{user.Email} is now an Admin.";
            await LoadUsers();
        }
        finally { _roleBusyId = null; }
    }

    private async Task DemoteUser(string userId)
    {
        _message = null; _errorMessage = null;

        if (userId == _currentUserId)
        {
            _errorMessage = "You cannot remove your own admin role.";
            return;
        }

        var adminCount = _users?.Count(u => u.IsAdmin) ?? 0;
        if (adminCount <= 1)
        {
            _errorMessage = "Cannot remove the last admin.";
            return;
        }

        if (_roleBusyId != null) return;
        _roleBusyId = userId;
        try
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (user == null) return;
            await UserManager.RemoveFromRoleAsync(user, "Admin");
            Logger.LogInformation("Removed Admin from {Email}", user.Email);
            _message = $"{user.Email} is now a Member.";
            await LoadUsers();
        }
        finally { _roleBusyId = null; }
    }

    private async Task DeleteUser(string userId)
    {
        _message = null; _errorMessage = null;
        _deleteConfirmId = null;
        var user = await UserManager.FindByIdAsync(userId);
        if (user == null) return;
        var email = user.Email;
        var result = await UserManager.DeleteAsync(user);
        if (result.Succeeded)
        {
            Logger.LogInformation("Deleted user {Email}", email);
            _message = $"{email} deleted.";
            await LoadUsers();
        }
        else
        {
            _errorMessage = $"Delete failed: {string.Join(", ", result.Errors.Select(e => e.Description))}";
        }
    }
}
