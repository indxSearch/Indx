@page "/admin/settings"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using IndxServer.Services
@attribute [Authorize(Roles = "Admin")]
@inject InstanceSettingsService SettingsService
@inject ILogger<Settings> Logger
@inject IConfiguration Configuration
@inject IndxServer.Services.SearchOrAsk.SearchOrAskService SearchOrAsk
@inject IndxServer.Services.SearchOrAsk.SearchOrAskModelLists ModelLists

<PageTitle>Admin — Settings</PageTitle>



<h2>Instance Settings</h2>
<p style="color: var(--lv5); margin-bottom: 40px;">Configure registration and access control for this Indx instance.</p>

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div style="max-width: 520px; margin-bottom: 24px;"><Alert Variant="success">@_successMessage</Alert></div>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div style="max-width: 520px; margin-bottom: 24px;"><Alert Variant="destructive">@_errorMessage</Alert></div>
}

<div style="max-width: 520px;">

    <div style="margin-bottom: 32px;">
        <h3>General</h3>
        <p style="color: var(--lv5); margin: 8px 0 20px;">Basic configuration for this instance.</p>
        <InputField Label="Instance Name" @bind-Value="_instanceName" placeholder="Indx" />
        <p style="font: var(--text-xs); color: var(--lv4); margin-top: 6px;">Shown in emails and the browser title.</p>
    </div>

    <div style="margin-bottom: 32px;">
        <h3>Access</h3>
        <p style="color: var(--lv5); margin: 8px 0 20px;">Control sign-in and account behaviour.</p>
        <div style="display: flex; flex-direction: column; gap: 16px;">
            <div>
                <ToggleSwitch Label="Require email verification" @bind-Checked="_requireEmailVerification" />
                <p style="font: var(--text-xs); color: var(--lv4); margin-top: 4px; margin-left: 48px;">Users must confirm their email address before they can sign in.</p>
            </div>
            <div>
                <ToggleSwitch Label="Allow users to delete their own account" @bind-Checked="_allowUserSelfDeletion" />
                <p style="font: var(--text-xs); color: var(--lv4); margin-top: 4px; margin-left: 48px;">When disabled, only admins can delete accounts.</p>
            </div>
        </div>
    </div>

    <div style="margin-bottom: 32px;">
        <h3>Websites</h3>
        <p style="color: var(--lv5); margin: 8px 0 20px;">The websites whose pages may call this instance's API from the browser, such as a shop with a search box.</p>
        <Textarea Label="Allowed origins" Rows="4" @bind-Value="_originsText" placeholder="https://shop.example.com&#10;https://*.example.com" />
        <p style="font: var(--text-xs); color: var(--lv4); margin-top: 6px;">
            One per line, with <code>https://</code>. A <code>*.</code> allows every subdomain. Servers, apps and this console need no entry.
        </p>
    </div>

    <div style="margin-bottom: 32px;">
        <h3>AI Agents (MCP)</h3>
        <p style="color: var(--lv5); margin: 8px 0 20px;">Let AI agents query your datasets over the Model Context Protocol.</p>
        <div>
            <ToggleSwitch Label="Enable MCP server" @bind-Checked="_mcpEnabled" />
            <p style="font: var(--text-xs); color: var(--lv4); margin-top: 4px; margin-left: 48px;">
                Exposes a read-only <code>/mcp</code> endpoint (search, describe, get document) authenticated by API key.
                When disabled, the endpoint returns 404. Users connect via <a href="/account/api-key">API keys</a>.
            </p>
        </div>
    </div>

    <div style="margin-bottom: 32px;">
        <h3>Experimental</h3>
        <p style="color: var(--lv5); margin: 8px 0 20px;">Features still being tried. Off until switched on here.</p>
        <div>
            <ToggleSwitch Label="Show Search or ask" @bind-Checked="_searchOrAskShown" />
            <p style="font: var(--text-xs); color: var(--lv4); margin-top: 4px; margin-left: 48px;">
                Offers to answer what visitors ask, written from a dataset's records. Adds a Search or ask tab to
                each dataset, where it is switched on one dataset at a time. Sends what visitors type to the model
                provider you choose, with your own key.
            </p>
            @if (_searchOrAskShown)
            {
                <div class="soa-admin">
                    @* Keys first, one per provider, then the two roles, each naming a provider: switching
                       is a choice, and a key is never typed twice (26 Oct 2026). A key the configuration
                       holds shows as set there and cannot be edited here; the rest can. *@
                    <h4 class="soa-admin-head">Keys</h4>
                    <p class="soa-admin-note">One key per provider you use. They are kept in this instance's settings file, as the licence is, and never shown again once saved.</p>
                    @foreach (var holder in KeyFields)
                    {
                        var h = holder;
                        @if (_configKeys.Contains(h))
                        {
                            <InputField Label="@KeyName(h)" type="password" Value="" ValueExpression="() => _blank" disabled placeholder="Set in the server's configuration" />
                        }
                        else
                        {
                            <InputField Label="@KeyName(h)" type="password" autocomplete="off" Value="@(_newKeys.GetValueOrDefault(h) ?? "")"
                                        ValueChanged="@(v => _newKeys[h] = v)" ValueExpression="() => _blank"
                                        placeholder="@(_savedKeys.Contains(h) && !_removeKeys.Contains(h) ? "Saved; type to replace" : KeyPlaceholder(h))" />
                            @if (_savedKeys.Contains(h) && !_removeKeys.Contains(h))
                            {
                                <div class="soa-admin-keyline">
                                    <span>Saved.</span>
                                    <Button Variant="ghost" Size="micro" @onclick="() => _removeKeys.Add(h)">Remove key</Button>
                                </div>
                            }
                            else if (_removeKeys.Contains(h))
                            {
                                <p class="soa-admin-note">Removed when you save.</p>
                            }
                        }
                    }

                    <h4 class="soa-admin-head">Decisions</h4>
                    <SelectField Label="The judge" Options="_judgeOptions" Value="@_judgeProvider" ValueChanged="@(v => _judgeProvider = v ?? "openrouter")"
                                 disabled="@SearchOrAsk.JudgeProviderConfigured" />
                    <p class="soa-admin-note">
                        @if (_judgeProvider == "decisions")
                        {
                            <text>OpenAI's Decisions API in place of Jev, on the OpenAI key: the same questions, far more decided. The thresholds were measured on Jev; Observr's replay tunes them per dataset.</text>
                        }
                        else
                        {
                            <text>Jev, TypeSafe's decision model, is served on OpenRouter and by TypeSafe directly.</text>
                        }
                        @if (!HasKey(IndxServer.Services.SearchOrAsk.SearchOrAskProviders.JudgeKeyHolder(_judgeProvider)))
                        {
                            <text> Needs the @KeyName(IndxServer.Services.SearchOrAsk.SearchOrAskProviders.JudgeKeyHolder(_judgeProvider)) above: Search or ask does not run without the judge.</text>
                        }
                    </p>

                    <h4 class="soa-admin-head">Answers and filters</h4>
                    <SelectField Label="Provider" Options="_providerOptions" Value="@_provider" ValueChanged="OnProviderChanged"
                                 disabled="@SearchOrAsk.ProviderConfigured" />
                    @if (!HasKey(_provider))
                    {
                        <p class="soa-admin-note">Needs the @KeyName(_provider) above.</p>
                    }
                    @if (_provider == "compatible")
                    {
                        <InputField Label="Base URL" @bind-Value="_baseUrl" placeholder="https://my-endpoint.example/v1" />
                        <p class="soa-admin-note">Any endpoint that speaks OpenAI's chat completions: Azure OpenAI, Mistral, Groq, a local model.</p>
                    }
                    @if (_provider is "openrouter" or "openai")
                    {
                        <ToggleSwitch Label="Keep requests in the EU" Checked="@_euRouting" CheckedChanged="OnEuChanged" Disabled="@SearchOrAsk.EuRoutingConfigured" />
                        <p class="soa-admin-note soa-admin-indent">
                            @if (_provider == "openai")
                            {
                                <text>OpenAI's EU data residency (eu.api.openai.com): requests are stored and processed in Europe, the Decisions API's included. It works only with a key from an OpenAI project created with Europe as its region.</text>
                            }
                            else
                            {
                                <text>OpenRouter's EU endpoint for the answers and the filters: those requests are processed in the EU and go only to providers there, and a model with no EU provider is refused rather than routed out. The models listed below are the ones it serves. The decisions are the exception: Jev has no EU provider, so what visitors type still goes to Jev through OpenRouter's global endpoint.</text>
                            }
                        </p>
                    }
                    @if (_provider == "openai")
                    {
                        <SelectField Label="Answer speed" Options="_speedOptions" Value="@_answerSpeed" ValueChanged="@(v => _answerSpeed = v ?? "standard")"
                                     disabled="@SearchOrAsk.AnswerSpeedConfigured" />
                        <p class="soa-admin-note">Ultrafast is OpenAI's faster tier for the answers, at several times the price, offered for some models such as Sol. The filters always run at standard speed.</p>
                    }
                    <div class="soa-admin-models">
                        <ModelPicker Label="Answer model" @bind-Value="_answerModel" Placeholder="@_defaults.Answer" Models="_models" />
                        <ModelPicker Label="Fast answer model" @bind-Value="_fastModel" Placeholder="@_defaults.Fast" Models="_models" />
                        <ModelPicker Label="Filter model" @bind-Value="_filterModel" Placeholder="@_defaults.Filter" Models="_models" />
                    </div>
                    <p class="soa-admin-note">
                        @if (_modelsLoading)
                        {
                            <text>Reading the provider's models…</text>
                        }
                        else if (_modelsProblem != null)
                        {
                            <text>The provider's list is not available: @_modelsProblem Any model name can be typed.</text>
                        }
                        else
                        {
                            <text>Left empty, the provider's default in grey is used. Any model the provider serves can be typed.</text>
                        }
                        @if (_provider != "openrouter")
                        {
                            <text> Only OpenRouter reports what a call costs, so the statistics show no cost for this provider.</text>
                        }
                    </p>

                    @* The saved keys, tried: one trivial call per door, the provider's own words back. *@
                    <div style="margin-top: 4px; display: flex; flex-direction: column; gap: 6px; align-items: flex-start;">
                        <Button Variant="secondary" Size="micro" @onclick="CheckKeysAsync" Disabled="@(_checking || IsDirty)">Check the keys</Button>
                        @if (IsDirty && !_checking)
                        {
                            <p class="soa-admin-note">Save first: the check uses the saved keys.</p>
                        }
                        @if (_checking)
                        {
                            <StreamStatus>Asking the judge and the answer model…</StreamStatus>
                        }
                        else if (_checked != null)
                        {
                            <p class="soa-admin-note soa-admin-mono">@_checked.Value.Judge</p>
                            <p class="soa-admin-note soa-admin-mono">@_checked.Value.Answers</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div style="margin-bottom: 32px;">
        <h3>Registration</h3>
        <p style="color: var(--lv5); margin: 8px 0 20px;">Control who can create accounts on this instance.</p>

        <SelectField Label="Registration Mode"
                     Value="@_registrationMode"
                     ValueChanged="OnModeChanged"
                     Options="_modeOptions" />

        @if (_registrationMode == "EmailDomain")
        {
            <div style="margin-top: 20px;">
                <p style="font: var(--text-xs); color: var(--lv5); margin-bottom: 8px;">
                    Allowed domains — one per line (e.g. <code style="background: var(--lv1); padding: 2px 5px; border-radius: 3px;">yourcompany.com</code>)
                </p>
                <textarea class="indx-text-input"
                          rows="4"
                          style="width: 100%; resize: vertical; font-family: var(--font-mono); font-size: 12px;"
                          @bind="_allowedDomainsText"
                          placeholder="yourcompany.com&#10;partner.com"></textarea>
            </div>
        }
    </div>

    @* The page action pattern (app.css): Save then Cancel, only while something changed. *@
    <SaveBar Visible="@IsDirty" Message="Unsaved changes">
        <Button Variant="primary" Size="micro" IconLeft="DatasetIcons.Save" @onclick="Save">Save</Button>
        <Button Variant="secondary" Size="micro" @onclick="Cancel">Cancel</Button>
    </SaveBar>

</div>

@code {
    private string _instanceName = "Indx";
    private bool _requireEmailVerification;
    private bool _allowUserSelfDeletion = true;
    private bool _mcpEnabled = true;
    private bool _searchOrAskShown;
    // Keys by provider. A saved key is never shown again: a field holds only a new one being typed.
    private readonly Dictionary<string, string?> _newKeys = [];
    private readonly HashSet<string> _removeKeys = [];
    private HashSet<string> _savedKeys = [];
    private IReadOnlySet<string> _configKeys = new HashSet<string>();
    private string? _blank;
    private string _provider = "openrouter";
    private string _baseUrl = "";
    private bool _euRouting;
    private string _judgeProvider = "openrouter";
    private string _answerSpeed = "standard";
    private string _answerModel = "", _fastModel = "", _filterModel = "";
    private IReadOnlyList<IndxServer.Services.SearchOrAsk.ModelOption>? _models;
    private string? _modelsProblem;
    private bool _modelsLoading;
    private int _modelsAsk;
    private bool _checking;
    private (string Judge, string Answers)? _checked;

    // The compatible endpoint's key is asked for only when it is the provider: most never use one.
    private IEnumerable<string> KeyFields => IndxServer.Services.SearchOrAsk.SearchOrAskProviders.KeyHolders
        .Where(h => h != "compatible" || _provider == "compatible" || _savedKeys.Contains(h));
    private static string KeyName(string holder) => holder switch
    {
        "openai" => "OpenAI key",
        "anthropic" => "Anthropic key",
        "typesafe" => "TypeSafe key",
        "compatible" => "Compatible endpoint's key",
        _ => "OpenRouter key",
    };
    private static string KeyPlaceholder(string holder) => holder switch
    {
        "openai" => "sk-…",
        "anthropic" => "sk-ant-…",
        "openrouter" => "sk-or-…",
        _ => "",
    };
    /// <summary>Whether a provider has a key once this form is saved.</summary>
    private bool HasKey(string holder) => _configKeys.Contains(holder)
        || !string.IsNullOrWhiteSpace(_newKeys.GetValueOrDefault(holder))
        || (_savedKeys.Contains(holder) && !_removeKeys.Contains(holder));

    private async Task OnProviderChanged(string? value)
    {
        _provider = value ?? "openrouter";
        await LoadModelsAsync();
    }

    private async Task OnEuChanged(bool value)
    {
        _euRouting = value;
        await LoadModelsAsync();
    }

    /// <summary>The chosen provider's models, read with its saved key; the latest ask wins.</summary>
    private async Task LoadModelsAsync()
    {
        var ask = ++_modelsAsk;
        _models = null;
        _modelsProblem = null;
        _modelsLoading = true;
        StateHasChanged();
        var (models, problem) = await ModelLists.ListAsync(_provider, _euRouting && _provider is "openrouter" or "openai", _baseUrl, CancellationToken.None);
        if (ask != _modelsAsk) return;
        _models = models;
        _modelsProblem = problem;
        _modelsLoading = false;
        StateHasChanged();
    }

    private async Task CheckKeysAsync()
    {
        if (_checking) return;
        _checking = true;
        _checked = null;
        try { _checked = await SearchOrAsk.CheckKeysAsync(CancellationToken.None); }
        finally { _checking = false; }
    }

    private static readonly IEnumerable<SelectField.SelectOption> _providerOptions =
    [
        new("OpenRouter", "openrouter"),
        new("OpenAI", "openai"),
        new("Anthropic", "anthropic"),
        new("Another OpenAI-compatible endpoint", "compatible"),
    ];
    private static readonly IEnumerable<SelectField.SelectOption> _speedOptions =
    [
        new("Standard", "standard"),
        new("Ultrafast", "ultrafast"),
    ];
    private static readonly IEnumerable<SelectField.SelectOption> _judgeOptions =
    [
        new("Jev, through OpenRouter", "openrouter"),
        new("Jev, through TypeSafe directly", "typesafe"),
        new("OpenAI's Decisions API", "decisions"),
    ];
    private (string Answer, string Fast, string Filter) _defaults => IndxServer.Services.SearchOrAsk.ModelDefaults.For(_provider);
    private string _registrationMode = "Open";
    private string _allowedDomainsText = "";
    private string _originsText = "";
    // What the field showed on load: an untouched field leaves the configuration in force.
    private string _originsLoaded = "";
    private string? _successMessage;
    private string? _errorMessage;

    private static readonly IEnumerable<SelectField.SelectOption> _modeOptions =
    [
        new("Open — anyone can register", "Open"),
        new("Email Domain — restrict to specific domains", "EmailDomain"),
        new("Invite — specific email addresses only", "Invite"),
        new("Closed — no new registrations", "Closed"),
    ];

    // What the page last loaded or saved, to tell whether there is anything to save.
    private (string, bool, bool, bool, bool, string, string, string) _saved;
    private (string, bool, bool, bool, bool, string, string, string) Current =>
        (_instanceName, _requireEmailVerification, _allowUserSelfDeletion, _mcpEnabled, _searchOrAskShown, _registrationMode, _allowedDomainsText,
         string.Join('\n', _provider, _baseUrl, _euRouting, _judgeProvider, _answerSpeed, _answerModel, _fastModel, _filterModel, _originsText));
    private bool IsDirty => Current != _saved || _newKeys.Values.Any(k => !string.IsNullOrWhiteSpace(k)) || _removeKeys.Count > 0;

    protected override void OnInitialized() => LoadFromSettings();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _searchOrAskShown) await LoadModelsAsync();
    }

    private void Cancel()
    {
        _successMessage = null;
        _errorMessage = null;
        LoadFromSettings();
    }

    private void LoadFromSettings()
    {
        var settings = SettingsService.Load();
        _instanceName = settings.InstanceName;
        _requireEmailVerification = settings.RequireEmailVerification;
        _allowUserSelfDeletion = settings.AllowUserSelfDeletion;
        _mcpEnabled = settings.McpEnabled;
        _searchOrAskShown = settings.SearchOrAskShown;
        // What is in force, the configuration's choices included, so the form shows what runs.
        var setup = SearchOrAsk.Setup;
        _savedKeys = IndxServer.Services.SearchOrAsk.InstanceSearchOrAskSwitch.ProvidersOf(settings).AllKeys().Keys.ToHashSet(StringComparer.OrdinalIgnoreCase);
        _configKeys = SearchOrAsk.ConfiguredKeyHolders;
        _newKeys.Clear();
        _removeKeys.Clear();
        _provider = setup.Provider;
        _baseUrl = settings.SearchOrAskBaseUrl ?? "";
        _euRouting = setup.EuRouting;
        _judgeProvider = setup.JudgeProvider;
        _answerSpeed = settings.SearchOrAskAnswerSpeed ?? "standard";
        _answerModel = settings.SearchOrAskAnswerModel ?? "";
        _fastModel = settings.SearchOrAskFastAnswerModel ?? "";
        _filterModel = settings.SearchOrAskFilterModel ?? "";
        _registrationMode = settings.RegistrationMode.ToString();
        _allowedDomainsText = string.Join("\n", settings.AllowedDomains);
        // Until an admin saves a list, the configuration's (Cors:AllowedOrigins) is the one in force.
        _originsText = string.Join("\n", settings.AllowedOrigins ?? InstanceCorsPolicyProvider.FromConfiguration(Configuration));
        _originsLoaded = _originsText;
        _saved = Current;
    }

    private void OnModeChanged(string? value)
    {
        _registrationMode = value ?? "Open";
        _successMessage = null;
        _errorMessage = null;
    }

    private void Save()
    {
        _successMessage = null;
        _errorMessage = null;

        try
        {
            var mode = Enum.Parse<RegistrationMode>(_registrationMode);
            var domains = _allowedDomainsText
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(d => d.Contains('.'))
                .ToList();
            var originLines = _originsText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var notOrigins = originLines.Where(o => InstanceCorsPolicyProvider.Normalize(o) is null).ToList();
            if (notOrigins.Count > 0)
            {
                _errorMessage = $"Not a website address: {string.Join(", ", notOrigins)}. Write it as https://shop.example.com.";
                return;
            }

            // Mutate the loaded settings in place — never construct a fresh InstanceSettings,
            // or fields this page doesn't edit (SetupComplete, LicenseToken, Plan, AllowedEmails)
            // get silently wiped to their defaults.
            var settings = SettingsService.Load();
            settings.InstanceName = _instanceName.Trim();
            settings.RequireEmailVerification = _requireEmailVerification;
            settings.AllowUserSelfDeletion = _allowUserSelfDeletion;
            settings.McpEnabled = _mcpEnabled;
            settings.SearchOrAskShown = _searchOrAskShown;
            // The keys by provider: the two older single keys move in here and are cleared.
            var keys = IndxServer.Services.SearchOrAsk.InstanceSearchOrAskSwitch.ProvidersOf(settings).AllKeys();
            foreach (var h in _removeKeys) keys.Remove(h);
            foreach (var (h, key) in _newKeys)
                if (!string.IsNullOrWhiteSpace(key)) keys[h] = key.Trim();
            settings.SearchOrAskKeys = keys.Count > 0 ? keys : null;
            settings.SearchOrAskApiKey = null;
            settings.SearchOrAskJudgeApiKey = null;
            settings.SearchOrAskProvider = _provider;
            settings.SearchOrAskBaseUrl = string.IsNullOrWhiteSpace(_baseUrl) ? null : _baseUrl.Trim();
            settings.SearchOrAskEuRouting = _euRouting;
            settings.SearchOrAskJudgeProvider = _judgeProvider;
            settings.SearchOrAskAnswerSpeed = _answerSpeed == "standard" ? null : _answerSpeed;
            settings.SearchOrAskAnswerModel = string.IsNullOrWhiteSpace(_answerModel) ? null : _answerModel.Trim();
            settings.SearchOrAskFastAnswerModel = string.IsNullOrWhiteSpace(_fastModel) ? null : _fastModel.Trim();
            settings.SearchOrAskFilterModel = string.IsNullOrWhiteSpace(_filterModel) ? null : _filterModel.Trim();
            settings.RegistrationMode = mode;
            settings.AllowedDomains = domains;
            if (settings.AllowedOrigins is not null || _originsText != _originsLoaded)
                settings.AllowedOrigins = [.. originLines.Select(o => InstanceCorsPolicyProvider.Normalize(o)!).Distinct()];
            SettingsService.Save(settings);
            if (settings.AllowedOrigins is not null) _originsText = _originsLoaded = string.Join("\n", settings.AllowedOrigins);
            SearchOrAsk.InstanceSettingsChanged();
            _savedKeys = keys.Keys.ToHashSet(StringComparer.OrdinalIgnoreCase);
            _newKeys.Clear();
            _removeKeys.Clear();
            _saved = Current;
            _ = LoadModelsAsync();

            _successMessage = "Settings saved.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to save: {ex.Message}";
            Logger.LogError(ex, "Error saving instance settings");
        }
    }
}
