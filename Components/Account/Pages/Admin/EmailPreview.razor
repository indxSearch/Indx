@page "/Admin/EmailPreview"
@using Microsoft.AspNetCore.Authorization
@using IndxCloudApi.Services
@attribute [Authorize(Roles = "Admin")]
@inject InstanceSettingsService InstanceSettingsService

<PageTitle>Admin — Email Preview</PageTitle>

<h2 style="margin-bottom: 24px;">Admin</h2>

<AdminNav Active="EmailPreview" />

<p style="color: var(--lv5); margin-bottom: 32px; font-size: 14px;">Live preview of all transactional emails. Instance name and styling reflect current settings.</p>

<div style="display: flex; flex-direction: column; gap: 40px;">
    @foreach (var email in _emails)
    {
        <div>
            <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 12px;">
                <span style="font-size: 14px; font-weight: 600; color: var(--lv6);">@email.Label</span>
                <span style="font-size: 12px; color: var(--lv4);">Subject: @email.Subject</span>
            </div>
            <iframe srcdoc="@email.Html"
                    style="width: 100%; height: 480px; border: 1px solid var(--lv2); border-radius: 6px; background: #fff;"
                    sandbox="allow-same-origin">
            </iframe>
        </div>
    }
</div>

@code {
    private record EmailPreviewEntry(string Label, string Subject, string Html);
    private List<EmailPreviewEntry> _emails = [];

    protected override void OnInitialized()
    {
        var instanceName = InstanceSettingsService.Load().InstanceName;
        var exampleUrl = "https://example.indx.co/Account/ConfirmEmail?code=example-token";

        _emails =
        [
            new("Invite", EmailTemplates.Subject(instanceName, "You have been invited"),
                EmailTemplates.Invite(instanceName, exampleUrl)),

            new("Verify email (on registration)", EmailTemplates.Subject(instanceName, "Please verify your email"),
                EmailTemplates.VerifyEmail(instanceName, exampleUrl)),

            new("Reset password", EmailTemplates.Subject(instanceName, "Reset your password"),
                EmailTemplates.ResetPassword(instanceName, exampleUrl)),

            new("Confirm email change", EmailTemplates.Subject(instanceName, "Confirm your new email address"),
                EmailTemplates.ConfirmEmailChange(instanceName, exampleUrl)),

            new("Resend verification", EmailTemplates.Subject(instanceName, "Please verify your email"),
                EmailTemplates.ResendConfirmation(instanceName, exampleUrl)),
        ];
    }
}
