@page "/admin/monitor"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using IndxServer.Monitor
@using Indx.Systm.Blazor
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@inject MonitorState State

<PageTitle>Admin — Monitor</PageTitle>


@* The same stream the terminal monitor shows, for the deployments where there is no terminal to
   show it in -- which is every Azure one. Admin only: a line names the team whose dataset changed,
   so a member of one team must not read another's activity here. *@
<div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
    <div>
        <h2 style="margin-bottom: 4px;">Monitor</h2>
        <p style="color: var(--lv5);">What this server has been doing, newest first.</p>
    </div>
</div>

@if (_snapshot is not { } snapshot)
{
    <p style="color: var(--lv5);">Waiting for the first reading…</p>
}
else
{
    @* The instance at a glance. CPU is this process's share of the cores over the last second,
       the view from inside the box. Memory is resident against what the runtime may use, the
       machine's or the container's limit: resident rather than the managed heap, because the
       engine keeps its score arrays in unmanaged memory through SpanAlloc and the heap
       understates it. The native pool is that memory, and its block count is the exact figure:
       heap and resident both move with paging, a steady count still means balanced alloc/free. *@
    <div class="admin-monitor-stats">
        <StatGroup Columns="6">
            <Stat Label="CPU" Hint="This process's share of all cores over the last second.">
                <Figure><BarMeter Shape="ring" Size="48" Value="@snapshot.Process.CpuPercent" Max="100" Format="@(v => $"{v:0} %")"
                                  Color="@(snapshot.Process.CpuPercent > 85 ? "var(--CSignal)" : null)" /></Figure>
                <ChildContent>of @Environment.ProcessorCount cores</ChildContent>
            </Stat>
            <Stat Label="Memory" Hint="Resident memory, against what the runtime may use on this machine or in this container. It includes the unmanaged memory the search engine allocates itself, which the managed heap does not.">
                <Figure><BarMeter Shape="ring" Size="48" Value="@snapshot.Process.WorkingSetMb" Max="@Math.Max(snapshot.Process.AvailableMb, 1)" Format="@(v => $"{v / Math.Max(snapshot.Process.AvailableMb, 1) * 100:0} %")"
                                  Color="@(snapshot.Process.AvailableMb > 0 && snapshot.Process.WorkingSetMb > snapshot.Process.AvailableMb * 0.85 ? "var(--CSignal)" : null)" /></Figure>
                <ChildContent>@Gb(snapshot.Process.WorkingSetMb) of @Gb(snapshot.Process.AvailableMb)</ChildContent>
            </Stat>
            <Stat Label="Native pool" Hint="The unmanaged memory the search engine holds for its score arrays, and the count of those allocations. A steady count means they are being released." Value="@Gb(snapshot.Process.NativePoolMb)">
                @snapshot.Process.NativeBlocks.ToString("N0") blocks · @snapshot.Process.GcHeapMb.ToString("N0") MB managed heap
            </Stat>
            <Stat Label="Searches" Hint="Counted since the monitor started." Value="@snapshot.SearchesTotal.ToString("N0")">
                since the monitor started
            </Stat>
            <Stat Label="Avg searches per minute" Hint="Over the last minute; the line is the last hour, one reading a minute.">
                <Figure><Sparkline Values="snapshot.RateHistory" Width="64px" Height="24" Fill="true" Baseline="true" AriaLabel="Searches a minute, the last hour" /></Figure>
                <ValueContent>@snapshot.SearchesPerMinute.ToString("N0")</ValueContent>
                <ChildContent>the last hour</ChildContent>
            </Stat>
            <Stat Label="Datasets" Hint="One cell a dataset: ready in the ink, hibernated dim, an error in the signal red." Value="@snapshot.Datasets.Count.ToString("N0")">
                @if (snapshot.Datasets.Count > 0)
                {
                    <Waffle Segments="DatasetsByState(snapshot)" Columns="@snapshot.Datasets.Count" Rows="1" Cell="4"
                            Format="@((f, v) => v.ToString("N0"))" AriaLabel="Datasets by state" />
                }
            </Stat>
        </StatGroup>

        @if (snapshot.Datasets.Count > 0)
        {
            <div class="admin-monitor-panel">
                <span class="admin-monitor-panel-title">Documents by dataset</span>
                <BarMeter Segments="DocumentsByDataset(snapshot)" Labels="legend" Format="@(v => v.ToString("N0"))" />
            </div>
        }
    </div>

    @if (_events.Count == 0)
    {
        @* Not an error: a server that has just started has nothing to report yet, and saying so
           is better than an empty box that looks broken. *@
        <p style="color: var(--lv5);">
            Nothing yet. Dataset state changes, field configuration changes and anything the
            server logs will appear here as they happen.
        </p>
    }
    else
    {
        @* Scrollable so that a long line widens the frame and never the page. No widths on the
           header cells: a fixed Time and Source leave a phone nothing for the column that matters,
           and at that width the row stacks instead (Monitor.razor.css). *@
        @* The wrapper is not decoration. Scoped CSS compiles ::deep to "[scope] .selector", so the
           rules in Monitor.razor.css need an element authored in THIS file above the table to
           carry the scope attribute. systm Table renders its own wrapper, so without this there is
           no such ancestor and the whole stylesheet silently matches nothing. *@
        <div class="admin-monitor-table-wrap">
        <Table Scrollable BleedEnd="var(--page-gutter)" AriaLabel="Server activity" Class="admin-monitor-table">
            <thead>
                <tr><th scope="col">Time</th><th scope="col">Source</th><th scope="col">What</th></tr>
            </thead>
            <tbody>
                @foreach (var item in _events)
                {
                    <tr>
                        <td style="color: var(--lv5);">
                            <TimeAgo Value="@item.AtUtc.UtcDateTime" TooltipPosition="left" />
                        </td>
                        <td style="color: var(--lv5);">@item.Source</td>
                        <td>@item.Text</td>
                    </tr>
                }
            </tbody>
        </Table>
        </div>

        <p style="color: var(--lv5); margin-top: 24px;">
            The most recent @_events.Count. These are kept in memory only, so they start again
            when the server restarts.
        </p>
    }
}

@code {
    private MonitorSnapshot? _snapshot;
    private List<MonitorEvent> _events = [];

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Read();
    }

    // Raised from the collector's timer, off the circuit thread.
    private void OnChanged() => _ = InvokeAsync(() => { Read(); StateHasChanged(); });

    private void Read()
    {
        _snapshot = State.Latest;
        _events = [.. State.Events().Reverse()];
    }

    public void Dispose() => State.Changed -= OnChanged;

    private static string Gb(long mb) => mb >= 1024 ? $"{mb / 1024.0:0.0} GB" : $"{mb:N0} MB";

    /// <summary>The largest four datasets by loaded documents, the rest as one segment.</summary>
    private static List<BarMeter.Segment> DocumentsByDataset(MonitorSnapshot s)
    {
        var withDocs = s.Datasets.Where(d => d.DocumentCount > 0).OrderByDescending(d => d.DocumentCount).ToList();
        var top = withDocs.Take(4).Select(d => new BarMeter.Segment(d.DataSetName, d.DocumentCount)).ToList();
        var rest = withDocs.Skip(4).Sum(d => (double)d.DocumentCount);
        if (rest > 0) top.Add(new("Others", rest));
        if (top.Count == 0) top.Add(new("None loaded", 1, "var(--lv2)"));
        return top;
    }

    /// <summary>Ready, hibernated, then the in-between states, then error in the signal red.</summary>
    private static List<Waffle.Segment> DatasetsByState(MonitorSnapshot s)
    {
        var byPhase = s.Datasets.GroupBy(d => d.Phase).ToDictionary(g => g.Key, g => g.Count());
        var segments = new List<Waffle.Segment>();
        void Add(string phase, string? color = null) { if (byPhase.Remove(phase, out var n) && n > 0) segments.Add(new(phase, n, color)); }
        Add("Ready"); Add("Hibernated");
        foreach (var (phase, n) in byPhase.Where(kv => kv.Key != "Error").OrderByDescending(kv => kv.Value)) segments.Add(new(phase, n));
        Add("Error", "var(--CSignal)");
        return segments;
    }
}
