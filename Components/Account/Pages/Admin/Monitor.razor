@page "/admin/monitor"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using IndxServer.Monitor
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@inject MonitorState State

<PageTitle>Admin — Monitor</PageTitle>

<AdminNav Active="Monitor" />

@* The same stream the terminal monitor shows, for the deployments where there is no terminal to
   show it in -- which is every Azure one. Admin only: a line names the team whose dataset changed,
   so a member of one team must not read another's activity here. *@
<div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
    <div>
        <h2 style="margin-bottom: 4px;">Monitor</h2>
        <p style="color: var(--lv5);">What this server has been doing, newest first.</p>
    </div>
</div>

@if (_snapshot is not { } snapshot)
{
    <p style="color: var(--lv5);">Waiting for the first reading…</p>
}
else
{
    <p style="color: var(--lv5); margin-bottom: 24px;">
        @snapshot.Datasets.Count dataset@(snapshot.Datasets.Count == 1 ? "" : "s")
        (@snapshot.LoadedCount loaded) ·
        @snapshot.TotalDocuments.ToString("N0") documents ·
        @snapshot.DescribeSearches()
    </p>

    @* Three numbers rather than one, because for Indx they disagree on purpose. The engine keeps
       its score arrays in unmanaged memory through SpanAlloc, so the managed heap understates
       what it is using and resident memory is the honest answer. Outstanding native blocks is the
       exact one: heap and resident both move with paging, that does not. *@
    <p style="color: var(--lv5); margin-bottom: 24px;"
       title="Managed heap is what the GC accounts for. Resident is the physical memory the process holds, which includes the unmanaged memory the search engine allocates itself. Native blocks is the count of those allocations, and a steady number means they are being released.">
        @snapshot.Process.GcHeapMb.ToString("N0") MB managed heap ·
        @snapshot.Process.WorkingSetMb.ToString("N0") MB resident ·
        @snapshot.Process.NativeBlocks.ToString("N0") native blocks
    </p>

    @if (_events.Count == 0)
    {
        @* Not an error: a server that has just started has nothing to report yet, and saying so
           is better than an empty box that looks broken. *@
        <p style="color: var(--lv5);">
            Nothing yet. Dataset state changes, field configuration changes and anything the
            server logs will appear here as they happen.
        </p>
    }
    else
    {
        @* Scrollable so that a long line widens the frame and never the page. No widths on the
           header cells: a fixed Time and Source leave a phone nothing for the column that matters,
           and at that width the row stacks instead (Monitor.razor.css). *@
        <Table Scrollable BleedEnd="var(--page-gutter)" AriaLabel="Server activity" Class="admin-monitor-table">
            <thead>
                <tr><th scope="col">Time</th><th scope="col">Source</th><th scope="col">What</th></tr>
            </thead>
            <tbody>
                @foreach (var item in _events)
                {
                    <tr>
                        <td style="color: var(--lv5);">
                            <TimeAgo Value="@item.AtUtc.UtcDateTime" TooltipPosition="left" />
                        </td>
                        <td style="color: var(--lv5);">@item.Source</td>
                        <td>@item.Text</td>
                    </tr>
                }
            </tbody>
        </Table>

        <p style="color: var(--lv5); margin-top: 24px;">
            The most recent @_events.Count. These are kept in memory only, so they start again
            when the server restarts.
        </p>
    }
}

@code {
    private MonitorSnapshot? _snapshot;
    private List<MonitorEvent> _events = [];

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Read();
    }

    // Raised from the collector's timer, off the circuit thread.
    private void OnChanged() => _ = InvokeAsync(() => { Read(); StateHasChanged(); });

    private void Read()
    {
        _snapshot = State.Latest;
        _events = [.. State.Events().Reverse()];
    }

    public void Dispose() => State.Changed -= OnChanged;
}
