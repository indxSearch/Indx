@page "/Account/ApiKey"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.IdentityModel.Tokens
@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@using System.Text
@using IndxCloudApi.Data
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApplicationDbContext Db
@inject IJSRuntime JSRuntime
@inject ILogger<ApiKey> Logger
@inject NavigationManager Nav
@inject IndxCloudApi.Services.InstanceSettingsService Settings

<PageTitle>API Keys</PageTitle>

<h2>API Keys</h2>
<p style="color:var(--lv5); margin-bottom: 32px;">
    API keys authenticate your requests to the Indx API. Each key is shown only once at creation — store it securely.
</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div style="padding: 16px; border: 1px solid var(--CSignal); border-radius: var(--radius); background: rgba(255,66,56,0.08); margin-bottom: 24px;">
        @errorMessage
    </div>
}

@* ── NEW KEY REVEAL ── *@
@if (newlyCreatedToken != null)
{
    <div style="padding: 20px; border: 1px solid var(--CTeal); border-radius: var(--radius); background: rgba(114,245,198,0.08); margin-bottom: 32px;">
        <strong>Key created — copy it now. You won't be able to see it again.</strong>
        <div style="display:flex; gap:10px; margin-top:12px;">
            <textarea style="flex:1; padding:10px; border:1px solid var(--lv3); border-radius:var(--radius); background:var(--lv0); color:var(--lv8); font-family:monospace; font-size:11px;"
                      rows="5" readonly>@newlyCreatedToken</textarea>
            <Button Variant="secondary" Size="micro" @onclick="CopyNewToken">Copy</Button>
        </div>
        @if (!string.IsNullOrEmpty(copyMessage))
        {
            <p style="margin-top:8px; color:var(--CTeal); font-size:13px;">@copyMessage</p>
        }
    </div>
}

@* ── EXISTING KEYS TABLE ── *@
@if (existingKeys.Count > 0)
{
    <table style="width:100%; border-collapse:collapse; margin-bottom:32px; font-size:13px;">
        <thead>
            <tr style="border-bottom:1px solid var(--lv3); color:var(--lv5);">
                <th style="text-align:left; padding:8px 12px; font-weight:500;">Name</th>
                <th style="text-align:left; padding:8px 12px; font-weight:500;">Key prefix</th>
                <th style="text-align:left; padding:8px 12px; font-weight:500;">Created</th>
                <th style="text-align:left; padding:8px 12px; font-weight:500;">Expires</th>
                <th style="text-align:left; padding:8px 12px; font-weight:500;">Status</th>
                <th style="padding:8px 12px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var key in existingKeys)
            {
                var expired = key.ExpiresAt < DateTime.UtcNow;
                <tr style="border-bottom:1px solid var(--lv2);">
                    <td style="padding:10px 12px;">@key.Name</td>
                    <td style="padding:10px 12px; font-family:monospace; color:var(--lv6);">@key.KeyPrefix…</td>
                    <td style="padding:10px 12px; color:var(--lv5);">@key.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td style="padding:10px 12px; color:@(expired ? "var(--CSignal)" : "var(--lv5)");">
                        @key.ExpiresAt.ToString("yyyy-MM-dd")
                        @if (expired) { <span> (expired)</span> }
                    </td>
                    <td style="padding:10px 12px;">
                        @if (key.IsRevoked)
                        {
                            <Chip Color="var(--lv3)" TextColor="var(--lv5)">Revoked</Chip>
                        }
                        else if (expired)
                        {
                            <Chip Color="var(--lv3)" TextColor="var(--lv5)">Expired</Chip>
                        }
                        else
                        {
                            <Chip Color="var(--CTeal)" TextColor="#080809">Active</Chip>
                        }
                    </td>
                    <td style="padding:10px 12px; text-align:right;">
                        @if (!key.IsRevoked && !expired)
                        {
                            <Button Variant="ghost" Size="micro" @onclick="() => ConfirmRevoke(key.Id)">Revoke</Button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (newlyCreatedToken == null)
{
    <p style="color:var(--lv5); margin-bottom:32px;">No API keys yet.</p>
}

@* ── REVOKE CONFIRMATION ── *@
@if (revokeConfirmId.HasValue)
{
    <div style="padding:16px; border:1px solid var(--CWarning); border-radius:var(--radius); background:rgba(255,178,41,0.08); margin-bottom:24px; display:flex; align-items:center; gap:16px;">
        <span>Revoke this key? Any requests using it will immediately fail.</span>
        <Button Variant="danger" Size="micro" @onclick="ExecuteRevoke">Yes, revoke</Button>
        <Button Variant="secondary" Size="micro" @onclick="() => revokeConfirmId = null">Cancel</Button>
    </div>
}

@* ── CREATE FORM ── *@
@if (!showCreateForm)
{
    <Button Variant="primary" Size="micro" @onclick="() => showCreateForm = true">New API key</Button>
}
else
{
    <div style="border:1px solid var(--lv3); border-radius:var(--radius); padding:24px; max-width:480px; margin-bottom:32px;">
        <h3 style="margin-top:0;">Create API key</h3>

        <label style="display:block; margin-bottom:6px; font-size:13px;">Name</label>
        <input style="width:100%; padding:10px; border:1px solid var(--lv3); border-radius:var(--radius); background:var(--lv0); color:var(--lv8); font-size:13px; box-sizing:border-box; margin-bottom:16px;"
               placeholder="e.g. Production, CI/CD"
               @bind="newKeyName" />

        <label style="display:block; margin-bottom:6px; font-size:13px;">Expiration</label>
        <div style="margin-bottom:20px;">
            <SelectField Value="@selectedExpirationDays.ToString()"
                         ValueChanged="@(v => { if (int.TryParse(v, out var d)) selectedExpirationDays = d; })"
                         Options="_expirationOptions" />
        </div>

        <div style="display:flex; gap:10px;">
            <Button Variant="primary" Size="micro" @onclick="CreateKey" Disabled="@isCreating">
                @(isCreating ? "Creating…" : "Create")
            </Button>
            <Button Variant="secondary" Size="micro" @onclick='() => { showCreateForm = false; newKeyName = ""; }'>Cancel</Button>
        </div>
    </div>
}

@* ── USAGE EXAMPLES (shown after creation) ── *@
@if (newlyCreatedToken != null)
{
    <div style="margin-top:32px;">
        <h3>How to use this key</h3>

        <h4>cURL</h4>
        <pre style="padding:15px; background:var(--lv1); border:1px solid var(--lv3); border-radius:var(--radius); overflow-x:auto; font-family:monospace; font-size:11px; margin:10px 0 24px;"><code>curl -X PUT "https://localhost:5001/api/CreateOrOpen/myDataset/1" \
     -H "Authorization: Bearer @newlyCreatedToken"</code></pre>

        <h4>JavaScript / Fetch</h4>
        <pre style="padding:15px; background:var(--lv1); border:1px solid var(--lv3); border-radius:var(--radius); overflow-x:auto; font-family:monospace; font-size:11px; margin:10px 0 24px;"><code>fetch('https://localhost:5001/api/CreateOrOpen/myDataset/1', {
  method: 'PUT',
  headers: { 'Authorization': 'Bearer @newlyCreatedToken' }
})</code></pre>

        <h4>C# HttpClient</h4>
        <pre style="padding:15px; background:var(--lv1); border:1px solid var(--lv3); border-radius:var(--radius); overflow-x:auto; font-family:monospace; font-size:11px; margin:10px 0 24px;"><code>client.DefaultRequestHeaders.Authorization =
    new AuthenticationHeaderValue("Bearer", "@newlyCreatedToken");</code></pre>

        <h4>Python</h4>
        <pre style="padding:15px; background:var(--lv1); border:1px solid var(--lv3); border-radius:var(--radius); overflow-x:auto; font-family:monospace; font-size:11px; margin:10px 0;"><code>headers = { 'Authorization': f'Bearer @newlyCreatedToken' }</code></pre>

        <div style="margin-top:24px;">
            <Button Href="/swagger" Variant="secondary" Size="micro">View API docs</Button>
        </div>
    </div>
}

@* ── MCP / AI agents ── *@
@{
    var mcpEnabled = Settings.Load().McpEnabled;
    var mcpUrl = Nav.BaseUri.TrimEnd('/') + "/mcp";
    var mcpSnippet =
        "{\n  \"mcpServers\": {\n    \"indx\": {\n      \"command\": \"npx\",\n" +
        "      \"args\": [\"mcp-remote\", \"" + mcpUrl + "\", \"--header\", \"Authorization: Bearer <your-api-key>\"]\n" +
        "    }\n  }\n}";
}
@if (mcpEnabled)
{
    <div style="margin-top:32px; padding: 20px; border: 1px solid var(--lv2); border-radius: var(--radius); background: var(--lv1);">
        <strong>Use with AI agents (MCP)</strong>
        <p style="color:var(--lv5); font:var(--text-sm); margin:8px 0 0;">
            Add this as a remote MCP server in your AI client:
            <code>@mcpUrl</code> — authenticate with any API key above as a <strong>Bearer</strong> token.
        </p>
        <p style="color:var(--lv4); font:var(--text-xs); margin:10px 0 6px;">
            Clients without a header field can use the <code>mcp-remote</code> bridge:
        </p>
        <textarea style="width:100%; padding:10px; border:1px solid var(--lv3); border-radius:var(--radius); background:var(--lv0); color:var(--lv8); font-family:monospace; font-size:11px;"
                  rows="8" readonly>@mcpSnippet</textarea>
    </div>
}

@code {
    private List<Data.ApiKey> existingKeys = new();
    private string? newlyCreatedToken;
    private string? copyMessage;
    private string? errorMessage;
    private bool showCreateForm = false;
    private bool isCreating = false;
    private string newKeyName = "";
    private int selectedExpirationDays = 90;
    private readonly List<SelectField.SelectOption> _expirationOptions = new()
    {
        new("30 days", "30"),
        new("90 days (recommended)", "90"),
        new("180 days", "180"),
        new("1 year", "365"),
    };
    private int? revokeConfirmId;
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.GetUserAsync(authState.User);
        if (appUser == null) return;
        currentUserId = appUser.Id;
        await LoadKeys();
    }

    private async Task LoadKeys()
    {
        if (currentUserId == null) return;
        existingKeys = await Db.ApiKeys
            .Where(k => k.UserId == currentUserId)
            .OrderByDescending(k => k.CreatedAt)
            .ToListAsync();
    }

    private async Task CreateKey()
    {
        if (string.IsNullOrWhiteSpace(newKeyName))
        {
            errorMessage = "Please enter a name for this key.";
            return;
        }

        isCreating = true;
        errorMessage = null;
        newlyCreatedToken = null;
        StateHasChanged();

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var appUser = await UserManager.GetUserAsync(authState.User);
            if (appUser == null) { errorMessage = "User not found."; return; }

            var jti = Guid.NewGuid().ToString();
            var token = GenerateJwtToken(appUser, selectedExpirationDays, jti);

            var record = new Data.ApiKey
            {
                UserId = appUser.Id,
                Name = newKeyName.Trim(),
                KeyPrefix = token[..Math.Min(24, token.Length)],
                Jti = jti,
                CreatedAt = DateTime.UtcNow,
                ExpiresAt = DateTime.UtcNow.AddDays(selectedExpirationDays),
                IsRevoked = false
            };

            Db.ApiKeys.Add(record);
            await Db.SaveChangesAsync();

            newlyCreatedToken = token;
            showCreateForm = false;
            newKeyName = "";
            await LoadKeys();
            Logger.LogInformation("API key created for user {UserId}, expires {Expires}", appUser.Id, record.ExpiresAt);
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to create key.";
            Logger.LogError(ex, "Error creating API key");
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }

    private void ConfirmRevoke(int id)
    {
        revokeConfirmId = id;
    }

    private async Task ExecuteRevoke()
    {
        if (revokeConfirmId == null) return;
        var key = existingKeys.FirstOrDefault(k => k.Id == revokeConfirmId);
        if (key == null || key.UserId != currentUserId) return;

        key.IsRevoked = true;
        await Db.SaveChangesAsync();
        revokeConfirmId = null;
        await LoadKeys();
        Logger.LogInformation("API key {Id} revoked for user {UserId}", key.Id, key.UserId);
    }

    private string GenerateJwtToken(ApplicationUser user, int expirationDays, string jti)
    {
        var jwtKey = Configuration["Jwt:Key"]
            ?? throw new InvalidOperationException("JWT Key is not configured");

        var securityKey = new SymmetricSecurityKey(Encoding.UTF8.GetBytes(jwtKey));
        var credentials = new SigningCredentials(securityKey, SecurityAlgorithms.HmacSha256);

        var claims = new List<Claim>
        {
            new Claim(ClaimTypes.Email, user.Email ?? ""),
            new Claim(ClaimTypes.NameIdentifier, user.Id),
            new Claim(ClaimTypes.Name, user.UserName ?? user.Email ?? ""),
            new Claim(JwtRegisteredClaimNames.Sub, user.Id),
            new Claim(JwtRegisteredClaimNames.Email, user.Email ?? ""),
            new Claim(JwtRegisteredClaimNames.Jti, jti)
        };

        var roles = UserManager.GetRolesAsync(user).Result;
        foreach (var role in roles)
            claims.Add(new Claim(ClaimTypes.Role, role));

        var token = new JwtSecurityToken(
            issuer: Configuration["Jwt:Issuer"],
            audience: Configuration["Jwt:Audience"],
            claims: claims,
            expires: DateTime.UtcNow.AddDays(expirationDays),
            signingCredentials: credentials);

        return new JwtSecurityTokenHandler().WriteToken(token);
    }

    private async Task CopyNewToken()
    {
        if (string.IsNullOrEmpty(newlyCreatedToken)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("copyToClipboard", newlyCreatedToken);
            copyMessage = "Copied to clipboard";
            StateHasChanged();
            await Task.Delay(3000);
            copyMessage = null;
            StateHasChanged();
        }
        catch
        {
            copyMessage = "Copy failed — please select and copy manually.";
            StateHasChanged();
        }
    }
}
