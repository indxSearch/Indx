@page "/account/change-password"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using IndxCloudApi.Data
@using IndxCloudApi.Components.Account
@using IndxCloudApi.Components.Account.Shared
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject ILogger<ChangePassword> Logger
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache MemoryCache

<PageTitle>Change password</PageTitle>

<div style="max-width: 360px;">
    <a href="/account/manage" style="font: var(--text-sm);">← Back to account</a>
    <h2 style="margin: 12px 0 16px;">Change password</h2>

    <StatusMessage Message="@_message" />

    @if (!_hasPassword)
    {
        <p style="color: var(--lv5);">
            You signed in with an external provider and don't have a password to change.
        </p>
    }
    else
    {
        <EditForm Model="Input" FormName="change-password" method="post" OnValidSubmit="OnValidSubmitAsync">
            <DataAnnotationsValidator />
            <ValidationSummary style="color: var(--CSignal);" role="alert" />

            <div style="margin-bottom: 12px;">
                <InputField Label="Current password" type="password" autocomplete="current-password" @bind-Value="Input.OldPassword" />
                <ValidationMessage For="() => Input.OldPassword" />
            </div>
            <div style="margin-bottom: 12px;">
                <InputField Label="New password" type="password" autocomplete="new-password" @bind-Value="Input.NewPassword" />
                <ValidationMessage For="() => Input.NewPassword" />
            </div>
            <div style="margin-bottom: 16px;">
                <InputField Label="Confirm new password" type="password" autocomplete="new-password" @bind-Value="Input.ConfirmPassword" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
            </div>
            <p style="font: var(--text-xs); color: var(--lv5); margin-bottom: 20px;">
                At least 8 characters with an uppercase letter, a digit and a non-alphanumeric character.
            </p>
            <Button Type="submit" Variant="primary">Update password</Button>
        </EditForm>
    }
</div>

@code {
    private string? _message;
    private bool _hasPassword;
    private ApplicationUser _user = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _hasPassword = await UserManager.HasPasswordAsync(_user);
    }

    private async Task OnValidSubmitAsync()
    {
        var result = await UserManager.ChangePasswordAsync(_user, Input.OldPassword, Input.NewPassword);
        if (result.Succeeded)
            IndxCloudApi.Services.TokenValidationCache.EvictUser(MemoryCache, _user.Id); // retire outstanding login tokens now
        if (!result.Succeeded)
        {
            _message = "Error: " + string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        // Clear the first-login rotation flag if it was set (e.g. seeded admin).
        if (_user.MustChangePassword)
        {
            _user.MustChangePassword = false;
            await UserManager.UpdateAsync(_user);
        }

        await SignInManager.RefreshSignInAsync(_user);
        Logger.LogInformation("User changed their password.");
        Input = new();
        _message = "Your password has been changed.";
    }

    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Current password")]
        public string OldPassword { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "The {0} must be at least {2} characters long.")]
        [DataType(DataType.Password)]
        [Display(Name = "New password")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm new password")]
        [Compare(nameof(NewPassword), ErrorMessage = "The new password and confirmation do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
