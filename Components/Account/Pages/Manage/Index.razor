@page "/Account/Manage"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Identity.UI.Services
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@using System.Text.Encodings.Web
@using IndxCloudApi.Data
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IEmailSender EmailSender
@inject NavigationManager NavigationManager
@inject ILogger<Index> Logger
@inject IndxCloudApi.Services.InstanceSettingsService InstanceSettingsService

<PageTitle>Manage Account</PageTitle>

<h2>Manage Your Account</h2>
<p style="color: var(--lv5); margin-bottom: 40px;">Manage your account settings and preferences.</p>

@if (user != null)
{
    <div style="margin-bottom: 40px;">
        <h3>Account Information</h3>

        <div style="margin-top: 20px;">
            <p><strong>Email:</strong> @user.Email</p>

            <div style="margin-bottom: 20px;">
                <p>
                    <strong>Email Confirmed:</strong>
                    @if (user.EmailConfirmed)
                    {
                        <span style="color: var(--CTeal); margin-left: 10px;">✓ Confirmed</span>
                    }
                    else
                    {
                        <span style="color: var(--CWarning); margin-left: 10px;">⚠ Not Confirmed</span>
                    }
                </p>
                @if (!user.EmailConfirmed)
                {
                    @if (emailResendSuccess)
                    {
                        <div style="color: var(--CTeal); margin-top: 10px;">Confirmation email sent!</div>
                    }
                    else if (!string.IsNullOrEmpty(emailResendError))
                    {
                        <div style="color: var(--CSignal); margin-top: 10px;">@emailResendError</div>
                    }
                    else
                    {
                        <Button Variant="ghost" Size="micro" style="margin-top: 10px;" @onclick="ResendConfirmationEmail" Disabled="@isResending">
                            @if (isResending) { <span>Sending...</span> }
                            else { <span>Resend Confirmation Email</span> }
                        </Button>
                    }
                }
            </div>

        </div>

        <div style="margin-top: 28px;">
            <h3 style="margin-bottom: 12px;">Notifications</h3>
            <ToggleSwitch Checked="@(user.EmailNotificationsEnabled)" CheckedChanged="SaveEmailPref" Label="Send notification emails" />
            <p style="font:var(--text-xs); color:var(--lv4); margin:6px 0 0;">
                In-app notifications are always delivered. This controls whether emails are also sent.
            </p>
            @if (!string.IsNullOrEmpty(_emailPrefMessage))
            {
                <p style="font:var(--text-xs); color:var(--CTeal); margin:6px 0 0;">@_emailPrefMessage</p>
            }
        </div>

        <form method="post" action="Account/Logout" style="margin-top: 28px;">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="" />
            <button type="submit" class="btn btn-secondary btn-micro">Log out</button>
        </form>
    </div>

    @if (InstanceSettingsService.Load().AllowUserSelfDeletion)
    {
    <div style="margin-bottom: 40px;">
        <h3 style="color: var(--CSignal);">Danger Zone</h3>
        <p style="color: var(--lv5); margin-top: 10px;">
            Once you delete your account, there is no going back. This will permanently delete your account and all associated data.
        </p>

        @if (showDeleteConfirmation)
        {
            <div style="margin-top: 12px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                <span style="font: var(--text-xs); color: var(--lv5);">Type your email to confirm:</span>
                <input class="indx-input" @bind="confirmEmail" @bind:event="oninput" placeholder="@user?.Email" style="width: 200px;" />
                @if (CanDeleteAccount)
                {
                    <form action="Account/Manage/DeleteAccount" method="post" style="display:contents;">
                        <AntiforgeryToken />
                        <Button Type="submit" Variant="danger" Size="micro">Yes, Delete My Account</Button>
                    </form>
                }
                else
                {
                    <Button Variant="danger" Size="micro" Disabled="true">Yes, Delete My Account</Button>
                }
                <Button Variant="secondary" Size="micro" @onclick="CancelDelete">Cancel</Button>
            </div>
        }
        else
        {
            <Button Variant="ghost" Size="micro" IconLeft="_iconDelete" style="margin-top: 8px;" @onclick="ShowDeleteConfirmation">Delete My Account</Button>
        }
    </div>
    }
}
else
{
    <p>Loading account information...</p>
}

@code {
    private RenderFragment<int> _iconDelete => size => @<UserX Size="size" />;

    private ApplicationUser? user;
    private bool showDeleteConfirmation = false;
    private string confirmEmail = "";
    private bool isResending = false;
    private bool emailResendSuccess = false;
    private string? emailResendError = null;
    private string? _emailPrefMessage;

    private bool CanDeleteAccount => user != null && confirmEmail.Trim().ToLower() == user.Email?.ToLower();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;

        if (userName != null)
        {
            user = await UserManager.FindByNameAsync(userName);
        }
    }

    private async Task ResendConfirmationEmail()
    {
        if (user == null || string.IsNullOrEmpty(user.Email))
            return;

        isResending = true;
        emailResendSuccess = false;
        emailResendError = null;

        try
        {
            var userId = await UserManager.GetUserIdAsync(user);
            var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

            var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
                new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });

            var instanceName = InstanceSettingsService.Load().InstanceName;
            await EmailSender.SendEmailAsync(
                user.Email,
                IndxCloudApi.Services.EmailTemplates.Subject(instanceName, "Confirm your new email address"),
                IndxCloudApi.Services.EmailTemplates.ConfirmEmailChange(instanceName, callbackUrl));

            Logger.LogInformation("Resent confirmation email to {Email}", user.Email);
            emailResendSuccess = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error resending email confirmation");
            emailResendError = "Failed to send email. Please try again.";
        }
        finally
        {
            isResending = false;
        }
    }

    private void ShowDeleteConfirmation()
    {
        showDeleteConfirmation = true;
        confirmEmail = "";
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
        confirmEmail = "";
    }

    private async Task SaveEmailPref(bool enabled)
    {
        if (user == null) return;
        user.EmailNotificationsEnabled = enabled;
        await UserManager.UpdateAsync(user);
        _emailPrefMessage = enabled ? "Email notifications enabled." : "Email notifications disabled.";
        await Task.Delay(2000);
        _emailPrefMessage = null;
        StateHasChanged();
    }
}
