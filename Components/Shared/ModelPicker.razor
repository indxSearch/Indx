@* A model name for Search or ask: free text, since any model the provider serves will do, with the
   provider's own list to choose from once it is read (SearchOrAskModelLists). The list opens in
   place under the field, a filter and ghost Buttons, so nothing floats over the page. *@
@using IndxServer.Services.SearchOrAsk

<div class="model-picker">
    <InputField Label="@Label" Value="@Value" ValueChanged="@(v => ValueChanged.InvokeAsync(v ?? ""))" ValueExpression="() => Value" placeholder="@Placeholder" />
    @if (Models is { Count: > 0 })
    {
        <Button Variant="ghost" Size="micro" @onclick="() => _open = !_open">@(_open ? "Close the list" : $"Choose from {Models.Count} models")</Button>
        @if (_open)
        {
            <div class="model-picker-list">
                <SearchField Size="micro" Placeholder="Filter models" Value="@_filter" ValueChanged="@(v => _filter = v ?? "")" aria-label="Filter models" />
                @{ var shown = Filtered().Take(Shown).ToList(); }
                @foreach (var m in shown)
                {
                    var id = m.Id;
                    <Button Variant="@(id == Value ? "primary" : "ghost")" Size="micro" title="@(m.Price ?? m.Name ?? id)" @onclick="() => PickAsync(id)">
                        <span class="model-picker-id">@id</span>
                        @if (m.Price != null) { <span class="model-picker-price">@m.Price</span> }
                    </Button>
                }
                @if (shown.Count == 0)
                {
                    <p class="model-picker-note">No model matches.</p>
                }
                else if (Filtered().Count() > Shown)
                {
                    <p class="model-picker-note">The first @Shown; filter to find the rest.</p>
                }
            </div>
        }
    }
</div>

@code {
    private const int Shown = 40;
    private bool _open;
    private string _filter = "";

    [Parameter] public string? Label { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public IReadOnlyList<ModelOption>? Models { get; set; }

    private IEnumerable<ModelOption> Filtered() =>
        string.IsNullOrWhiteSpace(_filter) ? Models ?? []
        : (Models ?? []).Where(m => m.Id.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)
                                   || (m.Name?.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    private async Task PickAsync(string id)
    {
        _open = false;
        await ValueChanged.InvokeAsync(id);
    }
}
