@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using IndxServer.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject OnboardingService Onboarding
@inject ActiveTeamState ActiveTeam
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IndxServer.Services.Observr.ObservrSubscription Observr
@* Show me around (Nov 2026; mockup: indx-react/apps/components, "Get started"): a stop at a time,
   the rest of the console dimmed, the part a stop is about outlined in the ink and left as it is,
   and a small surface beside it with what it is and Back, Next and Skip. No shadow, no glow: the
   dim and a 1px line. The parts carry data-tour marks; a part not on the page is skipped. Started
   from Get started, the welcome on a team page or the account menu, through OnboardingService;
   finishing or skipping both mark the step. Escape ends it. *@
@if (_box is { } box && _at is { } at)
{
    var stop = Stops[at];
    const double pad = 4;
    double x = box.X - pad, y = box.Y - pad, w = box.W + 2 * pad, h = box.H + 2 * pad;
    // Beside a part at the window's left edge (the column), else under it, kept in the window.
    var right = box.X < 40 && box.Y >= 40;
    const double cw = 300, ch = 200;
    var left = right ? Math.Min(x + w + 12, box.Vw - cw - 12) : Math.Max(12, Math.Min(x, box.Vw - cw - 12));
    var top = right ? Math.Max(12, Math.Min(y + h - ch, box.Vh - ch - 12)) : Math.Min(y + h + 12, box.Vh - ch - 12);
    <div class="tour" role="dialog" aria-modal="true" aria-label="@($"Tour: {stop.Title}")" @onkeydown="Key" tabindex="-1" @ref="_root">
        <div class="tour-dim" style="@Rect(0, 0, box.Vw, Math.Max(0, y))"></div>
        <div class="tour-dim" style="@Rect(0, y + h, box.Vw, Math.Max(0, box.Vh - y - h))"></div>
        <div class="tour-dim" style="@Rect(0, y, Math.Max(0, x), h)"></div>
        <div class="tour-dim" style="@Rect(x + w, y, Math.Max(0, box.Vw - x - w), h)"></div>
        <div class="tour-outline" style="@Rect(x, y, w, h)"></div>
        <div class="tour-callout" style="@($"left:{Px(left)};top:{Px(top)};width:{Px(cw)}")">
            <div class="tour-head">
                <span class="tour-title">@stop.Title</span>
                @if (stop.Pro && !Observr.Visible) { <Chip>Pro</Chip> }
                <span class="tour-spacer"></span>
                <span class="tour-count">@(_shown.IndexOf(at) + 1) of @_shown.Count</span>
            </div>
            <p class="tour-text">@(stop.Pro && !Observr.Visible ? stop.Without : stop.Text)</p>
            <ScoreMeter Value="@((double)(_shown.IndexOf(at) + 1) / _shown.Count)" Cells="@(_shown.Count * 4)" Cell="4" AriaLabel="@($"Stop {_shown.IndexOf(at) + 1} of {_shown.Count}")" />
            <div class="tour-actions">
                <Button Variant="ghost" Size="micro" @onclick="EndAsync">Skip</Button>
                <span class="tour-spacer"></span>
                @if (_shown.IndexOf(at) > 0) { <Button Variant="secondary" Size="micro" @onclick="() => MoveAsync(-1)">Back</Button> }
                <Button Variant="primary" Size="micro" @onclick="() => MoveAsync(1)">@(_shown.IndexOf(at) + 1 < _shown.Count ? "Next" : "Done")</Button>
            </div>
        </div>
    </div>
}

@code {
    private sealed record Stop(string Target, string Title, string Text, bool Pro = false, string Without = "");
    private sealed record Box(double X, double Y, double W, double H, double Vw, double Vh);

    private static readonly Stop[] Stops =
    [
        new("column", "Sections", "Everything about the team, or the dataset you are in, is listed here. Fold it to icons with ⌘B."),
        new("trail", "Where you are", "The team, then the dataset. Click either to switch to another."),
        new("jump", "Jump to", "⌘K finds any page, dataset or setting by its name."),
        new("datasets", "Your datasets", "Each card shows how a dataset is doing: ready, asleep or indexing. Open one to search it, tune it and read its statistics."),
        new("bell", "Notifications", "What happened while you were away: an index that finished, a webhook batch held back."),
        new("agent", "Observr", "Ask about your search in plain words, and read what Observr noticed this week.", Pro: true,
            Without: "With Pro, ask about your search in plain words, and read what Observr noticed this week."),
        new("getstarted", "Get started", "Your checklist stays here until everything is done. The tour is under your account menu if you want it again."),
    ];

    private IJSObjectReference? _module;
    private DotNetObjectReference<ConsoleTour>? _self;
    private ElementReference _root;
    private int? _at;
    private Box? _box;
    private List<int> _shown = [];

    protected override void OnInitialized() => Onboarding.TourRequested += OnRequested;

    private void OnRequested() => _ = InvokeAsync(StartAsync);

    private async Task StartAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/console-tour.js");
        // The stops whose part is on this page now; the rest are skipped.
        _shown = [];
        for (var i = 0; i < Stops.Length; i++)
            if (await _module.InvokeAsync<Box?>("measure", Stops[i].Target) != null) _shown.Add(i);
        if (_shown.Count == 0) return;
        _self ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("follow", _self);
        await ShowAsync(_shown[0]);
    }

    private async Task ShowAsync(int at)
    {
        _at = at;
        _box = await _module!.InvokeAsync<Box?>("measure", Stops[at].Target);
        StateHasChanged();
        try { await _root.FocusAsync(); } catch (InvalidOperationException) { /* not drawn yet */ }
    }

    [JSInvokable]
    public async Task Remeasure()
    {
        if (_at is { } at && _module != null)
        {
            _box = await _module.InvokeAsync<Box?>("measure", Stops[at].Target);
            StateHasChanged();
        }
    }

    private async Task MoveAsync(int by)
    {
        var i = _shown.IndexOf(_at ?? 0) + by;
        if (i >= _shown.Count) { await EndAsync(); return; }
        if (i >= 0) await ShowAsync(_shown[i]);
    }

    private async Task Key(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await EndAsync();
        else if (e.Key == "ArrowRight") await MoveAsync(1);
        else if (e.Key == "ArrowLeft") await MoveAsync(-1);
    }

    /// <summary>Skipped or finished: the tour step is done either way, on the page's team.</summary>
    private async Task EndAsync()
    {
        _at = null;
        _box = null;
        if (_module != null) await _module.InvokeVoidAsync("stop");
        StateHasChanged();
        var user = (await AuthState.GetAuthenticationStateAsync()).User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var seg = new Uri(Navigation.Uri).AbsolutePath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        var name = seg.Length >= 2 && seg[0].Equals("teams", StringComparison.OrdinalIgnoreCase) ? Uri.UnescapeDataString(seg[1]) : ActiveTeam.ActiveTeamName;
        if (user != null && ActiveTeam.Find(name) is { } team)
            await Onboarding.MarkAsync(user, team.Team.Id.ToString(), OnboardingService.Tour);
    }

    private static string Px(double v) => FormattableString.Invariant($"{v:0.#}px");
    private static string Rect(double x, double y, double w, double h) => $"left:{Px(x)};top:{Px(y)};width:{Px(w)};height:{Px(h)}";

    public async ValueTask DisposeAsync()
    {
        Onboarding.TourRequested -= OnRequested;
        if (_module != null)
        {
            try { await _module.InvokeVoidAsync("stop"); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
