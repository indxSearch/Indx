@using IndxServer.Engine
@using IndxServer.Data
@using IndxServer.Models
@using IndxServer.Services
@using IndxServer.Services.Observr
@using IndxServer.Components.Datasets
@inject ObservrFindingStore Findings
@inject ObservrClient Observr
@inject AgentPanelState Agent
@inject HeaderState Header
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Observr · @Team.Name</PageTitle>

@* The team's Observr page: [team ▾] › Observr (Notes/Anders/observr-plan.md). What Observr does on
   each of the team's datasets, chosen by the team's editors: on or off, how often it reports, and
   whether its buttons show in the dataset's tabs. Below, everything Observr has found for the
   team, with Yes and No for editors. Viewers read both. Reached from the Observr button on the
   team page, shown only while an admin has Observr on for the instance. Which datasets it watches
   is its own page beside this one (TeamObservrDatasetsView). Hosted by Pages/ConsolePage. *@

<div>
    @{
        var onCount = _rows?.Count(r => r.Settings.Enabled) ?? 0;
        var allCount = _rows?.Count ?? 0;
    }
    <div class="tov-heading">
        <h2 class="indx-section-heading indx-section-heading--first">Observr</h2>
        @if (_rows != null && allCount > 0)
        {
            @* Which datasets Observr watches: a dialog, since it is set once and read rarely,
               and the page is the findings. The label says what is on, so nobody opens it to know. *@
            <Button Variant="ghost" Size="micro" IconLeft="_iconRecorder" Href="@TeamRoutes.TeamObservrDatasets(Team.Name)" title="Which datasets Observr watches">Datasets · @onCount of @allCount on</Button>
        }
    </div>
    <p class="indx-section-help">
        Observr reads each watched dataset's statistics every morning, never a record, never a visitor, and puts what is
        worth your attention here and on the dataset's Status page.
    </p>

    @{
        var openCount = _findings.Count(f => f.Status == ObservrFinding.Open);
        var weekAgo = DateTime.UtcNow.AddDays(-7);
        var decidedThisWeek = _findings.Count(f => f.Status != ObservrFinding.Open && f.DecidedUtc >= weekAgo);
        var latest = _findings.Count > 0 ? _findings.Max(f => f.CreatedUtc) : (DateTime?)null;
    }
    @if (_rows != null && onCount == 0 && _findings.Count == 0)
    {
        @* The first visit: nothing watched, nothing found. No tabs to an empty list; what happens
           once a dataset is on, in the shape of the console's other empty pages, and the datasets
           right here to switch on. *@
        <div class="tov-empty">
            <span class="tov-empty-icon"><Observr Size="70" Color="var(--lv4)" /></span>
            <div class="tov-empty-title">Observr is not watching anything here yet</div>
            <div class="tov-empty-detail">
                Switch it on for a dataset and it reads that dataset's week every morning. What is worth your attention lands on
                the dataset's Status page, each with a proposal you say yes or no to.@if (!_canEdit) { <text> An editor of this team switches it on.</text> }
            </div>
        </div>
        <ObservrDatasetsTable Team="Team" Role="@Role" OnChanged="LoadAsync" />
    }
    else
    {
        @* The team's week in four numbers, as the Statistics page opens. *@
        <StatGroup Columns="4" Class="tov-stats">
            <Stat Label="Watched" ValueContent="@(Tile($"{onCount} of {_rows?.Count ?? 0}"))" />
            <Stat Label="Waiting for a decision" ValueContent="@(Tile(openCount.ToString()))" />
            <Stat Label="Decided this week" ValueContent="@(Tile(decidedThisWeek.ToString()))" />
            <Stat Label="Latest finding" ValueContent="@LatestTile(latest)" />
        </StatGroup>

        <div class="indx-context-bar tov-bar">
            <Tabs Items="@ViewItems(openCount)" Active="@_view" ActiveChanged="@(v => _view = v ?? Open)" Size="micro" Variant="button" AriaLabel="Findings shown" />
            <div class="indx-context-bar-end">
                @if (DatasetOptions.Count > 2)
                {
                    <SelectField Size="micro" Variant="ghost" Options="DatasetOptions" Value="@(_dataset ?? "")" ValueChanged="v => _dataset = string.IsNullOrEmpty(v) ? null : v" aria-label="Dataset" />
                }
                @if (KindOptions.Count > 2)
                {
                    <SelectField Size="micro" Variant="ghost" Options="KindOptions" Value="@(_kind ?? "")" ValueChanged="v => _kind = string.IsNullOrEmpty(v) ? null : v" aria-label="Kind of finding" />
                }
            </div>
        </div>

        <ObservrFindingList Findings="Shown()" Grid Link="@(f => $"{TeamRoutes.Dataset(Team.Name, f.DataSetName)}?tab={f.Tab}")" CanDecide="_canEdit" Busy="_busy"
                                OnDecide="d => DecideAsync(d.Finding, d.Yes, d.Only)" OnDiscuss="Discuss" OnHide="HideAsync" KindIcon="StatusTab.KindIcon"
                                Empty="@(_view == Open
                                    ? (_findings.Count == 0
                                        ? (onCount == 0 ? "Nothing yet: Observr is on for none of the team's datasets. Switch some on under Datasets." : "Nothing yet. The first report comes the morning after a dataset is switched on; Send this week's summary under Datasets brings it now.")
                                        : "Nothing waiting for a decision.")
                                    : "Nothing decided yet.")" />
    }
</div>

@code {
    /// <summary>The Datasets button's icon: the recorder, for what Observr watches and records, not
    /// the fields icon it borrowed.</summary>
    private static readonly RenderFragment<int> _iconRecorder = size => @<Recorder Size="size" Color="currentColor" />;
    [Parameter, EditorRequired] public Team Team { get; set; } = default!;
    [Parameter] public string? Role { get; set; }

    private sealed record Row(string DataSetName, ObservrDatasetSettings Settings, int Open);


    private const string Open = "open", Archive = "archive";

    private static List<Tabs.TabItem> ViewItems(int open) =>
    [
        new("Open", Open, DatasetIcons.OpenFinding, Badge: open > 0 ? open.ToString() : null, BadgeTone: "info"),
        new("Archive", Archive, DatasetIcons.Archive),
    ];

    private static RenderFragment Tile(string text) => @<text>@text</text>;
    private static RenderFragment LatestTile(DateTime? at) => at is { } t ? @<TimeAgo Value="t" /> : Tile("—");

    private string _view = Open;
    private string? _dataset, _kind;

    private List<ObservrFinding> Shown() => _findings
        .Where(f => _view == Open ? f.Status == ObservrFinding.Open : f.Status != ObservrFinding.Open)
        .Where(f => _dataset == null || f.DataSetName == _dataset)
        .Where(f => _kind == null || KindOf(f) == _kind)
        .ToList();

    private static string KindOf(ObservrFinding f) => f.Kind.StartsWith(ObservrClient.DigestKind) ? ObservrClient.DigestKind : f.Kind;

    private List<SelectField.SelectOption> DatasetOptions =>
        new List<SelectField.SelectOption> { new("All datasets", "") }
            .Concat(_findings.Select(f => f.DataSetName).Distinct().OrderBy(n => n).Select(n => new SelectField.SelectOption(n, n)))
            .ToList();

    private List<SelectField.SelectOption> KindOptions =>
        new List<SelectField.SelectOption> { new("All kinds", "") }
            .Concat(_findings.Select(KindOf).Distinct().OrderBy(k => StatusTab.KindLabel(k)).Select(k => new SelectField.SelectOption(StatusTab.KindLabel(k), k)))
            .ToList();

    /// <summary>Into the Agent panel, with the finding named.</summary>
    private void Discuss(ObservrFinding f) => Agent.Open($"About your finding \u201c{f.Title}\u201d on {f.DataSetName}: ");

    private async Task HideAsync(ObservrFinding f)
    {
        if (!_canEdit) return;
        Findings.Remove(f.Id);
        await LoadAsync();
    }

    private string TeamId => Team.Id.ToString();
    private bool _canEdit;
    private List<Row>? _rows;
    private List<ObservrFinding> _findings = [];
    private long _busy;
    private Guid _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        Header.Set(this, b =>
        {
            b.OpenComponent<ConsoleBreadcrumb>(0);
            b.AddAttribute(1, "TeamName", Team.Name);
            b.AddAttribute(2, "Page", "Observr");
            b.CloseComponent();
        });
        _canEdit = TeamRoles.CanWrite(Role);
        if (_loadedFor == Team.Id) return;
        _loadedFor = Team.Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // The registry's list and the finding store only: never GetState, which loads a sleeping dataset.
        var team = TeamId;
        var (rows, findings) = await Task.Run(() =>
        {
            var settings = Findings.SettingsForTeam(team);
            var all = Findings.List([team]);
            var rows = (IndxServerInternalApi.ManagerOrNull?.GetAllDataSets() ?? []).Where(d => d.TeamId == team)
                .Select(d => new Row(d.DataSetName, settings.GetValueOrDefault(d.DataSetName, ObservrDatasetSettings.Default),
                    all.Count(f => f.DataSetName == d.DataSetName && f.Status == ObservrFinding.Open)))
                .OrderByDescending(r => r.Settings.Enabled).ThenBy(r => r.DataSetName).ToList();
            return (rows, all);
        });
        _rows = rows;
        _findings = findings;
    }

    private async Task DecideAsync(ObservrFinding f, bool yes, IReadOnlyList<int>? only)
    {
        _busy = f.Id;
        try { await Task.Run(() => Observr.Decide(f.Id, yes, only)); }
        finally { _busy = 0; }
        await LoadAsync();
    }

    public void Dispose() => Header.Clear(this, keepIf: NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("teams/", StringComparison.OrdinalIgnoreCase));
}
