<div class="@_class">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Transparent { get; set; }
    [Parameter] public string? Class { get; set; }

    private string _class
    {
        get
        {
            var base_ = Transparent ? "indx-surface indx-surface-transparent" : "indx-surface";
            return string.IsNullOrEmpty(Class) ? base_ : $"{base_} {Class}";
        }
    }
}
