@* The Agent panel (Notes/Anders/console-shell-plan-2026-10-13.md, stage 5; Notes/observr-agent-plan.md):
   Observr as conversations, in a column at the right. What it shows is what Observr remembers
   (2 Nov 2026): one current conversation, read whole by the model, with a line where its memory
   starts if it outgrows it; New conversation instead of Clear, the earlier ones in History; each
   answer with what it looked at. The context, on a dataset page that dataset, elsewhere the active
   team, is a chip at the input, not a key that swaps the transcript. The findings are not here: a
   dataset's wait on its Status page, a team's on its Observr page, each with Yes and No; Discuss
   there brings one into this conversation. The tabs' buttons (Review my setup, Ask about this
   query, …) run their ask here, as a turn. An island of its own: the layout renders statically. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using System.Security.Claims
@using IndxServer.Services
@using IndxServer.Services.Observr
@inject NavigationManager Nav
@inject ActiveTeamState ActiveTeam
@inject AgentPanelState Agent
@inject ObservrSubscription Subscription
@inject ObservrFindingStore Findings
@inject ObservrConversationStore Conversations
@inject ObservrChat Chat
@inject ObservrClient Observr
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

@if (!Subscription.Visible || _ctx == null) { return; }

@* Always in the tree so the width can slide; the chat is built only while open. *@
<aside class="shell-agent @(Agent.IsOpen ? "shell-agent--open" : null)" aria-label="Agent" aria-hidden="@(Agent.IsOpen ? null : "true")">
@if (Agent.IsOpen)
{
    <ChatPanel Class="agent-chat" Hints="false">
        <Header>
            <div class="agent-head">
                @if (_history)
                {
                    <Button Variant="ghost" Size="micro" aria-label="Back to the conversation" IconLeft="_iconBack" @onclick="() => _history = false" />
                    <span class="agent-title">Conversations</span>
                }
                else if (_memory)
                {
                    <Button Variant="ghost" Size="micro" aria-label="Back to the conversation" IconLeft="_iconBack" @onclick="() => _memory = false" />
                    <span class="agent-title" title="What Observr knows about @_ctx.DataSetName"><span class="agent-title-text">What Observr knows about @_ctx.DataSetName</span></span>
                }
                else
                {
                    <span class="agent-title" title="@Title()"><Observr Size="14" Color="currentColor" /><span class="agent-title-text">@Title()</span></span>
                }
                <span class="agent-spacer"></span>
                @if (!_history && !_memory)
                {
                    <Tooltip Content="History" Position="bottom"><Button Variant="ghost" Size="micro" aria-label="History" IconLeft="_iconHistory" @onclick="OpenHistory" Disabled="@_running" /></Tooltip>
                }
                @if (_turns.Count > 0 || _history)
                {
                    <Tooltip Content="New conversation" Position="bottom"><Button Variant="ghost" Size="micro" aria-label="New conversation" IconLeft="_iconNew" @onclick="NewConversation" Disabled="@_running" /></Tooltip>
                }
                <Button Variant="ghost" Size="micro" aria-label="Close" IconLeft="_iconClose" @onclick="Agent.Close" />
            </div>
        </Header>
        <ChildContent>
            @if (_memory && _ctx.HasDataset)
            {
                @* The notes Observr keeps about the dataset: read with every question about it, so a No
                   holds beyond its conversation. The owner adds and forgets them here. *@
                var notes = Findings.NotesFor(_ctx.TeamId, _ctx.DatasetKey);
                <p class="agent-note">Observr reads these with every question about @_ctx.DataSetName, so it does not propose what you turned down. Forget what is no longer true.</p>
                <div class="agent-notes">
                    @foreach (var n in notes)
                    {
                        <div class="agent-note-row">
                            <div class="agent-note-text">@n.Text
                                <span class="agent-history-meta">@(n.Source == ObservrNote.Declined ? "Your No" : "You said") · <TimeAgo Value="n.CreatedUtc" TooltipPosition="left" /></span>
                            </div>
                            @if (_canDecide)
                            {
                                <Button Variant="ghost" Size="micro" aria-label="Forget this" IconLeft="_iconForget" @onclick="() => ForgetNote(n.Id)" />
                            }
                        </div>
                    }
                </div>
                @if (_canDecide)
                {
                    <div class="agent-note-add">
                        <InputField placeholder="Tell Observr something to keep in mind" Immediate @bind-Value="_note" maxlength="@ObservrFindingStore.MaxNoteLength" />
                        <Button Variant="secondary" Size="micro" Disabled="@string.IsNullOrWhiteSpace(_note)" @onclick="KeepNote">Keep</Button>
                    </div>
                }
            }
            else if (_history)
            {
                @* The History: the user's conversations, newest first, each where it began; one opens to read and continue. *@
                var all = Conversations.Conversations(_userId);
                @if (all.Count == 0)
                {
                    <p class="agent-note">No conversations yet.</p>
                }
                <div class="agent-history">
                    @foreach (var c in all)
                    {
                        <button type="button" class="agent-history-row @(c.Id == _conversationId ? "agent-history-row--current" : null)" @onclick="() => Open(c.Id)">
                            <span class="agent-history-title">@c.Title</span>
                            <span class="agent-history-meta">@Where(c.TeamId, c.DatasetName) · <TimeAgo Value="c.LastUtc" TooltipPosition="left" /> · @c.Turns turns@(c.Id == _conversationId ? " · current" : "")</span>
                        </button>
                    }
                </div>
                <p class="agent-note">A conversation stays current until you start a new one, or after four quiet hours. Open any of these to continue it.</p>
            }
            else if (_turns.Count == 0)
            {
                <AssistantMessage Label="Observr" Icon="_iconObservr">
                    <p>@Intro()</p>
                </AssistantMessage>
                <Suggestions Items="Suggested()" OnPick="SendAsync" />
            }
            @{ var current = _turns.FindLastIndex(t => t.Role == ObservrTurn.User); }
            @foreach (var (t, i) in _turns.Select((t, i) => (t, i)).Where(_ => !_history && !_memory))
            {
                @if (i == _rememberedFrom && i > 0)
                {
                    @* Honest about memory: the turns above this line are past what Observr reads. *@
                    <p class="agent-forgotten">Observr no longer reads the turns above. A new conversation keeps it focused.</p>
                }
                @* The exchange under way reads as the present; what came before it is history and
                   steps back a tone, since the thread is one and has no other break. *@
                var past = i < current ? "agent-past" : null;
                if (t.Role == ObservrTurn.User)
                {
                    @* A turn asked elsewhere says where, quietly, since the thread is one. *@
                    <UserMessage Class="@past">@if (Elsewhere(t) is { } where) { <span class="agent-where">@where</span> }@t.Text</UserMessage>
                }
                else
                {
                    <AssistantMessage Label="Observr" Icon="_iconObservr" Class="@past">
                        @if (t.LookedAt() is { Count: > 0 } looked)
                        {
                            @* What the answer looked at, kept with it: Observr reads it again with the answer. *@
                            <ToolSteps Summary="@(looked.Count == 1 ? "Looked at 1 thing" : $"Looked at {looked.Count} things")">
                                @foreach (var step in looked) { <ToolStep Icon="@StepIcon(step.Tool)">@step.Done</ToolStep> }
                            </ToolSteps>
                        }
                        @ChatMarkdown.Render(t.Text)
                        @if (t.FindingId is { } fid && _byId.TryGetValue(fid, out var finding) && finding.Status == ObservrFinding.Open)
                        {
                            <ObservrFindingList Findings="@([finding])" Link="Link" CanDecide="_canDecide" Busy="_busy" OnDecide="d => DecideAsync(d.Finding, d.Yes, d.Only)" Empty="" ProposalsOnly />
                        }
                        else if (t.FindingId is { } did && _byId.TryGetValue(did, out var decided))
                        {
                            <span class="agent-decided">@(decided.Status == ObservrFinding.Accepted ? "Applied." : "Declined.")</span>
                        }
                    </AssistantMessage>
                }
            }
            @if (_running && !_history && !_memory)
            {
                @* Observr's answer on its way, as its own message: the step it is on, then a few
                   skeleton lines where the answer will land. Writing gets the grow spinner. *@
                <AssistantMessage Label="Observr" Icon="_iconObservr" Class="agent-pending">
                    @if (_steps.Count > 0)
                    {
                        @* Each tool Observr has run, and the one it is running, with its spinner. *@
                        <ToolSteps>
                            @foreach (var step in _steps)
                            {
                                <ToolStep State="@(step.Finished ? "done" : "running")" Icon="@StepIcon(step.Tool)">@(step.Finished ? step.Done : step.Text)</ToolStep>
                            }
                        </ToolSteps>
                    }
                    @if (!_steps.Any(st => !st.Finished))
                    {
                        <StreamStatus SpinnerName="@(_status == "Writing" ? "grow" : Spinners.Names.First())">@_status…</StreamStatus>
                    }
                    <div class="agent-pending-lines">
                        <Skeleton Width="92%" />
                        <Skeleton Width="78%" Delay="0.05" />
                        <Skeleton Width="54%" Delay="0.1" />
                    </div>
                </AssistantMessage>
            }
            @if (_error != null)
            {
                <p class="agent-error">@_error</p>
            }
            else if (Observr.Allowance is { } allowance && (allowance.Spent() || allowance.Low()))
            {
                @* Before the owner types a question it cannot have answered, or as the last few go. *@
                <p class="agent-allowance">@(allowance.Spent()
                    ? allowance.SpentSentence()
                    : allowance.MonthLeft == 1 ? "One Observr ask left this month." : $"{ObservrAllowance.N(allowance.MonthLeft ?? 0)} Observr asks left this month.")</p>
            }
            <div @ref="_end"></div>
        </ChildContent>
        <Composer>
            @if (!_history && !_memory)
            {
                @* Where the question is about, once, at the input: a turn asked elsewhere says so itself.
                   On a dataset, the notes Observr keeps about it, a click away. *@
                <div class="agent-compose">
                    <div class="agent-compose-head">
                        <span class="agent-context-chip" title="@(_ctx.HasDataset ? $"About the dataset {_ctx.DataSetName}" : $"About the team {_ctx.TeamName}")">
                            <Chip Icon="@(_ctx.HasDataset ? _iconFields : _iconTeam)">About @(_ctx.HasDataset ? _ctx.DataSetName : _ctx.TeamName)</Chip>
                        </span>
                        @if (_ctx.HasDataset)
                        {
                            var count = Findings.NotesFor(_ctx.TeamId, _ctx.DatasetKey).Count;
                            <span class="agent-notes-link"><Button Variant="ghost" Size="micro" @onclick="() => _memory = true">@(count == 0 ? "Notes" : count == 1 ? "1 note" : $"{count} notes")</Button></span>
                        }
                    </div>
                    <Composer Value="@_draft" ValueChanged="v => _draft = v" OnSend="SendAsync" Streaming="@_running" Disabled="@(!_canAsk)" MaxLength="ObservrChat.MaxQuestion"
                              Placeholder="@(_canAsk ? (_ctx.HasDataset ? $"Ask about {_ctx.DataSetName}…" : $"Ask about {_ctx.TeamName}…") : "Editors can ask")" Icon="_iconComposer" />
                </div>
            }
        </Composer>
    </ChatPanel>
}
</aside>

@code {
    private ObservrChatContext? _ctx;
    private string _userId = "";
    private bool _canDecide, _canAsk;
    private List<ObservrTurn> _turns = [];
    private Dictionary<long, ObservrFinding> _byId = [];
    private readonly Dictionary<long, AgentAction> _actions = [];
    private int _scrolledFor = -1;
    private string _draft = "";
    private bool _running;
    private string _status = "";
    /// <summary>The tools run for the question under way; the last unfinished one is running.</summary>
    private readonly List<Step> _steps = [];
    /// <summary>The conversation shown and asked in; null for a new one, numbered by its first question.</summary>
    private long? _conversationId;
    /// <summary>A New conversation was asked for: the next load does not pick the current one back up.</summary>
    private bool _fresh;
    /// <summary>The first turn Observr reads (ObservrConversationStore.RememberedFrom); the line goes above it.</summary>
    private int _rememberedFrom;
    private bool _history;
    private bool _memory;
    private string? _note;
    private sealed record Step(string Text, string Done, string? Tool) { public bool Finished { get; set; } }
    private string? _error;
    private long _busy;
    private ElementReference _end;
    private bool _loaded;

    private static readonly RenderFragment<int> _iconObservr = size => @<Observr Size="size" Color="currentColor" />;
    /// <summary>The composer's icon at 14px, as in the header and the message heads. The Composer asks
    /// for 21, which suits the default AI agent (seven dots) but makes the solid Observr glyph loom.</summary>
    private static readonly RenderFragment<int> _iconComposer = _ => @<Observr Size="14" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconClose = size => @<IndentRight Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconSearch = size => @<Search Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconFields = size => @<Database Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconDocs = size => @<Book Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconTeam = size => @<UserGroup Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconHistory = size => @<Clock Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconNew = size => @<Plus Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconBack = size => @<ArrowLeft Size="size" Color="currentColor" />;
    private static readonly RenderFragment<int> _iconForget = size => @<Trash Size="size" Color="currentColor" />;

    /// <summary>A step's icon by its tool; the rest have the step's check.</summary>
    private static RenderFragment<int>? StepIcon(string? tool) => tool switch
    {
        "search" or "zero_hit_evidence" => _iconSearch,
        "fields" or "datasets" => _iconFields,
        "docs" => _iconDocs,
        _ => null,
    };

    /// <summary>Observr's progress: a tool call ends the one before it and runs; reading or
    /// writing ends them all and is the status line.</summary>
    private void OnStatus(ObservrChatStatus s)
    {
        foreach (var step in _steps) step.Finished = true;
        if (s.Tool != null) _steps.Add(new Step(s.Text, s.Done ?? s.Text, s.Tool));
        else _status = s.Text;
    }

    protected override async Task OnInitializedAsync()
    {
        Subscription.EnsureChecked();
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        if (_userId.Length > 0) await ActiveTeam.EnsureInitializedAsync(_userId);
        Agent.Changed += OnAgentChanged;
        Nav.LocationChanged += OnLocationChanged;
        ActiveTeam.OnChange += OnTeamChanged;
        Subscription.Changed += OnTeamChanged;
        Resolve();
    }

    public void Dispose()
    {
        Subscription.Changed -= OnTeamChanged;
        Agent.Changed -= OnAgentChanged;
        Nav.LocationChanged -= OnLocationChanged;
        ActiveTeam.OnChange -= OnTeamChanged;
    }

    /// <summary>The newest turn into view, whenever the thread grew or the panel opened
    /// (wwwroot/js/agent-thread.js, which scrolls the thread on the frames after this render).</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Agent.IsOpen) { _scrolledFor = -1; return; }
        var mark = _turns.Count * 2 + (_running ? 1 : 0);
        if (mark == _scrolledFor) return;
        _scrolledFor = mark;
        try { await JS.InvokeVoidAsync("indxAgent.scrollToEnd", _end); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private void OnAgentChanged() => _ = InvokeAsync(async () =>
    {
        Resolve();
        if (Agent.TakePrefill() is { } prefill) _draft = prefill;
        StateHasChanged();
        if (Agent.IsOpen && Agent.TakePending() is { } action) await RunActionAsync(action);
    });
    private void OnLocationChanged(object? s, LocationChangedEventArgs e) { Resolve(); _ = InvokeAsync(StateHasChanged); }
    private void OnTeamChanged() { Resolve(); _ = InvokeAsync(StateHasChanged); }

    /// <summary>Where the owner is, from the URL: a dataset of a team, or the active team.</summary>
    private void Resolve()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var seg = path.Split('?')[0].Split('/', StringSplitOptions.RemoveEmptyEntries);
        (Data.Team Team, string Role)? team = null;
        string? dataset = null, tab = null;
        if (seg.Length >= 2 && seg[0].Equals("teams", StringComparison.OrdinalIgnoreCase))
        {
            team = ActiveTeam.Find(Uri.UnescapeDataString(seg[1]));
            dataset = TeamRoutes.DatasetFromPath(path);
            tab = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).TryGetValue("tab", out var v) ? v.ToString() : null;
        }
        team ??= ActiveTeam.ActiveTeamId is { } id ? ActiveTeam.Teams.FirstOrDefault(t => t.Team.Id == id) : null;
        if (team?.Team == null) { _ctx = null; return; }
        _ctx = new ObservrChatContext(team.Value.Team.Id.ToString(), team.Value.Team.Name, dataset, dataset != null ? tab ?? "status" : null);
        _canDecide = TeamRoles.CanWrite(team.Value.Role);
        _canAsk = _canDecide;
        if (!_loaded) { _loaded = true; Load(); }
    }

    private void Load()
    {
        if (!_fresh) _conversationId ??= Conversations.Current(_userId, DateTime.UtcNow);
        _turns = _conversationId is { } conversation ? Conversations.Turns(_userId, conversation) : [];
        _rememberedFrom = ObservrConversationStore.RememberedFrom(_turns);
        _byId = [];
        foreach (var id in _turns.Where(t => t.FindingId != null).Select(t => t.FindingId!.Value).Distinct())
            if (Findings.Get(id) is { } f) _byId[f.Id] = f;
        // Not _error: Send and the actions reload in their finally, after a refusal set it, and
        // clearing it here showed nothing and put the question back in the composer without a
        // word (19 Oct 2026). Each path clears it as it starts.
    }

    /// <summary>Where a turn was asked, when that is not where the owner is now.</summary>
    private string? Elsewhere(ObservrTurn t)
    {
        if (_ctx == null || (t.TeamId == _ctx.TeamId && t.DatasetName == _ctx.DatasetKey)) return null;
        if (t.DatasetName.Length > 0) return t.DatasetName;
        return ActiveTeam.Teams.FirstOrDefault(x => x.Team.Id.ToString() == t.TeamId).Team?.Name ?? "another team";
    }

    /// <summary>The conversation's title: its first question, or "New conversation".</summary>
    private string Title()
    {
        var first = _turns.FirstOrDefault(t => t.Role == ObservrTurn.User)?.Text.Trim().ReplaceLineEndings(" ");
        return string.IsNullOrEmpty(first) ? "New conversation" : first.Length > 60 ? first[..60] + "…" : first;
    }

    /// <summary>Where a conversation began, for the History: the dataset, or the team.</summary>
    private string Where(string teamId, string dataset) => dataset.Length > 0 ? dataset : $"team {TeamNameOf(teamId)}";

    private void OpenHistory() { _history = true; _memory = false; _error = null; }

    private void KeepNote()
    {
        if (_ctx is not { HasDataset: true } || string.IsNullOrWhiteSpace(_note)) return;
        Findings.AddNote(_ctx.TeamId, _ctx.DatasetKey, _note, ObservrNote.Owner);
        _note = null;
    }

    private void ForgetNote(long id)
    {
        if (_ctx is { HasDataset: true }) Findings.ForgetNote(id, _ctx.TeamId, _ctx.DatasetKey);
    }

    /// <summary>Opens a conversation from the History to read and continue.</summary>
    private void Open(long id)
    {
        _conversationId = id;
        _fresh = false;
        _history = false;
        _error = null;
        Load();
    }

    /// <summary>Starts over without losing anything: the current conversation goes to the History.</summary>
    private void NewConversation()
    {
        _conversationId = null;
        _fresh = true;
        _history = false;
        _error = null;
        Load();
    }

    /// <summary>The conversation a question goes into: the one shown, or a new one.</summary>
    private long Conversation()
    {
        var id = _conversationId ?? Conversations.Next(_userId);
        _conversationId = id;
        _fresh = false;
        return id;
    }

    private string TeamNameOf(string teamId) =>
        ActiveTeam.Teams.FirstOrDefault(x => x.Team.Id.ToString() == teamId).Team?.Name ?? _ctx?.TeamName ?? "";

    private string Intro() => _ctx!.HasDataset
        ? $"I watch {_ctx.DataSetName}: what visitors search for, how the fields are set up, and what changed. Ask me about any of it."
        : $"I watch the datasets of {_ctx.TeamName}. Open one to ask about it, or ask me about the team's.";

    private List<string> Suggested() => _ctx!.HasDataset
        ? ["What did visitors search for this week?", "Which searches found nothing?", "Is my field setup sensible?"]
        : ["Which datasets are hibernated?", "What did you find this week?"];

    private string Link(ObservrFinding f) => $"{TeamRoutes.Dataset(TeamNameOf(f.TeamId), f.DataSetName)}?tab={f.Tab}";

    private async Task SendAsync(string text)
    {
        if (_running || _ctx == null || !_canAsk || string.IsNullOrWhiteSpace(text)) return;
        _draft = "";
        _running = true;
        _status = "Reading the question";   // until Observr reports its first step, never a bare "…"
        _error = null;
        _steps.Clear();
        var conversation = Conversation();
        // Asked here, so it carries where: without it the turn read as asked on another team.
        _turns.Add(new ObservrTurn(0, ObservrTurn.User, text.Trim(), null, DateTime.UtcNow, _ctx.TeamId, _ctx.DatasetKey));
        StateHasChanged();
        try
        {
            var outcome = await Chat.AskAsync(_ctx, _userId, text, s => InvokeAsync(() => { OnStatus(s); StateHasChanged(); }), CancellationToken.None, conversation);
            if (outcome.Status != ObservrStatus.Ok)
            {
                // A refusal is not a turn of the thread: it shows here, and the question goes back
                // into the composer so it can be sent again when Observr is back.
                _error = ObservrText.Refusal(new ObservrOutcome(outcome.Status, Reason: outcome.Reason), "to answer");
                _draft = text;
            }
        }
        catch (Exception ex) { _error = ex.Message; _draft = text; }
        finally
        {
            _running = false;
            Load();
            _steps.Clear();
            StateHasChanged();
        }
    }

    /// <summary>A tab's button: its ask runs here as a turn, the label as the question.</summary>
    private async Task RunActionAsync(AgentAction action)
    {
        if (_running || _ctx == null) return;
        _running = true;
        _status = "Observr is looking";
        _error = null;
        var conversation = Conversation();
        _turns.Add(new ObservrTurn(0, ObservrTurn.User, action.Label, null, DateTime.UtcNow, _ctx.TeamId, _ctx.DatasetKey));
        StateHasChanged();
        try
        {
            var outcome = await action.Ask(CancellationToken.None);
            if (outcome.Status == ObservrStatus.Ok && outcome.Answer != null)
            {
                // The exchange goes into the thread only once it exists; a refusal shows here and
                // leaves the button to press again.
                Conversations.Add(_userId, _ctx.TeamId, _ctx.DatasetKey, ObservrTurn.User, action.Label, conversationId: conversation);
                Conversations.Add(_userId, _ctx.TeamId, _ctx.DatasetKey, ObservrTurn.Assistant, outcome.Answer.Answer, outcome.FindingId > 0 ? outcome.FindingId : null,
                    conversation);
                if (outcome.FindingId > 0 && (action.OnApplied != null || action.OnApplying != null)) _actions[outcome.FindingId] = action;
            }
            else _error = ObservrText.Refusal(outcome, "to look at");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _running = false;
            Load();
            StateHasChanged();
        }
    }

    private async Task DecideAsync(ObservrFinding f, bool yes, IReadOnlyList<int>? only)
    {
        if (_busy != 0) return;
        _busy = f.Id;
        _error = null;
        _actions.TryGetValue(f.Id, out var action);
        try
        {
            if (yes && action?.OnApplying != null) await action.OnApplying();
            _error = await Task.Run(() => Observr.Decide(f.Id, yes, only));
        }
        finally
        {
            if (yes && action?.OnApplied != null) await action.OnApplied();
            _actions.Remove(f.Id);
            _busy = 0;
            Load();
        }
    }
}
