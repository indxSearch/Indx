@inherits InputBase<string?>
@using Microsoft.AspNetCore.Components.Forms

@if (!string.IsNullOrEmpty(Label))
{
    <div class="@_wrapperClass">
        <label for="@_id" class="indx-input-label">
            @Label
            @if (Required) { <span aria-label="required"> *</span> }
        </label>
        <input id="@_id"
               name="@NameAttributeValue"
               class="@_inputClass"
               value="@CurrentValueAsString"
               @onchange="OnChange"
               aria-invalid="@(HasError ? "true" : "false")"
               aria-describedby="@(HasError && !string.IsNullOrEmpty(Error) ? $"{_id}-error" : null)"
               @attributes="AdditionalAttributes" />
        @if (!string.IsNullOrEmpty(Error))
        {
            <span id="@_id-error" class="indx-input-error-text" role="alert">@Error</span>
        }
    </div>
}
else
{
    <input id="@_id"
           name="@NameAttributeValue"
           class="@_inputClass"
           value="@CurrentValueAsString"
           @onchange="OnChange"
           aria-invalid="@(HasError ? "true" : "false")"
           @attributes="AdditionalAttributes" />
}

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool IsValid { get; set; } = true;
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Required { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error) || !IsValid;

    private string _id => Id ?? _generatedId;
    private readonly string _generatedId = $"input-{Guid.NewGuid():N}";

    private string _wrapperClass => "indx-input-wrapper";

    private string _inputClass
    {
        get
        {
            var cls = "indx-input";
            if (Variant == "borderBottom") cls += " indx-input-border-bottom";
            if (HasError) cls += " indx-input-error";
            return cls;
        }
    }

    protected override bool TryParseValueFromString(string? value, out string? result, out string validationErrorMessage)
    {
        result = value;
        validationErrorMessage = string.Empty;
        return true;
    }

    private void OnChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }
}
